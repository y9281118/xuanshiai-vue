      real_name: source.realName != null && String(source.realName).trim() != '' ? String(source.realName).trim() : null,
      phone: source.phone != null && String(source.phone).trim() != '' ? String(source.phone).trim() : null,
      wechat: source.wechat != null && String(source.wechat).trim() != '' ? String(source.wechat).trim() : null,
      source: source.source != null && String(source.source).trim() != '' ? String(source.source).trim() : '手动录入',
      intention_level: source.intentionLevel != null ? Number(source.intentionLevel) : 1,
      intention_value: source.intentionValue != null ? Number(source.intentionValue) : 1,
      remark: source.remark != null && String(source.remark).trim() != '' ? String(source.remark).trim() : null,
      photo: source.photo != null && String(source.photo).trim() != '' ? String(source.photo).trim() : null,
      gender: source.gender != null ? Number(source.gender) : null,
      birthday: source.birthday != null && String(source.birthday).trim() != '' ? String(source.birthday).trim() : null
    }
  })
}

/** 上传客源线索照片，返回 { url, thumbnail_url, size }。 */
export async function uploadWorkspaceLeadPhoto(filePath: string) {
  if (!hasRemoteMatchmakerEndpoint('POST', '/matchmaker/workbench/leads/photo')) return remoteMatchmakerUnavailable()
  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl('/matchmaker/workbench/leads/photo'),
      filePath: filePath,
      name: 'file',
      header: getAccessToken() != '' ? { Authorization: 'Bearer ' + getAccessToken() } : {},
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, code: res.statusCode, message: '上传响应解析失败' })
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve({ success: true, data, code: res.statusCode, message: 'success' })
        } else {
          const detail = data != null && data.detail != null ? data.detail : '上传失败'
          resolve({ success: false, data, code: res.statusCode, message: '' + detail })
        }
      },
      fail: (err: any) => {
        const message = err != null && err.errMsg != null ? '' + err.errMsg : '上传失败，请检查网络'
        resolve({ success: false, data: null, code: -1, message })
      }
    })
  })
}

function normalizeWorkspaceIntroductionStatus(value: any): string {
  const status = value != null ? String(value) : ''
  return status == 'PENDING' || status == 'IN_PROGRESS' || status == 'SUCCEEDED' || status == 'FAILED' || status == 'CLOSED' ? status : 'PENDING'
}

function normalizeWorkspaceIntroductionPerson(value: any) {
  const source = value != null ? value : {}
  return {
    id: source.user_id != null ? String(source.user_id) : '',
    name: source.nickname != null && String(source.nickname).length > 0 ? String(source.nickname) : '未命名会员',
    avatar: source.avatar != null ? String(source.avatar) : '',
    gender: Number(source.gender) == 1 ? '男' : (Number(source.gender) == 2 ? '女' : '未填写'),
    isVip: source.is_vip === true || source.is_vip === 1
  }
}

/** 查询当前服务红娘工作范围内的四态牵线记录；不返回双方联系方式。 */
export async function getMatchmakerWorkspaceIntroductions() {
  const result = await request({
    url: '/matchmaker/workbench/introductions',
    method: 'GET',
    data: { page: 1, page_size: 100 },
    mockData: USE_MOCK ? { items: mockMatchmakerWorkspaceIntroductions, total: mockMatchmakerWorkspaceIntroductions.length } : null
  })
  // 牵线记录不做本机演示兜底：假记录的会员编号进不了主页也读不到联系方式，空列表就交给页面显示空状态。
  if (!result.success || result.data == null) return result
  const source = result.data
  const items: any[] = Array.isArray(source.items) ? source.items.slice() : []
  let more = source.has_more === true
  let page = 1
  while (more && page < 1000 && !USE_MOCK) {
    page += 1
    const next = await request({ url: '/matchmaker/workbench/introductions', method: 'GET', data: { page: page, page_size: 100 } })
    if (!next.success || next.data == null) return next
    const nextItems = Array.isArray(next.data.items) ? next.data.items : []
    items.push(...nextItems)
    more = next.data.has_more === true
  }
  return {
    success: true,
    data: {
      items: items.map((item: any) => ({
        id: item.id != null ? String(item.id) : '',
        status: normalizeWorkspaceIntroductionStatus(item.status),
        failureReason: item.failure_reason != null ? String(item.failure_reason) : '',
        applicationResponse: item.application_response != null ? String(item.application_response) : 'UNANSWERED',
        responseReason: item.response_reason != null ? String(item.response_reason) : '',
        fromPhoneViewed: item.from_phone_viewed === true,
        toPhoneViewed: item.to_phone_viewed === true,
        note: item.note != null ? String(item.note) : '',
        createdAt: formatWorkspaceTime(item.created_at),
        updatedAt: formatWorkspaceTime(item.updated_at),
        fromUser: normalizeWorkspaceIntroductionPerson(item.from_user),
        toUser: normalizeWorkspaceIntroductionPerson(item.to_user)
      })),
      total: source.total != null ? Number(source.total) : items.length,
      workflowVersion: Number(source.workflow_version || 0),
      isDemo: USE_MOCK
    },
    code: result.code,
    message: result.message
  }
}

function normalizeWorkspaceMeetingRecord(value: any) {
  if (value == null) return null
  const status = value.status != null ? String(value.status) : ''
  const validStatus = status == 'SCHEDULED' || status == 'REMINDED' || status == 'CHECKED_IN' || status == 'COMPLETED' || status == 'CANCELLED' || status == 'NO_SHOW'
  if (!validStatus) return null
  return {
    id: value.id != null ? String(value.id) : '',
    status: status,
    scheduledAt: formatWorkspaceTime(value.scheduled_at),
    location: value.location != null ? String(value.location) : '',
    cancelReason: value.cancel_reason != null ? String(value.cancel_reason) : '',
    followUpContent: value.follow_up_content != null ? String(value.follow_up_content) : ''
  }
}

/** 查询当前服务红娘工作范围内的约见申请及最新约见安排；不返回双方联系方式。 */
export async function getMatchmakerWorkspaceMeetingRequests() {
  let result = await request({
    url: '/matchmaker/workbench/meeting-requests',
    method: 'GET',
    data: { page: 1, page_size: 100 },
    mockData: USE_MOCK ? { items: mockMatchmakerWorkspaceMeetingRequests, total: mockMatchmakerWorkspaceMeetingRequests.length } : null
  })
  // 现有页面在本地切换分组和搜索，必须先取齐分页，不能只搜索前 100 条。
  if (!USE_MOCK && result.success && result.data != null && Array.isArray(result.data.items)) {
    const allItems: any[] = [...result.data.items]
    let hasMore = result.data.has_more == true
    let page = 1
    while (hasMore && page < 1000) {
      page += 1
      const next = await request({ url: '/matchmaker/workbench/meeting-requests', method: 'GET', data: { page: page, page_size: 100 } })
      if (!next.success || next.data == null || !Array.isArray(next.data.items)) return next
      allItems.push(...next.data.items)
      hasMore = next.data.has_more == true
    }
    if (hasMore) return { success: false, code: 422, message: '约会记录过多，请联系平台处理', data: null }
    result = { ...result, data: { ...result.data, items: allItems } }
  }
  const useDemoFallback = USE_MOCK
  if (!result.success && !useDemoFallback) return result
  const source = useDemoFallback ? { items: mockMatchmakerWorkspaceMeetingRequests, total: mockMatchmakerWorkspaceMeetingRequests.length } : result.data
  if (source == null) return result
  const items = Array.isArray(source.items) ? source.items : []
  return {
    success: true,
    data: {
      items: items.map((item: any) => ({
        id: item.id != null ? String(item.id) : '',
        status: item.status != null ? String(item.status) : 'SUBMITTED',
        matchmakerName: item.matchmaker_name != null && String(item.matchmaker_name) != '' ? String(item.matchmaker_name) : '待分派',
        note: item.note != null ? String(item.note) : '',
        createdAt: formatWorkspaceTime(item.created_at),
        updatedAt: formatWorkspaceTime(item.updated_at),
        applicant: normalizeWorkspaceIntroductionPerson(item.applicant),
        target: normalizeWorkspaceIntroductionPerson(item.target),
        meeting: normalizeWorkspaceMeetingRecord(item.meeting)
      })),
      total: source.total != null ? Number(source.total) : items.length,
      isDemo: useDemoFallback,
      workflowVersion: Number(source.workflow_version || 0)
    },
    code: useDemoFallback ? 0 : result.code,
    message: useDemoFallback ? '本地测试数据' : result.message
  }
}

/** 分成金额统一两位小数并做千分位分组；符号由调用方补齐。 */
function formatWorkspaceMoney(value: any): string {
  let amount = Number(value)
  if (isNaN(amount)) amount = 0
  const fixed = (amount < 0 ? -amount : amount).toFixed(2)
  const segments = fixed.split('.')
  let intPart = segments[0]
  let grouped = ''
  while (intPart.length > 3) {
    grouped = ',' + intPart.substring(intPart.length - 3) + grouped
    intPart = intPart.substring(0, intPart.length - 3)
  }
  return intPart + grouped + '.' + segments[1]
}

/** 明细行金额带符号：冲正为负，其余为正。 */
function signedWorkspaceMoney(value: any): string {
  return (Number(value) < 0 ? '-￥' : '+￥') + formatWorkspaceMoney(value)
}

/** 演示行金额形如「+￥38.00」，只在回退演示数据时用于汇总。 */
function sumDemoAmounts(rows: any[]): number {
  let total = 0
  for (let i = 0; i < rows.length; i++) {
    const text = rows[i] != null && rows[i].amount != null ? String(rows[i].amount) : ''
    let digits = ''
    for (let j = 0; j < text.length; j++) {
      const ch = text.charAt(j)
      if ((ch >= '0' && ch <= '9') || ch == '.') digits += ch
    }
    if (digits.length > 0) total += Number(digits)
  }
  return total
}

/**
 * 我的线上分成明细：消费会员名/头像按支付订单回带，分成事件取规则名（规则缺失退回商品名），
 * 与后台「总店红娘-分成明细」同一口径；合计剔除冲正行，与工作台概览的线上分成一致。
 */
export async function getMatchmakerWorkspaceCommissionEntries(page: number = 1, pageSize: number = 100) {
  if (MATCHMAKER_REMOTE_MODE) {
    const result = await getRemoteCommissionEntries()
    if (!result.success || !Array.isArray(result.data)) return result
    const rows = result.data as any[]
    const labels: any = { PENDING: '待入账', AVAILABLE: '已入账', FROZEN: '冻结中', REVERSED: '已冲正' }
    const total = rows.filter((row: any) => row.status != 'REVERSED').reduce((sum: number, row: any) => sum + Number(row.amount || 0), 0)
    return { success: true, data: { items: rows.map((row: any) => ({ id: String(row.id), time: formatWorkspaceTime(row.created_at), name: '订单 #' + String(row.order_id), avatar: '', item: '服务分成', amount: signedWorkspaceMoney(row.amount), status: row.status, statusLabel: labels[row.status] || String(row.status), orderNo: '' })), total: rows.length, page: 1, pageSize: rows.length, hasMore: false, totalAmount: '￥' + formatWorkspaceMoney(total), isDemo: false }, code: result.code, message: result.message }
  }
  const result = await request({
    url: '/matchmaker/workbench/commission-entries',
    method: 'GET',
    data: { page: page, page_size: pageSize },
    mockData: USE_MOCK ? { items: mockMatchmakerCommissionEntries, total: mockMatchmakerCommissionEntries.length } : null
  })
  const serverItems = result.success && result.data != null && Array.isArray(result.data.items) ? result.data.items : []
  const useMockSource = USE_MOCK && result.success && result.data != null
  const useDemoFallback = useMockSource
  if (!result.success && !useDemoFallback) return result
  if (useDemoFallback) {
    const demoItems = mockMatchmakerCommissionEntries
    return {
      success: true,
      data: {
        items: demoItems.map((item: any) => ({
          id: item.time != null ? String(item.time) : '',
          time: item.time != null ? String(item.time) : '',
          name: item.name != null ? String(item.name) : '',
          avatar: item.avatar != null ? String(item.avatar) : '',
          item: item.item != null ? String(item.item) : '',
          amount: item.amount != null ? String(item.amount) : '',
          status: 'AVAILABLE',
          statusLabel: '已入账',
          orderNo: ''
        })),
        total: demoItems.length,
        page: page,
        pageSize: pageSize,
        hasMore: false,
        totalAmount: '￥' + formatWorkspaceMoney(sumDemoAmounts(demoItems)),
        isDemo: true
      },
      code: 0,
      message: '本地测试数据'
    }
  }
  const source = result.data
  if (source == null) return result
  const statusLabels: any = { PENDING: '待入账', AVAILABLE: '已入账', FROZEN: '冻结中', REVERSED: '已冲正' }
  const items = Array.isArray(source.items) ? source.items : []
  return {
    success: true,
    data: {
      items: items.map((item: any) => ({
        id: item.id != null ? String(item.id) : '',
        time: formatWorkspaceTime(item.created_at),
        name: item.consumer_name != null && String(item.consumer_name).length > 0 ? String(item.consumer_name) : '未知会员',
        avatar: item.consumer_avatar != null && String(item.consumer_avatar).length > 0 ? resolveMediaUrl(String(item.consumer_avatar)) : '',
        item: item.event_name != null && String(item.event_name).length > 0 ? String(item.event_name) : '服务分成',
        amount: signedWorkspaceMoney(item.amount),
        status: item.status != null ? String(item.status) : 'PENDING',
        statusLabel: statusLabels[item.status] != null ? String(statusLabels[item.status]) : '待入账',
        orderNo: item.order_no != null ? String(item.order_no) : ''
      })),
      total: source.total != null ? Number(source.total) : items.length,
      page: source.page != null ? Number(source.page) : page,
      pageSize: source.page_size != null ? Number(source.page_size) : pageSize,
      hasMore: source.has_more === true,
      totalAmount: '￥' + formatWorkspaceMoney(source.total_amount),
      isDemo: false
    },
    code: result.code,
    message: result.message
  }
}

/** 分成标准金额只做显示归一：整数不带小数位，其余保留两位；取不到一律 '--'，不按 0 渲染。 */
function formatCommissionNumber(value: any): string {
  if (value == null) return '--'
  const amount = Number(value)
  if (isNaN(amount)) return '--'
  return amount == Math.round(amount) ? String(Math.round(amount)) : amount.toFixed(2)
}

/**
 * 「分成级别」页面数据：级别总览、本人当前级别与按消费项目的分成标准。
 * 全部取服务端配置（后台「总店红娘 → 分成配置」维护同一份 commission_level），
 * 前端不写死级别与金额；后台未指派级别或未配置规则时返回空值，由页面显示占位与空状态。
 */
export async function getMatchmakerCommissionStandards() {
  const result = await request({ url: '/matchmaker/workbench/commission-standards', method: 'GET' })
  if (!result.success || result.data == null) return result
  const data: any = result.data
  const rawLevels = Array.isArray(data.levels) ? data.levels : []
  const rawEvents = Array.isArray(data.events) ? data.events : []
  const currentLevel = data.current_level
  return {
    success: true,
    data: {
      levels: rawLevels.map((row: any) => ({
        code: row.code != null ? String(row.code) : '',
        name: row.name != null && String(row.name).length > 0 ? String(row.name) : '--',
        condition: row.promotion_condition != null && String(row.promotion_condition).length > 0 ? String(row.promotion_condition) : '--',
        extra: row.platform_extra_amount != null ? formatCommissionNumber(row.platform_extra_amount) + '元' : '--'
      })),
      currentLevelName: currentLevel != null && currentLevel.name != null && String(currentLevel.name).length > 0 ? String(currentLevel.name) : '--',
      events: rawEvents.map((row: any) => ({
        key: row.name != null ? String(row.name) : '',
        name: row.name != null && String(row.name).length > 0 ? String(row.name) : '分成事件',
        amount: row.mode == 'rate'
          ? (row.rate_percent != null ? formatCommissionNumber(row.rate_percent) + '%' : '--')
          : (row.amount != null ? formatCommissionNumber(row.amount) + '元' : '--')
      }))
    },
    code: result.code,
    message: result.message
  }
}

