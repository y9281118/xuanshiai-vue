}

export async function uploadMemberFollowUpImage(memberId: string, followUpId: string, filePath: string, uploadKey: string) {
  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl('/matchmaker/workbench/members/' + encodeURIComponent(memberId) + '/follow-ups/' + encodeURIComponent(followUpId) + '/images'),
      filePath, name: 'file', formData: { upload_key: uploadKey }, header: { Authorization: 'Bearer ' + getAccessToken() },
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let message = '图片上传失败'
        try { const data = JSON.parse('' + res.data); if (data.detail != null) message = '' + data.detail } catch (e) {}
        resolve({ success: res.statusCode >= 200 && res.statusCode < 300, message })
      },
      fail: () => resolve({ success: false, message: '图片上传失败，请检查网络' })
    })
  })
}

export async function downloadMemberFollowUpImage(path: string) {
  return new Promise<string>((resolve) => {
    uni.downloadFile({
      url: buildApiUrl(path), header: { Authorization: 'Bearer ' + getAccessToken() },
      success: (res: any) => resolve(res.statusCode == 200 ? String(res.tempFilePath) : ''),
      fail: () => resolve('')
    })
  })
}

export async function getMatchmakerMemberContact(id: string) {
  const result = await request({ url: '/matchmaker/workbench/members/' + encodeURIComponent(id) + '/contact', method: 'GET' })
  if (!result.success || result.data == null) return result
  const source: any = result.data
  return {
    success: true,
    data: {
      userId: source.user_id != null ? String(source.user_id) : String(id),
      nickname: source.nickname != null ? String(source.nickname) : '',
      realName: source.real_name != null ? String(source.real_name) : '',
      phone: source.phone != null ? String(source.phone) : '',
      wechat: source.wechat != null ? String(source.wechat) : '',
      scope: source.scope != null ? String(source.scope) : 'SERVED'
    },
    code: result.code,
    message: result.message
  }
}

