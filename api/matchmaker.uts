/** 报喜图片上传：返回的 url 是服务端相对路径，直接写入 extra.images，展示时再拼域名。 */
export async function uploadWorkspaceGoodNewsPhoto(filePath: string) {
  if (!hasRemoteMatchmakerEndpoint('POST', '/matchmaker/workbench/good-news/photo')) return remoteMatchmakerUnavailable()
  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl('/matchmaker/workbench/good-news/photo'),
      filePath: filePath,
      name: 'file',
      header: getAccessToken() != '' ? { Authorization: 'Bearer ' + getAccessToken() } : {},
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, code: res.statusCode, message: '上传响应解析失败' })
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve({ success: true, data, code: res.statusCode, message: 'success' })
        } else {
          const detail = data != null && data.detail != null ? data.detail : '上传失败'
          resolve({ success: false, data, code: res.statusCode, message: '' + detail })
        }
      },
      fail: (err: any) => {
        const message = err != null && err.errMsg != null ? '' + err.errMsg : '上传失败，请检查网络'
        resolve({ success: false, data: null, code: -1, message })
      }
    })
  })
}

/** 报喜-反馈喜讯：写入后台喜讯内容域的待审行，放行由后台「喜讯管理」操作。 */
export async function createMatchmakerWorkspaceGoodNews(data: any) {
  const source = data != null ? data : {}
  const images: string[] = []
  if (source.images != null) {
    const sourceImages = source.images as any[]
    for (let i = 0; i < sourceImages.length; i++) {
      const image = String(sourceImages[i]).trim()
      if (image.length > 0) images.push(image)
    }
  }
  return request({
    url: '/matchmaker/workbench/good-news', method: 'POST', data: {
      stage: String(source.stage || '').trim(),
      partner_name: String(source.partnerName || '').trim(),
      meet_duration: String(source.meetDuration || '').trim(),
      content: String(source.content || '').trim(),
      images: images
    }
  })
}

/** 添加牵线记录：双方须为工作范围内会员，成功需完成时间、失败需原因。 */
export async function createMatchmakerIntroduction(data: any) {
  const source = data != null ? data : {}
  return request({
    url: '/matchmaker/workbench/introductions', method: 'POST', data: {
      from_user_id: Number(source.fromUserId), to_user_id: Number(source.toUserId),
      applied_at: source.appliedAt || null, result: 'PENDING'
    }
  })
}

/** 更新牵线状态；仅牵线失败需要携带失败原因。 */
export async function updateMatchmakerIntroductionStatus(id: string, status: string, failureReason: string, contactConfirmed: boolean = false) {
  const data: any = { status: status, contact_confirmed: contactConfirmed }
  if (status == 'FAILED' && failureReason.trim().length > 0) data.failure_reason = failureReason.trim()
  return request({ url: '/matchmaker/workbench/introductions/' + encodeURIComponent(id) + '/status', method: 'PATCH', data: data })
}

/** 查看这一条牵线的指定一方电话；后端审计并在双方电话已查看时推进状态。 */
export async function viewMatchmakerIntroductionContact(id: string, side: string, contactsObtained: boolean = false) {
  if (!Number.isInteger(Number(id)) || Number(id) < 1 || (side != 'from' && side != 'to')) return { success: false, data: null, code: 422, message: '无效的牵线记录或查看方' }
  return request({ url: '/matchmaker/workbench/introductions/' + encodeURIComponent(id) + '/contact-views', method: 'POST', data: { side: side, contacts_obtained: contactsObtained } })
}

/** 更新约见申请处理状态：待处理 SUBMITTED / 已处理 ACCEPTED、DECLINED、CLOSED。 */
export async function updateMatchmakerMeetingStatus(id: string, status: string, confirmation: any = null) {
  return request({ url: '/matchmaker/workbench/meeting-requests/' + encodeURIComponent(id) + '/status', method: 'PATCH', data: { ...(confirmation || {}), status: status } })
}

export async function createMatchmakerMeeting(data: any) {
  return request({ url: '/matchmaker/workbench/meetings', method: 'POST', data: data })
}

/** 删除约见申请记录（连同其约见安排），仅限服务范围内。 */
export async function deleteMatchmakerMeetingRequest(id: string) {
  return request({ url: '/matchmaker/workbench/meeting-requests/' + encodeURIComponent(id), method: 'DELETE' })
}

/** 安排约见：为双方接受的约见申请创建约见安排（时间须为未来，地点必填）。 */
export async function scheduleMatchmakerMeeting(id: string, scheduledAt: string, location: string) {
  return request({
    url: '/matchmaker/workbench/meeting-requests/' + encodeURIComponent(id) + '/schedule',
    method: 'POST',
    data: { scheduled_at: scheduledAt, location: location.trim() }
  })
}

/** 流转约见安排状态：REMINDED/CHECKED_IN/COMPLETED/CANCELLED/NO_SHOW；取消或爽约须带原因。 */
export async function updateMatchmakerMeetingRecordStatus(id: string, status: string, cancelReason: string, followUpContent: string = '') {
  const data: any = { status: status }
  if (status == 'CANCELLED' || status == 'NO_SHOW') data.cancel_reason = cancelReason.trim()
  if (status == 'COMPLETED') data.follow_up_content = followUpContent.trim()
  return request({ url: '/matchmaker/workbench/meetings/' + encodeURIComponent(id) + '/status', method: 'PATCH', data: data })
}

/** 审核仅影响公开资料状态，实名认证与学历认证继续由平台认证流程管理。 */
export async function updateMatchmakerReviewMember(id: string, changes: any) {
  const status = changes != null && changes.status != null ? String(changes.status) : ''
  const reason = changes != null && changes.reason != null ? String(changes.reason) : ''
  return request({ url: '/matchmaker/workbench/members/' + encodeURIComponent(id) + '/public-profile-review', method: 'PATCH', data: { status: status, reason: reason } })
}

