/**
 * 牵线/红娘相关 API
 * 包含：服务红娘、热心红娘、私人定制
 */

import { request, MATCHMAKER_REMOTE_MODE, hasRemoteMatchmakerEndpoint, remoteMatchmakerUnavailable, getRemoteCommissionEntries, createRemoteWithdrawal } from './matchmaker-remote.uts'
import { API_BASE_URL, USE_MOCK, getAccessToken, clearAuthTokens, buildApiUrl, resolveMediaUrl } from './config.uts'
import {
  mockMatchmakerManagementCenterAccess,
  mockMatchmakerManagementCenterSnapshot,
  mockPartnerCenterSnapshot,
  mockMatchmakerWorkspaceIntroductions,
  mockMatchmakerWorkspaceMeetingRequests,
  mockMatchmakerCommissionEntries,
  mockMatchmakerFinanceEntries
} from '@/mock/matchmaker.uts'

// 仅本机联调可在服务端尚未写入工作台记录时展示脱敏测试明细；部署环境始终只用服务端数据。
// 真实模式下空数据、错误都不得替换为演示记录。

function toMatchmakerCard(item: any) {
  const successCount = item.success_count != null ? Number(item.success_count) : 0
  const cases: any[] = []
  if (item.cases != null) {
    const source = item.cases as any[]
    for (let i = 0; i < source.length; i++) {
      const entry = source[i]
      const description = entry.description != null ? String(entry.description).trim() : ''
      if (description.length == 0) continue
      const images: string[] = []
      if (entry.images != null) {
        const sourceImages = entry.images as any[]
        for (let j = 0; j < sourceImages.length; j++) {
          const image = resolveMediaUrl(String(sourceImages[j]).trim())
          if (image.length > 0) images.push(image)
        }
      }
      cases.push({
        _id: 'service-case-' + String(item.user_id) + '-' + String(i),
        image: images.length > 0 ? images[0] : '',
        images: images,
        story: description,
        copy: description,
        feedback: entry.feedback != null ? String(entry.feedback).trim() : '',
        matchmakerComment: '',
        tags: []
      })
    }
  }
  return {
    id: item.user_id != null ? Number(item.user_id) : Number(item.id),
    name: item.nickname != null && String(item.nickname).length > 0 ? String(item.nickname) : '服务红娘',
    avatar: item.avatar != null ? resolveMediaUrl(String(item.avatar)) : '',
    city: '',
    title: '平台认证服务红娘',
    introduction: item.intro != null ? String(item.intro) : '',
    description: item.intro != null ? String(item.intro) : '',
    serviceCount: successCount,
    successCount,
    successRate: 0,
    tags: item.certification_tags != null ? item.certification_tags : [],
    badge: '平台认证',
    slogan: item.slogan != null ? String(item.slogan).trim() : '',
    specialties: Array.isArray(item.specialties) ? (item.specialties as any[]).map((entry: any) : String => String(entry).trim()).filter((entry: string) => entry.length > 0) : [] as string[],
    price: null,
    priceUnit: '',
    status: item.is_available === true ? 'online' : 'busy',
    certification: item.certification_tags != null && item.certification_tags.length > 0,
    isOnline: item.is_available === true,
    cases: cases,
    caseRecord: successCount > 0 ? '累计促成 ' + successCount + ' 次有效牵线。' : ''
  }
}

function cleanPlanText(value: any, fallback: string): string {
  const text = value != null ? String(value).trim() : ''
  if (text.length == 0 || text.indexOf('?') >= 0) {
    return fallback
  }
  return text
}

/**
 * 将服务端管理中心访问状态收敛为页面使用的字段。
 * 准入只依赖服务红娘申请审核和有效角色；本期不使用支付作为门槛。
 */
function normalizeMatchmakerManagementCenterAccess(data: any) {
  const source = data != null ? data : {}
  const roleStatus = source.role_status != null ? String(source.role_status) : (source.roleStatus != null ? String(source.roleStatus) : '')
  const serverCanAccess = source.can_access != null
    ? source.can_access == true || String(source.can_access) == 'true'
    : (source.canAccess == true || String(source.canAccess) == 'true')
  return {
    roleStatus: roleStatus,
    paymentStatus: 'not_required',
    canAccess: serverCanAccess && roleStatus == 'active',
    scope: source.scope != null ? String(source.scope) : '',
    source: source.source != null ? String(source.source) : 'api',
    message: source.message != null ? String(source.message) : ''
  }
}

/** 获取总店红娘管理中心开通与权限状态。 */
export async function getMatchmakerManagementCenterAccess() {
  const result = await request({
    url: '/matchmaker/management-center/access',
    forceHttp: true,
    method: 'GET',
    mockData: USE_MOCK ? mockMatchmakerManagementCenterAccess : null
  })
  if (!result.success || result.data == null) return result
  return {
    success: true,
    data: normalizeMatchmakerManagementCenterAccess(result.data),
    code: result.code,
    message: result.message
  }
}

/**
 * 获取总店红娘工作台聚合快照。
 * 不返回手机号、微信号等敏感资料；明细和写操作须由各业务接口按 RBAC 单独控制。
 */
function normalizeMatchmakerManagementCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const identity = source.identity != null ? source.identity : {}
  const metrics = Array.isArray(source.store_metrics)
    ? source.store_metrics
    : (Array.isArray(source.storeMetrics) ? source.storeMetrics : [])
  return {
    identity: {
      greeting: identity.greeting != null ? String(identity.greeting) : '你好',
      name: identity.name != null ? String(identity.name) : '服务红娘',
      roleName: identity.role_name != null ? String(identity.role_name) : (identity.roleName != null ? String(identity.roleName) : '服务红娘'),
      avatar: identity.avatar != null ? String(identity.avatar) : ''
    },
    storeMetrics: metrics.map((item: any) => ({
      key: item.key != null ? String(item.key) : '',
      label: item.label != null ? String(item.label) : '',
      value: item.value != null ? String(item.value) : '0',
      action: item.action != null ? String(item.action) : '',
      valuePrefix: item.value_prefix != null ? String(item.value_prefix) : (item.valuePrefix != null ? String(item.valuePrefix) : '')
    }))
  }
}

export async function getMatchmakerManagementCenterSnapshot() {
  const result = await request({
    url: '/matchmaker/management-center/dashboard',
    forceHttp: true,
    method: 'GET',
    mockData: USE_MOCK ? mockMatchmakerManagementCenterSnapshot : null
  })
  if (!result.success || result.data == null) return result
  return {
    success: true,
    data: normalizeMatchmakerManagementCenterSnapshot(result.data),
    code: result.code,
    message: result.message
  }
}

function formatWorkspaceTime(value: any): string {
  if (value == null) return ''
  return String(value).replace('T', ' ').substring(0, 19)
}

/**
 * 当前红娘的工作台身份：名称、头像与角色徽标。
 * 角色文案由服务端按工作台档案的 level + 门店给出（总店超级红娘 / 门店超级红娘 / 服务红娘），
 * 小程序不再写死，避免后台调整角色后徽标还停在旧称呼。
 */
export async function getMatchmakerWorkspaceIdentity() {
  const result = await request({
    url: MATCHMAKER_REMOTE_MODE ? '/matchmaker/management-center/dashboard' : '/matchmaker/workbench/identity',
    method: 'GET'
  })
  if (!result.success || result.data == null) return result
  const identity: any = MATCHMAKER_REMOTE_MODE ? (result.data.identity || {}) : result.data
  return {
    success: true,
    data: {
      greeting: identity.greeting != null ? String(identity.greeting) : '你好',
      name: identity.name != null ? String(identity.name) : '',
      roleName: identity.role_name != null ? String(identity.role_name) : (identity.roleName != null ? String(identity.roleName) : '服务红娘'),
      avatar: identity.avatar != null ? String(identity.avatar) : ''
    },
    code: result.code,
    message: result.message
  }
}

function readAmount(value: any): number | null {
  if (value == null || String(value) == '') return null
  const amount = Number(value)
  return isNaN(amount) || amount < 0 ? null : amount
}

function normalizePartnerCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const profile = source.profile != null ? source.profile : {}
  const teamSource = Array.isArray(source.team_members) ? source.team_members : (Array.isArray(source.teamMembers) ? source.teamMembers : [])
  const memberSource = Array.isArray(source.effective_members) ? source.effective_members : (Array.isArray(source.effectiveMembers) ? source.effectiveMembers : [])
  const withdrawalSource = Array.isArray(source.withdrawal_records) ? source.withdrawal_records : (Array.isArray(source.withdrawalRecords) ? source.withdrawalRecords : [])
  const withdrawableBalance = readAmount(source.withdrawable_balance != null ? source.withdrawable_balance : (source.withdrawableBalance != null ? source.withdrawableBalance : (source.balance != null ? source.balance : (profile.withdrawable_balance != null ? profile.withdrawable_balance : (profile.withdrawableBalance != null ? profile.withdrawableBalance : profile.balance)))))
  const teamPerformance = readAmount(source.team_performance != null ? source.team_performance : (source.teamPerformance != null ? source.teamPerformance : (profile.team_performance != null ? profile.team_performance : profile.teamPerformance)))
  const totalEarned = readAmount(source.total_earned != null ? source.total_earned : (source.totalEarned != null ? source.totalEarned : (profile.total_earned != null ? profile.total_earned : profile.totalEarned)))
  const memberGenderOf = (item: any): string => item.gender == 1 || item.gender == '男' ? '男' : (item.gender == 2 || item.gender == '女' ? '女' : '')
  const memberProfileByName: any = {}
  for (let i = 0; i < memberSource.length; i++) {
    const memberRow: any = memberSource[i]
    const rowName = memberRow.nickname != null ? String(memberRow.nickname) : String(memberRow.name || '')
    if (rowName != '') memberProfileByName[rowName] = memberRow
  }
  return {
    profile: {
      nickname: profile.nickname != null ? String(profile.nickname) : '',
      teamName: profile.team_name != null ? String(profile.team_name) : (profile.teamName != null ? String(profile.teamName) : ''),
      inviteCode: profile.invite_code != null ? String(profile.invite_code) : (profile.inviteCode != null ? String(profile.inviteCode) : (source.inviteCode != null ? String(source.inviteCode) : '')),
      level: source.level != null && source.level.level != null ? String(source.level.level) : (profile.level != null ? String(profile.level) : '初级合伙'),
      nextLevel: source.level != null && source.level.next_level != null ? String(source.level.next_level) : '',
      memberGap: source.level != null && source.level.member_gap != null ? Number(source.level.member_gap) : null,
      effectiveMemberCount: source.level != null && source.level.effective_member_count != null ? Number(source.level.effective_member_count) : null,
      balance: withdrawableBalance,
      withdrawableBalance: withdrawableBalance,
      points: readAmount(profile.points),
      phone: profile.phone != null ? String(profile.phone) : '',
      wechatBound: profile.wechat_bound == true || profile.wechatBound == true,
      registerAt: formatWorkspaceTime(profile.register_at != null ? profile.register_at : profile.registerAt)
    },
    teamPerformance: teamPerformance,
    totalEarned: totalEarned,
    teamMembers: teamSource.map((item: any) => ({ id: item.user_id != null ? item.user_id : item.id, name: item.nickname != null ? item.nickname : (item.name || ''), joinedAt: formatWorkspaceTime(item.joined_at != null ? item.joined_at : item.joinedAt), performance: readAmount(item.performance != null ? item.performance : item.team_performance), effectiveCount: item.effective_count != null ? Number(item.effective_count) : (item.effectiveCount != null ? Number(item.effectiveCount) : null) })),
    effectiveMembers: memberSource.map((item: any) => ({ id: item.user_id != null ? item.user_id : item.id, name: item.nickname != null ? item.nickname : (item.name || ''), gender: item.gender == 1 || item.gender == '男' ? '男' : (item.gender == 2 || item.gender == '女' ? '女' : ''), registerAt: formatWorkspaceTime(item.register_at != null ? item.register_at : item.registerAt), promoterName: item.promoter_name != null ? item.promoter_name : (item.promoterName || ''), avatar: item.avatar != null ? item.avatar : (item.avatar_url || ''), reviewStatus: item.review_status != null ? String(item.review_status) : (item.reviewStatus || 'PASSED') })),
    registrationRewards: (Array.isArray(source.registration_rewards) ? source.registration_rewards : (Array.isArray(source.registrationRewards) ? source.registrationRewards : [])).map((item: any) => {
      // 服务端新格式：user_id/nickname/avatar/register_at/reward_amount；本地 mock 旧格式：member_name/member_id/amount。
      const isServerShape = item.member_name == null && item.memberId == null && (item.user_id != null || item.nickname != null)
      if (isServerShape) {
        const serverName = item.nickname != null ? String(item.nickname) : (item.member_name != null ? String(item.member_name) : '')
        return { id: item.user_id != null ? 'PR-' + String(item.user_id) : String(item.id || ''), promoterName: item.promoter_name != null ? String(item.promoter_name) : '', memberName: serverName, memberId: item.user_id != null ? String(item.user_id) : '', gender: memberGenderOf(item), itemName: '会员注册奖励', amount: readAmount(item.reward_amount != null ? item.reward_amount : item.amount), createdAt: formatWorkspaceTime(item.register_at != null ? item.register_at : item.created_at), avatar: item.avatar != null ? String(item.avatar) : '' }
      }
      const memberName = item.member_name != null ? String(item.member_name) : (item.memberName || '')
      const rewardMemberRow: any = memberProfileByName[memberName] != null ? memberProfileByName[memberName] : {}
      return { id: item.id != null ? String(item.id) : '', promoterName: item.promoter_name != null ? String(item.promoter_name) : (item.promoterName || ''), memberName: memberName, memberId: item.member_id != null ? String(item.member_id) : (item.memberId != null ? String(item.memberId) : (rewardMemberRow.user_id != null ? String(rewardMemberRow.user_id) : (rewardMemberRow.id != null ? String(rewardMemberRow.id) : ''))), gender: item.gender != null ? memberGenderOf(item) : memberGenderOf(rewardMemberRow), itemName: '会员注册奖励', amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt), avatar: rewardMemberRow.avatar != null ? rewardMemberRow.avatar : (rewardMemberRow.avatar_url != null ? rewardMemberRow.avatar_url : '') }
    }),
    commissionRecords: (Array.isArray(source.commission_records) ? source.commission_records : (Array.isArray(source.commissionRecords) ? source.commissionRecords : [])).map((item: any) => {
      const memberName = item.member_name != null ? String(item.member_name) : (item.memberName || '')
      const memberRow: any = memberProfileByName[memberName] != null ? memberProfileByName[memberName] : {}
      const memberId = memberRow.user_id != null ? String(memberRow.user_id) : (memberRow.id != null ? String(memberRow.id) : (item.member_id != null ? String(item.member_id) : (item.memberId != null ? String(item.memberId) : '')))
      return { id: item.id != null ? String(item.id) : '', promoterName: item.promoter_name != null ? String(item.promoter_name) : (item.promoterName || ''), memberName: memberName, memberId: memberId, gender: item.gender != null ? memberGenderOf(item) : memberGenderOf(memberRow), itemName: item.item_name != null ? String(item.item_name) : (item.itemName || ''), amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt), avatar: memberRow.avatar != null ? memberRow.avatar : (memberRow.avatar_url != null ? memberRow.avatar_url : '') }
    }),
    withdrawalRecords: withdrawalSource.map((item: any) => {
      const appliedAmount = readAmount(item.amount)
      const feeRaw = item.fee != null ? item.fee : (item.withdrawal_fee != null ? item.withdrawal_fee : (item.withdrawalFee != null ? item.withdrawalFee : null))
      const feeValue = readAmount(feeRaw)
      const fee = feeValue != null ? feeValue : (appliedAmount != null ? Math.round(appliedAmount) * 0.01 : 0)
      return { id: item.id != null ? String(item.id) : '', amount: appliedAmount, fee: fee, arrivedAmount: appliedAmount != null ? appliedAmount - fee : null, status: item.status != null ? String(item.status) : '处理中', createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) }
    }),
    financeAvailable: source.finance_available == true
  }
}

/** 合伙人中心优先使用真实服务端数据；本机联调中无归属会员时回退到脱敏测试明细。 */
export async function getPartnerCenterSnapshot() {
  const result = await request({ url: '/matchmaker/partner-center', method: 'GET', mockData: USE_MOCK ? mockPartnerCenterSnapshot : null })
  const serverMembers = result.success && result.data != null && Array.isArray(result.data.effective_members)
    ? result.data.effective_members
    : (result.success && result.data != null && Array.isArray(result.data.effectiveMembers) ? result.data.effectiveMembers : [])
  const useDemoFallback = USE_MOCK
  if (!result.success && !useDemoFallback) return result
  const source = useDemoFallback ? mockPartnerCenterSnapshot : result.data
  if (source == null) return result
  return { success: true, data: normalizePartnerCenterSnapshot(source), code: result.code, message: result.message }
}

/** 创建或修改当前合伙人的唯一团队。 */
export async function updatePartnerTeamName(teamName: string) {
  const value = teamName.trim()
  if (value.length < 2 || value.length > 128) return { success: false, data: null, code: 400, message: '团队名称需为 2-128 个字符' }
  const result = await request({ url: '/matchmaker/partner-center/team', method: 'PUT', data: { name: value } })
  if (!result.success || result.data == null) return result
  return { success: true, data: normalizePartnerCenterSnapshot(result.data), code: result.code, message: result.message }
}

export async function createPartnerTeamInvite() {
  return request({ url: '/matchmaker/partner-center/invites', method: 'POST' })
}

/** 生成的团队邀请小程序码（base64 图片）；未配置微信能力时服务端返回 503。 */
export async function createPartnerTeamQrcode() {
  return request({ url: '/matchmaker/partner-center/qrcode', method: 'POST' })
}

/** 查询团队的入团申请（合伙人）；status 可选 PENDING/APPROVED/REJECTED/CANCELLED。 */
export async function getPartnerJoinRequests(status: string | null = null) {
  const query: any = status != null && status != '' ? { status: status } : {}
  return request({ url: '/matchmaker/partner-center/join-requests', method: 'GET', data: query })
}

/** 审批入团申请：APPROVED 通过入团 / REJECTED 拒绝（需 reason）。 */
export async function reviewPartnerJoinRequest(requestId: string, status: string, reason: string) {
  const data: any = { status: status }
  if (status == 'REJECTED') data.reason = reason.trim()
  return request({ url: '/matchmaker/partner-center/join-requests/' + encodeURIComponent(requestId), method: 'PATCH', data: data })
}

/** 推广红娘凭团队邀请码提交入团申请。 */
export async function submitPromoterTeamRequest(inviteCode: string) {
  return request({ url: '/matchmaker/promoter-center/team-requests', method: 'POST', data: { invite_code: inviteCode.trim() } })
}

/** 推广红娘撤回自己的待确认入团申请。 */
export async function cancelPromoterTeamRequest(requestId: string) {
  return request({ url: '/matchmaker/promoter-center/team-requests/' + encodeURIComponent(requestId), method: 'DELETE' })
}

/** 手机号与用户昵称由账号资料、账号安全流程管理，工作台不在设备侧暂存。 */
export async function updatePartnerAccountProfile(changes: any) {
  return { success: false, data: null, code: 501, message: '请在账号资料和账号安全页面修改昵称或手机号' }
}

/** 服务端控制提现开关、额度与审核，不创建本地资金记录。 */
async function createWorkspaceWithdrawal(data: any) {
  const account = data != null && data.account != null ? String(data.account).trim() : ''
  const payee = data != null && data.payee != null ? String(data.payee).trim() : ''
  if (account.length < 4 || payee.length < 1) return { success: false, data: null, code: 422, message: '请填写收款账号和收款人' }
  const masked = payee.charAt(0) + '** / 尾号 ' + account.substring(account.length - 4)
  return createRemoteWithdrawal(String(data.amount), masked)
}

export async function createPartnerWithdrawal(data: any) {
  return createWorkspaceWithdrawal(data)
}

function normalizePromoterCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const profile = source.profile != null ? source.profile : {}
  const toMember = (item: any) => ({ id: item.user_id, memberCode: item.member_code != null ? String(item.member_code) : (item.memberCode != null ? String(item.memberCode) : ''), name: item.nickname || '', gender: item.gender == 1 ? '男' : (item.gender == 2 ? '女' : ''), registerAt: formatWorkspaceTime(item.register_at), reviewStatus: item.review_status || 'PENDING', avatar: item.avatar != null ? item.avatar : (item.avatar_url != null ? item.avatar_url : '') })
  const toLead = (item: any) => { const statusMap: any = { NEW: '待审核', CONTACTED: '待审核', INTENDED: '有效', CONVERTED: '有效', LOST: '无效', CLOSED: '无效' }; const rawStatus = item.status != null ? String(item.status) : '待审核'; return { id: item.id, name: item.name || '', nickname: item.name || '', realName: item.name || '', phone: item.phone || '', wechat: item.wechat || '', source: item.source || '', status: statusMap[rawStatus] != null ? statusMap[rawStatus] : rawStatus, createdAt: formatWorkspaceTime(item.created_at) } }
  return { profile: { nickname: profile.nickname || '', promotionCode: profile.promotion_code || '', teamName: profile.team_name != null ? String(profile.team_name) : (profile.teamName != null ? String(profile.teamName) : ''), teamStatus: profile.team_status != null ? String(profile.team_status) : 'NONE', pendingRequestId: profile.pending_request_id != null ? String(profile.pending_request_id) : '', level: profile.level != null && String(profile.level) != '推广红娘' ? String(profile.level) : '初级', nextLevel: profile.next_level != null ? String(profile.next_level) : '', memberGap: profile.member_gap != null ? Number(profile.member_gap) : null, phone: profile.phone != null ? String(profile.phone) : '', wechatBound: profile.wechat_bound == true || profile.wechatBound == true, registerAt: formatWorkspaceTime(profile.register_at != null ? profile.register_at : profile.registerAt), balance: null, points: null }, teamOptions: (Array.isArray(source.team_options) ? source.team_options : (Array.isArray(source.teamOptions) ? source.teamOptions : [])).map((team: any) => ({ id: team.id != null ? String(team.id) : '', name: team.name != null ? String(team.name) : '' })), leads: (Array.isArray(source.leads) ? source.leads : []).map(toLead), effectiveMembers: (Array.isArray(source.effective_members) ? source.effective_members : []).map(toMember), incompleteMembers: (Array.isArray(source.incomplete_members) ? source.incomplete_members : []).map(toMember), rewards: (() => {
          const rawRewardList = source.rewards
          const isRewardList = Array.isArray(rawRewardList)
          const result: any[] = []
          if (isRewardList) {
            const list = rawRewardList as any[]
            for (let i = 0; i < list.length; i++) {
              const item = list[i]
              result.push({
                id: item.user_id != null ? String(item.user_id) : (item.id != null ? String(item.id) : ''),
                memberName: item.nickname != null ? String(item.nickname) : (item.member_name != null ? String(item.member_name) : (item.memberName != null ? String(item.memberName) : '')),
                memberId: item.user_id != null ? String(item.user_id) : (item.member_id != null ? String(item.member_id) : ''),
                gender: item.gender == 1 ? '男' : (item.gender == 2 ? '女' : (item.gender != null ? String(item.gender) : '')),
                reviewStatus: item.review_status != null ? String(item.review_status) : (item.reviewStatus != null ? String(item.reviewStatus) : 'PENDING'),
                amount: readAmount(item.reward_amount != null ? item.reward_amount : item.amount),
                createdAt: formatWorkspaceTime(item.register_at != null ? item.register_at : (item.created_at != null ? item.created_at : item.createdAt)),
                avatar: item.avatar != null ? String(item.avatar) : (item.avatar_url != null ? String(item.avatar_url) : '')
              })
            }
          }
          return result
        })(), commissions: (Array.isArray(source.commissions) ? source.commissions : (Array.isArray(source.commission_records) ? source.commission_records : (Array.isArray(source.commissionRecords) ? source.commissionRecords : []))).map((item: any) => ({ id: item.id != null ? String(item.id) : '', itemName: item.item_name != null ? String(item.item_name) : (item.itemName || ''), memberName: item.member_name != null ? String(item.member_name) : (item.memberName || ''), amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) })), withdrawals: [] as any[], offlineOrders: (Array.isArray(source.offline_orders) ? source.offline_orders : (Array.isArray(source.offlineOrders) ? source.offlineOrders : [])).map((item: any) => ({ id: item.id != null ? String(item.id) : '', customer: item.customer != null ? String(item.customer) : (item.customer_name != null ? String(item.customer_name) : (item.name || '')), amount: readAmount(item.amount), status: item.status != null ? String(item.status) : '已结算', createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) })), financeAvailable: source.finance_available == true }
}

export async function getPromoterCenterSnapshot() { const result = await request({ url: '/matchmaker/promoter-center', method: 'GET' }); if (!result.success || result.data == null) return result; return { success: true, data: normalizePromoterCenterSnapshot(result.data), code: result.code, message: result.message } }
export async function updatePromoterCenterProfile(changes: any) { return { success: false, data: null, code: 501, message: '请在账号资料和账号安全页面修改昵称或手机号' } }
export async function addPromoterLead(data: any) { const source = data != null ? data : {}; const name = source.nickname != null && String(source.nickname).trim() != '' ? String(source.nickname).trim() : String(source.realName || '').trim(); return request({ url: '/matchmaker/promoter-center/leads', method: 'POST', data: { name: name, phone: source.phone != null ? String(source.phone).trim() : '', wechat: source.wechat != null ? String(source.wechat).trim() : '', source: source.source != null && String(source.source).trim() != '' ? String(source.source).trim() : 'promoter', remark: source.description != null ? String(source.description).trim() : '' } }) }
export async function createPromoterWithdrawal(data: any) { return createWorkspaceWithdrawal(data) }
export async function createPromoterPromotionCode() { return request({ url: '/matchmaker/promoter-center/promotion-codes', method: 'POST' }) }

/** 查询红娘工作范围内会员公开资料审核队列（支持 review_status/search 分页参数）。 */
export async function getMatchmakerReviewMembers(data: any | null = null) {
  const query = data != null ? data : { page: 1, page_size: 100 }
  return request({ url: '/matchmaker/workbench/members', method: 'GET', data: query })
}

/** 红娘后台录入会员；走工作台域接口，单次调用完成建档+待审+分派。
 *  建档接口是可多次带料的旧契约，红娘端现在只在「建号」这一步收必要项，
 *  未提供的资料一律传 null，让后端 exclude_none 跳过——否则缺省值会把会员
 *  自己还没填的字段（如婚况）提前占位，基础信息门槛被系统代填。 */
export async function createMatchmakerWorkspaceMember(data: any) {
  const source = data != null ? data : {}
  const maritalText = source.maritalStatus != null ? String(source.maritalStatus) : ''
  // 写入域与会员端「资料编辑」的三档一致；库里 4~7 是旧的离异细分档，只读展示仍支持，但写 4~7 会被后端 422。
  const maritalMap: any = { '未婚': 1, '离异': 2, '离婚': 2, '丧偶': 3 }
  const isMarried = maritalMap[maritalText] != null ? maritalMap[maritalText] : null
  const heightText = source.height != null && String(source.height).trim() != '' ? Number(source.height) : null
  const weightText = source.weight != null && String(source.weight).trim() != '' ? Number(source.weight) : null
  // 收入：支持直接传数值（月收入），或传档位文案（录入表单选择）。档位映射与后台 INCOME_VALUES 一致。
  const incomeRaw = source.income != null ? String(source.income).trim() : ''
  const incomeBands: any = { '3千元以下': 2500, '3-5千元': 4000, '5-8千元': 6500, '8千-1万元': 9000, '1-2万元': 15000, '2万以上': 30000, '5万以上': 50000, '年入百万': 83333 }
  let incomeValue: any = null
  if (incomeRaw != '') {
    const banded = incomeBands[incomeRaw]
    if (banded != null) incomeValue = banded
    else {
      const numeric = Number(incomeRaw.replace(/[^0-9.]/g, ''))
      incomeValue = !isNaN(numeric) && numeric > 0 ? numeric : null
    }
  }
  // 标签：既支持数组（多选），也兼容旧「|」分隔字符串。
  let tagsValue: any = null
  if (source.tags != null) {
    if (Array.isArray(source.tags)) {
      const arr = (source.tags as any[]).filter((t: any) => t != null && String(t).trim() != '')
      tagsValue = arr.length > 0 ? arr.map((t: any) => String(t).trim()).join('|') : null
    } else {
      tagsValue = String(source.tags).trim() || null
    }
  }
  // 择偶要求编码映射（与后台 MemberDetailWorkspace 一致）
  const pref = source.pref != null ? source.pref : {}
  const eduOrder = ['初中', '技校', '高中', '中专', '大专', '本科', '硕士', '博士']
  const eduMin = pref.education != null && String(pref.education) != '' && String(pref.education) != '不限'
    ? eduOrder.indexOf(String(pref.education)) + 1 : null
  const incomeMin = pref.income != null && String(pref.income) != '' && String(pref.income) != '不限'
    ? (incomeBands[String(pref.income)] != null ? incomeBands[String(pref.income)] : Number(String(pref.income).replace(/[^0-9.]/g, ''))) : null
  const occReq = pref.occupation != null && String(pref.occupation) != '' && String(pref.occupation) != '不限' ? String(pref.occupation) : null
  const marriageAccept = pref.marriageAccept != null && String(pref.marriageAccept) != '' && String(pref.marriageAccept) != '不限' ? String(pref.marriageAccept) : null
  const housingReq = pref.housing != null && String(pref.housing) != '' && String(pref.housing) != '不限'
    ? (String(pref.housing) == '愿意和父母同住' ? 1 : String(pref.housing) == '要有独立婚房' ? 2 : null) : null
  const smokingReq = pref.smoking != null && String(pref.smoking) != '' && String(pref.smoking) != '不限'
    ? (String(pref.smoking) == '不接受吸烟' ? 1 : String(pref.smoking) == '可以偶尔吸烟' ? 2 : null) : null
  const weddingPlan = pref.weddingPlan != null && String(pref.weddingPlan) != '' && String(pref.weddingPlan) != '不限' ? String(pref.weddingPlan) : null
  const ageMin = pref.ageMin != null && Number(pref.ageMin) > 0 ? Number(pref.ageMin) : null
  const ageMax = pref.ageMax != null && Number(pref.ageMax) > 0 ? Number(pref.ageMax) : null
  const heightMin = pref.heightMin != null && Number(pref.heightMin) > 0 ? Number(pref.heightMin) : null
  const heightMax = pref.heightMax != null && Number(pref.heightMax) > 0 ? Number(pref.heightMax) : null
  const hasPref = ageMin != null || ageMax != null || heightMin != null || heightMax != null || eduMin != null || incomeMin != null || occReq != null || marriageAccept != null || housingReq != null || smokingReq != null || weddingPlan != null
  return request({
    url: '/matchmaker/workbench/members', method: 'POST', data: {
      phone: String(source.phone || '').trim(), nickname: String(source.nickname || '').trim(), real_name: String(source.realName || '').trim() || null,
      gender: Number(source.gender), birthday: source.birthday || null, is_married: isMarried,
      wechat: String(source.wechat || '').trim() || null, height: heightText, weight: weightText,
      hometown: String(source.hometown || '').trim() || null, residence: String(source.residence || '').trim() || null,
      household: String(source.household || '').trim() || null, ethnicity: String(source.ethnicity || '').trim() || null,
      zodiac: String(source.zodiac || '').trim() || null, education: String(source.education || '').trim() || null,
      job: String(source.occupation || '').trim() || null, income: incomeValue,
      house: String(source.housing || '').trim() || null, car: String(source.vehicle || '').trim() || null,
      smoking: String(source.smoking || '').trim() || null, drinking: String(source.drinking || '').trim() || null,
      religion: String(source.religion || '').trim() || null, marriage_plan: String(source.marriagePlan || '').trim() || null,
      tags: tagsValue, remark: String(source.remark != null ? source.remark : (source.memberCode != null && source.codeMode == 'custom' ? '录入编号：' + String(source.memberCode).trim() : '')).trim() || null,
      age_min: ageMin, age_max: ageMax, height_min: heightMin, height_max: heightMax,
      education_min: eduMin, income_min: incomeMin, occupation_requirement: occReq,
      marriage_accept: marriageAccept, housing_requirement: housingReq, smoking_requirement: smokingReq, wedding_plan: weddingPlan
    }
  })
}

/** 查询当前红娘工作台资料（含 user_id，供"我的"过滤与改派预选）。 */
export async function getMatchmakerWorkspaceProfile() {
  return request({ url: '/matchmaker/workbench/profile', method: 'GET' })
}

/**
 * 读取当前红娘可编辑的主页资料。
 * 服务端把昵称、签名、擅长领域、介绍、成功案例都落在入驻申请表，与公开主页同一份数据；
 * 图片一律返回入库原值（/storage/... 相对路径），展示侧再解析，保存时才能原样写回。
 */
export async function getMatchmakerWorkspaceHomepage() {
  const result = await request({ url: '/matchmaker/workbench/homepage', method: 'GET' })
  if (MATCHMAKER_REMOTE_MODE && !result.success && Number(result.code) == 404) {
    const profile = await getMatchmakerWorkspaceProfile()
    if (!profile.success || profile.data == null) return profile
    const id = Number(profile.data.user_id)
    if (!Number.isInteger(id) || id < 1) return { success: false, data: null, code: 422, message: '工作台身份无效，请重新登录' }
    const detail = await request({ url: '/matchmakers/' + id, method: 'GET' })
    if (!detail.success || detail.data == null) return detail
    const item = detail.data
    return { success: true, data: { nickname: String(item.nickname || profile.data.display_name || ''), avatar: item.avatar || '', slogan: item.slogan || '', specialties: Array.isArray(item.specialties) ? item.specialties : [], introduction: item.intro || '', cases: Array.isArray(item.cases) ? item.cases : [] }, code: detail.code, message: detail.message }
  }
  if (!result.success || result.data == null) return result
  const source: any = result.data
  const rawCases = Array.isArray(source.success_cases) ? source.success_cases as any[] : []
  return {
    success: true,
    data: {
      userId: source.user_id != null ? Number(source.user_id) : 0,
      nickname: source.nickname != null ? String(source.nickname) : '',
      avatar: source.avatar != null ? String(source.avatar) : '',
      slogan: source.slogan != null ? String(source.slogan) : '',
      specialties: Array.isArray(source.specialties) ? (source.specialties as any[]).map((item: any) => String(item)) : [] as string[],
      introduction: source.introduction != null ? String(source.introduction) : '',
      cases: rawCases.map((item: any) => ({
        description: item.description != null ? String(item.description) : '',
        images: Array.isArray(item.images) ? (item.images as any[]).map((image: any) => String(image)) : [] as string[]
      }))
    },
    code: result.code,
    message: result.message
  }
}

/** 保存红娘主页；只提交传入的字段，头像走会员侧头像接口，不在这里写。 */
export async function updateMatchmakerWorkspaceHomepage(changes: any) {
  const source = changes != null ? changes : {}
  const data: any = {}
  if (source.nickname != null) data.nickname = String(source.nickname).trim()
  if (source.slogan != null) data.slogan = String(source.slogan).trim()
  if (source.specialties != null) {
    data.specialties = (source.specialties as any[]).map((item: any) => String(item).trim()).filter((item: string) => item.length > 0)
  }
  if (source.introduction != null) data.introduction = String(source.introduction).trim()
  if (source.cases != null) {
    data.success_cases = (source.cases as any[]).map((item: any) => ({
      description: item.description != null ? String(item.description).trim() : '',
      images: Array.isArray(item.images) ? (item.images as any[]).map((image: any) => String(image).trim()).filter((image: string) => image.length > 0) : []
    })).filter((item: any) => item.description.length > 0)
  }
  const result = await request({ url: '/matchmaker/workbench/homepage', method: 'PATCH', data: data })
  if (!result.success && Number(result.code) == 404) return { success: false, data: null, code: 404, message: '远端尚未部署红娘主页编辑接口，请先更新后端服务' }
  return result
}

