/** 服务端对无名一侧返回占位串「未命名会员」，前端按空处理，卡片上就不渲染这一侧。 */
function newsPersonName(raw: any): string {
  const name = raw != null ? String(raw).trim() : ''
  return name == '未命名会员' ? '' : name
}

/** 红娘喜讯：只读后台「运营工具-喜讯管理」的内容域，服务端已按红娘范围与公开开关过滤。 */
export async function getMatchmakerWorkspaceGoodNews(stage: string, page: number, pageSize: number) {
  const result = await request({
    url: '/matchmaker/workbench/good-news',
    method: 'GET',
    data: { stage: stage, page: page, page_size: pageSize }
  })
  if (!result.success || result.data == null) return result
  const source = result.data
  const items = Array.isArray(source.items) ? source.items : []
  return {
    success: true,
    data: {
      items: items.map((item: any) => {
        const images: string[] = []
        if (item.images != null) {
          const sourceImages = item.images as any[]
          for (let i = 0; i < sourceImages.length; i++) {
            const image = resolveMediaUrl(String(sourceImages[i]).trim())
            if (image.length > 0) images.push(image)
          }
        }
        return {
          id: item.id != null ? String(item.id) : '',
          stage: item.stage != null ? String(item.stage) : '',
          fromUserId: item.from_user_id != null ? String(item.from_user_id) : '',
          toUserId: item.to_user_id != null ? String(item.to_user_id) : '',
          // 服务端对没有姓名的历史行给的是占位串，前端按「这一侧没人」处理，不显示占位文案。
          fromName: newsPersonName(item.from_name),
          toName: newsPersonName(item.to_name),
          fromAvatar: item.from_avatar != null ? resolveMediaUrl(String(item.from_avatar)) : '',
          toAvatar: item.to_avatar != null ? resolveMediaUrl(String(item.to_avatar)) : '',
          matchmakerName: item.matchmaker_name != null ? String(item.matchmaker_name) : '服务红娘',
          meetDuration: item.meet_duration != null ? String(item.meet_duration) : '',
          images: images,
          content: item.content != null ? String(item.content) : '',
          blessing: item.blessing != null ? String(item.blessing) : '',
          blessingCount: item.blessing_count != null ? Number(item.blessing_count) : 0,
          pendingReview: item.pending_review === true,
          public: item.public !== false,
          createdAt: formatWorkspaceTime(item.created_at)
        }
      }),
      total: source.total != null ? Number(source.total) : items.length,
      page: source.page != null ? Number(source.page) : page,
      hasMore: source.has_more === true
    },
    code: result.code,
    message: result.message
  }
}

