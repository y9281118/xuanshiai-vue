/**
 * 认证相关 API
 * 优先走 FastAPI，失败时回退到本地演示数据。
 */

import { request } from './request.uts'
import { mockMeProfile } from '@/mock'
import { CURRENT_USER_ID_KEY, USE_MOCK, buildApiUrl, getAccessToken, setAuthTokens, clearAuthTokens } from './config.uts'
// 退出登录要清掉缓存的己方头像，否则换号后聊天页仍显示上一个账号的头像。
import { resetMyAvatarCache } from './message.uts'

// 登录态自动续期入口（实现位于 request.uts，此处 re-export 供外部统一从 auth 模块引用）。
export { refreshAccessToken } from './request.uts'

const mockCertifications: any = {
  education: { kind: 'education', status: 0, material_submitted: false, submitted_at: null, reviewed_at: null, fail_reason: null, next_action: '提交认证材料' },
  house: { kind: 'house', status: 0, material_submitted: false, submitted_at: null, reviewed_at: null, fail_reason: null, next_action: '提交认证材料' },
  marriage: { kind: 'marriage', status: 0, material_submitted: false, submitted_at: null, reviewed_at: null, fail_reason: null, next_action: '提交认证材料' },
  single_pledge: { kind: 'single_pledge', status: 0, material_submitted: false, material: null, submitted_at: null, reviewed_at: null, fail_reason: null, next_action: '提交单身承诺', title: '单身承诺', content: null }
}

export async function getProfileCompletion() {
  const tags = Array.isArray(mockMeProfile.personal_tags) ? mockMeProfile.personal_tags as string[] : []
  const tagsCompleted = tags.length >= 3
  // Mock 也必须满足 score = Σ(已填项 weight)、Σ(全部 weight) = 100，
  // 否则 H5 预览会出现 N% 与 +X% 对不上的假象。
  const items = [
    { key: 'avatar', label: '头像', weight: 15, completed: true },
    { key: 'intro', label: '关于我', weight: 10, completed: true },
    { key: 'album', label: '相册', weight: 8, completed: true },
    { key: 'personal_tags', label: '兴趣标签', weight: 8, completed: tagsCompleted },
    { key: 'education', label: '学历', weight: 8, completed: true },
    { key: 'location', label: '所在地区', weight: 8, completed: true },
    { key: 'occupation', label: '职业', weight: 8, completed: true },
    { key: 'income', label: '收入', weight: 8, completed: true },
    { key: 'height', label: '身高', weight: 5, completed: true },
    { key: 'weight', label: '体重', weight: 5, completed: true },
    { key: 'gender', label: '性别', weight: 5, completed: true },
    { key: 'birthday', label: '出生日期', weight: 5, completed: true },
    { key: 'marriage', label: '婚姻状况', weight: 3, completed: true },
    { key: 'mbti', label: 'MBTI', weight: 4, completed: true }
  ]
  let score = 0
  for (let i = 0; i < items.length; i++) {
    if (items[i].completed == true) score += items[i].weight
  }
  return request({
    url: '/users/me/completion',
    method: 'GET',
    mockData: { score: score, items: items }
  })
}

export async function sendSms(phone: string, purpose: string = 'login') {
  return request({
    url: '/auth/sms/send',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, purpose },
    mockData: { message: '验证码已发送' }
  })
}

export async function loginByPhone(phone: string, code: string) {
  const res = await request({
    url: '/auth/phone/login',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, code, purpose: 'login' },
    mockData: {
      access_token: 'mock_access_token_xsa',
      refresh_token: 'mock_refresh_token_xsa',
      token_type: 'bearer',
      expires_in: 3600,
      need_bind_phone: false,
      user_id: 1
    }
  })
  if (res.success && res.data != null && res.data.access_token != null) {
    setAuthTokens(String(res.data.access_token), res.data.refresh_token != null ? String(res.data.refresh_token) : '')
    if (res.data.user_id != null) uni.setStorageSync(CURRENT_USER_ID_KEY, res.data.user_id)
  }
  return res
}

