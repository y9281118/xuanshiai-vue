<template>
	<view class="page">
		<!-- 导航栏 -->
		<view class="nav-bar" :style="{ paddingTop: (statusBarHeight + 12) + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="nav-right">
				<view class="nav-icon-btn role-switch-btn" @tap="onSwitchToParent" aria-label="切换到父母端" title="切换到父母端">
					<image class="nav-icon-img role-switch-icon" src="/static/icons/switch-parents.webp" mode="aspectFit"></image>
				</view>
				<view class="nav-icon-btn" @tap="onSettings">
					<text class="ic ic-me ic-shezhi nav-icon"></text>
				</view>
			</view>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view scroll-y class="content-scroll" enhanced show-scrollbar="false">
			<view class="content-inner">
			<!-- 个人资料头部（横向布局） -->
			<view class="profile-header">
				<view class="avatar-wrap" @tap="onViewMyProfile">
					<image v-if="user.avatar != ''" class="avatar-image" :src="user.avatar" mode="aspectFill"></image>
					<text v-else class="ic ic-social ic-touxiang avatar-icon"></text>
				</view>
				<view class="profile-info">
					<view class="nickname-row">
						<text class="nickname">{{ user.nickname }}</text>
						<view v-if="aiAttachmentStyleLabel != ''" class="moxiang-attachment-badge">
							<text class="moxiang-attachment-text">{{ aiAttachmentStyleLabel }}</text>
						</view>
					</view>
					<!-- 墨相心性称号与特质标签行（点击直达我的画像） -->
					<view v-if="aiPersonaTitle != '' || aiPersonaTags.length > 0" class="moxiang-badge-wrap" @tap="onAiPortrait">
						<view v-if="aiPersonaTitle != ''" class="moxiang-title-badge">
							<text class="moxiang-title-seal">墨</text>
							<text class="moxiang-title-text">{{ aiPersonaTitle }}</text>
						</view>
						<view v-for="tag in aiPersonaTags" :key="tag" class="moxiang-tag-pill">
							<text class="moxiang-tag-text">{{ tag }}</text>
						</view>
					</view>
					<view class="vip-tag-row">
						<view v-if="user.isVip" class="vip-tag">
							<text class="vip-tag-text">VIP会员</text>
						</view>
						<text class="vip-tag-desc">{{ user.isVip ? '会员权益有效' : '开通会员解锁更多功能' }}</text>
					</view>
					<!-- H5：这里是资料完整度，不是会员进度；与下方会员权益文案区分开。 -->
					<view class="progress-row">
						<text class="progress-label">资料完整度</text>
						<view class="progress-bar">
							<view class="progress-fill" :style="{ width: (completionLoaded ? profileCompletion : 0) + '%' }"></view>
						</view>
						<text class="progress-percent">{{ completionLoaded ? profileCompletion + '%' : '—' }}</text>
					</view>
					<text v-if="completionRulesVersion != ''" class="progress-rule">规则版本 {{ completionRulesVersion }}</text>
				</view>
				<view class="edit-profile-btn" @tap="onEditProfile">
					<text class="edit-profile-text">编辑资料</text>
					<text class="edit-profile-arrow">›</text>
				</view>
			</view>

			<!-- 统计数据行 -->
			<view class="stats-card">
				<view class="stat-item" v-for="stat in stats" :key="stat.label" @tap="openStatPage(stat.route)">
					<text class="stat-value">{{ stat.value }}</text>
					<view class="stat-label"><text v-for="line in stat.lines" :key="line">{{ line }}</text></view>
				</view>
			</view>

			<!-- H3：概览失败有独立提示与重试，不把昵称永久停在「加载中」，统计用「—」而非 0。 -->
			<view v-if="overviewError != ''" class="overview-error-bar">
				<text class="overview-error-text">{{ overviewError }}</text>
				<view class="overview-error-retry" @tap="loadOverview"><text>重试</text></view>
			</view>

			<!-- 知遇专区：认识自己、了解对方、整理资料的统一入口 -->
			<view class="ai-zone">
				<view class="ai-zone-head">
					<XsaZhiyuMark size="72rpx" :compact="true" />
					<text class="ai-zone-title">知遇</text>
				</view>
				<text class="ai-zone-sub">认识自己、了解对方、整理资料，都从这里开始。</text>
				<view class="zone-master" @tap="onMoxiangMaster">
					<view class="zone-master-figure">
						<XsaZhiyuMark size="46px" :show-label="false" />
					</view>
					<view class="zone-master-text">
						<view class="zone-master-title-row">
							<text class="zone-master-name">与知遇聊聊</text>
							<text class="zone-master-tag">{{ portraitTag }}</text>
						</view>
						<text class="zone-master-desc">{{ portraitDesc }}</text>
					</view>
					<text class="zone-master-arrow">›</text>
				</view>
				<view class="zone-master zone-master-archive" @tap="onAiPortrait">
					<view class="zone-master-figure">
						<XsaZhiyuMark size="46px" :show-label="false" />
					</view>
					<view class="zone-master-text">
						<text class="zone-master-name">我的画像</text>
						<text class="zone-master-desc">有成稿看结果，还没有就从对话开始</text>
					</view>
					<text class="zone-master-arrow">›</text>
				</view>
				<view class="zone-master zone-master-archive" @tap="onAiAvatar">
					<view class="zone-master-figure">
						<XsaZhiyuMark size="46px" :show-label="false" />
					</view>
					<view class="zone-master-text">
						<text class="zone-master-name">我的AI分身</text>
						<text class="zone-master-desc">管理你的数字分身</text>
					</view>
					<text class="zone-master-arrow">›</text>
				</view>
			</view>

			<!-- VIP 会员卡：会员态不再整块隐藏，否则已开通用户找不到续费/查看权益的入口 -->
			<view class="vip-card" @tap="onOpenVIP">
				<view class="vip-crown-wrap">
					<text class="ic ic-vip ic-huiyuan vip-crown"></text>
				</view>
				<view class="vip-text-col">
					<text class="vip-card-title">{{ user.isVip ? '会员中心' : '开通会员' }}</text>
					<text class="vip-card-sub">{{ user.isVip ? '查看权益与续费' : '解锁全部功能，遇见更多可能' }}</text>
				</view>
				<text class="ic ic-sys ic-jiantou-you vip-arrow"></text>
			</view>

			<!-- 主菜单 -->
			<view class="menu-card">
				<view class="menu-row" v-for="item in mainMenuItems" :key="item.label" @tap="handleMenuItem(item)">
					<view class="menu-icon-wrap" :style="{ backgroundColor: item.iconBg }">
						<image v-if="item.iconSrc != ''" class="menu-icon-img" :src="item.iconSrc" mode="aspectFit"></image>
						<text v-else :class="item.iconClass + ' menu-icon'"></text>
					</view>
					<text class="menu-label">{{ item.label }}</text>
					<view v-if="item.badge" class="menu-badge">
						<text class="menu-badge-text">{{ item.badge }}</text>
					</view>
					<view class="menu-spacer"></view>
					<text class="ic ic-sys ic-jiantou-you menu-arrow"></text>
				</view>
			</view>

			<!-- 底部菜单 -->
			<view class="menu-card">
				<view class="menu-row" v-for="item in bottomMenuItems" :key="item.label" @tap="item.label == '安全中心' ? onSecurity() : handleMenuItem(item)">
					<view class="menu-icon-wrap" :style="{ backgroundColor: item.iconBg }">
						<text :class="item.iconClass + ' menu-icon'"></text>
					</view>
					<view class="menu-text-col">
						<text class="menu-label">{{ item.label }}</text>
						<text v-if="item.subtitle" class="menu-subtitle">{{ item.subtitle }}</text>
					</view>
					<view class="menu-spacer"></view>
					<text class="ic ic-sys ic-jiantou-you menu-arrow"></text>
				</view>
			</view>

			<!-- 底部留白 -->
			<view class="scroll-bottom-spacer"></view>
			</view>
		</scroll-view>
	</view>

	<!-- 知遇悬浮入口：点开聚合面板；画像分流仍在面板里的「我的画像」 -->
	<view class="ai-portrait-fab" @tap="openZhiyuHub">
		<XsaZhiyuMark size="104rpx" />
	</view>

	<!-- 邀请分享弹窗：复用“我的任务.pen”的邀请分享弹窗-遮罩 -->
	<view v-if="inviteShareVisible" class="invite-share-mask" @tap="closeInviteShare">
		<view class="invite-share-sheet" @tap.stop>
			<view class="invite-share-handle"></view>
			<text class="invite-share-title">分享邀请好友</text>
			<view class="invite-share-options">
				<view class="invite-share-option" @tap="shareToWechat">
					<view class="invite-share-option-icon invite-share-option-icon-green"><text class="invite-share-symbol">↗</text></view>
					<text class="invite-share-option-label">发送给朋友</text>
				</view>
				<view class="invite-share-option" @tap="goMyPoster">
					<view class="invite-share-option-icon invite-share-option-icon-gold"><text class="invite-share-symbol">▧</text></view>
					<text class="invite-share-option-label">生成海报</text>
				</view>
			</view>
			<text class="invite-share-note">好友通过你的分享卡片/海报完成注册后，邀请人和新好友双方均可获得平台积分，分享可兑现奖励。</text>
			<view class="invite-share-cancel" @tap="closeInviteShare"><text>取消</text></view>
		</view>
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
	<XsaZhiyuHub
		:visible="zhiyuHubVisible"
		:actions="zhiyuHubActions"
		@close="zhiyuHubVisible = false"
		@select="onZhiyuHubSelect"
	/>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import XsaTabBar from '@/components/XsaTabBar.uvue'
import XsaZhiyuMark from '@/components/XsaZhiyuMark.uvue'
import XsaZhiyuHub from '@/components/XsaZhiyuHub.uvue'
import { getProfileOverview, getProfileCompletion, getMembershipStatus, getPortraitNarrative } from '@/api'
import { getContinuousMoxiangState, type ContinuousMoxiangState } from '@/api/ai-moxiang.uts'
import { mapProfileError } from '@/api/ai-profile.uts'
import { resolveMediaUrl } from '@/api/config.uts'
import { setCurrentUserVipStatus } from '@/utils/quota.uts'
import { attachmentStyleLabel, MASTER_ROLE_NAME } from '@/utils/moxiang-badge.uts'

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

const user = ref({
	nickname: '加载中',
	isVip: false,
	avatar: '',
})

const stats = ref([
	{ value: '0', label: '我的申请', lines: ['我的申请'], route: '/pagesSub/profileExtra/applications' },
	{ value: '0', label: '我看过谁/看过我', lines: ['我看过谁', '谁看过我'], route: '/pagesSub/profileExtra/visitors' },
	{ value: '0', label: '我的收藏', lines: ['我的收藏'], route: '/pagesSub/profileExtra/favorites' },
	{ value: '0', label: '我的爆灯', lines: ['我的爆灯'], route: '/pagesSub/profileExtra/spotlights' },
])

const portraitTag = ref('状态读取中')
const portraitDesc = ref('正在读取你的画像状态，请稍候。')
// 双画像快照是入口状态的唯一来源，未确认稿不得冒充正式画像。
const portraitState = ref('unknown')
const portraitSnapshot = ref<ContinuousMoxiangState | null>(null)
let portraitReadSeq = 0
let portraitPageVisible = true
const portraitHasResult = computed((): boolean => {
	const state = portraitSnapshot.value
	return state != null && state.consent_granted && [state.personal, state.ideal_partner].some((item) =>
		item.draft_id != null || item.published_revision_id != null || item.status != 'collecting')
})
const portraitStateLoading = ref(false)
const portraitStateError = ref('')
// 画像能力被服务端关闭（AI_FEATURE_DISABLED）时为 true：不再重试请求，只在点击时如实提示。
const portraitUnavailable = ref(false)
// 上一次画像状态读取失败的时刻，用于点击冷却，避免连点放大无效请求。
let lastPortraitFailedAt = 0
const PORTRAIT_RETRY_COOLDOWN_MS = 4000
// H3：概览区块独立的加载/错误态，失败给重试入口，不把昵称永久停在「加载中」。
const overviewLoading = ref(false)
const overviewError = ref('')
// H5：资料完整度与会员权益区分开——progress 来自 getProfileCompletion，
// 与 VIP 无关；读取失败显示「—」而不是 0%。
const profileCompletion = ref(0)
const completionLoaded = ref(false)
const completionRulesVersion = ref('')
const aiPersonaTitle = ref('')
const aiPersonaTags = ref([] as string[])
const aiAttachmentStyle = ref('')

const aiAttachmentStyleLabel = computed((): string => attachmentStyleLabel(aiAttachmentStyle.value))

const clearPortraitBadge = () => {
	aiPersonaTitle.value = ''
	aiPersonaTags.value = []
	aiAttachmentStyle.value = ''
}

const applyPortraitStateCopy = () => {
	const state = portraitState.value
	if (state == 'ready') {
		portraitTag.value = '已有确认画像'
		portraitDesc.value = '查看已确认内容，也可以继续聊聊微调'
	} else if (state == 'confirming') {
		portraitTag.value = '待你确认'
		portraitDesc.value = '已有完整待确认稿，两份画像各自确认生效'
	} else if (state == 'generating') {
		portraitTag.value = '正在成稿'
		portraitDesc.value = '后台正在生成，可到档案查看真实任务状态'
	} else if (state == 'attention') {
		portraitTag.value = '需要核对'
		portraitDesc.value = '稿件生成失败或版本已变化，请到档案核对'
	} else if (state == 'building') {
		portraitTag.value = '继续整理'
		portraitDesc.value = '一段自然对话，分别整理自己与伴侣期待'
	} else if (state == 'consent') {
		portraitTag.value = '待授权'
		portraitDesc.value = '由你决定是否授权整理，不影响继续浏览'
	} else if (state == 'idle') {
		portraitTag.value = '点击开启'
		portraitDesc.value = '从你想聊的开始，不必先完成任何一份画像'
	} else {
		portraitTag.value = '状态暂未读取'
		// 有明确错误原因时如实展示（如「AI 画像功能当前不可用」），
		// 不要用模糊文案把服务端主动关闭能力的情况盖掉。
		portraitDesc.value = portraitStateError.value != '' ? portraitStateError.value : '暂时无法确认画像状态，可稍后重试'
	}
}

const loadPortraitState = async (): Promise<boolean> => {
	const seq = ++portraitReadSeq
	portraitStateLoading.value = true
	portraitStateError.value = ''
	clearPortraitBadge()
	try {
		const state = await getContinuousMoxiangState()
		if (!portraitPageVisible || seq != portraitReadSeq) return false
		portraitSnapshot.value = state
		// 读取成功说明能力已恢复（例如服务端重新打开了开关），解除不可用标记。
		portraitUnavailable.value = false
		lastPortraitFailedAt = 0
		const items = [state.personal, state.ideal_partner]
		if (!state.consent_granted) portraitState.value = 'consent'
		else if (items.some((item) => item.status == 'awaiting_confirmation')) portraitState.value = 'confirming'
		else if (items.some((item) => item.status == 'failed' || item.status == 'stale')) portraitState.value = 'attention'
		else if (items.some((item) => item.status == 'generating')) portraitState.value = 'generating'
		else if (items.some((item) => item.status == 'confirmed' && item.published_revision_id != null)) portraitState.value = 'ready'
		else if (state.session_id != null || items.some((item) => item.overall_percent > 0)) portraitState.value = 'building'
		else portraitState.value = 'idle'
		applyPortraitStateCopy()
		return true
	} catch (error: any) {
		if (!portraitPageVisible || seq != portraitReadSeq) return false
		portraitSnapshot.value = null
		portraitState.value = 'unknown'
		// 不再统一写死「画像状态暂时无法读取」：按后端业务码分流，
		// 让「功能未开放」和「真的读取失败」在界面上可区分。
		const businessCode = error != null && error.businessCode != null ? '' + error.businessCode : ''
		const failedRequestId = error != null && error.requestId != null ? '' + error.requestId : ''
		portraitStateError.value = mapProfileError(businessCode, '画像状态暂时无法读取')
		portraitUnavailable.value = businessCode == 'AI_FEATURE_DISABLED'
		lastPortraitFailedAt = Date.now()
		console.error('[Profile] portrait state failed', businessCode, failedRequestId)
		applyPortraitStateCopy()
		return false
	} finally {
		if (seq == portraitReadSeq) portraitStateLoading.value = false
	}
}

// 只展示与当前正式 personal revision 一致的已确认叙事；失败不沿用私密旧缓存。
const loadPortraitNarrative = async () => {
	const seq = portraitReadSeq
	const snapshot = portraitSnapshot.value
	clearPortraitBadge()
	if (!portraitPageVisible || snapshot == null || !snapshot.consent_granted || snapshot.personal.published_revision_id == null) return
	const revisionId = String(snapshot.personal.published_revision_id)
	try {
		const res = await getPortraitNarrative('personal')
		if (!portraitPageVisible || seq != portraitReadSeq) return
		if (res == null || res.success !== true || res.data == null) throw res
		const data = res.data as any
		if (data.subject != 'personal' || data.status != 'confirmed' || String(data.revision_id ?? '') != revisionId) return
		aiPersonaTitle.value = String(data.persona_title ?? '').trim()
		const tags = Array.isArray(data.persona_tags) ? data.persona_tags as any[] : []
		aiPersonaTags.value = tags.map((t: any): string => String(t).trim()).filter((t: string): boolean => t != '')
		const insight = data.emotional_insight as any
		aiAttachmentStyle.value = insight != null ? String(insight.attachment_style ?? '').trim() : ''
	} catch (e: any) {
		if (!portraitPageVisible || seq != portraitReadSeq) return
		clearPortraitBadge()
		const code = Number(e?.code ?? e?.statusCode ?? 0)
		if (code == 401 || code == 403) {
			portraitReadSeq++
			portraitSnapshot.value = null
			portraitState.value = 'unknown'
			applyPortraitStateCopy()
		}
	}
}

// H3：各区块独立反馈。overview 失败不再直接 return 让昵称停在「加载中」，
// 统计未取到用「—」而不是 0；会员、画像、概览并行读取，慢项不拖住其它区块。
// refreshSeq 由 onShow 传入：写入前校验，只有最新一次刷新允许落地。
const loadOverview = async () => {
	overviewLoading.value = true
	const membershipTask = getMembershipStatus()
		.then((membershipRes: any) => {
			if (membershipRes != null && membershipRes.success && membershipRes.data != null) {
				user.value.isVip = (membershipRes.data as any).is_vip === true
				// 会员态以服务端为准，同时回写本地缓存（按 user_id 分键），供首页本地查看额度判定。
				setCurrentUserVipStatus(user.value.isVip === true)
			}
		})
		.catch((error: any) => { console.error('[Profile] membership refresh failed', error) })
	// 画像状态与概览并行：画像读取慢不阻塞头像/昵称/统计的先到。
	const portraitTask = loadPortraitState().then((ok) => { if (ok) return loadPortraitNarrative() })
	const overviewTask = getProfileOverview()
		.then((res: any) => {
			if (res == null || !res.success || res.data == null) {
				overviewError.value = res != null && res.message != null && String(res.message).trim() != ''
					? String(res.message).trim()
					: '资料概览暂时无法加载'
				return
			}
			overviewError.value = ''
			const data = res.data as any
			const profile = data.profile != null && typeof data.profile === 'object' ? data.profile : {}
			const account = data.user != null && typeof data.user === 'object' ? data.user : {}
			const nickname = data.nickname != null && data.nickname != ''
				? data.nickname
				: (profile.nickname != null && profile.nickname != '' ? profile.nickname : account.nickname)
			user.value.nickname = nickname != null && nickname != '' ? '' + nickname : '未设置昵称'
			const avatar = data.avatar != null && data.avatar != '' ? data.avatar : (profile.avatar != null && profile.avatar != '' ? profile.avatar : account.avatar)
			user.value.avatar = resolveMediaUrl(avatar)
			// 统计缺失用「—」占位，不伪装成 0。
			const incoming = data.incoming_application_count
			const outgoing = data.outgoing_application_count
			stats.value[0].value = incoming != null || outgoing != null
				? '' + (Number(incoming != null ? incoming : 0) + Number(outgoing != null ? outgoing : 0))
				: '—'
			stats.value[1].value = data.visitor_count != null ? '' + data.visitor_count : '—'
			stats.value[2].value = data.favorite_count != null ? '' + data.favorite_count : '—'
			stats.value[3].value = data.superlike_sent_count != null ? '' + data.superlike_sent_count : '—'
		})
		.catch((error: any) => {
			console.error('[Profile] overview refresh failed', error)
			overviewError.value = '资料概览暂时无法加载'
		})
	// 资料完整度单独读写并单独失败：与会员权益区隔，读取失败显示「—」而不是 0%。
	const completionTask = getProfileCompletion()
		.then((completion: any) => {
			if (completion != null && completion.success && completion.data != null) {
				const completionData = completion.data as any
				const score = completionData.score
				completionRulesVersion.value = completionData.rules_version != null ? '' + completionData.rules_version : ''
				if (score != null && !isNaN(Number(score))) {
					profileCompletion.value = Math.round(Number(score))
					completionLoaded.value = true
					return
				}
			}
			completionLoaded.value = false
		})
		.catch((error: any) => {
			console.error('[Profile] completion refresh failed', error)
			completionLoaded.value = false
		})
	await Promise.all([membershipTask, portraitTask, overviewTask, completionTask])
	overviewLoading.value = false
}

const onSettings = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
}

const onSwitchToParent = () => {
	uni.showModal({
		title: '切换至父母端',
		content: '父母端将使用独立的身份和授权视图。',
		cancelText: '暂不切换',
		confirmText: '确认切换',
		success: (result) => {
			if (result.confirm != true) return
			uni.setStorageSync('xsa_onboarding_mode', 'parent')
			uni.reLaunch({ url: '/pagesSub/parent/parent' })
		}
	})
}

const onViewMyProfile = () => {
	uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' })
}

const onEditProfile = () => {
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/edit',
		fail: () => { uni.showToast({ title: '编辑资料打开失败，请重试', icon: 'none' }) }
	})
}

const zhiyuHubVisible = ref(false)
const zhiyuHubActions = [
	{ key: 'self', glyph: '己', title: '与知遇聊聊', desc: '用对话认识自己和期待的关系' },
	{ key: 'portrait', glyph: '像', title: '我的画像', desc: '有成稿就看结果，还没有就继续建构' },
	{ key: 'avatar', glyph: '身', title: '我的 AI 分身', desc: '管理数字分身，不冒充你本人' },
	{ key: 'search', glyph: '寻', title: '帮我找找', desc: '按条件筛选，结果仍由你自己判断' }
]
const openZhiyuHub = () => { zhiyuHubVisible.value = true }

// 两份待审阅/任务在档案中独立恢复；只有确认后的个人稿可以直达正式结果。
const openPortraitDestination = () => {
	if (!portraitPageVisible || portraitState.value == 'unknown') return
	const snapshot = portraitSnapshot.value
	let url = '/pagesSub/profileExtra/my-portrait-master?flow_version=continuous_v2'
	if (portraitHasResult.value) url = '/pagesSub/profileExtra/my-portrait-archive?flow_version=continuous_v2'
	if (portraitState.value == 'ready' && snapshot?.personal.status == 'confirmed' && !snapshot.personal.has_updates) {
		url = '/pagesSub/profileExtra/my-portrait-result?flow_version=continuous_v2&subject=personal&published=1'
	}
	uni.navigateTo({
		url,
		fail: () => { uni.showToast({ title: 'AI画像打开失败，请重试', icon: 'none' }) }
	})
}
const onAiPortrait = () => {
	if (!portraitPageVisible || portraitStateLoading.value) return
	if (portraitState.value == 'unknown') {
		// 服务端明确关闭该能力（retryable=false）：重试没有意义，直接如实说明。
		if (portraitUnavailable.value) {
			uni.showToast({ title: portraitStateError.value, icon: 'none' })
			return
		}
		// 冷却期内不再重复请求，避免连点把失败日志放大成多次无效调用。
		if (Date.now() - lastPortraitFailedAt < PORTRAIT_RETRY_COOLDOWN_MS) {
			uni.showToast({ title: '正在恢复中，请稍后再试', icon: 'none' })
			return
		}
		// 状态未知时不猜去向：先重试读取，仍失败则如实提示，不冒充新用户。
		loadPortraitState().then((ok) => {
			if (!portraitPageVisible) return
			if (!ok || portraitState.value == 'unknown') {
				uni.showToast({ title: portraitStateError.value, icon: 'none' })
				return
			}
			openPortraitDestination()
		})
		return
	}
	openPortraitDestination()
}

const onOpenVIP = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/vip', fail: () => { uni.showToast({ title: '会员页面打开失败，请重试', icon: 'none' }) } })
}

const onAiAvatar = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-ai-avatar',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMoxiangMaster = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-portrait-master?flow_version=continuous_v2',
		fail: () => { uni.showToast({ title: MASTER_ROLE_NAME + '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMoxiangArchive = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-portrait-archive?flow_version=continuous_v2',
		fail: () => { uni.showToast({ title: '档案页面打开失败，请重试', icon: 'none' }) }
	})
}

const onZhiyuHubSelect = (key: string) => {
	zhiyuHubVisible.value = false
	if (key == 'self') onMoxiangMaster()
	else if (key == 'portrait') onAiPortrait()
	else if (key == 'avatar') onAiAvatar()
	else if (key == 'search') {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/search',
			fail: () => { uni.showToast({ title: '搜索页面打开失败，请重试', icon: 'none' }) }
		})
	}
}

const openStatPage = (url: string) => { if (url != '') uni.navigateTo({ url }) }

const onMyTasks = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-tasks',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMyMoments = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/my-moments' })
}

const onMyPoster = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-posters?userId=9001',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
