	})
}

const onCertification = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/certification' })
}

const onInviteFriend = () => {
	inviteShareVisible.value = true
}

const inviteShareVisible = ref(false)

const closeInviteShare = () => { inviteShareVisible.value = false }

const shareToWechat = () => {
	inviteShareVisible.value = false
	uni.showToast({ title: '已准备好分享内容', icon: 'success' })
}

const goMyPoster = () => {
	inviteShareVisible.value = false
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-posters?userId=9001',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMenuSettings = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
}

const onHelp = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/help', fail: () => { uni.showToast({ title: '客服与帮助打开失败，请重试', icon: 'none' }) } })
}

const onAbout = () => {
	uni.navigateTo({ url: '/pagesSub/about/about' })
}

const onSecurity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/security',
		animationType: 'slide-in-right',
		fail: (err) => {
			console.warn('安全中心导航失败', err)
			uni.showToast({ title: '安全中心暂不可用，请重试', icon: 'none' })
		}
	})
}

const handleMenuItem = (item: any) => {
	if (item == null) return
	const directUrl = item.url != null ? '' + item.url : ''
	if (directUrl != '') {
		uni.navigateTo({ url: directUrl, fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) } })
		return
	}
	const label = item.label != null ? '' + item.label : ''
	if (label == '客服与帮助') {
		onHelp()
	} else if (label == '安全中心') {
		onSecurity()
	} else if (label == '设置') {
		onMenuSettings()
	} else if (label == '关于我们') {
		onAbout()
	} else if (label == '我的动态') {
		onMyMoments()
	} else if (label == '诚信认证') {
		onCertification()
	} else if (label == '会员中心') {
		onOpenVIP()
	} else if (item.action != null) {
		item.action()
	}
}

const onEmotionLab = () => {
	uni.navigateTo({ url: '/pagesSub/emotionLab/emotion-lab' })
}

// iconSrc 非空时用 SVG 图片图标（优先），否则用 iconClass 字体图标
const mainMenuItems = [
	{ iconClass: 'ic ic-vip ic-renwu', iconSrc: '', iconBg: '#EDE4F0', label: '我的任务', badge: 'NEW', action: onMyTasks },
	{ iconClass: 'ic ic-me ic-dongtai', iconSrc: '', iconBg: '#E4EDE8', label: '我的动态', action: onMyMoments },
	{ iconClass: '', iconSrc: '/static/icons/flask.svg', iconBg: '#E4EDE8', label: '情感实验室', action: onEmotionLab },
	{ iconClass: 'ic ic-home ic-heart', iconSrc: '', iconBg: '#FDE8EC', label: '我的海报', action: onMyPoster },
	{ iconClass: 'ic ic-social ic-huodong', iconSrc: '', iconBg: '#FEF3E4', label: '我的报名', action: onMyRegistration },
	{ iconClass: 'ic ic-social ic-peidui', iconSrc: '', iconBg: '#FDE8EC', label: '我的约会', action: onMyDate },
	{ iconClass: 'ic ic-sys ic-shiming', iconSrc: '', iconBg: '#FEF3E4', label: '诚信认证', action: onCertification },
	{ iconClass: 'ic ic-sys ic-fenxiang', iconSrc: '', iconBg: '#FEF3E4', label: '推荐给好友', action: onInviteFriend },
	{ iconClass: 'ic ic-me ic-shezhi', iconSrc: '', iconBg: '#FEF3E4', label: '设置', action: onMenuSettings },
]

const bottomMenuItems = [
	{ iconClass: 'ic ic-me ic-kefu', iconBg: '#F7F4F0', label: '客服与帮助', subtitle: 'AI客服 . 意见反馈', action: onHelp },
	{ iconClass: 'ic ic-me ic-bangzhu', iconBg: '#F7F4F0', label: '关于我们', subtitle: '版本 1.0.0', action: onAbout },
	{ iconClass: 'ic ic-sys ic-shiming', iconBg: '#FEF3E4', label: '安全中心', url: '/pagesSub/profileExtra/security', action: onSecurity },
]

// H3：页面级刷新代际——只允许最新一次刷新写入，避免旧响应覆盖新数据。
let overviewRefreshSeq = 0
onShow(() => {
	portraitPageVisible = true
	overviewRefreshSeq += 1
	const seq = overviewRefreshSeq
	loadOverview().then(() => {
		if (seq != overviewRefreshSeq) return
	})
})
const hidePortraitState = () => {
	portraitPageVisible = false
	portraitReadSeq++
	portraitStateLoading.value = false
	portraitSnapshot.value = null
	portraitState.value = 'unknown'
	clearPortraitBadge()
}
onHide(hidePortraitState)
onUnload(hidePortraitState)
</script>

