const visibleMoments = computed((): any[] => {
	const all = user.value.lifePhotos as any[]
	return momentsExpanded.value ? all : all.slice(0, MOMENTS_PREVIEW_COUNT)
})

const textValue = (value: any, fallback: string): string => {
	return value != null && value != '' ? '' + value : fallback
}

const firstField = (raw: any, keys: string[]): any => {
	if (raw == null) return null
	for (const key of keys) if (raw[key] != null && raw[key] != '') return raw[key]
	return null
}

const locationTextByCodes = (raw: any, provinceKey: string, cityKey: string, districtKey: string): string => {
	const provinceCode = raw != null ? textValue(raw[provinceKey], '') : ''
	const cityCode = raw != null ? textValue(raw[cityKey], '') : ''
	const districtCode = raw != null ? textValue(raw[districtKey], '') : ''
	if (provinceCode == '' || cityCode == '' || districtCode == '') return ''
	const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
	for (const province of provinces) {
		if ('' + province.code != provinceCode) continue
		const cities = Array.isArray(province.city) ? province.city as any[] : []
		for (const city of cities) {
			if ('' + city.code != cityCode) continue
			const areas = Array.isArray(city.area) ? city.area as any[] : []
			for (const area of areas) if ('' + area.code == districtCode) return province.name + ' ' + city.name + ' ' + area.name
		}
	}
	return ''
}

const locationTextByPrefix = (raw: any, prefix: string): string => {
	const province = firstField(raw, [prefix + '_province_code', prefix + '_province'])
	const city = firstField(raw, [prefix + '_city_code', prefix + '_city'])
	const district = firstField(raw, [prefix + '_district_code', prefix + '_district', prefix + '_area_code', prefix + '_area'])
	if (province != null && city != null && district != null) {
		const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
		for (const item of provinces) {
			if ('' + item.code != '' + province && '' + item.name != '' + province) continue
			const cities = Array.isArray(item.city) ? item.city as any[] : []
			for (const cityItem of cities) {
				if ('' + cityItem.code != '' + city && '' + cityItem.name != '' + city) continue
				const areas = Array.isArray(cityItem.area) ? cityItem.area as any[] : []
				for (const area of areas) if ('' + area.code == '' + district || '' + area.name == '' + district) return item.name + ' ' + cityItem.name + ' ' + area.name
			}
		}
	}
	return ''
}

const constellationFromBirthday = (birthday: any): string => {
	const value = textValue(birthday, '')
	if (value.length < 10) return ''
	const month = Number(value.substring(5, 7))
	const day = Number(value.substring(8, 10))
	const signs = ['摩羯座', '水瓶座', '双鱼座', '白羊座', '金牛座', '双子座', '巨蟹座', '狮子座', '处女座', '天秤座', '天蝎座', '射手座']
	const cutoffs = [20, 19, 21, 21, 21, 22, 23, 23, 23, 23, 22, 22]
	if (month < 1 || month > 12 || day < 1 || day > 31) return ''
	return signs[(day < cutoffs[month - 1] ? month - 1 : month) % 12]
}

// 属相兜底：老数据没有 zodiac 列值时按生日年份推导。1900 年为庚子鼠年。
const ZODIAC_ANIMALS: string[] = ['鼠', '牛', '虎', '兔', '龙', '蛇', '马', '羊', '猴', '鸡', '狗', '猪']
const zodiacFromBirthday = (birthday: any): string => {
	const value = textValue(birthday, '')
	if (value.length < 4) return ''
	const year = Number(value.substring(0, 4))
	if (isNaN(year) || year < 1900 || year > 2100) return ''
	return ZODIAC_ANIMALS[(year - 1900) % 12] + '年'
}

const locationTextByCityCode = (rawCode: any): string => {
	const cityCode = textValue(rawCode, '')
	if (cityCode == '') return ''
	const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
	for (const province of provinces) {
		const cities = Array.isArray(province.city) ? province.city as any[] : []
		for (const city of cities) {
			if ('' + city.code == cityCode) return province.name + ' ' + city.name
		}
	}
	return ''
}

const formatDimension = (raw: any, unit: string): string => {
	if (raw == null || raw === '' || Number(raw) <= 0) return '未填写'
	const output = '' + raw
	return output.endsWith(unit) ? output : output + unit
}

// 统一口径：收入展示走 utils 里的唯一实现，避免首页/详情/编辑三处各写一份
const formatIncome = (raw: any): string => incomeDisplayText(raw)

user.value = {
	id: 0, name: '', detailLocked: false, age: '', avatar: '', isVIP: false, job: '', edu: '', city: '',
	online: '', distance: '', recentActivity: '', match: 0, matchAvailable: false, tags: [], bio: '',
	cover: '', photos: [], lifePhotos: [], expect: [], basicInfo: [], detailInfo: [] as any[], qaAnswers: [] as any[],
	moxiangPersonaTitle: '',
	moxiangPersonaTags: [] as string[],
	moxiangAttachmentStyle: ''
}
dynamics.value = []
certs.value = []

const formatAttachmentStyle = (rawStyle: any): string => attachmentStyleLabel(rawStyle)

const mapDetailUser = (raw: any, id: number) => {
	if (raw == null) return
	const envelope = raw.data != null ? raw.data : raw
	if (envelope == null) return
	const card = envelope.card != null ? envelope.card : envelope
	const profile = envelope.profile != null ? envelope.profile : envelope
	const account = envelope.user != null ? envelope.user : {}
	const value = (primary: any, secondary: any, fallback: string): string => {
		return textValue(primary, textValue(secondary, fallback))
	}
	const missing = '未填写'
	const age = value(card.age, profile.age, missing)
	const educationLabel = (level: any): string => {
		// 学历字典已收口到 utils/profile-field-display.uts（1 高中及以下 … 5 博士，6-8 兜底博士）。
		// 与后端 app/services/discovery.py 的 _EDUCATION_LABELS 同口径，禁止在本页再维护映射表。
		const text = educationLabelOf(level)
		return text == '未填写' ? '' : text
	}
	const educationValue = firstField(card, ['education', 'education_level', 'edu']) || firstField(profile, ['education', 'education_level', 'edu'])
	const edu = educationLabel(educationValue) == '' ? missing : educationLabel(educationValue)
	const job = value(card.occupation, profile.occupation, value(card.job, profile.job, missing))
	const residenceText = value(profile.residence_display, card.residence_display, value(envelope.residence_display, '', locationTextByCodes(profile, 'residence_province_code', 'residence_city_code', 'residence_district_code') || locationTextByPrefix(profile, 'residence') || locationTextByPrefix(envelope, 'residence') || locationTextByCityCode(card.city_code)))
	const hometownText = value(profile.hometown_display, card.hometown_display, value(envelope.hometown_display, '', locationTextByCodes(profile, 'hometown_province_code', 'hometown_city_code', 'hometown_district_code') || locationTextByPrefix(profile, 'hometown') || locationTextByPrefix(envelope, 'hometown')))
	const city = value(residenceText, card.residence, value(profile.residence, value(card.city, profile.city, missing), missing))
	const height = formatDimension(card.height != null ? card.height : profile.height, 'cm')
	const weight = formatDimension(card.weight != null ? card.weight : profile.weight, 'kg')
	const birthday = firstField(card, ['birthday', 'birth_date', 'date_of_birth']) || firstField(profile, ['birthday', 'birth_date', 'date_of_birth']) || firstField(envelope, ['birthday', 'birth_date', 'date_of_birth'])
	const constellation = value(card.constellation, profile.constellation, constellationFromBirthday(birthday) == '' ? missing : constellationFromBirthday(birthday))
	const hometown = value(hometownText, card.hometown, value(profile.hometown, missing, missing))
	const incomeValue = firstField(profile, ['income_display', 'income', 'salary']) || firstField(card, ['income_display', 'income', 'salary']) || firstField(envelope, ['income_display', 'income', 'salary'])
	const income = formatIncome(incomeValue)
	const marriageStatus = card.is_married != null ? card.is_married : profile.is_married
	// users.is_married 编码：1 未婚 2 离异 3 丧偶，4-7 是离异的细分档（与资料待审卡片同口径）。
	const marriageText = (status: any): string | null => {
		if (status == null || status === '') return null
		const code = Number(status)
		if (isNaN(code)) return null
		if (code == 1) return '未婚'
		if (code == 2) return '离异'
		if (code == 3) return '丧偶'
		if (code == 4) return '离婚未育'
		if (code == 5) return '离异未带孩'
		if (code == 6) return '离异带女孩'
		if (code == 7) return '离异带男孩'
		return null
	}
	const marriage = value(card.marriage, marriageText(marriageStatus), '未填写')
	const mbti = value(card.mbti, profile.mbti, '未填写')
	const avatar = resolveMediaUrl(value(card.avatar, profile.avatar, value(envelope.avatar, account.avatar, '')))
	const background = resolveMediaUrl(value(card.background_wall, profile.background_wall, value(envelope.background_wall, '', '')))
	const nickname = value(card.nickname, profile.nickname, value(envelope.nickname, account.nickname, ''))
	const detailLocked = card.detail_locked === true || envelope.detail_locked === true
	// 红心初始态：读卡片上的 is_liked（user_favorite.type=1）；is_favorite 是 type=2 的旧收藏，不能用。
	const likedFlag = card.is_liked != null ? card.is_liked : envelope.is_liked
	if (likedFlag != null) isLikedUser.value = likedFlag == true
	if (envelope.is_vip_viewer != null) viewerIsVip.value = envelope.is_vip_viewer === true
	const rawPhotos = card.photos != null ? card.photos : profile.photos
	const photos = Array.isArray(rawPhotos)
		? (rawPhotos as any[]).map((photo: any) => photo != null && typeof photo === 'object' ? resolveMediaUrl(value(photo.url, photo.file_url, avatar)) : resolveMediaUrl(photo))
		: []
	const lifePhotos = photos
	// 标签口径与后端 display_personal_tags 一致：卡片与资料的 personal_tags 都是合并后的同一份列表，
	// card.interest_tags 只截 5 条且不含性格标签，必须排在最后兜底，否则采用标签后他人页会少显示。
	const tags = Array.isArray(card.personal_tags) ? card.personal_tags as string[] : Array.isArray(profile.personal_tags) ? profile.personal_tags as string[] : Array.isArray(card.tags) ? card.tags as string[] : Array.isArray(profile.interest_tags) ? profile.interest_tags as string[] : Array.isArray(card.interest_tags) ? card.interest_tags as string[] : []
	const tagWithMbti = mbti != '' && mbti != '未填写' ? [mbti].concat(tags) : tags
	const expectations = profile.tag_selections != null && Array.isArray(profile.tag_selections.relationship_expectation)
		? profile.tag_selections.relationship_expectation as string[]
		: Array.isArray(card.expect) && card.expect.length > 0 ? card.expect as string[] : []
	// 「关于我」公开问答：AI 画像整理成的自我介绍与三题回答会写回 user_profile.qa_answers，
	// 后端 get_profile 已返回该字段（public 脱敏分支不剔除），只渲染有答案的题。
	const rawQaAnswers = Array.isArray(profile.qa_answers) ? profile.qa_answers as any[] : (Array.isArray(card.qa_answers) ? card.qa_answers as any[] : [])
	const qaAnswers: any[] = []
	for (let qaIndex = 0; qaIndex < rawQaAnswers.length; qaIndex++) {
		const item: any = rawQaAnswers[qaIndex]
		if (item == null || typeof item != 'object') continue
		const answer = String(item.answer ?? '').trim()
		if (answer == '') continue
		const question = String(item.question ?? '').trim()
		let mediaUrl = ''
		const mediaList = Array.isArray(item.media) ? item.media as any[] : []
		if (mediaList.length > 0 && mediaList[0] != null) {
			const media = mediaList[0]
			const url = media.file_url != null ? media.file_url : media.thumbnail_url
			if (url != null) mediaUrl = resolveMediaUrl('' + url)
		}
		qaAnswers.push({ question: question != '' ? question : '关于我', answer: answer, mediaUrl: mediaUrl })
	}
	// 基础资料固定 3 行 × 3 列 = 9 格（2026-10-27 定版）：
	// 婚姻、MBTI 与新增的 10 项一起归入「详细资料」，避免两块重复展示同一字段。
	const mappedInfo = [
		[{ label: '年龄', value: age == missing ? missing : age + '岁' }, { label: '身高', value: height }, { label: '体重', value: weight }],
		[{ label: '星座', value: constellation }, { label: '学历', value: edu }, { label: '职业', value: job }],
		[{ label: '现居', value: city }, { label: '家乡', value: hometown }, { label: '收入', value: income }]
	]
	// 详细资料 12 项：取值优先 card，再 profile，都没有显示「未填写」。
	// 12 项都不计入资料完整度，所以这里缺值不影响任何门槛。
	const pickDetail = (keys: string[]): string => {
		const fromCard = firstField(card, keys)
		if (fromCard != null) return ('' + fromCard).trim()
		const fromProfile = firstField(profile, keys)
		return fromProfile != null ? ('' + fromProfile).trim() : ''
	}
	const detailValue = (keys: string[]): string => {
		const text = pickDetail(keys)
		return text == '' ? missing : text
	}
	const householdText = pickDetail(['household_display', 'household'])
	const detailInfo = [
		{ label: '婚姻状况', value: marriage },
		{ label: 'MBTI', value: mbti },
		{ label: '属相', value: pickDetail(['zodiac']) != '' ? pickDetail(['zodiac']) : (zodiacFromBirthday(birthday) != '' ? zodiacFromBirthday(birthday) : missing) },
		{ label: '户口', value: householdText != '' ? householdText : missing },
		{ label: '购房', value: detailValue(['house']) },
		{ label: '购车', value: detailValue(['car']) },
		{ label: '毕业学校', value: detailValue(['school']) },
		{ label: '工作单位', value: detailValue(['company']) },
		{ label: '民族', value: detailValue(['ethnicity']) },
		{ label: '吸烟', value: detailValue(['smoking']) },
		{ label: '喝酒', value: detailValue(['drinking']) },
		{ label: '宗教', value: detailValue(['religion']) }
	]
	const moxiangTitleRaw = firstField(card, ['moxiang_persona_title', 'persona_title']) || firstField(profile, ['moxiang_persona_title', 'persona_title']) || firstField(envelope, ['moxiang_persona_title', 'persona_title'])
	const moxiangPersonaTitle = moxiangTitleRaw != null ? String(moxiangTitleRaw).trim() : ''

	const moxiangTagsRaw = card.moxiang_persona_tags != null
		? card.moxiang_persona_tags
		: (profile.moxiang_persona_tags != null
			? profile.moxiang_persona_tags
			: (envelope.moxiang_persona_tags != null
				? envelope.moxiang_persona_tags
				: (card.persona_tags != null ? card.persona_tags : (profile.persona_tags != null ? profile.persona_tags : []))))
	const moxiangPersonaTags = Array.isArray(moxiangTagsRaw)
		? (moxiangTagsRaw as any[]).map((t: any): string => String(t).trim()).filter((t: string): boolean => t != '')
		: []

	const moxiangAttachRaw = firstField(card, ['moxiang_attachment_style', 'attachment_style']) || firstField(profile, ['moxiang_attachment_style', 'attachment_style']) || firstField(envelope, ['moxiang_attachment_style', 'attachment_style'])
	const moxiangAttachmentStyle = formatAttachmentStyle(moxiangAttachRaw)

	user.value = {
		...user.value,
		// 使用路由传入的 id，防止后端返回的 user_id/card.id 错误覆盖成其他用户
		id: id,
		name: value(nickname, card.name, user.value.name),
		detailLocked,
		age,
		avatar,
		isVIP: card.is_vip === true || card.isVip === true || card.isVIP === true || profile.is_vip === true || profile.isVip === true || profile.isVIP === true,
		job,
		edu,
		city,
		online: value(card.online, card.online_status, ''),
		distance: value(card.distance, card.distance_km != null ? '距你 ' + card.distance_km + 'km' : null, ''),
		recentActivity: value(card.recentActivity, card.activeStatus, ''),
		match: card.match_score != null ? Number(card.match_score) : (card.match != null ? Number(card.match) : 0),
		matchAvailable: card.match_score != null || card.match != null,
		mbti,
		tags: tagWithMbti,
		bio: value(card.intro, profile.self_intro, value(card.introduction, profile.introduction, '')),
		cover: background != '' ? background : (photos.length > 0 ? photos[0] : avatar),
		photos,
		lifePhotos,
		expect: expectations,
		qaAnswers: qaAnswers,
		basicInfo: mappedInfo,
		detailInfo: detailInfo,
		moxiangPersonaTitle,
		moxiangPersonaTags,
		moxiangAttachmentStyle
	}
	// 认证区曾硬编码「实名/学历/头像/房产」四项并在初始化后清空，
	// 结果既永远不渲染、又虚构了不存在的「房产认证」。
	// 现在只认后端下发的 certification_tags（与首页名片同一数据源），无数据则整块隐藏。
	certs.value = buildCertsFromTags(card.certification_tags != null ? card.certification_tags : (profile.certification_tags != null ? profile.certification_tags : []))
	applyUserId.value = user.value.id
}

const load = async () => {
	detailLoading.value = true
	detailError.value = ''
	detailQuotaExhausted.value = false
	visitorCount.value = null
	try {
		let res: any = null
		if (isOwnProfile.value) {
			res = await getOwnProfile()
		} else {
			res = await getUserDetail(user.value.id)
		}
		if (res != null && res.success === true && res.data != null) {
			mapDetailUser(res, user.value.id)
			if (isOwnProfile.value && user.value.moxiangPersonaTitle == '' && user.value.moxiangPersonaTags.length == 0) {
				try {
					const portraitRes = await getPortraitNarrative('personal')
					// 该接口按设计透传 status 交前端驱动确认 UI，未确认成稿不得上资料页。
					if (portraitRes != null && portraitRes.success === true && narrativeBadgeVisible(portraitRes.data)) {
						const pData = portraitRes.data as any
						if (pData.persona_title != null) {
							user.value.moxiangPersonaTitle = String(pData.persona_title).trim()
						}
						const pTags = pData.persona_tags != null && Array.isArray(pData.persona_tags) ? pData.persona_tags as any[] : []
						user.value.moxiangPersonaTags = pTags.map((t: any): string => String(t).trim()).filter((t: string): boolean => t != '')
						const ei = pData.emotional_insight != null ? pData.emotional_insight as any : null
						if (ei != null && ei.attachment_style != null) {
							user.value.moxiangAttachmentStyle = formatAttachmentStyle(ei.attachment_style)
						}
					}
				} catch (e) {}
			}
			if (!isOwnProfile.value && !isPreview.value && user.value.id > 0) {
				const visitorRes = await getUserVisitorCount(user.value.id)
				if (visitorRes != null && visitorRes.success === true && visitorRes.data != null) {
					const count = Number((visitorRes.data as any).visitor_count)
					if (!isNaN(count) && count >= 0) visitorCount.value = count
				}
			}
			// Ta 的理想型：详情响应已内嵌 preference（后端 view_profile 同门禁归一），优先用它，省一次请求。
			// 拿不到（旧后端）再回退到单独接口；两者都失败则静默隐藏，不影响主资料加载。
			if (!isOwnProfile.value && !isPreview.value && !fromMatchmaker.value && user.value.id > 0) {
				const envelope: any = res.data != null ? res.data : {}
				const embedded: any = envelope.preference != null ? envelope.preference : null
				if (embedded != null && embedded.has_data !== false) {
					const summary = normalizeIdealPartner(embedded)
					idealPartner.value = summary.hasData ? summary : null
				} else if (embedded == null) {
					try {
						const prefRes = await getUserPartnerPreference(user.value.id)
						const prefData: any = prefRes != null && prefRes.success ? prefRes.data : null
						idealPartner.value = prefData != null && prefData.hasData == true ? prefData : null
					} catch (e) {
						idealPartner.value = null
					}
				}
			}
			if (isOwnProfile.value) {
				const postsRes = await getMyPosts({ page: 1, pageSize: 50 })
				if (postsRes.success && postsRes.data != null) {
					const rawPosts = postsRes.data.list != null ? postsRes.data.list as any[] : []
					dynamics.value = rawPosts.map((post: any) => ({
						id: post.id,
						time: post.timeText != null ? '' + post.timeText : '',
						content: post.content != null ? '' + post.content : '',
						photo: post.photos != null && post.photos.length > 0 ? '' + post.photos[0] : '',
						topic: post.topicTitle != null ? '' + post.topicTitle : '',
						likes: post.likeCount != null ? Number(post.likeCount) : 0,
						comments: post.commentCount != null ? Number(post.commentCount) : 0
					}))
				}
			} else if (!isPreview.value && user.value.id > 0) {
				await loadUserDynamics(user.value.id)
			}
		} else {
			const message = res != null && res.message != null ? '' + res.message : '请稍后重试'
			const isQuota = res != null && Number(res.code) == 429 && message.indexOf('浏览额度') >= 0
			detailQuotaExhausted.value = isQuota
			detailError.value = isQuota ? '今日可查看的新资料已用完' : message
			// 本地已为该用户记账、但服务端判定无额度：把这一位还回去，避免白扣。
			// rollbackProfileView 对未记录的 id 是无操作，回看已浏览用户被 429 不会误删记录。
			if (isQuota) rollbackProfileView(user.value.id)
		}
	} catch (e) {
		detailError.value = '网络异常，请稍后重试'
	} finally {
		detailLoading.value = false
		refreshLockedView()
	}
}

const loadUserDynamics = async (targetUserId: number) => {
	if (targetUserId <= 0) return
	const collected: any[] = []
	for (let page = 1; page <= 5; page++) {
		const res = await getDynamicList({ tab: 'discover', page: page, pageSize: 20 })
		if (!res.success || res.data == null) break
		const data = res.data as any
		const rows = data.list != null && Array.isArray(data.list) ? data.list as any[] : []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i]
			const author = row.user != null ? row.user : {}
			const authorId = Number(author.id != null ? author.id : (author.userId != null ? author.userId : 0))
			if (authorId != targetUserId) continue
			const rowPhotos = row.photos != null && Array.isArray(row.photos) ? row.photos as any[] : []
			const rowTags = row.tags != null && Array.isArray(row.tags) ? row.tags as any[] : []
			collected.push({
				id: Number(row.id || 0),
				time: row.timeText != null ? '' + row.timeText : '',
				content: row.content != null ? '' + row.content : '',
				photo: rowPhotos.length > 0 ? resolveMediaUrl(rowPhotos[0]) : '',
				topic: rowTags.length > 0 ? '' + rowTags[0] : '',
				likes: Number(row.likeCount || 0),
				comments: Number(row.commentCount || 0)
			})
		}
		if (data.hasMore != true) break
	}
	dynamics.value = collected
}

const refreshLockedView = () => {
	if (fromMatchmaker.value) {
		isLockedView.value = false
		return
	}
	const targetIsVip = user.value.isVIP === true
	isLockedView.value =
		!isPreview.value &&
		!isOwnProfile.value &&
		viewerIsVip.value !== true && targetIsVip
}

const loadViewerMembership = async () => {
	if (isOwnProfile.value || isPreview.value) return
	const res = await getMembershipStatus()
	if (res.success && res.data != null) viewerIsVip.value = (res.data as any).is_vip == true
}

const redirectParentRoute = (): boolean => {
	let storedMode: any = null
	try { storedMode = uni.getStorageSync('xsa_onboarding_mode') } catch (e) {}
	if (storedMode == null || String(storedMode) != 'parent') return false
	uni.reLaunch({ url: '/pagesSub/parent/parent' })
	return true
}

let detailLoadedOnce = false

onMounted(async () => {
	if (redirectParentRoute()) return
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	isPreview.value = options.preview === 'true' || options.preview === true
	fromMatchmaker.value = options.matchmakerView === '1' || options.matchmakerView === 'true' || options.matchmakerView === true

	let parsed = 0
	if (options.userId != null && options.userId != '') {
		const candidate = Number(options.userId)
		if (!isNaN(candidate) && candidate > 0) parsed = candidate
	}
	let viewerId = 0
	try {
		const storedViewerId = uni.getStorageSync('xsa_user_id')
		if (storedViewerId != null && storedViewerId != '') {
			const candidateViewerId = Number(storedViewerId)
			if (!isNaN(candidateViewerId) && candidateViewerId > 0) viewerId = candidateViewerId
		}
	} catch (e) {}
	// guest=1：明确以「访客资料」打开（推荐/广场卡片入口），即使 userId 与登录账号相同也不按本人主页处理
	const guestForced = options.guest === 'true' || options.guest === true
	isOwnProfile.value = !guestForced && (options.own === 'true' || options.own === true || isPreview.value || (viewerId > 0 && viewerId == parsed))
	user.value.id = parsed
	applyUserId.value = parsed
	await loadViewerMembership()
	// 打开他人完整资料计入一次「可查看人数」；本人主页、预览、红娘代看不计入。
	// 该记录是幂等的：若首页切卡已为该用户记过账，此处不会重复扣。
	const countsAsBrowse = !isOwnProfile.value && !isPreview.value && !fromMatchmaker.value && parsed > 0
	if (countsAsBrowse && !recordProfileView(parsed)) {
		// 本地额度耗尽**不再阻断**：积分兑换的加次记在服务端权益池（extra_remaining），
		// 本地只认 8/20，判 0 会直接复现「兑换了次数还是打不开」。
		// 是否放行交给服务端：真超限时 load() 会收到 429，并置 detailQuotaExhausted 走额度页。
		detailQuotaExhausted.value = false
	}
	await load()
	detailLoadedOnce = true
	if (!isOwnProfile.value && !isPreview.value && !fromMatchmaker.value && uni.getStorageSync('xsa_ai_avatar_guide_shown') != true) showAiGuide.value = true
	if (options.anchor != null && ('' + options.anchor) != '') {
		const anchorId = '' + options.anchor
		setTimeout(() => { scrollAnchor.value = anchorId }, 400)
	}
})

onShow(async () => {
	if (redirectParentRoute()) return
	const vipBefore = viewerIsVip.value
	await loadViewerMembership()
	// 从会员页开通成功返回：detailLocked 是上一次 load() 时的服务端快照，
	// 不重拉就会出现「付完钱仍让我开通会员」（R4-4）。这也是唯一需要主动刷新的场景。
	const vipUpgraded = !vipBefore && viewerIsVip.value
	if (vipUpgraded && detailLoadedOnce && Number(user.value.id) > 0) {
		// 不 return：下面的 refreshLockedView() 还要按新会员态重算锁定区。
		await load()
	}
	// 红娘代编返回后重新拉取会员资料，保证主页立即反映刚保存的内容
	if (detailLoadedOnce && fromMatchmaker.value) await load()
	// 额度用完态下从会员页返回：上限可能已从 8 提到 20，重新判定一次再加载，
	// 否则用户刚开通会员回到本页仍停在「今日可查看的新资料已用完」。
	if (!detailLoadedOnce && detailQuotaExhausted.value && Number(user.value.id) > 0) {
		const canView = !isOwnProfile.value && !isPreview.value && !fromMatchmaker.value
		if (canView && recordProfileView(Number(user.value.id))) {
			detailQuotaExhausted.value = false
			detailError.value = ''
			await load()
			detailLoadedOnce = true
		}
	}
	refreshLockedView()
})

const onBack = () => { uni.navigateBack({ delta: 1 }) }
const openQuotaMembership = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/vip' }) }
// 额度耗尽分两条路：普通用户去开通会员，VIP 去积分兑换次数。
// 以前 VIP 用完也被引导"开通会员"，既没有意义也找不到兑换入口。
const openQuotaExchange = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/my-tasks' }) }
const handleDetailErrorAction = () => {
	if (detailQuotaExhausted.value) {
		if (viewerIsVip.value) openQuotaExchange()
		else openQuotaMembership()
		return
	}
	load()
}
const onShare = () => { uni.showToast({ title: '分享给朋友', icon: 'none' }) }
const goEdit = () => { uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' }) }
/* 红娘查看会员主页底部操作栏：编辑资料 / 红娘中心 */
const onMatchmakerEditMember = () => {
	const id = Number(user.value.id)
	if (!(id > 0)) {
		uni.showToast({ title: '会员信息尚未加载完成', icon: 'none' })
		return
	}
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/edit?memberId=' + id + '&matchmakerView=1',
		fail: () => uni.showToast({ title: '打开会员资料编辑失败', icon: 'none' })
	})
}
const onMatchmakerCenter = () => {
	uni.navigateTo({
		url: '/pagesSub/matchmaker/become-matchmaker',
		fail: () => uni.showToast({ title: '打开红娘中心失败', icon: 'none' })
	})
}

const onViewMyPortrait = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-portrait-result?subject=personal',
		fail: () => { uni.showToast({ title: '画像成稿打开失败，请重试', icon: 'none' }) }
	})
}
const dismissAiGuide = () => {
	if (!showAiGuide.value) return
	showAiGuide.value = false
	uni.setStorageSync('xsa_ai_avatar_guide_shown', true)
}

const openAiAvatar = () => {
	dismissAiGuide()
	if (isOwnProfile.value) return
	if (getAccessToken() == '') {
		uni.showToast({ title: '请先登录后使用 AI 分身', icon: 'none' })
		setTimeout(() => { uni.navigateTo({ url: '/pages/auth/login' }) }, 350)
		return
	}
	const snapshotRes = saveAiAvatarProfileSnapshot(user.value.id, {
		id: user.value.id,
		name: user.value.name,
		avatar: user.value.avatar,
		age: user.value.age,
		city: user.value.city,
		job: user.value.job,
		education: user.value.edu,
		tags: user.value.tags,
		intro: user.value.bio,
		expectations: isLockedView.value ? [] : user.value.expect,
		dynamicSummary: isLockedView.value ? [] : dynamics.value.map((item: any) => item.content)
	}, isLockedView.value)
	if (!snapshotRes.success) {
		uni.showToast({ title: snapshotRes.message != null ? String(snapshotRes.message) : '公开资料读取失败', icon: 'none' })
		return
	}
	const url = '/pagesSub/chat/detail?mode=ai-avatar&userId=' + String(user.value.id)
		+ '&userName=' + encodeURIComponent(String(user.value.name))
		+ '&locked=' + (isLockedView.value ? 'true' : 'false')
	uni.navigateTo({ url: url, fail: () => { uni.showToast({ title: 'AI 分身打开失败，请重试', icon: 'none' }) } })
}
const zhiyuHubVisible = ref(false)
const zhiyuHubActions = [
	{ key: 'avatar', glyph: '聊', title: '与对方的 AI 分身聊天', desc: '只看当前公开资料，不冒充本人，对方不会收到提醒' },
	{ key: 'match', glyph: '合', title: '看看合拍度', desc: '整理交集和破冰建议，仅供参考' },
	{ key: 'self', glyph: '己', title: '与知遇聊聊', desc: '用对话认识自己和期待的关系' },
	{ key: 'search', glyph: '寻', title: '帮我找找', desc: '按条件筛选，结果仍由你自己判断' }
]
const openZhiyuHub = () => {
	dismissAiGuide()
	zhiyuHubVisible.value = true
}
const onZhiyuHubSelect = (key: string) => {
	zhiyuHubVisible.value = false
	if (key == 'avatar') openAiAvatar()
	else if (key == 'match') matchVisible.value = true
	else if (key == 'self') {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/my-portrait-master',
			fail: () => { uni.showToast({ title: '知遇页面打开失败，请重试', icon: 'none' }) }
		})
	} else if (key == 'search') {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/search',
			fail: () => { uni.showToast({ title: '搜索页面打开失败，请重试', icon: 'none' }) }
		})
	}
}
/** 爆灯按钮是否可点：本人/预览态不展示，发送中、今日额度用完、本次已送出都不可点。 */
const canSpotlight = computed((): boolean => {
	if (isOwnProfile.value || isPreview.value) return false
	if (spotlightSending.value || spotlightDone.value) return false
	if (spotlightRemaining.value == 0) return false
	return true
})

const spotlightButtonText = computed((): string => {
	if (spotlightSending.value) return '发送中...'
	if (spotlightDone.value) return '爆灯已送出'
	if (spotlightRemaining.value == 0) return '今日爆灯次数已用完'
	if (spotlightRemaining.value > 0) return '我要爆灯 · 今日还剩 ' + spotlightRemaining.value + ' 次'
	return '我要爆灯'
})

const closeSpotlightSuccess = () => {
	spotlightSuccessVisible.value = false
	spotlightTarget.value = { id: 0, name: '', avatar: '', meta: '' }
}

/**
 * 免费额度爆灯：走 POST /discovery/superlikes/{id}，额度扣减与「收到爆灯」通知都在后端完成，
 * 前端不做支付、也不做二次履约。额度默认普通号 1 次/天、VIP 3 次/天。
 */
// 幂等键在本页实例内复用：网络超时重试时复用同一 key，避免后端已落库却被再扣一次额度。
// 页面实例 = 一个爆灯对象（详情页按目标用户新开页面栈），所以这个粒度是正确的。
let spotlightRequestKey = ''

const onSpotlight = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己爆灯', icon: 'none' })
		return
	}
	if (!canSpotlight.value) return
	const targetId = Number(user.value.id)
	if (!(targetId > 0)) return
	spotlightSending.value = true
	spotlightError.value = ''
	spotlightTarget.value = { id: targetId, name: '' + user.value.name, avatar: '' + user.value.avatar, meta: '' + user.value.age + '岁 · ' + user.value.job }
	if (spotlightRequestKey == '') spotlightRequestKey = 'sl-' + Date.now() + '-' + targetId
	try {
		const res = await sendSuperlike(targetId, spotlightRequestKey)
		if (res.success !== true) {
			const message = res != null && res.message != null ? '' + res.message : ''
			const status = res != null && res.code != null ? Number(res.code) : 0
			// 后端额度耗尽返回 429「今日爆灯次数已用完」，顺手把本地次数归零，按钮立即置灰。
			if (status == 429 || message.indexOf('用完') >= 0) {
				spotlightRemaining.value = 0
				spotlightError.value = '今日爆灯次数已用完'
			} else if (message.indexOf('实名') >= 0) {
				spotlightError.value = '爆灯需要先完成实名认证'
			} else if (message != '') {
				spotlightError.value = message
			} else {
				spotlightError.value = '爆灯发送失败，请稍后重试'
			}
			uni.showToast({ title: spotlightError.value, icon: 'none' })
			return
		}
		const data = res.data
		if (data != null && data.remaining_today != null) {
			spotlightRemaining.value = Number(data.remaining_today)
		}
		spotlightDone.value = true
		spotlightSuccessVisible.value = true
	} catch (e) {
		spotlightError.value = '网络异常，爆灯未发送'
		uni.showToast({ title: spotlightError.value, icon: 'none' })
	} finally {
		spotlightSending.value = false
	}
}
const openVipUnlock = () => {
	const redirect = '/pagesSub/userExtra/user/detail?userId=' + user.value.id
	uni.navigateTo({
		url: '/pagesSub/profileExtra/vip?source=user-detail&userId=' + user.value.id + '&redirect=' + encodeURIComponent(redirect)
	})
}
const onMatch = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己申请认识', icon: 'none' })
		return
	}
	const ok = await guardRealName('apply')
	if (!ok) return
	applyUserId.value = user.value.id
	applyVisible.value = true
}
const onApplySuccess = (_payload: any) => {
	applyVisible.value = false
	uni.showToast({ title: '申请已送达，等待对方回应', icon: 'none' })
}
const onLike = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能收藏自己', icon: 'none' })
		return
	}
	const ok = await guardRealName('like')
	if (!ok) return
	const id = user.value.id != null ? Number(user.value.id) : 1
	try {
		const res = await likeUser(id, !isLikedUser.value)
		if (res.success && res.data != null) {
			const liked = res.data.liked == true
			isLikedUser.value = liked
			uni.showToast({ title: liked ? '已收藏，仅你自己可见' : '已取消收藏', icon: 'none' })
		} else {
			uni.showToast({ title: '操作失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '操作失败，请重试', icon: 'none' })
	}
}
</script>

<style scoped>
.detail-page { position: relative; width: 100%; max-width: 750rpx; height: 100vh; margin: 0 auto; background-color: var(--canvas); color: var(--ink);
	/* 底部操作栏/悬浮球专用：与首页 .page 作用域同源的暖绿 token（非页面全局青瓷绿） */
	--warm-accent: #7EC8A0;
	--warm-accent-dark: #5BAF80;
	--warm-text-secondary: #5A6B5C;
}
.state-block { padding: 72px 24px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.error-state { min-height: 100vh; padding: 120px 32px 180px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg, var(--canvas), var(--paper)); }
.error-mark { width: 82px; height: 82px; margin-bottom: 26px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 26px; background: var(--surface); box-shadow: var(--shadow-md); }
.error-mark text { color: var(--accent2); font-size: 42px; font-weight: 700; line-height: 1; }
.error-title { color: var(--ink); font-size: 18px; font-weight: 700; }
.error-description { max-width: 560rpx; margin-top: 12px; color: var(--ink2); font-size: 14px; line-height: 1.5; text-align: center; }
.error-hint { margin-top: 6px; color: var(--muted); font-size: 12px; }
.error-actions { display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 28px; }
.error-retry, .error-cancel { height: 42px; padding: 0 24px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 21px; font-size: 14px; }
.error-retry { min-width: 116px; background: var(--sage); color: var(--text-invert); box-shadow: var(--shadow-sm); }
.error-cancel { min-width: 76px; border: 1px solid var(--line); background: var(--surface); color: var(--ink2); }
.state-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.state-description { font-size: 13px; color: var(--muted); }
.detail-scroll { width: 100%; height: 100vh; }
.vip-detail-page { min-height: 100%; background-color: var(--canvas); }
.vip-cover-area { position: relative; width: 100%; height: 560rpx; overflow: visible; background-color: var(--warm); }
.vip-cover-img { width: 100%; height: 100%; }
.vip-avatar-circle { position: absolute; z-index: 3; left: 32rpx; bottom: -40rpx; width: 160rpx; height: 160rpx; overflow: hidden; border: 6rpx solid var(--surface); border-radius: 50%; background-color: var(--warm); box-sizing: border-box; }
.vip-avatar { width: 100%; height: 100%; }
.vip-profile-header { display: flex; flex-direction: column; gap: 14rpx; padding: 62rpx 40rpx 32rpx; background-color: var(--surface); }
.vip-name-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; }
.vip-name-group { display: flex; min-width: 0; flex: 1; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-name { max-width: 380rpx; overflow: hidden; color: var(--ink); font-family: var(--serif); font-size: 42rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.vip-age { flex-shrink: 0; color: var(--ink2); font-size: 28rpx; }
.vip-meta { color: var(--ink2); font-size: 24rpx; line-height: 1.5; }
.visitor-count-text { color: var(--ink3); font-size: 22rpx; line-height: 1.4; }
.vip-bio { color: var(--ink2); font-size: 25rpx; line-height: 1.65; }
.vip-detail-content { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 32rpx 36rpx; }
.vip-section-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 20rpx; background-color: var(--surface); box-shadow: var(--shadow-sm); }
.vip-section-title { color: var(--ink); font-family: var(--serif); font-size: 30rpx; font-weight: 700; }
.ordinary-detail-page { padding: 0; }
.ordinary-profile-card { overflow: hidden; border-radius: 0; background-color: var(--surface); box-shadow: none; }
.ordinary-cover, .locked-cover-area { position: relative; width: 100%; height: 560rpx; overflow: hidden; background-color: var(--warm); }
.ordinary-cover-img, .locked-cover-img { width: 100%; height: 100%; }
.cover-actions { position: absolute; top: 32rpx; right: 32rpx; left: 32rpx; display: flex; flex-direction: row; justify-content: space-between; }
.round-action { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background-color: rgba(12, 19, 19, 0.45); }
.round-action-text { color: var(--text-invert); font-size: 36rpx; font-weight: 700; }
.share-symbol { transform: rotate(-45deg); }
.ordinary-cover-user { position: absolute; right: 24rpx; bottom: 24rpx; left: 24rpx; display: flex; flex-direction: row; align-items: flex-end; gap: 20rpx; }
.ordinary-avatar { width: 128rpx; height: 128rpx; flex-shrink: 0; border: 6rpx solid var(--surface); border-radius: 50%; background-color: var(--warm); }
.ordinary-cover-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx; border-radius: 18rpx; background-color: rgba(12, 19, 19, 0.45); }
.ordinary-name-row, .locked-name-vip-row, .section-heading-row, .activity-row, .spot-heading, .spot-heading-left, .dynamic-footer { display: flex; flex-direction: row; align-items: center; }
.ordinary-name-row, .locked-name-vip-row, .section-heading-row, .activity-row, .spot-heading, .dynamic-footer { justify-content: space-between; }
.ordinary-name { color: var(--text-invert); font-family: var(--serif); font-size: 34rpx; font-weight: 700; }
.ordinary-cover-meta, .ordinary-active { color: var(--text-invert); font-size: 22rpx; }
.vip-badge { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 6rpx 14rpx; border-radius: 999px; background-color: var(--plane-yellow); }
.vip-badge-large { padding: 10rpx 18rpx; }
.vip-badge-text { color: var(--ink); font-size: 20rpx; font-weight: 700; }
.vip-crown { color: var(--ink); font-size: 22rpx; }
.ordinary-card-body { padding: 24rpx 32rpx 32rpx; background-color: var(--canvas); }
.ordinary-section { display: flex; flex-direction: column; gap: 24rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.ordinary-section-title, .locked-section-title { font-family: var(--serif); font-size: 30rpx; font-weight: 700; color: var(--ink); }
.tag-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.profile-tag { padding: 8rpx 18rpx; border-radius: 999px; background-color: var(--accent-bg); }
.profile-tag-text { color: var(--accent2); font-size: 22rpx; font-weight: 600; }
.about-text, .locked-bio { color: var(--ink2); font-size: 25rpx; line-height: 1.65; }
.cert-summary { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.cert-summary-label { color: var(--muted); font-size: 22rpx; }
.cert-summary-item { color: var(--accent2); font-size: 22rpx; }
.ai-match-section { display: flex; flex-direction: row; align-items: center; gap: 24rpx; margin: 24rpx 0 0; padding: 24rpx; border-radius: 20rpx; background-color: var(--accent-bg); }
.match-score { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; flex-shrink: 0; border: 8rpx solid var(--accent); border-radius: 50%; background-color: var(--surface); }
.match-score-value { color: var(--accent2); font-size: 28rpx; font-weight: 800; }
.match-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.match-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.match-desc { color: var(--ink2); font-size: 22rpx; line-height: 1.5; }
.basic-info-grid { display: flex; flex-direction: column; gap: 12rpx; }
.basic-info-row { display: flex; flex-direction: row; gap: 12rpx; }
.basic-info-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 18rpx 8rpx; border-radius: 12rpx; background-color: var(--canvas); }
.basic-info-label { color: var(--muted); font-size: 20rpx; }
.basic-info-value { color: var(--ink); font-size: 24rpx; font-weight: 600; }
/* 详细资料 / Ta 的理想型：行容器 + 列间距 + label 固定宽 + value 左对齐；长值通栏。
   不能再用“每个 cell 50% + space-between + value 右对齐”，否则相邻 cell 零间距会粘字。 */
.detail-info-grid, .ideal-grid { display: flex; flex-direction: column; }
.detail-info-row, .ideal-row-group { display: flex; flex-direction: row; border-bottom: 1rpx solid var(--line); }
.detail-info-cell, .ideal-cell { flex: 1; min-width: 0; box-sizing: border-box; padding: 14rpx 0; display: flex; flex-direction: row; align-items: flex-start; gap: 12rpx; }
.detail-info-cell-right, .ideal-cell-right { padding-left: 24rpx; border-left: 1rpx solid var(--line); }
.detail-info-label, .ideal-label { flex: 0 0 112rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.detail-info-value, .ideal-value { flex: 1; min-width: 0; text-align: left; color: var(--ink); font-size: 23rpx; font-weight: 500; line-height: 1.5; word-break: break-all; }
.detail-info-toggle { display: flex; flex-direction: row; align-items: center; justify-content: center; padding-top: 18rpx; }
.detail-info-toggle-text { color: var(--accent2); font-size: 22rpx; }
.ideal-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.ideal-row .ideal-value { text-align: right; }
.ideal-tags { margin-top: 16rpx; }
.moment-hero { width: 100%; height: 380rpx; border-radius: 16rpx; background-color: var(--warm); }
.qa-card { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border-radius: 16rpx; background-color: var(--canvas); }
.qa-question { color: var(--accent2); font-size: 24rpx; font-weight: 700; }
.qa-answer { color: var(--ink2); font-size: 24rpx; line-height: 1.6; }
.qa-photo { width: 100%; height: 320rpx; border-radius: 16rpx; margin-top: 12rpx; }
.qa-question { color: var(--ink); font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.section-more { color: var(--accent2); font-size: 22rpx; }
.dynamic-card { display: flex; flex-direction: column; gap: 18rpx; padding: 24rpx; border-radius: 18rpx; background-color: var(--canvas); }
.dynamic-user-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.dynamic-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background-color: var(--warm); }
.dynamic-user-copy { display: flex; flex-direction: column; gap: 4rpx; }
.dynamic-name { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.dynamic-time { color: var(--muted); font-size: 20rpx; }
.dynamic-content { color: var(--ink2); font-size: 24rpx; line-height: 1.6; }
.dynamic-photo { width: 100%; height: 320rpx; border-radius: 14rpx; background-color: var(--warm); }
.dynamic-topic { color: var(--accent2); font-size: 22rpx; }
.dynamic-count { color: var(--muted); font-size: 21rpx; }
.more-dynamics { display: flex; align-items: center; justify-content: center; padding: 18rpx; }
.more-dynamics-text { color: var(--accent2); font-size: 24rpx; font-weight: 600; }
.activity-row { padding-top: 28rpx; }
.activity-text { color: var(--accent2); font-size: 22rpx; }
.viewed-text { color: var(--muted); font-size: 22rpx; }
.locked-detail-page { background-color: var(--canvas); }
.locked-avatar-circle { position: absolute; left: 32rpx; bottom: 0; width: 160rpx; height: 160rpx; overflow: hidden; border: 6rpx solid var(--surface); border-radius: 50%; background-color: var(--warm); }
.locked-avatar { width: 100%; height: 100%; }
.locked-profile-header { display: flex; flex-direction: column; gap: 16rpx; padding: 24rpx 40rpx 32rpx; background-color: var(--surface); }
.locked-name-group { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.locked-name { color: var(--ink); font-family: var(--serif); font-size: 42rpx; font-weight: 700; }
.locked-age { color: var(--ink2); font-size: 28rpx; }
.locked-meta { color: var(--ink2); font-size: 24rpx; }
.online-text { color: var(--accent2); font-weight: 600; }
.online-text-off { color: var(--muted); }
.locked-detail-content { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 32rpx; }
.locked-section-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 20rpx; background-color: var(--surface); box-shadow: var(--shadow-sm); }
.vip-exclusive-card { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 28rpx 20rpx; border-radius: 16rpx; background-color: var(--canvas); }
.exclusive-lock { color: var(--accent2); font-size: 32rpx; }
.exclusive-title { color: var(--ink); font-size: 26rpx; font-weight: 700; }
.exclusive-desc { color: var(--muted); font-size: 22rpx; text-align: center; }
.unlock-button { margin-top: 4rpx; padding: 14rpx 42rpx; border-radius: 999px; background-color: var(--plane-yellow); }
.unlock-button-text { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 10rpx 0; }
.cert-icon-wrap { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 50%; background-color: var(--accent-bg); }
.cert-icon { color: var(--accent2); font-size: 24rpx; font-weight: 700; }
.cert-copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.cert-label { color: var(--ink); font-size: 25rpx; font-weight: 600; }
.cert-desc { color: var(--muted); font-size: 21rpx; }
.cert-check { color: var(--accent2); font-size: 30rpx; font-weight: 700; }
.spot-heading-left { gap: 12rpx; }
.spot-light-icon { font-size: 30rpx; }
.spot-count { color: var(--plane-yellow); font-size: 22rpx; font-weight: 700; }
.spot-more { color: var(--muted); font-size: 21rpx; }
.visitor-row { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.visitor-avatar { width: 64rpx; height: 64rpx; overflow: hidden; border-radius: 50%; background-color: var(--warm); }
.visitor-img { width: 100%; height: 100%; }
.visitor-more { margin-left: auto; color: var(--ink2); font-size: 22rpx; font-weight: 600; }
.spot-desc { color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.spot-benefits { display: flex; flex-direction: row; gap: 12rpx; }
.spot-benefit { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 16rpx 6rpx; border-radius: 14rpx; background-color: var(--canvas); }
.spot-benefit-icon { color: var(--plane-yellow); font-size: 28rpx; }
.spot-benefit-title { color: var(--ink); font-size: 22rpx; font-weight: 700; }
.spot-benefit-desc { color: var(--muted); font-size: 18rpx; text-align: center; }
.spot-price { display: flex; flex-direction: row; align-items: baseline; justify-content: center; gap: 10rpx; }
.spot-price-label, .spot-price-unit { color: var(--ink2); font-size: 23rpx; }
.spot-price-value { color: var(--ink); font-family: var(--serif); font-size: 40rpx; font-weight: 800; }
/* 爆灯卡片：沿用名片页青瓷绿家族（--sage / --sage-soft），与已上线的
   XsaSpotlightSuccessSheet 同源；比底部「申请认识」实心绿更轻，符合「爆灯不做主路径」。 */
.spotlight-card { display: flex; flex-direction: column; gap: 16rpx; }
.spotlight-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.spotlight-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.spotlight-remain { color: var(--sage); font-size: 22rpx; font-weight: 600; }
.spotlight-desc { color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.spotlight-reasons { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.spotlight-reason {
	display: flex; align-items: center; justify-content: center;
	padding: 8rpx 20rpx; border-radius: 999rpx;
	background-color: var(--canvas);
	border: 1rpx solid var(--line);
}
.spotlight-reason-active { background-color: var(--sage-soft); border-color: var(--sage-soft); }
.spotlight-reason-text { color: var(--muted); font-size: 22rpx; }
.spotlight-reason-active .spotlight-reason-text { color: var(--sage); font-weight: 700; }
.spotlight-button { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; background-color: var(--sage-soft); }
.spotlight-button-text { color: var(--sage); font-size: 28rpx; font-weight: 700; }
.spotlight-button-disabled { background-color: var(--warm); }
.spotlight-button-disabled .spotlight-button-text { color: var(--muted); }
.spotlight-error { color: var(--match-coral); font-size: 22rpx; line-height: 1.5; }
.scroll-bottom-spacer { height: 420rpx; }
.spacer-matchmaker { height: 560rpx; }

/* 红娘查看会员主页：底部权限提示 + 编辑资料 / 红娘中心 */
.mm-bar { position: fixed; z-index: 60; left: 0; right: 0; bottom: 0; display: flex; flex-direction: row; align-items: center; gap: 10rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background-color: var(--surface); border-top: 1rpx solid var(--line); box-shadow: 0 -4rpx 20rpx rgba(17, 23, 24, 0.06); }
.mm-bar-alert { width: 32rpx; height: 32rpx; border-radius: 8rpx; background-color: var(--match-blush); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.detail-ai-float { position: fixed; right: 20rpx; bottom: calc(200rpx + env(safe-area-inset-bottom)); width: 136rpx; z-index: 56; display: flex; align-items: center; justify-content: center; }
.mm-bar-alert-mark { color: var(--match-coral); font-size: 21rpx; font-weight: 800; }
.mm-bar-alert-text { flex: 1; min-width: 0; color: var(--ink2); font-size: 21rpx; }
.mm-bar-actions { display: flex; flex-direction: row; align-items: center; gap: 12rpx; flex-shrink: 0; }
.mm-bar-btn { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 4rpx; height: 62rpx; padding: 0 22rpx; border-radius: 999rpx; }
.mm-bar-btn text { color: var(--paper); font-size: 23rpx; font-weight: 800; }
.mm-bar-btn-arrow { font-size: 22rpx !important; }
.mm-bar-btn-edit { background-color: var(--accent2); }
.mm-bar-btn-center { background-color: var(--match-coral); }
.bottom-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background-color: var(--surface); box-shadow: var(--shadow-md); }
.bottom-bar-own { justify-content: center; }
.bottom-back { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.bottom-back-icon { color: var(--ink2); font-size: 36rpx; font-weight: 700; }
.bottom-back-text { color: var(--muted); font-size: 19rpx; }
.primary-action { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; background-color: var(--accent); box-shadow: var(--shadow-sm); }
.edit-only-btn { flex: 0 0 480rpx; width: 480rpx; }
.primary-action-text { color: var(--text-invert); font-size: 28rpx; font-weight: 700; }
.ai-guide-bubble { position: fixed; right: 32rpx; bottom: calc(340rpx + env(safe-area-inset-bottom)); max-width: 440rpx; padding: 16rpx 24rpx; border-radius: 20rpx 20rpx 6rpx 20rpx; background: var(--warm-accent-dark); color: var(--text-invert); font-size: 24rpx; line-height: 1.5; box-shadow: var(--shadow-md); z-index: 60; }
.ai-guide-text { color: var(--text-invert); font-size: 24rpx; }

/* ==================== 底部操作栏（与首页推荐页同源；首页底栏 190rpx 含自绘 tabbar 区，本页无 tabbar，按 tabbar 高度换算下沉） ==================== */
.float-bar { position: fixed; z-index: 55; bottom: calc(30rpx + env(safe-area-inset-bottom)); left: 0; right: 0; display: flex; flex-direction: row; align-items: center; gap: 24rpx; padding: 24rpx 40rpx; }
.share-btn { width: 88rpx; height: 88rpx; border-radius: 44rpx; background-color: var(--surface); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.share-icon { font-size: 40rpx; font-weight: 700; color: var(--warm-text-secondary); transform: rotate(-45deg); }
.chat-btn { flex: 1; height: 96rpx; border-radius: 48rpx; background-color: var(--warm-accent); display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 16rpx; box-shadow: 0 8rpx 24rpx rgba(126, 200, 160, 0.28); }
.chat-icon { font-size: 36rpx; color: var(--text-invert); }
.chat-text { font-size: 30rpx; font-weight: 700; color: var(--text-invert); }
.like-btn { width: 112rpx; height: 112rpx; border-radius: 56rpx; background-color: var(--surface); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
/* 用户提供的收藏爱心字体：空心=未收藏，实心染红=已收藏；同字号保证形状大小一致 */
.heart-icon { font-size: 52rpx; line-height: 1; }
.heart-outline { color: var(--muted); }
.heart-solid { color: var(--heart-red); }

/* ==================== AI 分身悬浮按钮（3D 小猫形象，静态） ==================== */
.detail-ai-float { position: fixed; right: 28rpx; bottom: calc(200rpx + env(safe-area-inset-bottom)); width: 136rpx; height: 136rpx; z-index: 56; display: flex; align-items: center; justify-content: center; }
.detail-ai-float-cat { width: 136rpx; height: 136rpx; flex: none; }

/* ==================== 详情页图标字体（与首页同源） ==================== */
@font-face { font-family: "iconfont-home"; src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-sys"; src: url('/static/婚恋小程序图标/系统通用/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/系统通用/iconfont.woff') format('woff'); }
/* 收藏爱心字体（用户提供）：e608=空心，e85c=实心 */
@font-face { font-family: "iconfont-heart"; src: url('/static/婚恋小程序图标/收藏爱心/iconfont.ttf') format('truetype'); }
.ic { font-style: normal; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
.ic-home { font-family: "iconfont-home" !important; }
.ic-sys { font-family: "iconfont-sys" !important; }
.ic-hello:before { content: "\e601"; }
.ic-fenxiang:before { content: "\e636"; }
.heart-font { font-family: "iconfont-heart" !important; font-style: normal; }
.heart-outline:before { content: "\e608"; }
.heart-solid:before { content: "\e85c"; }

/* ==================== 合拍度弹层 ==================== */
.match-sheet { display: flex; flex-direction: column; gap: 24rpx; }
.match-sheet-score { display: flex; align-items: center; justify-content: center; padding: 12rpx 0; }
.match-sheet-score text { font-size: 72rpx; font-weight: 800; color: var(--accent2); font-family: var(--serif); }
.match-interpret { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border-radius: 16rpx; background-color: var(--accent-bg); }
.match-interpret-head { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.match-interpret-mark { font-size: 26rpx; color: var(--accent2); font-weight: 700; }
.match-interpret-title { font-size: 26rpx; font-weight: 800; color: var(--accent2); }
