							</view>
						</view>
						<view v-if="idealPartner.extras.length > 0" class="tag-row ideal-tags">
							<view v-for="tag in idealPartner.extras" :key="tag" class="profile-tag"><text class="profile-tag-text">{{ tag }}</text></view>
						</view>
					</view>

					<view v-if="user.qaAnswers.length > 0" id="anchor-qa" class="vip-section-card">
						<text class="vip-section-title">Ta的问答</text>
