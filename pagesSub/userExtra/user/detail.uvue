							<text v-if="user.lifePhotos.length > MOMENTS_PREVIEW_COUNT" class="section-more" @tap="momentsExpanded = !momentsExpanded">{{ momentsExpanded ? '收起' : '查看全部 ' + user.lifePhotos.length + ' 张 ›' }}</text>
						</view>
						<image v-for="(photo, index) in visibleMoments" :key="index" class="moment-hero" :src="photo" mode="aspectFill"></image>
					</view>

					<view v-if="user.expect.length > 0" class="vip-section-card">
