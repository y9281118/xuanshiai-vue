							<text class="qa-question">{{ item.question }}</text>
							<text class="qa-answer">{{ item.answer }}</text>
							<image v-if="item.mediaUrl != null && item.mediaUrl != ''" class="qa-photo" :src="item.mediaUrl" mode="aspectFill"></image>
						</view>
					</view>

					<view v-if="dynamics.length > 0" id="anchor-dynamics" class="vip-section-card">
						<view class="section-heading-row">
							<text class="vip-section-title">Ta的动态</text>
							<!-- 原「查看全部 ›」是死链（没有 @tap）。独立动态页依赖后端 mode=user 接口 + pages.json 注册，
							     本期先用本地展开兜住：默认 3 条，点开可看全部，不再是假按钮。 -->
							<text v-if="dynamics.length > DYNAMICS_PREVIEW_COUNT" class="section-more" @tap="dynamicsExpanded = !dynamicsExpanded">{{ dynamicsExpanded ? '收起' : '查看全部 ' + dynamics.length + ' 条 ›' }}</text>
						</view>
						<view v-for="item in visibleDynamics" :key="item.id" class="dynamic-card"><view class="dynamic-user-row"><image class="dynamic-avatar" :src="user.avatar" mode="aspectFill"></image><view class="dynamic-user-copy"><text class="dynamic-name">{{ user.name }}</text><text class="dynamic-time">{{ item.time }}</text></view></view><text class="dynamic-content">{{ item.content }}</text><image v-if="item.photo != ''" class="dynamic-photo" :src="item.photo" mode="aspectFill"></image><view class="dynamic-footer"><text class="dynamic-topic">{{ item.topic }}</text><text class="dynamic-count">♡ {{ item.likes }}　◌ {{ item.comments }}</text></view></view>
					</view>

					<!-- 爆灯：名片下方。免费额度制，不涉及支付；理由仅本地展示。
					     自己的名片、预览态、红娘代看都不展示。 -->
					<view class="vip-section-card spotlight-card" v-if="!isOwnProfile && !isPreview && !fromMatchmaker">
						<view class="spotlight-head">
