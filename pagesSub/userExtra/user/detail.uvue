})

// 详细资料 12 行全展开会把「Ta 的瞬间 / 动态 / 爆灯」推到两屏外，默认只露 6 行。
const DETAIL_COLLAPSED_COUNT = 6
const detailExpanded = ref(false)
// Ta 的理想型：接口未上线或对方没填 → 保持 null，整块不渲染
const idealPartner = ref<any>(null)
const visibleDetailInfo = computed((): any[] => {
	const all = user.value.detailInfo
	return detailExpanded.value ? all : all.slice(0, DETAIL_COLLAPSED_COUNT)
})

// 两列清单的排版：先按“长值优先通栏”两两分组，避免 50% cell 之间零间距、长值换行把行高拉乱。
const chunkInfoRows = (items: any[], isLong: (item: any) => boolean): any[] => {
	const rows: any[] = []
	let index = 0
	while (index < items.length) {
		const first: any = items[index]
		const second: any = index + 1 < items.length ? items[index + 1] : null
		if (isLong(first) || second == null || isLong(second)) {
			rows.push([first])
			index += 1
		} else {
			rows.push([first, second])
			index += 2
		}
	}
	return rows
}

const detailInfoRows = computed((): any[] => {
	return chunkInfoRows(visibleDetailInfo.value, (item: any): boolean => {
		const label = '' + item.label
		const value = '' + item.value
		return label == '毕业学校' || label == '工作单位' || value.length > 8
	})
})

const idealRows = computed((): any[] => {
	const rows = idealPartner.value != null && Array.isArray(idealPartner.value.rows) ? idealPartner.value.rows as any[] : []
	return chunkInfoRows(rows, (item: any): boolean => {
		return item.label == '期望地区' || ('' + item.value).length > 8
	})
})

// 认证标签 → 展示项。只翻译后端真实下发的标签，不凭空补"房产认证"之类的结论。
const CERT_META: any = {
	'实名': { icon: '盾', desc: '已通过平台实名认证' },
	'实名认证': { icon: '盾', desc: '已通过平台实名认证' },
	'学历': { icon: '学', desc: '学历信息已核验' },
	'学历认证': { icon: '学', desc: '学历信息已核验' },
	'头像': { icon: '像', desc: '头像为本人真实照片' },
	'头像认证': { icon: '像', desc: '头像为本人真实照片' },
	'单身承诺': { icon: '誓', desc: '已签署单身承诺书' }
}

const buildCertsFromTags = (tags: any): any[] => {
	const list: any[] = []
	if (!Array.isArray(tags)) return list
	for (const raw of tags as any[]) {
		const label = ('' + raw).trim()
		if (label == '') continue
		const meta = CERT_META[label] != null ? CERT_META[label] : { icon: '✓', desc: '已通过平台认证' }
		list.push({
			icon: meta.icon,
			shortLabel: label,
			label: label.indexOf('认证') >= 0 ? label : label + '认证',
			desc: meta.desc
		})
	}
	return list
}

const certs = ref([] as any[])
const certsExpanded = ref(false)
const visibleCerts = computed(() => certsExpanded.value ? certs.value : certs.value.slice(0, 3))

const dynamics = ref([] as any[])

