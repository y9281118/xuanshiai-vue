	id: 0,
	detailLocked: false,
	name: '', age: '', avatar: '', isVIP: false, job: '', edu: '', city: '',
	online: '', distance: '', recentActivity: '', match: 0, matchAvailable: false, mbti: '', tags: [], bio: '',
	cover: '', photos: [], lifePhotos: [], expect: [], basicInfo: [], detailInfo: [] as any[], qaAnswers: [] as any[],
