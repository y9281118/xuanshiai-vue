							<text class="spotlight-remain" v-if="spotlightRemaining > 0">今日还剩 {{ spotlightRemaining }} 次</text>
							<text class="spotlight-remain" v-else-if="spotlightRemaining == 0">今日次数已用完</text>
						</view>
						<text class="spotlight-desc">让 Ta 在消息列表里更早看到你 · 不代替申请认识</text>
						<view class="spotlight-reasons">
							<view
								v-for="reason in SPOTLIGHT_REASONS"
								:key="reason"
								class="spotlight-reason"
								:class="{ 'spotlight-reason-active': reason == spotlightReason }"
								@tap="spotlightReason = reason"
							>
								<text class="spotlight-reason-text">{{ reason }}</text>
							</view>
						</view>
						<view class="spotlight-button" :class="{ 'spotlight-button-disabled': !canSpotlight }" @tap="onSpotlight">
							<text class="spotlight-button-text">{{ spotlightButtonText }}</text>
						</view>
						<text class="spotlight-error" v-if="spotlightError != ''">{{ spotlightError }}</text>
					</view>
				</view>
			</view>

			<view v-else class="locked-detail-page">
				<view class="locked-cover-area">
					<image class="locked-cover-img" :src="user.cover != '' ? user.cover : user.avatar" mode="aspectFill"></image>
					<view class="locked-avatar-circle"><image class="locked-avatar" :src="user.avatar" mode="aspectFill"></image></view>
				</view>

				<view class="locked-profile-header">
					<view class="locked-name-vip-row">
						<view class="locked-name-group"><text class="locked-name">{{ user.name }}</text><text class="locked-age">{{ user.age }}岁</text></view>
						<view v-if="user.isVIP" class="vip-badge vip-badge-large"><text class="vip-crown">♛</text><text class="vip-badge-text">VIP会员</text></view>
					</view>
					<text class="locked-meta">{{ user.job }} · {{ user.edu }}　{{ user.city }}　<text class="online-text">在线</text></text>
					<view class="tag-row">
						<view v-for="tag in user.tags" :key="tag" class="profile-tag"><text class="profile-tag-text">{{ tag }}</text></view>
					</view>
					<text class="locked-bio">{{ user.bio }}</text>
				</view>

				<view class="locked-detail-content">
					<view class="locked-section-card">
						<text class="locked-section-title">基础资料</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可解锁Ta的语音介绍</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

					<view class="locked-section-card certification-section">
						<text class="locked-section-title">认证信息</text>
						<view v-for="cert in certs" :key="cert.label" class="cert-item">
							<view class="cert-icon-wrap"><text class="cert-icon">{{ cert.icon }}</text></view>
							<view class="cert-copy"><text class="cert-label">{{ cert.label }}</text><text class="cert-desc">{{ cert.desc }}</text></view>
							<text class="cert-check">✓</text>
						</view>
					</view>

					<view class="locked-section-card">
						<text class="locked-section-title">Ta的瞬间</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可解锁Ta的语音介绍</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

					<view class="locked-section-card">
						<text class="locked-section-title">Ta的问答</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可查看TA的择偶标准与期待</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

					<!-- 爆灯：锁定态同样保留入口（未开 VIP 也能爆灯）。 -->
					<view class="locked-section-card spotlight-card" v-if="!isOwnProfile && !isPreview && !fromMatchmaker">
						<view class="spotlight-head">
							<text class="spotlight-title">为 Ta 爆灯</text>
							<text class="spotlight-remain" v-if="spotlightRemaining > 0">今日还剩 {{ spotlightRemaining }} 次</text>
							<text class="spotlight-remain" v-else-if="spotlightRemaining == 0">今日次数已用完</text>
						</view>
						<text class="spotlight-desc">让 Ta 在消息列表里更早看到你 · 不代替申请认识</text>
						<view class="spotlight-reasons">
							<view
								v-for="reason in SPOTLIGHT_REASONS"
								:key="reason"
								class="spotlight-reason"
								:class="{ 'spotlight-reason-active': reason == spotlightReason }"
								@tap="spotlightReason = reason"
							>
								<text class="spotlight-reason-text">{{ reason }}</text>
							</view>
						</view>
						<view class="spotlight-button" :class="{ 'spotlight-button-disabled': !canSpotlight }" @tap="onSpotlight">
							<text class="spotlight-button-text">{{ spotlightButtonText }}</text>
						</view>
						<text class="spotlight-error" v-if="spotlightError != ''">{{ spotlightError }}</text>
					</view>

				</view>
			</view>

			<view class="scroll-bottom-spacer" :class="{ 'spacer-matchmaker': fromMatchmaker }"></view>
		</scroll-view>

			<!-- 知遇悬浮入口：点开聚合能力；红娘代看模式隐藏 -->
			<view v-if="!isOwnProfile && !isPreview && !fromMatchmaker && !detailLoading && detailError == ''" class="detail-ai-float" @tap="openZhiyuHub">
				<XsaZhiyuMark size="112rpx" />
			</view>
			<view v-if="showAiGuide && !fromMatchmaker" class="ai-guide-bubble" @tap="dismissAiGuide"><text class="ai-guide-text">点知遇，看看能怎么了解对方</text></view>
			<!-- 知遇说话气泡：引导气泡消失后才开始自动弹出，避免两块气泡打架；红娘代看模式隐藏 -->
			<XsaAiCatBubble
				:active="!isOwnProfile && !isPreview && !fromMatchmaker && !detailLoading && detailError == '' && !showAiGuide"
				right="112rpx"
				bottom="calc(400rpx + env(safe-area-inset-bottom))"
				@tap="openZhiyuHub"
			/>

			<view v-if="isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="bottom-bar bottom-bar-own">
				<view class="primary-action edit-only-btn" @tap="goEdit"><text class="primary-action-text">编辑资料</text></view>
			</view>
			<!-- 底部操作栏：与首页推荐页同款（分享 + 申请认识 + 收藏爱心）；红娘查看资料时改用红娘操作栏 -->
			<view v-if="!isOwnProfile && !isPreview && !fromMatchmaker && !detailLoading && detailError == ''" class="float-bar">
				<view class="share-btn" @tap="onShare"><text class="ic ic-sys ic-fenxiang share-icon"></text></view>
				<view class="chat-btn" @tap="onMatch"><text class="ic ic-home ic-hello chat-icon"></text><text class="chat-text">申请认识</text></view>
				<view class="like-btn" @tap="onLike">
					<text v-if="isLikedUser" class="heart-icon heart-font heart-solid"></text>
					<text v-else class="heart-icon heart-font heart-outline"></text>
				</view>
			</view>

			<!-- 红娘查看会员主页时的底部操作栏：权限提示 + 编辑资料 + 红娘中心 -->
			<view v-if="fromMatchmaker && !isPreview && !detailLoading && detailError == ''" class="mm-bar">
				<view class="mm-bar-alert"><text class="mm-bar-alert-mark">!</text></view>
				<text class="mm-bar-alert-text">您在以红娘权限查看资料</text>
				<view class="mm-bar-actions">
					<view class="mm-bar-btn mm-bar-btn-edit" @tap="onMatchmakerEditMember"><text>编辑资料</text><text class="mm-bar-btn-arrow">›</text></view>
					<view class="mm-bar-btn mm-bar-btn-center" @tap="onMatchmakerCenter"><text>红娘中心</text><text class="mm-bar-btn-arrow">›</text></view>
				</view>
			</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplySuccess" />
		<XsaSpotlightSuccessSheet :visible="spotlightSuccessVisible" :target="spotlightTarget" @close="closeSpotlightSuccess" />

		<XsaAiMatchSheet
			:visible="matchVisible"
			:target-user-id="user.id"
			my-name="你"
			my-avatar=""
			my-mbti=""
			:other-name="user.name"
			:other-avatar="user.avatar"
			:other-mbti="user.mbti"
			@close="matchVisible = false"
		/>
		<XsaZhiyuHub
			:visible="zhiyuHubVisible"
			:actions="zhiyuHubActions"
			@close="zhiyuHubVisible = false"
			@select="onZhiyuHubSelect"
		/>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import XsaApplySheet from '@/components/XsaApplySheet.uvue'
import XsaSpotlightSuccessSheet from '@/pagesSub/userExtra/components/XsaSpotlightSuccessSheet.uvue'
import XsaAiMatchSheet from '@/components/XsaAiMatchSheet.uvue'
import XsaAiCatBubble from '@/components/XsaAiCatBubble.uvue'
import XsaZhiyuMark from '@/components/XsaZhiyuMark.uvue'
import XsaZhiyuHub from '@/components/XsaZhiyuHub.uvue'
import { getUserDetail, likeUser, getOwnProfile, getMyPosts, getMembershipStatus, getUserVisitorCount, saveAiAvatarProfileSnapshot, getDynamicList, getPortraitNarrative, getUserPartnerPreference } from '@/api'
import { normalizeIdealPartner } from '@/api/preference.uts'
import { resolveMediaUrl, getAccessToken } from '@/api/config.uts'
import { LOCATION_TREE as locationJson } from '../data/location.uts'
import { sendSuperlike } from '@/api/spotlight.uts'
import { guardRealName } from '@/utils/realNameGate.uts'
import { incomeDisplayText, locationDisplayByCodes, educationLabel as educationLabelOf } from '@/utils/profile-field-display.uts'
import { recordProfileView, rollbackProfileView } from '@/utils/quota.uts'
import { attachmentStyleLabel, narrativeBadgeVisible } from '@/utils/moxiang-badge.uts'

const isLockedView = ref(false)
const viewerIsVip = ref(false)
const isOwnProfile = ref(false)
const isPreview = ref(false)
// 红娘从资料待审进入时跳过 VIP 解锁墙/额度限制（后端 view_profile 已豁免）。
const fromMatchmaker = ref(false)
const isLikedUser = ref(false)
const showAiGuide = ref(false)
const scrollAnchor = ref('')
const matchVisible = ref(false)
const detailLoading = ref(true)
const detailError = ref('')
const detailQuotaExhausted = ref(false)
const applyVisible = ref(false)
const applyUserId = ref(1)
const spotlightSuccessVisible = ref(false)
const spotlightTarget = ref({ id: 0, name: '', avatar: '', meta: '' })
