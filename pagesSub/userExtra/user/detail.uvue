									:key="item.label"
									class="detail-info-cell"
									:class="{ 'detail-info-cell-right': row.length > 1 && ci == 1 }"
								>
									<text class="detail-info-label">{{ item.label }}</text>
									<text class="detail-info-value">{{ item.value }}</text>
								</view>
							</view>
						</view>
						<view v-if="user.detailInfo.length > DETAIL_COLLAPSED_COUNT" class="detail-info-toggle" @tap="detailExpanded = !detailExpanded">
							<text class="detail-info-toggle-text">{{ detailExpanded ? '收起' : '展开全部 ' + user.detailInfo.length + ' 项' }}</text>
						</view>
					</view>

					<view v-if="certs.length > 0" class="vip-section-card">
