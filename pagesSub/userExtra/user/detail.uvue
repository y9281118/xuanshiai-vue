						<view v-for="cert in visibleCerts" :key="cert.label" class="cert-item"><view class="cert-icon-wrap"><text class="cert-icon">{{ cert.icon }}</text></view><view class="cert-copy"><text class="cert-label">{{ cert.label }}</text><text class="cert-desc">{{ cert.desc }}</text></view><text class="cert-check">✓</text></view>
						<view v-if="certs.length > 3" class="detail-info-toggle" @tap="certsExpanded = !certsExpanded"><text class="detail-info-toggle-text">{{ certsExpanded ? '收起认证' : '展开全部 ' + certs.length + ' 项认证' }}</text></view>
					</view>

					<view v-if="user.lifePhotos.length > 0" id="anchor-moments" class="vip-section-card">
						<view class="section-heading-row">
