	}

	/* ===== 评论区 v2：灰昵称 + 粉作者胶囊 + 黑正文 + 左右两组底行 ===== */
	.comment {
		display: flex;
		flex-direction: row;
		gap: 11px;
		padding: 15px 16px 14px;
		border-bottom: 1px solid var(--line);
