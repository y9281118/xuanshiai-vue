		padding: 6px 0 6px 12px;
	}
	.foot-text {
		font-size: 13px;
		color: var(--muted);
	}
	.foot-reply {
		font-size: 13px;
		color: var(--muted);
		padding: 6px 2px;
	}
	.like-icon {
		width: 18px;
