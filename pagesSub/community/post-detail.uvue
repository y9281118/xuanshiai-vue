		background: var(--plane-sky);
		border-color: var(--plane-yellow);
	}
	.avatar {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--soft);
		border: 1px solid var(--line);
		flex-shrink: 0;
	}
