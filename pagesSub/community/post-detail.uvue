<template>
	<view class="page">
		<scroll-view class="scroll" scroll-y :scroll-into-view="commentScrollTarget">
			<view v-if="loading" class="state"><text class="text-muted">加载中…</text></view>
			<view v-else-if="post == null" class="state">
				<XsaEmpty text="动态不存在" description="可能已被删除" />
			</view>
			<view v-else>
				<XsaDynamicCard
					:dynamic="normalize(post)"
					:show-follow="!isOwnPost"
					:is-self="isOwnPost"
					@user-click="goUser"
					@like="onLike"
					@comment="focusComment"
					@collect="onCollect"
					@share="onShare"
					@follow="onFollow"
					@unfollow="onUnfollow"
					@apply="onApply"
					@more="onMore"
					@topic="goTopic"
				/>
				<view class="comment-head">
					<text class="title">评论 {{ post.commentCount || 0 }}</text>
				</view>
				<view v-if="commentTargetMissing" class="target-missing"><text>该评论已不可查看</text></view>
				<view v-if="comments.length == 0" class="empty-c">
					<text class="text-muted">还没有评论，说一句真诚的话吧</text>
				</view>
				<view :id="'comment-' + c.id" class="comment" :class="{ highlighted: highlightedCommentId == c.id }" v-for="c in comments" :key="c.id" @longpress.stop="openCommentActions(c)">
					<image class="avatar" :src="c.user.avatar" mode="aspectFill"></image>
					<view class="body">
						<view class="comment-name-row">
							<text class="name">{{ c.user.name }}</text>
							<text v-if="isAuthorBadge(c)" class="author-badge">作者</text>
						</view>
						<text class="content">{{ c.content }}</text>
						<view class="comment-foot">
							<view class="foot-left">
								<text class="foot-text">{{ c.dateText }}</text>
								<text class="foot-text" v-if="c.location != ''">{{ c.location }}</text>
								<text class="foot-reply" @click.stop="replyTo(c)">回复</text>
							</view>
							<view class="foot-right" @click.stop="onLikeComment(c)">
								<image v-if="!c.liked" class="like-icon" src="/static/icons/like-line.svg" mode="aspectFit"></image>
								<image v-else class="like-icon" src="/static/icons/like-fill-pink.svg" mode="aspectFit"></image>
								<text class="like-count">{{ c.likeCount > 0 ? c.likeCount : '' }}</text>
							</view>
						</view>
						<view v-if="c.likedByAuthor" class="author-liked-wrap"><text class="author-liked">作者赞过</text></view>
						<view :id="'comment-' + r.id" class="reply" :class="{ highlighted: highlightedCommentId == r.id }" v-for="r in c.replies" :key="r.id" @click.stop="replyTo(r)" @longpress.stop="openCommentActions(r)">
							<image class="reply-avatar" :src="r.user.avatar" mode="aspectFill"></image>
							<view class="reply-body">
								<view class="reply-head">
									<text class="reply-name">{{ r.user.name }}</text>
									<text v-if="isAuthorBadge(r)" class="author-badge">作者</text>
									<text v-if="r.replyToUserName" class="reply-to">回复 @{{ r.replyToUserName }}</text>
								</view>
								<text class="reply-content">{{ r.content }}</text>
								<view class="reply-foot">
									<view class="foot-left">
										<text class="foot-text">{{ r.dateText }}</text>
										<text class="foot-text" v-if="r.location != ''">{{ r.location }}</text>
										<text class="foot-reply" @click.stop="replyTo(r)">回复</text>
									</view>
									<view class="foot-right" @click.stop="onLikeComment(r)">
										<image v-if="!r.liked" class="like-icon" src="/static/icons/like-line.svg" mode="aspectFit"></image>
										<image v-else class="like-icon" src="/static/icons/like-fill-pink.svg" mode="aspectFit"></image>
										<text class="like-count">{{ r.likeCount > 0 ? r.likeCount : '' }}</text>
									</view>
								</view>
							</view>
						</view>
						<text class="expand-replies" v-if="c.replyCount > (c.replies != null ? c.replies.length : 0)" @click.stop="loadReplies(c)">—— 展开 {{ c.replyCount - (c.replies != null ? c.replies.length : 0) }} 条回复</text>
					</view>
				</view>
				<text class="like-btn load-more" v-if="commentHasMore" @click="loadMoreComments">加载更多评论</text>
			</view>
			<view class="pad"></view>
		</scroll-view>

		<view class="composer" v-if="post != null">
			<input
				class="input"
				:value="draft"
				@input="onDraft"
				:placeholder="replyTarget != null ? '回复 @' + replyTarget.user.name : '友善评论，完成实名后可发送'"
				confirm-type="send"
				@confirm="submitComment"
			/>
			<button class="send" :disabled="sending" @click="submitComment">发送</button>
		</view>

<XsaApplySheet
				:visible="applyVisible"
				:user-id="applyUserId"
				@close="applyVisible = false"
				@success="onApplyOk"
			/>
				<XsaReportSheet
					:visible="reportVisible"
					:target-type="reportTargetType"
					:target-id="reportTargetId"
					:user-id="reportUserId"
					@close="reportVisible = false"
					@blocked="onBlocked"
				/>
				<XsaSheet :visible="actionVisible" :show-handle="false" @close="actionVisible = false">
					<view class="comment-action-sheet">
						<view v-if="canDeleteComment(actionTarget)" class="comment-action-row" @click="onCommentActionDelete">
							<text class="comment-action-label danger">删除</text>
						</view>
						<view v-if="canReportComment(actionTarget)" class="comment-action-row" @click="onCommentActionReport">
							<text class="comment-action-label">举报</text>
						</view>
						<view class="comment-action-row cancel" @click="actionVisible = false">
							<text class="comment-action-label cancel-label">取消</text>
						</view>
					</view>
				</XsaSheet>
				<XsaSheet :visible="moreVisible" :show-handle="false" @close="moreVisible = false">
					<view class="comment-action-sheet">
						<view class="comment-action-row" @click="onMoreActionReport">
							<text class="comment-action-label">举报</text>
						</view>
						<view class="comment-action-row cancel" @click="moreVisible = false">
							<text class="comment-action-label cancel-label">取消</text>
						</view>
					</view>
				</XsaSheet>
	</view>
</template>

<script setup lang="uts">
	import XsaDynamicCard from '@/components/XsaDynamicCard.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
import {
			getDynamicDetail,
			likeDynamic,
			likeComment,
			collectDynamic,
			shareDynamic,
			followUserFromCommunity,
			unfollowUserFromCommunity,
			commentDynamic,
			deleteComment,
			deleteDynamic,
			getThreadedComments,
			getCommentReplies,
			createCommunityCreateKey,
			discardCommunityCreateKey
		} from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	const postId = ref(0)
	const post = ref(null)
	// 本人动态：用来隐藏"关注/申请认识"、并把 ⋯ 菜单换成"删除动态"
	const viewerId = ref(0)
	try {
		const storedViewerId = uni.getStorageSync('xsa_user_id')
		if (storedViewerId != null && storedViewerId != '') {
			const candidate = Number(storedViewerId)
			if (!isNaN(candidate) && candidate > 0) viewerId.value = candidate
		}
	} catch (e) {}
	const isOwnPost = computed((): boolean => {
		const current = post.value as any
		if (current == null || viewerId.value <= 0) return false
		const author = current.user != null ? current.user : {}
		const authorId = Number(author.id != null ? author.id : (author.userId != null ? author.userId : (current.userId != null ? current.userId : 0)))
		return authorId > 0 && authorId == viewerId.value
	})
	const comments = ref([])
	const loading = ref(false)
	const draft = ref('')
	const sending = ref(false)
	const pendingCommentKey = ref('')
	const pendingCommentFingerprint = ref('')
	const applyVisible = ref(false)
	const applyUserId = ref(0)
	const reportVisible = ref(false)
	const moreVisible = ref(false)
	const reportTargetType = ref('post')
	const reportTargetId = ref(0)
	const reportUserId = ref(0)
	const replyTarget = ref(null as any)
	const commentCursor = ref('')
	const commentHasMore = ref(false)
	const commentIdTarget = ref(0)
	const commentScrollTarget = ref('')
	const highlightedCommentId = ref(0)
	const commentTargetMissing = ref(false)
	// 长按评论后的底部操作菜单
	const actionVisible = ref(false)
	const actionTarget = ref(null as any)
	const lastLongPressAt = ref(0)
	const unfollowPendingUserId = ref(0)

	onLoad((q: any) => {
		postId.value = q != null && q.id != null ? parseInt('' + q.id) : 0
		commentIdTarget.value = q != null && q.commentId != null ? parseInt('' + q.commentId) : 0
		load()
	})

const normalize = (item: any) => {
			const photos = item.photos != null ? item.photos : item.media
			return {
				id: item.id,
				user: item.user,
				content: item.content,
				photos,
				location: item.location,
				time: item.timeText != null ? item.timeText : '',
				timeText: item.timeText,
				likeCount: item.likeCount,
				commentCount: item.commentCount,
				collectCount: item.collectCount,
				liked: item.liked,
				collected: item.collected,
				followed: item.followed,
				applyStatus: item.applyStatus,
				topicId: item.topicId,
				tags: item.tags,
				declaration: item.declaration,
				cityTag: item.cityTag === true,
				relationTags: item.relationTags != null ? item.relationTags : [],
				topicTitle: item.topicTitle != null ? item.topicTitle : '',
				videos: item.videos != null ? item.videos : [],
				mediaType: item.mediaType != null ? item.mediaType : ''
			}
		}

const load = async () => {
			if (postId.value <= 0) return
			loading.value = true
			try {
				const res = await getDynamicDetail(postId.value)
				if (res.success) {
					post.value = res.data
					comments.value = []
					commentCursor.value = ''
					await loadMoreComments()
					await locateCommentTarget()
					if (res.data != null && res.data.commentsLoadError == true) {
						uni.showToast({ title: '评论加载失败', icon: 'none' })
					}
				} else {
					const msg =
						res.data != null && res.data.message != null
							? res.data.message
							: res.message != null
								? res.message
								: '加载失败'
					uni.showToast({ title: msg, icon: 'none' })
				}
			} catch (e) {
				console.error(e)
				uni.showToast({ title: '加载失败', icon: 'none' })
			} finally {
				loading.value = false
			}
		}

	const commentFingerprint = (text: string) => postId.value + '|' + text + '|' + (replyTarget.value != null ? replyTarget.value.id : 0)
	const loadMoreComments = async () => {
		const res = await getThreadedComments(postId.value, commentCursor.value)
		if (!res.success || res.data == null) return
		const raw = res.data as any
		const items = raw.items != null ? raw.items : []
		for (let i = 0; i < items.length; i++) { if (items[i].replies == null) items[i].replies = []; (comments.value as any[]).push(items[i]) }
		commentCursor.value = raw.next_cursor != null ? raw.next_cursor : ''
		commentHasMore.value = raw.has_more == true
	}
	const loadReplies = async (comment: any) => { const res = await getCommentReplies(comment.id, comment.replyCursor != null ? comment.replyCursor : ''); if (res.success && res.data != null) { const data = res.data as any; const more = data.items != null ? data.items as any[] : []; if (comment.replies == null) comment.replies = []; for (let i = 0; i < more.length; i++) comment.replies.push(more[i]); comment.replyCursor = data.next_cursor != null ? data.next_cursor : ''; comment.replyHasMore = data.has_more == true } else uni.showToast({ title: '回复加载失败，请重试', icon: 'none' }) }
	const findComment = (): any => {
		if (commentIdTarget.value <= 0) return null
		const roots = comments.value as any[]
		for (let i = 0; i < roots.length; i++) {
			const root = roots[i]
			if (Number(root.id) == commentIdTarget.value) return root
			const replies = root.replies != null ? root.replies as any[] : []
			for (let j = 0; j < replies.length; j++) {
				if (Number(replies[j].id) == commentIdTarget.value) return replies[j]
			}
		}
		return null
	}
	const locateCommentTarget = async () => {
		if (commentIdTarget.value <= 0) return
		commentTargetMissing.value = false
		for (let page = 0; page < 5; page++) {
			let found = findComment()
			if (found != null) {
				highlightedCommentId.value = commentIdTarget.value
				commentScrollTarget.value = 'comment-' + commentIdTarget.value
				return
			}
			const roots = comments.value as any[]
			for (let i = 0; i < roots.length; i++) {
				const root = roots[i]
				if (root.replyHasMore == true || (root.replyCount != null && Number(root.replyCount) > (root.replies != null ? (root.replies as any[]).length : 0))) await loadReplies(root)
			}
			found = findComment()
			if (found != null) {
				highlightedCommentId.value = commentIdTarget.value
				commentScrollTarget.value = 'comment-' + commentIdTarget.value
				return
			}
			if (!commentHasMore.value) break
			await loadMoreComments()
		}
		commentTargetMissing.value = true
		uni.showToast({ title: '该评论已不可查看', icon: 'none' })
	}
	const replyTo = (comment: any) => {
		if (comment.isDeleted == true) return
		// 长按松手后微信可能补发一次 click，350ms 内忽略，避免「长按却跳去回复」
		if (Date.now() - lastLongPressAt.value < 350) return
		replyTarget.value = comment
	}
	// 删除后必须把节点真正从树里摘掉：
	// 旧实现只把正文替换成「该评论已删除」并置 isDeleted，导致评论仍占位、
	// 其下回复照旧渲染、评论总数也不减——用户会认为"删了没生效"。
	const removeCommentFromList = (id: any): boolean => {
		const roots = comments.value as any[]
		for (let i = roots.length - 1; i >= 0; i--) {
			const root = roots[i]
			if (root.id == id) {
				roots.splice(i, 1)
				return true
			}
			const replies = root.replies != null && Array.isArray(root.replies) ? root.replies as any[] : []
			for (let j = replies.length - 1; j >= 0; j--) {
				if (replies[j].id == id) {
					replies.splice(j, 1)
					if (root.replyCount != null && Number(root.replyCount) > 0) root.replyCount = Number(root.replyCount) - 1
					return true
				}
			}
		}
		return false
	}
	const removeComment = async (comment: any) => {
		const res = await deleteComment(comment.id, postId.value)
		if (!res.success) {
			uni.showToast({ title: '删除失败，请重试', icon: 'none' })
			return
		}
		const removed = removeCommentFromList(comment.id)
		if (removed && post.value != null) {
			post.value.commentCount = Math.max(0, Number(post.value.commentCount || 0) - 1)
		}
		uni.showToast({ title: '已删除', icon: 'none' })
	}
	const discardPendingCommentKey = () => {
		if (pendingCommentKey.value != '') {
			discardCommunityCreateKey(pendingCommentKey.value)
		}
		pendingCommentKey.value = ''
		pendingCommentFingerprint.value = ''
	}
	const shouldDiscardCommentKey = (res: any): boolean => {
		if (res == null) return false
		if (res.success == false) return res.code != null && res.code != -1
		return res.data != null && res.data.success == false
	}

	const onDraft = (e: any) => {
		draft.value = e.detail.value
		if (pendingCommentFingerprint.value != '' && pendingCommentFingerprint.value != commentFingerprint(draft.value.trim())) {
			discardPendingCommentKey()
		}
	}

	onUnload(() => {
		discardPendingCommentKey()
	})

	const focusComment = async () => {
		// 底部输入即可
	}

const submitComment = async () => {
			const text = draft.value.trim()
			if (text.length == 0) {
				uni.showToast({ title: '请输入评论', icon: 'none' })
				return
			}
			const ok = await guardRealName('comment')
			if (!ok) return
			if (sending.value) return
			const fingerprint = commentFingerprint(text)
			if (pendingCommentKey.value == '' || pendingCommentFingerprint.value != fingerprint) {
				discardPendingCommentKey()
				pendingCommentKey.value = createCommunityCreateKey('comment')
				pendingCommentFingerprint.value = fingerprint
			}
			sending.value = true
			try {
				const res = await commentDynamic({
					dynamicId: postId.value,
					content: text,
					replyToCommentId: replyTarget.value != null ? replyTarget.value.id : 0,
					idempotencyKey: pendingCommentKey.value
				})
				const data = res != null ? res.data : null
				const bizOk = res != null && res.success && (data == null || data.success != false)
				if (bizOk && data != null && data.comment != null) {
					if (replyTarget.value != null) {
						const root = (comments.value as any[]).find((c: any) => c.id == replyTarget.value.id || c.id == replyTarget.value.rootId)
						if (root != null) { if (root.replies == null) root.replies = []; root.replies.push(data.comment) }
					} else comments.value.push(data.comment)
					if (post.value != null) {
						post.value.commentCount = (post.value.commentCount || 0) + 1
					}
					discardPendingCommentKey()
					draft.value = ''
					replyTarget.value = null
					uni.showToast({ title: '已发送', icon: 'success' })
				} else {
					if (shouldDiscardCommentKey(res)) discardPendingCommentKey()
					const msg = data != null && data.message != null ? data.message : '发送失败'
					uni.showToast({ title: msg, icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '发送失败', icon: 'none' })
			} finally {
				sending.value = false
			}
		}

	const goUser = (id: number) => {
		uni.navigateTo({ url: `/pagesSub/userExtra/user/detail?userId=${id}` })
	}

	const goTopic = (id: number) => {
		uni.navigateTo({ url: `/pagesSub/community/topic-detail?id=${id}` })
	}

const onLike = async (id: number) => {
			const ok = await guardRealName('like')
			if (!ok) return
			const res = await likeDynamic(id)
			if (res.success && post.value != null && res.data != null) {
				post.value.liked = res.data.liked
				post.value.likeCount = res.data.likeCount
			} else if (!res.success) {
				const msg =
					res.data != null && res.data.message != null
						? res.data.message
						: res.message != null
							? res.message
							: '点赞失败'
				uni.showToast({ title: msg, icon: 'none' })
			}
		}

		const onLikeComment = async (c: any) => {
			if (c == null) return
			const ok = await guardRealName('like')
			if (!ok) return
			const prevLiked = c.liked == true
			const prevCount = c.likeCount != null ? (c.likeCount as number) : 0
			c.liked = !prevLiked
			c.likeCount = prevCount + (c.liked ? 1 : -1)
			if (c.likeCount < 0) c.likeCount = 0
			const res = await likeComment(c.id, prevLiked)
			if (res.success && res.data != null) {
				c.liked = res.data.liked == true
				if (res.data.likeCount != null) c.likeCount = res.data.likeCount
			} else {
				c.liked = prevLiked
				c.likeCount = prevCount
				const msg =
					res != null && res.data != null && res.data.message != null
						? res.data.message
						: res != null && res.message != null
							? res.message
							: '评论点赞失败'
				uni.showToast({ title: msg, icon: 'none' })
			}
		}

		const onShare = async (id: number) => {
			const res = await shareDynamic(id)
			uni.showToast({ title: res.success ? '已生成分享内容，请使用右上角分享' : '分享暂不可用，请稍后重试', icon: 'none' })
		}

		const onCollect = async (id: number) => {
			const ok = await guardRealName('collect')
			if (!ok) return
			const res = await collectDynamic(id)
			if (res.success && post.value != null && res.data != null) {
				post.value.collected = res.data.collected == true
				if (res.data.collectCount != null) post.value.collectCount = Number(res.data.collectCount)
			} else if (!res.success) {
				const msg = res.message != null && res.message != '' ? '' + res.message : '收藏失败，请重试'
				uni.showToast({ title: msg, icon: 'none' })
			}
		}

	const onFollow = async (userId: number) => {
		const ok = await guardRealName('follow')
		if (!ok) return
		const res = await followUserFromCommunity(userId)
		if (res.success && post.value != null) {
			post.value.followed = true
		} else if (!res.success) {
			const msg =
				res.data != null && res.data.message != null
					? res.data.message
					: res.message != null
						? res.message
						: '关注失败'
			uni.showToast({ title: msg, icon: 'none' })
		}
	}

	const onUnfollow = (userId: number) => {
		if (unfollowPendingUserId.value != 0) return
		unfollowPendingUserId.value = userId
		uni.showModal({
			title: '取消关注',
			content: '确定不再关注这位用户吗？',
			cancelText: '取消',
			confirmText: '确定',
			success: async (modalRes: any) => {
				if (modalRes == null || modalRes.confirm != true) {
					unfollowPendingUserId.value = 0
					return
				}
				try {
					const res = await unfollowUserFromCommunity(userId)
					if (res.success && post.value != null) {
						post.value.followed = false
						uni.showToast({ title: '已取消关注', icon: 'none' })
					} else {
						const msg =
							res != null && res.data != null && res.data.message != null
								? '' + res.data.message
								: res != null && res.message != null
									? '' + res.message
									: '取消关注失败，请重试'
						uni.showToast({ title: msg, icon: 'none' })
					}
				} catch (e) {
					uni.showToast({ title: '取消关注失败，请重试', icon: 'none' })
				} finally {
					if (unfollowPendingUserId.value == userId) unfollowPendingUserId.value = 0
				}
			}
			, fail: () => {
				if (unfollowPendingUserId.value == userId) unfollowPendingUserId.value = 0
			}
		})
	}

const onApply = (userId: number) => {
			applyUserId.value = userId
			applyVisible.value = true
		}

		const onApplyOk = (payload: any) => {
			const status =
				payload != null && payload.applyStatus != null ? (payload.applyStatus as string) : 'pending'
			if (post.value != null) {
				post.value.applyStatus = status
			}
		}

			const confirmDeletePost = () => {
				uni.showModal({
					title: '删除动态',
					content: '删除后不可恢复，确定删除这条动态吗？',
					success: async (modal: any) => {
						if (modal.confirm != true) return
						const res = await deleteDynamic(postId.value)
						if (!res.success) {
							uni.showToast({ title: res.message != null && res.message != '' ? '' + res.message : '删除失败，请重试', icon: 'none' })
							return
						}
						uni.showToast({ title: '已删除', icon: 'none' })
						setTimeout(() => { uni.navigateBack() }, 600)
					}
				})
			}
			const onMore = (dynamicId: number, userId: number) => {
				// 本人的动态：⋯ 只提供删除（举报自己的内容没有意义）；
				// 以前无论谁点都只弹举报，导致"自己的动态删不掉"。
				if (isOwnPost.value) {
					uni.showActionSheet({
						itemList: ['删除动态'],
						success: (res: any) => { if (res.tapIndex == 0) confirmDeletePost() }
					})
					return
				}
				// 别人的动态：⋯ 先弹底部菜单（举报/取消），点举报再进举报面板
				reportTargetType.value = 'post'
				reportTargetId.value = dynamicId
				reportUserId.value = userId
				moreVisible.value = true
			}
			const onMoreActionReport = () => {
				// 先关菜单再开举报面板，避免两个遮罩叠在一起
				moreVisible.value = false
				reportVisible.value = true
			}

			const onReportComment = (c: any) => {
				if (c == null) return
				reportTargetType.value = 'comment'
				reportTargetId.value = c.id != null ? (c.id as number) : 0
				const uid = c.user != null && c.user.id != null ? (c.user.id as number) : 0
				reportUserId.value = uid
				reportVisible.value = true
			}

			// 作者胶囊：后端 is_post_author 优先，mock / 旧数据回退到帖子作者 id 比对
			const isAuthorBadge = (c: any): boolean => {
				if (c == null) return false
				if (c.isPostAuthor == true) return true
				const p = post.value as any
				if (p == null) return false
				const author = p.user != null ? p.user : {}
				const aid = Number(author.id != null ? author.id : (author.userId != null ? author.userId : (p.userId != null ? p.userId : 0)))
				const cid = c.user != null && c.user.id != null ? Number(c.user.id) : 0
				return aid > 0 && aid == cid
			}
			// 删除：评论本人 或 帖子作者（后端 can_delete 已按同一口径放开）
			const canDeleteComment = (c: any): boolean => {
				if (c == null || c.isDeleted == true) return false
				return isOwnPost.value || c.canDelete == true
			}
			// 举报：不能举报自己
			const canReportComment = (c: any): boolean => {
				if (c == null || c.isDeleted == true) return false
				const uid = c.user != null && c.user.id != null ? Number(c.user.id) : 0
				return viewerId.value > 0 && uid > 0 && uid != viewerId.value
			}
			const openCommentActions = (c: any) => {
				if (c == null || c.isDeleted == true) return
				lastLongPressAt.value = Date.now()
				actionTarget.value = c
				actionVisible.value = true
			}
			const onCommentActionDelete = () => {
				const c = actionTarget.value as any
				actionVisible.value = false
				if (c == null) return
				uni.showModal({
					title: '删除评论',
					content: '删除后不可恢复，确定删除这条评论吗？',
					success: async (modal: any) => {
						if (modal != null && modal.confirm == true) await removeComment(c)
					}
				})
			}
			const onCommentActionReport = () => {
				const c = actionTarget.value as any
				// 先关菜单再开举报面板，避免两个遮罩叠在一起
				actionVisible.value = false
				if (c == null) return
				onReportComment(c)
			}

			const onBlocked = (_userId: number) => {
				uni.showToast({ title: '已屏蔽，返回上一页', icon: 'none' })
				setTimeout(() => {
					uni.navigateBack()
				}, 400)
			}
		</script>

<style scoped>
	.page {
		height: 100vh;
