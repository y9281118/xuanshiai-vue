<template>
	<view class="page">
		<!-- 社区通知只保留 评论 / 点赞 / 关注 / 活动 / 系统 五个分类，外加「全部」跨分类混排。
		     私信（会话 / 消息）与匹配（申请认识）两类提醒由「消息」页承接，不在这里建 Tab，
		     也不进「全部」列表与角标，避免同一件事两处重复提醒、角标清不掉。
		     可见分类统一由 api 层的 COMMUNITY_NOTIFICATION_CATEGORIES 收口。 -->
		<scroll-view class="tabs" scroll-x>
			<view class="tabs-inner">
				<view
					class="tab"
					:class="{ active: currentTab === 'all' }"
					@click="switchTab('all')"
				>
					<text class="tab-text">全部</text>
					<text class="tab-badge" v-if="unreadOf('all') > 0">{{ unreadOf('all') }}</text>
				</view>
				<view
					class="tab"
					:class="{ active: currentTab === 'comment' }"
					@click="switchTab('comment')"
				>
					<text class="tab-text">评论</text>
					<text class="tab-badge" v-if="unreadOf('comment') > 0">{{ unreadOf('comment') }}</text>
				</view>
				<view
					class="tab"
					:class="{ active: currentTab === 'like' }"
					@click="switchTab('like')"
				>
					<text class="tab-text">点赞</text>
					<text class="tab-badge" v-if="unreadOf('like') > 0">{{ unreadOf('like') }}</text>
				</view>
				<view
					class="tab"
					:class="{ active: currentTab === 'follow' }"
					@click="switchTab('follow')"
				>
					<text class="tab-text">关注</text>
					<text class="tab-badge" v-if="unreadOf('follow') > 0">{{ unreadOf('follow') }}</text>
				</view>
				<!-- 私信、匹配两类提醒由「消息」页承接，不在此建分类入口。 -->
				<view
					class="tab"
					:class="{ active: currentTab === 'activity' }"
					@click="switchTab('activity')"
				>
					<text class="tab-text">活动</text>
					<text class="tab-badge" v-if="unreadOf('activity') > 0">{{ unreadOf('activity') }}</text>
				</view>
				<view
					class="tab"
					:class="{ active: currentTab === 'system' }"
					@click="switchTab('system')"
				>
					<text class="tab-text">系统</text>
					<text class="tab-badge" v-if="unreadOf('system') > 0">{{ unreadOf('system') }}</text>
				</view>
			</view>
		</scroll-view>
		<view class="toolbar" v-if="visibleList.length > 0">
			<text class="mark-all text-accent" @click="markAll">全部已读</text>
		</view>
		<scroll-view class="list" scroll-y @scrolltolower="loadMore">
			<view class="state" v-if="loading"><text class="text-muted">通知加载中...</text></view>
			<XsaEmpty
				v-else-if="notificationError"
				type="noNetwork"
				text="通知加载失败"
				description="请检查网络后重试"
				:show-action="true"
				action-text="重试"
				@action="load"
			/>
			<XsaEmpty
				v-else-if="visibleList.length == 0 && !hasMore"
				:text="emptyText"
				:description="emptyDesc"
			/>
			<!-- 「全部」下整页都是消息页承接的分类时仍可继续翻页，不误报空态。 -->
			<view class="state" v-else-if="visibleList.length == 0">
				<text class="text-muted">正在查找更多通知...</text>
			</view>
			<view
				class="item"
				:class="{ unread: !n.read }"
				v-for="n in visibleList"
				:key="n.id"
				@click="open(n)"
			>
				<view class="dot" v-if="!n.read"></view>
				<view class="body">
					<text class="title">{{ n.title }}</text>
					<text class="content text-muted">{{ n.content }}</text>
					<text class="time text-muted">{{ n.timeText }}</text>
				</view>
			</view>
			<view class="state" v-if="loadingMore"><text class="text-muted">加载更多...</text></view>
			<view class="state" v-else-if="!hasMore && visibleList.length > 0">
				<text class="text-muted">没有更多了</text>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import {
		getCommunityNotifications,
		getUnreadNotificationSummary,
		markNotificationRead,
		markAllNotificationsRead,
		notificationCategoryOf,
		isCommunityNotificationVisible
	} from '@/api'

	// 每页条数：与服务端 page_size 上限（50）留余量，滚动到底再续拉。
	const PAGE_SIZE = 20

	const items = ref([] as any[])
	const loading = ref(false)
	const loadingMore = ref(false)
	const notificationError = ref(false)
	const currentTab = ref('all')
	const page = ref(1)
	const hasMore = ref(false)
	// 分类未读角标：与列表筛选同源于服务端 NOTIFICATION_CATEGORY_BY_TYPE。
	// unreadTotal 取汇总接口的 visibleTotal（已排除私信 / 匹配），保证「全部」
	// 角标、社区入口角标与「全部」列表条数同源，不会出现清不掉的角标。
	const unreadByCategory = ref({} as any)
	const unreadTotal = ref(0)

	const unreadOf = (key: string): number => {
		if (key == 'all') return unreadTotal.value
		const map = unreadByCategory.value as any
		const value = map[key]
		return value != null ? Number(value) : 0
	}

	// 「全部」不传 category，其余 Tab 名即分类名（与后端七桶完全同名）。
	const currentCategory = (): string => {
		if (currentTab.value == 'all') return ''
		return currentTab.value
	}

	const switchTab = (tab: string) => {
		if (currentTab.value == tab) return
		currentTab.value = tab
		items.value = []
		page.value = 1
		hasMore.value = false
		load()
	}

	// 分页与筛选都在服务端完成，这里只做展示侧兜底守卫：
	// 旧后端会忽略未知查询参数返回混排列表，不能让别的分类串进当前 Tab，
	// 也不能让消息页承接的两类回到社区通知。分类口径统一走 api 层的
	// notificationCategoryOf / isCommunityNotificationVisible。
	const matchesTab = (n: any, tab: string): boolean => {
		// 兜底守卫：即使旧后端忽略查询参数返回混排列表，消息页承接的两类
		// 也不得出现在社区通知里（列表口径与 api 层一致）。
		if (!isCommunityNotificationVisible(n)) return false
		if (tab == 'all') return true
		return notificationCategoryOf(n) == tab
	}

	// 活动分类含社区动态提醒，Tab 必须与角标同口径全部展示；
	// 之前只留 isOfficialActivity 会让角标数大于列表条数。
	const visibleList = computed(() => {
		const all = items.value as any[]
		const tab = currentTab.value
		const out: any[] = []
		for (let i = 0; i < all.length; i++) {
			const n = all[i]
			if (!matchesTab(n, tab)) continue
			out.push(n)
		}
		return out
	})

	const emptyText = computed(() => {
		if (currentTab.value == 'all') return '暂无通知'
		if (currentTab.value == 'comment') return '暂无评论'
		if (currentTab.value == 'like') return '暂无点赞'
		if (currentTab.value == 'follow') return '暂无关注'
		if (currentTab.value == 'activity') return '暂无活动通知'
		return '暂无系统通知'
	})

	const emptyDesc = computed(() => {
		if (currentTab.value == 'comment') return '收到的评论会出现在这里'
		if (currentTab.value == 'like') return '收到的点赞会出现在这里'
		if (currentTab.value == 'follow') return '有人关注你时会出现在这里'
		if (currentTab.value == 'activity') return '活动报名、审核、签到进展与社区动态提醒会出现在这里'
		if (currentTab.value == 'system') return '举报、申诉与审核结果会出现在这里'
		return '评论、点赞、关注、活动与系统通知都在这里；私信与申请认识请到消息页查看'
	})

	onMounted(() => {
		loadUnread()
		load()
	})

	const loadUnread = async () => {
		try {
			const res = await getUnreadNotificationSummary()
			if (res.success && res.data != null) {
				const payload = res.data as any
				unreadByCategory.value = payload.byCategory != null ? payload.byCategory : {}
				unreadTotal.value = payload.visibleTotal != null
					? Number(payload.visibleTotal)
					: (payload.total != null ? Number(payload.total) : 0)
			}
		} catch (e) {}
	}

	const load = async () => {
		loading.value = true
		notificationError.value = false
		page.value = 1
		hasMore.value = false
		try {
			const res = await getCommunityNotifications(1, PAGE_SIZE, currentCategory())
			if (res.success && res.data != null) {
				const payload = res.data as any
				items.value = payload.items != null ? (payload.items as any[]) : []
				hasMore.value = payload.hasMore == true
			} else if (res.success) {
				items.value = []
			} else {
				notificationError.value = true
			}
		} catch (e) {
			notificationError.value = true
			uni.showToast({ title: '通知加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
		await ensureVisible()
	}

	const loadMore = async () => {
		if (loading.value || loadingMore.value || !hasMore.value) return
		loadingMore.value = true
		try {
			// 服务端分页仍按全量通知推进；连续几页都只含消息页承接的分类时，
			// 自动续拉到出现可见通知或到底，避免列表停在「还有更多」却不增长。
			let guard = 0
			while (hasMore.value && guard < 8) {
				guard += 1
				const before = visibleList.value.length
				const next = page.value + 1
				const res = await getCommunityNotifications(next, PAGE_SIZE, currentCategory())
				if (!res.success || res.data == null) {
					// 续拉失败就停下，避免滚动到底反复请求。
					hasMore.value = false
					break
				}
				const payload = res.data as any
				const incoming = payload.items != null ? (payload.items as any[]) : []
				const merged: any[] = []
				const prev = items.value as any[]
				for (let i = 0; i < prev.length; i++) merged.push(prev[i])
				for (let i = 0; i < incoming.length; i++) merged.push(incoming[i])
				items.value = merged
				page.value = next
				hasMore.value = payload.hasMore == true
				if (visibleList.value.length > before || !hasMore.value) break
			}
		} catch (e) {
			hasMore.value = false
		} finally {
			loadingMore.value = false
		}
	}

	// 首屏整页都是消息页承接的分类时，交给 loadMore 自动续拉到有可见通知或到底。
	const ensureVisible = async () => {
		if (notificationError.value) return
		if (visibleList.value.length == 0 && hasMore.value) await loadMore()
	}

	const open = async (n: any) => {
		const item = n
		if (n.read != true) {
			n.read = true
			try {
				await markNotificationRead(n.id as number)
				loadUnread()
			} catch (e) {}
		}
		if (item.targetType == 'comment' && item.postId > 0 && item.commentId > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.postId + '&commentId=' + item.commentId })
		} else if (item.targetType == 'comment' && item.payload != null && item.payload.post_id > 0 && item.payload.comment_id > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.payload.post_id + '&commentId=' + item.payload.comment_id })
		} else if (item.type == 'comment' && item.postId > 0 && item.commentId > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.postId + '&commentId=' + item.commentId })
		} else if (item.targetType == 'post' && item.targetId > 0) {
			uni.navigateTo({ url: `/pagesSub/community/post-detail?id=${item.targetId}` })
		} else if (item.targetType == 'community_post' && item.targetId > 0) {
			// 社区动态提醒（community_post_remind）归 activity 分类，target_type 是
			// community_post 而不是 post；不接这一支会落到「内容已不可查看」。
			uni.navigateTo({ url: `/pagesSub/community/post-detail?id=${item.targetId}` })
		} else if (item.type == 'comment') {
			uni.showToast({ title: '该评论已不可查看', icon: 'none' })
		} else if (item.targetType == 'activity' && item.targetId > 0 && item.isOfficialActivity == true) {
			uni.navigateTo({ url: `/pagesSub/community/activity-detail?id=${item.targetId}` })
		} else if (item.targetType == 'user' && item.targetId > 0) {
			uni.navigateTo({ url: `/pagesSub/userExtra/user/detail?userId=${item.targetId}` })
		} else if (item.targetType == 'report' || item.targetType == 'appeal') {
			uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
		} else if (item.targetType == 'message') {
			uni.switchTab({ url: '/pages/message/message' })
		} else if (item.targetType == 'chat_session' || item.targetType == 'chat_session_request' || item.targetType == 'chat_session_request_result') {
			// 撤回通知（message_recalled，target_type=chat_session）与会话请求类通知
			// 只带 session_id，不带对方 userId，没法直接进 /pagesSub/chat/detail。
			// 以前这一支落到「该通知关联内容已不可查看」；现在统一回消息列表——
			// 会话预览已按撤回态重算（显示「消息已撤回」，不露原文）。
			// 私信 / 会话类通知现已由消息页承接，本分支仅作旧数据兼容保留。
			uni.switchTab({ url: '/pages/message/message' })
		} else {
			uni.showToast({ title: '该通知关联内容已不可查看', icon: 'none' })
		}
	}

	const markAll = async () => {
		try {
			const res = await markAllNotificationsRead()
			if (res.success) {
				const arr = items.value as any[]
				for (let i = 0; i < arr.length; i++) {
					arr[i].read = true
				}
				await loadUnread()
				uni.showToast({ title: '已全部标为已读', icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}
	.tabs {
		height: 44px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
		white-space: nowrap;
	}
	.tabs-inner {
		display: flex;
		flex-direction: row;
		align-items: stretch;
	}
	.tab {
		flex-shrink: 0;
		padding: 0 12px;
		height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-bottom: 2px solid transparent;
	}
	.tab.active {
		border-bottom-color: var(--accent);
	}
	.tab-text {
		font-size: 14px;
		font-weight: 600;
		color: var(--muted);
	}
	.tab.active .tab-text {
		color: var(--accent);
		font-weight: 700;
	}
	.tab-badge {
		margin-left: 3px;
		min-width: 16px;
		height: 16px;
		line-height: 16px;
		padding: 0 4px;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font-size: 10px;
		font-weight: 700;
		text-align: center;
	}
	.state {
		padding: 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.toolbar {
		height: 40px;
		padding: 0 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
	}
	.mark-all {
		font-size: 12px;
		font-weight: 700;
	}
	.list {
		flex: 1;
		height: 0;
	}
	.item {
		display: flex;
		flex-direction: row;
		gap: 10px;
		padding: 14px 16px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.item.unread {
		background: var(--soft);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		margin-top: 6px;
		flex-shrink: 0;
	}
	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.title {
		font-size: 14px;
		font-weight: 700;
		color: var(--ink);
	}
	.content {
		font-size: 12px;
		line-height: 1.45;
	}
	.time {
		font-size: 11px;
	}
	.pad {
		height: 24px;
	}
</style>
