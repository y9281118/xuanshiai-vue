	flex: 1;
	min-width: 0;
	font-size: 24rpx;
	color: var(--ink);
	font-weight: 700;
}

.level-event-amount {
	width: 200rpx;
	flex-shrink: 0;
	text-align: right;
	font-size: 24rpx;
	color: var(--ink2);
}

/* 空态与错误态 */
.level-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 14rpx;
	box-sizing: border-box;
	padding: 46rpx 28rpx;
}

.level-state text {
	font-size: 22rpx;
	line-height: 1.5;
	text-align: center;
	color: var(--muted);
}

