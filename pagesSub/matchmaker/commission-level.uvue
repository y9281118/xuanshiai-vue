	font-size: 22rpx;
	font-weight: 800;
	color: var(--review-purple);
}

.level-tip-body {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	flex: 1;
}

.level-tip-title {
	font-size: 26rpx;
	font-weight: 800;
	color: var(--review-deep);
}

.level-tip-text {
	font-size: 22rpx;
	line-height: 1.6;
	color: var(--ink2);
}

/* 分节标题（两侧圆点） */
.level-section {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 14rpx;
	margin: 40rpx 0 18rpx;
}

.level-section-dots {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6rpx;
}

.level-dot {
	width: 14rpx;
	height: 14rpx;
	border-radius: 999rpx;
}

.level-dot-a {
	background: var(--review-lilac);
}

.level-dot-b {
	background: var(--review-pink);
}

.level-section-title {
	font-size: 30rpx;
	font-weight: 800;
	font-family: var(--serif);
	color: var(--ink);
}

/* 标准表 */
.level-table {
	display: flex;
	flex-direction: column;
	border-radius: 24rpx;
	background: var(--review-canvas);
	overflow: hidden;
}

.level-table-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	padding: 20rpx 24rpx;
	background: var(--review-soft);
}

.level-table-head text {
	font-size: 22rpx;
	font-weight: 800;
	color: var(--review-deep);
}

.level-table-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	padding: 24rpx;
}

.level-col {
	font-size: 24rpx;
	line-height: 1.5;
	color: var(--ink2);
}

.level-col-name {
	width: 180rpx;
	flex-shrink: 0;
	color: var(--ink);
	font-weight: 700;
}

.level-col-condition {
	flex: 1;
	min-width: 0;
}

.level-col-amount {
	width: 150rpx;
	flex-shrink: 0;
	text-align: right;
}

