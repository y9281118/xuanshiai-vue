// 判断牵线记录中的会员是否为会员专区（VIP）会员，用于卡片上的 VIP 徽章。
const isVipPerson = (person: any): boolean => person != null && Number(person.isVip) == 1

// 点击「联系」→ 打开查看联系方式弹窗（受审计读取，超级红娘可查全部会员）。牵线卡片不走这里，改为就地展开。
const workspaceContactVisible = ref(false)
const workspaceContactLoading = ref(false)
const workspaceContactNickname = ref('')
const workspaceContactRealName = ref('')
const workspaceContactPhone = ref('')
const workspaceContactWechat = ref('')
const workspaceContactScope = ref('SERVED')
const workspaceContactError = ref('')
const workspaceContactMemberId = ref(0)

const resetWorkspaceContact = () => {
	workspaceContactNickname.value = ''
	workspaceContactRealName.value = ''
	workspaceContactPhone.value = ''
	workspaceContactWechat.value = ''
	workspaceContactScope.value = 'SERVED'
	workspaceContactError.value = ''
}

const closeWorkspaceContact = () => {
	workspaceContactVisible.value = false
	workspaceContactMemberId.value = 0
	resetWorkspaceContact()
}

// 遮罩点击守卫：打开后 360ms 内忽略遮罩点击，避免「打开弹窗的那一次点击」穿透关闭弹窗。
const workspaceContactReady = ref(false)

// 名称行：昵称去掉「（演示）」后缀 + 实名，两者相同只显示一个。
const workspaceContactNameText = computed<string>((): string => {
	const nick = workspaceContactNickname.value.length > 0 ? workspaceContactNickname.value.replace('（演示）', '').replace('(演示)', '').trim() : ''
	const real = workspaceContactRealName.value.trim()
	if (nick.length > 0 && real.length > 0 && nick != real) return nick + ' | ' + real
	if (nick.length > 0) return nick
	if (real.length > 0) return real
	return '会员联系方式'
})

const workspaceContactTipText = computed<string>((): string => {
	if (workspaceContactScope.value == 'ALL') return '您当前是超级红娘，可以查看所有会员的联系方式；请勿外泄，每次查看都会记录到服务审计日志。'
	return '超级红娘可以查看所有会员的联系方式；普通红娘仅能查看所服务会员的联系方式。本次查看已记录到服务审计日志。'
})

const copyWorkspaceContact = (value: string) => {
	if (value.length == 0) return
	uni.setClipboardData({
		data: value,
		success: () => { uni.showToast({ title: '已复制', icon: 'none' }) }
	})
}

const callWorkspaceContact = () => {
	const phone = workspaceContactPhone.value.trim()
	if (phone.length == 0) {
		uni.showToast({ title: '该会员未绑定手机号', icon: 'none' })
		return
	}
	uni.makePhoneCall({
		phoneNumber: phone,
		fail: () => { uni.showToast({ title: '拨号未成功，可先复制号码', icon: 'none' }) }
	})
}

const onWorkspaceContactOverlay = () => {
	if (!workspaceContactReady.value) return
	closeWorkspaceContact()
}

// 资料待审里的「联系」→ 上抛会员，复用页面里同一个弹窗（避免重复实现弹层）。
const onPendingReviewContact = (member: any) => {
	const id = member != null && member.user_id != null ? String(member.user_id).trim() : ''
	const name = member != null && member.nickname != null ? String(member.nickname) : ''
	openWorkspaceContact({ id: id, name: name })
}

// 解析会员编号：演示数据（如 W10001）会得到 NaN，必须用「非正数」判断兜住，否则会带着 NaN 去请求接口。
const parseMemberId = (person: any): number => {
	const raw = person != null && person.id != null ? String(person.id).trim() : ''
	if (raw.length == 0) return 0
	const value = Number(raw)
	if (!(value > 0)) return 0
	return Math.floor(value)
}

// 牵线卡片上的「查看联系方式」：不弹层，直接走同一个受审计接口，把号码就地展开在该侧行内。
const revealMatchContact = async (row: any, side: string) => {
	if (workspaceIntroductionWorkflowVersion.value != 2) { showToast('服务端牵线流程尚未升级'); return }
	const person = side == 'from' ? row.fromUser : row.toUser
	const slot = side == 'from' ? row.fromContact : row.toContact
	if (slot.loading) return
	if (slot.revealed) {
		slot.revealed = false
		return
	}
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂不支持查看联系方式')
		return
	}
	slot.loading = true
	slot.error = ''
	try {
		const result = await viewMatchmakerIntroductionContact(String(row.id), side)
		if (!result.success || result.data == null) {
			slot.error = result.message != null && String(result.message).length > 0 ? String(result.message) : '联系方式加载失败，请稍后重试'
			return
		}
		const payload: any = result.data
		const data: any = payload.contact
		if (data == null || Number(payload.introduction_id) != Number(row.id)) { slot.error = '牵线联系方式响应无效'; return }
		slot.phone = data.phone != null ? String(data.phone) : ''
		slot.wechat = data.wechat != null ? String(data.wechat) : ''
		slot.revealed = true
		row.fromPhoneViewed = payload.from_phone_viewed === true
		row.toPhoneViewed = payload.to_phone_viewed === true
		const next = String(payload.status)
		if (['PENDING', 'IN_PROGRESS', 'SUCCEEDED', 'FAILED'].indexOf(next) >= 0) {
			row.status = next
			const labels: any = { PENDING: '待牵线', IN_PROGRESS: '牵线中', SUCCEEDED: '牵线成功', FAILED: '牵线失败' }
			row.statusLabel = labels[next]
		}
		if (slot.phone.length == 0) showToast('该会员未留电话，不能推进牵线状态')
		if (row.status == 'PENDING' && row.fromPhoneViewed && row.toPhoneViewed && slot.phone.length > 0) confirmMatchContactsObtained(row)
		await reloadManagementCenterSnapshot()
	} catch (e) {
		slot.error = '网络异常，请稍后重试'
	} finally {
		slot.loading = false
	}
}

const confirmMatchContactsObtained = (row: any) => {
	if (row.contactsConfirming === true || row.status != 'PENDING') return
	row.contactsConfirming = true
	uni.showModal({
		title: '确认已获得双方联系方式',
		content: '请确认红娘已获得申请人和被牵线方的联系方式。确认后进入牵线中。',
		confirmText: '确认已获得',
		cancelText: '暂不确认',
		success: async (res: any) => {
			if (!res.confirm) { row.contactsConfirming = false; return }
			try {
				const result = await viewMatchmakerIntroductionContact(String(row.id), 'to', true)
				if (!result.success) { showToast(result.message || '确认失败，请重试'); return }
				await loadWorkspaceMatches()
				await reloadManagementCenterSnapshot()
			} catch (e) { showToast('网络异常，请重试') }
			finally { row.contactsConfirming = false }
		},
		fail: () => { row.contactsConfirming = false }
	})
}

const openWorkspaceContact = async (person: any, row: any = null) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂不支持查看联系方式')
		return
	}
	workspaceContactMemberId.value = id
	resetWorkspaceContact()
	// 先用卡片上的姓名占位，避免弹窗加载期间标题为空。
	workspaceContactNickname.value = person != null && person.name != null ? String(person.name) : ''
	// 打开瞬间屏蔽遮罩点击（同一次点击可能落到刚出现的遮罩上）。
	workspaceContactReady.value = false
	setTimeout(() => { workspaceContactReady.value = true }, 360)
	workspaceContactLoading.value = true
	workspaceContactVisible.value = true
	try {
		const result = await getMatchmakerMemberContact(String(id))
		if (workspaceContactMemberId.value != id) return
		if (!result.success || result.data == null) {
			// 读取失败时保持弹窗打开并就地提示，避免「一闪而过」看起来像没反应。
			workspaceContactError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '联系方式加载失败，请稍后重试'
			return
		}
		const data: any = result.data
		if (data.nickname != null && String(data.nickname).length > 0) workspaceContactNickname.value = String(data.nickname)
		workspaceContactRealName.value = data.realName != null ? String(data.realName) : ''
		workspaceContactPhone.value = data.phone != null ? String(data.phone) : ''
		workspaceContactWechat.value = data.wechat != null ? String(data.wechat) : ''
		workspaceContactScope.value = data.scope != null ? String(data.scope) : 'SERVED'
	} catch (e) {
		workspaceContactError.value = '网络异常，请稍后重试'
	} finally {
		workspaceContactLoading.value = false
	}
}

// 点击牵线记录里的会员头像 → 以红娘权限查看该会员主页。
const openWorkspaceMemberProfile = (person: any) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂无主页')
		return
	}
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/detail?userId=' + String(id) + '&matchmakerView=1',
		fail: () => showToast('打开会员主页失败')
	})
}

const loadWorkspaceMeetings = async () => {
	workspaceMeetingsLoading.value = true
	workspaceMeetingsError.value = ''
	workspaceMeetingsLoaded.value = false
	workspaceMeetingsUsingDemoData.value = false
	try {
		const result = await getMatchmakerWorkspaceMeetingRequests()
		if (!result.success || result.data == null) {
			workspaceMeetings.value = []
			workspaceMeetingsError.value = result.message != null ? String(result.message) : '约见申请加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceMeetingsUsingDemoData.value = source.isDemo == true
		workspaceMeetingWorkflowVersion.value = Number(source.workflowVersion || 0)
		introductionFallbackUsed = []
		workspaceMeetings.value = items.map((item: any) => {
			const applicant = item.applicant != null ? item.applicant : {}
			const target = item.target != null ? item.target : {}
			const meeting = item.meeting != null ? item.meeting : null
			const presentation = getWorkspaceMeetingPresentation(item.status != null ? String(item.status) : 'SUBMITTED', meeting)
			return {
				id: item.id != null ? String(item.id) : '',
				phase: presentation.phase,
				statusLabel: presentation.statusLabel,
				statusTone: presentation.statusTone,
				detail: presentation.detail,
				requestStatus: item.status != null ? String(item.status) : 'SUBMITTED',
				createdAt: item.createdAt != null ? String(item.createdAt).substring(0, 16) : '',
				owner: item.matchmakerName != null && String(item.matchmakerName) != '' ? String(item.matchmakerName) : '待分派',
				note: item.note != null ? String(item.note) : '',
				meeting: meeting != null ? {
					id: meeting.id != null ? String(meeting.id) : '',
					status: meeting.status != null ? String(meeting.status) : '',
					scheduledAt: meeting.scheduledAt != null ? String(meeting.scheduledAt).substring(0, 16) : '',
					location: meeting.location != null ? String(meeting.location) : '',
					followUpContent: meeting.followUpContent != null ? String(meeting.followUpContent) : ''
				} : null,
				applicant: {
					id: applicant.id != null ? String(applicant.id) : '',
					name: applicant.name != null ? String(applicant.name) : '未命名会员',
					gender: applicant.gender != null ? String(applicant.gender) : '未填写',
					isVip: applicant.isVip === true || applicant.isVip === 1,
					avatar: applicant.avatar != null && String(applicant.avatar).length > 0 ? String(applicant.avatar) : getIntroductionFallbackAvatar(applicant.id, String(applicant.gender), String(applicant.name))
				},
				target: {
					id: target.id != null ? String(target.id) : '',
					name: target.name != null ? String(target.name) : '未命名会员',
					gender: target.gender != null ? String(target.gender) : '未填写',
					isVip: target.isVip === true || target.isVip === 1,
					avatar: target.avatar != null && String(target.avatar).length > 0 ? String(target.avatar) : getIntroductionFallbackAvatar(target.id, String(target.gender), String(target.name))
				}
			}
		})
		workspaceMeetingsLoaded.value = true
		syncBusinessMetricCountsFromWorkspace()
	} catch (e) {
		workspaceMeetings.value = []
		workspaceMeetingsUsingDemoData.value = false
		workspaceMeetingsError.value = '网络数据加载失败，请稍后重试'
	} finally {
		workspaceMeetingsLoading.value = false
	}
}

// ===== 牵线管理：添加牵线记录 =====
const matchAddSheetVisible = ref(false)
const matchAddPickerVisible = ref(false)
const matchAddPickerKind = ref('from')
const matchAddFromId = ref('')
const matchAddFromName = ref('')
const matchAddToId = ref('')
const matchAddToName = ref('')
const matchAddAppliedAt = ref('')
const matchAddError = ref('')
const matchAddSubmitting = ref(false)
const matchAddLoading = ref(false)
const matchAddCandidates = ref<any[]>([])
// 会员选择弹层支持按名字 / 编号搜索（待我牵线 → 添加牵线记录）
const matchAddSearch = ref('')
const matchAddContext = ref('introduction')
const onMatchAddSearchInput = (event: any) => {
	matchAddSearch.value = event.detail.value
}
const matchAddFilteredCandidates = computed(() => {
	const rows = matchAddCandidates.value.filter((item: any) => matchAddContext.value != 'meeting' || matchAddPickerKind.value != 'from' || Number(item.ownerId) == selfMatchmakerUserId.value)
	const keyword = matchAddSearch.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any): boolean => {
		const content = (String(item.name) + String(item.id) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const matchAddResultsLabel = computed(() => {
	const count = String(matchAddFilteredCandidates.value.length)
	return matchAddSearch.value.trim().length > 0 ? '搜索结果（' + count + '）' : '可选会员（' + count + '）'
})
const openMatchAddSheet = () => {
	matchAddContext.value = 'introduction'
	matchAddFromId.value = ''
	matchAddFromName.value = ''
	matchAddToId.value = ''
	matchAddToName.value = ''
	matchAddAppliedAt.value = ''
	matchAddError.value = ''
	matchAddSheetVisible.value = true
}
const openMatchAddPicker = async (kind: string) => {
	matchAddPickerKind.value = kind
	matchAddSearch.value = ''
	matchAddPickerVisible.value = true
	if (matchAddCandidates.value.length == 0) {
		matchAddLoading.value = true
		try {
			await loadWorkspaceMembers()
			const rows = workspaceMembers.value
			const options: any[] = []
			for (let i = 0; i < rows.length; i++) {
				const row = rows[i]
				options.push({
					id: String(row.id),
					ownerId: Number(row.ownerId || 0),
					name: String(row.name || '未命名会员'),
					gender: String(row.gender || '未填写'),
					avatar: String(row.avatar || '')
				})
			}
			matchAddCandidates.value = options
		} catch (e) {
			showToast('会员列表加载失败')
		} finally {
			matchAddLoading.value = false
		}
	}
}
const isMatchAddPicked = (id: string) => {
	if (matchAddContext.value == 'meeting') return matchAddPickerKind.value == 'from' ? meetingCreateTargetId.value == id : meetingCreateApplicantId.value == id
	return (matchAddPickerKind.value == 'from' && matchAddToId.value == id) || (matchAddPickerKind.value == 'to' && matchAddFromId.value == id)
}
const pickMatchAddMember = (m: any) => {
	if (isMatchAddPicked(String(m.id))) return
	if (matchAddContext.value == 'meeting') {
		meetingCreateContacted.value = false
		meetingCreateApplicantAgreed.value = false
		meetingCreateTargetAgreed.value = false
		if (matchAddPickerKind.value == 'from') { meetingCreateApplicantId.value = m.id; meetingCreateApplicantName.value = m.name }
		else { meetingCreateTargetId.value = m.id; meetingCreateTargetName.value = m.name }
		matchAddPickerVisible.value = false
		return
	}
	if (matchAddPickerKind.value == 'from') {
		matchAddFromId.value = m.id
		matchAddFromName.value = m.name
	} else {
		matchAddToId.value = m.id
		matchAddToName.value = m.name
	}
	matchAddPickerVisible.value = false
}
const submitMatchAdd = async () => {
	if (matchAddSubmitting.value) return
	if (workspaceIntroductionWorkflowVersion.value != 2) { matchAddError.value = '服务端牵线流程尚未升级'; return }
	if (matchAddFromId.value.length == 0) { matchAddError.value = '请选择牵线会员'; return }
	if (matchAddToId.value.length == 0) { matchAddError.value = '请选择被牵线会员'; return }
	if (matchAddFromId.value == matchAddToId.value) { matchAddError.value = '牵线双方不能是同一人'; return }
	matchAddSubmitting.value = true
	matchAddError.value = ''
	try {
		const result = await createMatchmakerIntroduction({
			fromUserId: matchAddFromId.value, toUserId: matchAddToId.value,
			appliedAt: matchAddAppliedAt.value || ''
		})
		if (!result.success) {
			matchAddError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '添加失败，请稍后重试'
			return
		}
		matchAddSheetVisible.value = false
		showToast('牵线记录已添加')
		await loadWorkspaceMatches()
		await reloadManagementCenterSnapshot()
	} catch (e) {
		matchAddError.value = '网络异常，请稍后重试'
	} finally {
		matchAddSubmitting.value = false
	}
}

// ===== 牵线管理：牵线状态弹窗（失败必填原因，其他状态无备注） =====
const matchStatusSheetVisible = ref(false)
const matchStatusRow = ref<any>(null)
const matchStatusChoice = ref('SUCCEEDED')
const matchContactConfirmed = ref(false)
const matchFailureReason = ref('')
const matchStatusSubmitting = ref(false)
const matchStatusOptions = [
	{ value: 'SUCCEEDED', label: '牵线成功' },
	{ value: 'FAILED', label: '牵线失败' }
]
const openMatchStatusSheet = (row: any) => {
	if (workspaceIntroductionWorkflowVersion.value != 2) { showToast('服务端牵线流程尚未升级'); return }
	if (row.status != 'IN_PROGRESS') { showToast(row.status == 'PENDING' ? '请先查看双方电话，进入牵线中后确认联系结果' : '牵线结果已确认'); return }
	if (!row.fromPhoneViewed || !row.toPhoneViewed) { showToast('请先在本条记录中查看双方电话'); return }
	matchContactConfirmed.value = false
	matchStatusRow.value = row
	matchStatusChoice.value = 'SUCCEEDED'
	matchFailureReason.value = ''
	matchStatusSheetVisible.value = true
}
const submitMatchStatus = async () => {
	const row = matchStatusRow.value
	if (row == null || matchStatusSubmitting.value) return
	if (!matchContactConfirmed.value) { showToast('请先确认已联系双方并了解被牵线方态度'); return }
	if (matchStatusChoice.value == 'FAILED' && matchFailureReason.value.trim().length == 0) {
		showToast('牵线失败需要填写失败原因')
		return
	}
	matchStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerIntroductionStatus(String(row.id), matchStatusChoice.value, matchStatusChoice.value == 'FAILED' ? matchFailureReason.value : '', matchContactConfirmed.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			if (Number(result.code) == 409) { matchStatusSheetVisible.value = false; await loadWorkspaceMatches(); await reloadManagementCenterSnapshot() }
			return
		}
		matchStatusSheetVisible.value = false
		showToast('牵线状态已更新')
		await loadWorkspaceMatches()
		await reloadManagementCenterSnapshot()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		matchStatusSubmitting.value = false
	}
}


const requireMeetingWorkflow = (): boolean => {
	if (workspaceMeetingWorkflowVersion.value == 2) return true
	showToast('服务端约会流程尚未升级，请先部署新版后端')
	return false
}
const meetingCreateApplicantId = ref('')
const meetingCreateApplicantName = ref('')
const meetingCreateTargetId = ref('')
const meetingCreateTargetName = ref('')
const meetingCreateContacted = ref(false)
const meetingCreateApplicantAgreed = ref(false)
const meetingCreateTargetAgreed = ref(false)
const openMeetingCreateSheet = () => {
	if (!requireMeetingWorkflow()) return
	meetingScheduleRow.value = null
	meetingCreateApplicantId.value = ''
	meetingCreateApplicantName.value = ''
	meetingCreateTargetId.value = ''
	meetingCreateTargetName.value = ''
	meetingCreateContacted.value = false
	meetingCreateApplicantAgreed.value = false
	meetingCreateTargetAgreed.value = false
	meetingScheduleDate.value = ''
	meetingScheduleTime.value = ''
	meetingScheduleLocation.value = ''
	meetingScheduleError.value = ''
	const now = new Date()
	meetingScheduleMinDate.value = String(now.getFullYear()) + '-' + padMeetingNumber(now.getMonth() + 1) + '-' + padMeetingNumber(now.getDate())
	matchAddCandidates.value = []
	meetingScheduleSheetVisible.value = true
}
const openMeetingMemberPicker = async (kind: string) => {
	matchAddContext.value = 'meeting'
	await ensureSelfMatchmakerUserId()
	await openMatchAddPicker(kind)
}

// ===== 约会申请：确认意愿 / 删除确认 =====
const meetingStatusSheetVisible = ref(false)
const meetingStatusRow = ref<any>(null)
const meetingStatusChoice = ref('ACCEPTED')
const meetingStatusSubmitting = ref(false)
const meetingContactsConfirmed = ref(false)
const meetingApplicantAgreed = ref(false)
const meetingTargetAgreed = ref(false)
const meetingStatusReason = ref('')
const meetingDeleteSheetVisible = ref(false)
const meetingDeleteRow = ref<any>(null)
const meetingDeleteSubmitting = ref(false)
// 已处理选项映射服务端状态；待处理回 SUBMITTED 用于误操作还原。
const openMeetingStatusSheet = (row: any) => {
	if (!requireMeetingWorkflow()) return
	meetingContactsConfirmed.value = false
	meetingApplicantAgreed.value = false
	meetingTargetAgreed.value = false
	meetingStatusReason.value = ''
	meetingStatusRow.value = row
	meetingStatusChoice.value = 'ACCEPTED'
	meetingStatusSheetVisible.value = true
}
const submitMeetingStatus = async () => {
	const row = meetingStatusRow.value
	if (row == null || meetingStatusSubmitting.value || !requireMeetingWorkflow()) return
	if (meetingStatusChoice.value == 'ACCEPTED' && !(meetingContactsConfirmed.value && meetingApplicantAgreed.value && meetingTargetAgreed.value)) { showToast('请先联系双方并确认双方均同意'); return }
	if (meetingStatusChoice.value == 'DECLINED' && meetingStatusReason.value.trim().length == 0) { showToast('请填写约会失败原因'); return }
	meetingStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerMeetingStatus(String(row.id), meetingStatusChoice.value, { contacts_confirmed: meetingContactsConfirmed.value, applicant_agreed: meetingApplicantAgreed.value, target_agreed: meetingTargetAgreed.value, reason: meetingStatusReason.value.trim() })
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		meetingStatusSheetVisible.value = false
		showToast('状态已更新')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingStatusSubmitting.value = false
	}
}
const openMeetingDeleteSheet = (row: any) => {
	meetingDeleteRow.value = row
	meetingDeleteSheetVisible.value = true
}
const submitMeetingDelete = async () => {
	const row = meetingDeleteRow.value
	if (row == null || meetingDeleteSubmitting.value) return
	meetingDeleteSubmitting.value = true
	try {
		const result = await deleteMatchmakerMeetingRequest(String(row.id))
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '删除失败')
			return
		}
		meetingDeleteSheetVisible.value = false
		showToast('记录已删除')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingDeleteSubmitting.value = false
	}
}

// ===== 约见安排：排期弹层 / 安排状态弹层 =====
const meetingScheduleSheetVisible = ref(false)
const meetingScheduleRow = ref<any>(null)
const meetingScheduleDate = ref('')
const meetingScheduleTime = ref('')
const meetingScheduleLocation = ref('')
const meetingScheduleSubmitting = ref(false)
const meetingScheduleError = ref('')
const meetingScheduleMinDate = ref('')
const meetingRecordSheetVisible = ref(false)
const meetingRecordRow = ref<any>(null)
const meetingRecordChoice = ref('REMINDED')
const meetingRecordReason = ref('')
const meetingRecordSubmitting = ref(false)
const meetingRecordFollowUp = ref('')

const padMeetingNumber = (value: number): string => String(value).padStart(2, '0')

const openMeetingScheduleSheet = (row: any) => {
	if (!requireMeetingWorkflow()) return
	const now = new Date()
	meetingScheduleMinDate.value = String(now.getFullYear()) + '-' + padMeetingNumber(now.getMonth() + 1) + '-' + padMeetingNumber(now.getDate())
	meetingScheduleRow.value = row
	meetingScheduleDate.value = ''
	meetingScheduleTime.value = ''
	meetingScheduleLocation.value = ''
	meetingScheduleError.value = ''
	meetingScheduleSheetVisible.value = true
}
const onMeetingScheduleDate = (event: any) => { meetingScheduleDate.value = event.detail.value }
const onMeetingScheduleTime = (event: any) => { meetingScheduleTime.value = event.detail.value }
const submitMeetingSchedule = async () => {
	const row = meetingScheduleRow.value
	if (meetingScheduleSubmitting.value || !requireMeetingWorkflow()) return
	if (row == null && (meetingCreateApplicantId.value == '' || meetingCreateTargetId.value == '')) { meetingScheduleError.value = '请选择双方会员'; return }
	if (row == null && !(meetingCreateContacted.value && meetingCreateApplicantAgreed.value && meetingCreateTargetAgreed.value)) { meetingScheduleError.value = '请先联系双方并确认双方均同意约会'; return }
	if (meetingScheduleDate.value == '' || meetingScheduleTime.value == '') {
		meetingScheduleError.value = '请选择约会日期和时间'
		return
	}
	if (meetingScheduleLocation.value.trim().length == 0) {
		meetingScheduleError.value = '请填写约会地点'
		return
	}
	meetingScheduleSubmitting.value = true
	meetingScheduleError.value = ''
	try {
		const scheduledAt = meetingScheduleDate.value + 'T' + meetingScheduleTime.value + ':00+08:00'
		const result = row == null ? await createMatchmakerMeeting({ applicant_user_id: Number(meetingCreateApplicantId.value), target_user_id: Number(meetingCreateTargetId.value), scheduled_at: scheduledAt, location: meetingScheduleLocation.value.trim(), contacts_confirmed: meetingCreateContacted.value, applicant_agreed: meetingCreateApplicantAgreed.value, target_agreed: meetingCreateTargetAgreed.value }) : await scheduleMatchmakerMeeting(String(row.id), scheduledAt, meetingScheduleLocation.value)
		if (!result.success) {
			meetingScheduleError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '约见安排失败'
			return
		}
		meetingScheduleSheetVisible.value = false
		showToast('约见已安排')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingScheduleSubmitting.value = false
	}
}
const openMeetingRecordSheet = (row: any) => {
	if (!requireMeetingWorkflow()) return
	meetingRecordFollowUp.value = ''
	const meeting = row != null && row.meeting != null ? row.meeting : null
	const currentStatus = meeting != null && meeting.status != null ? String(meeting.status) : 'SCHEDULED'
	meetingRecordRow.value = row
	meetingRecordChoice.value = 'COMPLETED'
	meetingRecordReason.value = ''
	meetingRecordSheetVisible.value = true
}
const submitMeetingRecordStatus = async () => {
	const row = meetingRecordRow.value
	if (row == null || meetingRecordSubmitting.value || !requireMeetingWorkflow()) return
	if (meetingRecordChoice.value == 'COMPLETED' && meetingRecordFollowUp.value.trim().length == 0) { showToast('完成约会前请填写跟进记录'); return }
	if (row.meeting == null) {
		showToast('该申请还没有约见安排')
		return
	}
	if ((meetingRecordChoice.value == 'CANCELLED' || meetingRecordChoice.value == 'NO_SHOW') && meetingRecordReason.value.trim().length == 0) {
		showToast(meetingRecordChoice.value == 'CANCELLED' ? '取消约见需要填写原因' : '爽约需要填写说明')
		return
	}
	meetingRecordSubmitting.value = true
	try {
		const result = await updateMatchmakerMeetingRecordStatus(String(row.meeting.id), meetingRecordChoice.value, meetingRecordReason.value, meetingRecordFollowUp.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		meetingRecordSheetVisible.value = false
		showToast('约见状态已更新')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingRecordSubmitting.value = false
	}
}
const workspaceScrollTop = ref(0)
const scrollWorkspaceTop = () => {
	// scroll-top 仅在值变化时触发滚动；0 与 0.1 交替保证重复点击同样回到顶部。
	workspaceScrollTop.value = workspaceScrollTop.value == 0 ? 0.1 : 0
}

const openWorkspace = async (title: string, kind: string, initialTab: string = '') => {
	workspaceTitle.value = title
	workspaceKind.value = kind
	workspaceActiveTab.value = initialTab.length > 0 ? initialTab : (kind == 'commission' ? (title == '财务明细' ? '财务明细' : '分成明细') : (kind == 'lead' ? '客源线索' : (kind == 'news' ? '喜讯' : '全部')))
	workspaceKeyword.value = ''
	workspaceVisible.value = true
	if (kind == 'entry') {
		// 录入客源线索 / 录入会员：重置线索表单，避免残留上一次填写。
		// 录入页只建新客源，必须同时清掉编辑弹层留下的编辑态，否则提交会改成 PATCH 上一条线索。
		leadFormIsEdit.value = false
		leadFormLeadId.value = ''
		leadFormRealName.value = ''
		leadFormName.value = ''
		leadFormPhone.value = ''
		leadFormWechat.value = ''
		leadFormSource.value = ''
		leadFormSourcePickerVisible.value = false
		leadFormRemark.value = ''
		leadFormIntention.value = 1
		leadFormPhoto.value = ''
		leadFormGender.value = 0
		leadFormBirthday.value = ''
		leadFormError.value = ''
		resetLeadAutoName()
	}
	if (kind == 'member') await loadWorkspaceMembers()
	if (kind == 'lead') await loadWorkspaceLeads()
	if (kind == 'match') await loadWorkspaceMatches()
	if (kind == 'meeting') await loadWorkspaceMeetings()
	// 「线上分成」与「财务明细」各读服务端；「专属推广工具」没有对应数据源，仍是演示数据。
	if (kind == 'commission' && title == '我的分成') await loadWorkspaceCommissionEntries()
	if (kind == 'commission' && title == '财务明细') await loadWorkspaceOfflineIncome()
	if (kind == 'news') workspaceTitle.value = '红娘喜讯'
}

const refreshManagementCenter = async () => {
	await loadManagementAccess()
	if (!canEnterManagementCenter.value) {
		exitManagementCenter()
		showToast('当前开通状态已变化，已返回申请页')
		return
	}
	try {
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			applyPendingReviewCount('--')
			await Promise.all([refreshBusinessMetricCounts(), refreshServedMemberCount(), refreshPendingReviewCount()])
			showToast('工作台已刷新')
		} else {
			showToast(result.message != null ? String(result.message) : '工作台刷新失败')
		}
	} catch (e) {
		showToast('工作台刷新失败，请检查网络后重试')
	}
}

const handleManagementCenterAction = (name: string) => {
	// 数据看板：四项直达——我的会员进资料待审「我的」，牵线成功进牵线列表「成功」，两条金额进对应明细
	if (name == 'metric:my_members') {
		openPendingReview('mine')
		return
	}
	if (name == 'metric:online_commission') {
		openWorkspace('我的分成', 'commission')
		return
	}
	if (name == 'metric:offline_performance') {
		openWorkspace('财务明细', 'income-placeholder')
		return
	}
	if (name == 'metric:pending_introduction') {
		openWorkspace('待我牵线', 'match', '待牵线')
		return
	}
	if (name == 'metric:introduction_succeeded') {
		openWorkspace('牵线成功', 'match', '成功')
		return
	}
	if (name == 'metric:meeting_requests') {
		openWorkspace('约会管理', 'meeting', '全部')
		return
	}
	if (name == 'metric:pending_meeting') {
		openWorkspace('约会管理', 'meeting', '待见面')
		return
	}
	if (name == '资料待审') {
		openPendingReview('PENDING')
		return
	}
	if (name == '查看全部会员') {
		openPendingReview('')
		return
	}
	if (name == '查看我服务的' || name == '我服务的') {
		openPendingReview('mine')
		return
	}
	if (name == '分成明细' || name == '查看分成明细' || name == '财务明细' || name == '查看财务明细') {
		name.indexOf('财务') >= 0 ? openWorkspace('财务明细', 'income-placeholder') : openWorkspace('我的分成', 'commission')
		return
	}
	if (name == '录入线索' || name == '录入会员') {
		openWorkspace(name == '录入线索' ? '录入客源线索' : '录入会员', 'entry')
		return
	}
	if (name.indexOf('客源') >= 0) {
		openWorkspace('客源线索', 'lead')
		return
	}
	if (name.indexOf('约见') >= 0 || name.indexOf('约会') >= 0 || name == '安排约见') {
		openWorkspace('约会管理', 'meeting', '全部')
		return
	}
	if (name.indexOf('牵线') >= 0 || name == '添加牵线') {
		openWorkspace(name == '查看牵线记录' ? '牵线管理' : name, 'match')
		return
	}
	if (name.indexOf('海报') >= 0) {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/promoter-center?page=poster',
			fail: () => showToast('推广海报打开失败，请稍后重试')
		})
		return
	}
	if (name.indexOf('链接') >= 0) {
		copyPromotionLink()
		return
	}
	if (name.indexOf('活动') >= 0) {
		openWorkspace(name, 'activity')
		return
	}
	if (name.indexOf('会员') >= 0 || name.indexOf('我服务的') >= 0) {
		openWorkspace(name.replace('查看', ''), 'member')
		return
	}
	if (name.indexOf('账号') >= 0) {
		openMyAccount()
		return
	}
	openWorkspace(name.replace('查看', ''), 'general')
}

const openMatchmakerIdentity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/certification',
		fail: () => showToast('个人身份信息打开失败，请稍后重试')
	})
}

// 服务导航下拉菜单：组件只回报选项，跳转按红娘中心角色决定。
const serviceNavVisible = ref(false)
const openPage = (url: string) => {
	uni.navigateTo({ url: url, fail: () => showToast('页面打开失败，请稍后重试') })
}
// 「我的账号」：红娘管理中心子页面——会员端「我的」页的精简版，共用账号数据但页面独立。
const openMyAccount = () => {
	uni.navigateTo({
		url: '/pagesSub/matchmaker/my-account',
		fail: () => showToast('我的账号打开失败，请稍后重试')
	})
}
const onServiceNavSelect = (key: string) => {
	serviceNavVisible.value = false
	if (key == 'member_zone') { uni.reLaunch({ url: '/pages/index/index?tab=2', fail: () => showToast('会员分区打开失败，请稍后重试') }); return }
	if (key == 'filter') { openPendingReview(''); return }
	if (key == 'activity') { openPage('/pagesSub/community/activity-list'); return }
	if (key == 'news') { openWorkspace('红娘喜讯', 'news'); return }
	if (key == 'custom') { openPage('/pagesSub/matchmaker/custom'); return }
	if (key == 'vip') { openPage('/pagesSub/profileExtra/vip'); return }
	if (key == 'matchmaker_center') { showToast('当前已在红娘中心'); return }
	if (key == 'about') { openPage('/pagesSub/about/about'); return }
	// 「我的账号」「短视频」入口已从红娘中心的服务导航隐藏（服务导航不再展示这两项），
	// 故此处不再处理 member_center / video；账号页由管理中心顶栏入口进入。
	if (key == 'intro_outgoing' || key == 'intro_incoming') { openWorkspace('牵线管理', 'match'); return }
	if (key == 'meeting') { openWorkspace('约会管理', 'meeting', '全部'); return }
}

onShareAppMessage(() => {
	const row = goodNewsShare.value
	if (row != null && row.kind == 'news' && row.pendingReview !== true && row.public !== false) {
		return { title: row.stage + ' · 记录美好进展', path: '/pagesSub/matchmaker/become-matchmaker?workspace=news&newsId=' + encodeURIComponent(String(row.id)), imageUrl: row.images.length > 0 ? row.images[0] : '' }
	}
	return { title: '红娘喜讯 · 记录每一步美好进展', path: '/pagesSub/matchmaker/become-matchmaker?workspace=news' }
})

onLoad((options: any) => {
	goodNewsInitialItem.value = options != null && options.newsId != null ? String(options.newsId) : ''
	goodNewsInitialKind.value = options != null && options.newsKind == 'pennant' ? 'pennant' : 'news'
	// 会员主页「编辑资料」入口：进入页面后自动打开资料待审列表
	autoOpenPendingReview.value = options != null && (options.openPendingReview == '1' || options.openPendingReview == 1 || options.openPendingReview === true)
	// 直达工作区：?workspace=meeting（约见申请）/ ?workspace=match（待我牵线）
	autoOpenWorkspace.value = options != null && options.workspace != null ? String(options.workspace) : ''
})

onShow(async () => {
	if (managementCenterVisible.value) {
		refreshPendingReviewCount()
		startPendingReviewCountTimer()
	}
	if (pendingReviewVisible.value) pendingReviewRefreshToken.value += 1
	if (autoOpenPendingReview.value) {
		autoOpenPendingReview.value = false
		await loadManagementAccess()
		await openManagementCenter()
		if (managementCenterVisible.value) openPendingReview('PENDING')
		return
	}
	if (autoOpenWorkspace.value.length > 0) {
		const kind = autoOpenWorkspace.value
		autoOpenWorkspace.value = ''
		await loadManagementAccess()
		await openManagementCenter()
		if (managementCenterVisible.value) {
			if (kind == 'meeting') openWorkspace('约会管理', 'meeting', '全部')
			else if (kind == 'match') openWorkspace('待我牵线', 'match', '待牵线')
			else if (kind == 'news') openWorkspace('红娘喜讯', 'news')
		}
		return
	}
	if (!managementCenterVisible.value && !pendingReviewVisible.value && !workspaceVisible.value) loadManagementAccess()
})

onHide(() => { stopPendingReviewCountTimer(); pendingReviewCountRequest += 1 })
onUnload(() => { stopPendingReviewCountTimer(); pendingReviewCountRequest += 1 })

const guideToRequiredVerification = (message: string) => {
	const needsPhone = message.indexOf('绑定手机号') >= 0
	uni.showModal({
		title: needsPhone ? '请先绑定手机号' : '请先完成实名认证',
		content: needsPhone ? '绑定手机号后，还需要完成实名认证才可提交申请。' : '实名认证审核通过后即可提交申请。',
		confirmText: '去完成',
		success: (modal: any) => {
			if (modal.confirm) {
				uni.navigateTo({
					url: '/pagesSub/profileExtra/certification?type=' + (needsPhone ? 'phone' : 'realname') + '&returnTo=matchmaker',
					fail: () => { uni.showToast({ title: '认证页打开失败，请稍后重试', icon: 'none' }) }
				})
			}
		}
	})
}

const showExistingApplication = () => {
	uni.showModal({
		title: '申请正在审核',
		content: '你已提交服务红娘申请，请等待平台审核结果，无需重复提交。',
		confirmText: '查看状态',
		success: (modal: any) => {
			if (modal.confirm) uni.redirectTo({ url: '/pagesSub/matchmaker/application-success?type=service_matchmaker' })
		}
	})
}

// ===== 导航 =====
const goBack = () => {
	uni.navigateBack()
}

const handlePageBack = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	if (workspaceVisible.value) {
		closeWorkspace()
		return
	}
	goBack()
}

const showHelp = () => {
	uni.showModal({
		title: '申请说明',
		content: '成为平台红娘需要经过实名认证、资料审核和培训流程。审核通常在 1-3 个工作日内完成，审核结果将通过短信通知你。如有问题，请联系客服。',
		showCancel: false,
		confirmText: '知道了'
	})
}

const callConsult = () => {
	uni.showModal({
		title: '电话咨询',
		content: '咨询热线：400-XXX-XXXX（工作时间：周一至周五 9:00-18:00）',
		showCancel: false,
		confirmText: '知道了'
	})
}

const wechatConsult = () => {
	qrVisible.value = true
}

// ===== 表单输入 =====
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onWechatInput = (e: any) => { wechat.value = e.detail.value }
const onIntroductionInput = (e: any) => { introduction.value = e.detail.value }
const onPriceInput = (e: any) => { price.value = e.detail.value }

const isValidOptionalPrice = (): boolean => {
	const value = price.value.trim()
	if (value.length == 0) return true
	const amount = Number(value)
	return !isNaN(amount) && amount >= 0 && amount <= 1000000
}

// ===== 头像上传 =====
const uploadAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				avatar.value = res.tempFilePaths[0]
				showToast('头像已上传')
			}
		}
	})
}

// ===== 擅长领域 =====
const toggleSpecialty = (item: string) => {
	const idx = specialties.value.indexOf(item)
	if (idx >= 0) {
		specialties.value.splice(idx, 1)
	} else {
		if (specialties.value.length >= 5) {
			showToast('最多选择 5 个擅长领域')
			return
		}
		specialties.value.push(item)
	}
}

// ===== 成功案例 =====
const addCase = () => {
	if (successCases.value.length >= 3) return
	successCases.value.push({ description: '', images: [] })
}

const removeCase = (index: number) => {
	successCases.value.splice(index, 1)
}

const onCaseDescriptionInput = (index: number, e: any) => {
	if (index >= 0 && index < successCases.value.length) {
		successCases.value[index].description = e.detail.value
	}
}

const uploadCaseImage = (index: number) => {
	uni.chooseImage({
		count: 3 - successCases.value[index].images.length,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				const imgs = res.tempFilePaths as string[]
				for (let i = 0; i < imgs.length; i++) {
					successCases.value[index].images.push(imgs[i])
				}
			}
		}
	})
}

const removeCaseImage = (caseIndex: number, imgIndex: number) => {
	if (caseIndex >= 0 && caseIndex < successCases.value.length) {
		successCases.value[caseIndex].images.splice(imgIndex, 1)
	}
}

// ===== 提交申请 =====
const submitApplication = async () => {
	if (submitting.value) return
	if (getAccessToken() == '') {
		showToast('登录状态已失效，请重新登录')
		uni.navigateTo({ url: '/pages/auth/login' })
		return
	}

	// 基本信息校验
	if (realName.value.trim().length < 2 || realName.value.trim().length > 64) {
		showToast('真实姓名需为 2-64 个字符')
		return
	}
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		showToast('请填写正确的 11 位手机号')
		return
	}
	if (wechat.value.trim().length === 0 || wechat.value.trim().length > 128) {
		showToast('微信号需为 1-128 个字符')
		return
	}

	// 红娘资料校验
	if (avatar.value.length === 0 || avatar.value.length > 512) {
		showToast('请上传有效头像')
		return
	}
	if (introduction.value.trim().length < 10 || introduction.value.trim().length > 2000) {
		showToast('个人简介需为 10-2000 个字符')
		return
	}
	if (specialties.value.length === 0) {
		showToast('请至少选择一个擅长领域')
		return
	}
	if (!isValidOptionalPrice()) {
		showToast('服务价格需为 0-1000000 的数字')
		return
	}
	for (let index = 0; index < successCases.value.length; index++) {
		const description = successCases.value[index].description.trim()
		if (description.length > 50) {
			showToast('成功案例说明最多 50 个字符')
			return
		}
	}

	try {
		submitting.value = true

		const formData = {
			realName: realName.value.trim(),
			phone: phone.value.trim(),
			wechat: wechat.value.trim(),
			avatar: avatar.value,
			introduction: introduction.value.trim(),
			specialties: specialties.value,
			price: price.value.trim().length > 0 ? Number(price.value.trim()) : undefined,
			cases: successCases.value
				.filter((c: CaseItem) => c.description.trim().length > 0)
				.map((c: CaseItem) => ({
					description: c.description.trim(),
					images: c.images
				}))
		}

		const result = await submitMatchmakerApplication(formData)

		if (result.success) {
			const applicationId = result.data != null && result.data.id != null ? String(result.data.id) : ''
			uni.redirectTo({
				url: '/pagesSub/matchmaker/application-success?type=service_matchmaker&id=' + applicationId
			})
		} else {
			const message = result.message != null ? String(result.message) : '提交失败，请稍后重试'
			if (result.code == 403 && (message.indexOf('绑定手机号') >= 0 || message.indexOf('实名认证') >= 0)) {
				guideToRequiredVerification(message)
			} else if (result.code == 409) {
				showExistingApplication()
			} else {
				showToast(message)
			}
		}
	} catch (e) {
		showToast('提交失败，请稍后重试')
	} finally {
		submitting.value = false
	}
}
</script>

<style scoped>
.become-page {
	min-height: 100vh;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* ===== 导航栏 ===== */
/* 操作行（返回/帮助/快捷入口）统一下移到胶囊带以下（胶囊底约 statusBar+72rpx），避免与胶囊及标题互相遮挡。 */
.nav-bar {
	position: relative;
	height: calc(156rpx + var(--status-bar-height));
	padding: var(--status-bar-height) 12rpx 0;
	box-sizing: border-box;
	background: var(--paper);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-bottom: 1px solid var(--line);
	flex-shrink: 0;
}

.nav-back {
	position: absolute;
	left: 12rpx;
	top: calc(var(--status-bar-height) + 84rpx);
	width: 64rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: flex-start;
}

.nav-back-chevron {
	width: 26rpx;
	height: 26rpx;
	margin-left: 12rpx;
	border-left: 5rpx solid var(--ink);
	border-bottom: 5rpx solid var(--ink);
	transform: rotate(45deg);
}

.nav-title {
	position: absolute;
	left: 120rpx;
	right: 120rpx;
	top: calc(var(--status-bar-height) + 22rpx);
	display: block;
	min-width: 0;
	line-height: 1.3;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	font-size: 34rpx;
	font-family: var(--sans);
	font-weight: 700;
	color: var(--ink);
}

.nav-help {
	position: absolute;
	right: 20rpx;
	top: calc(var(--status-bar-height) + 84rpx);
	height: 44rpx;
	padding: 0 14rpx;
	border-radius: 999rpx;
	border: 1px solid var(--line);
	display: flex;
	align-items: center;
}

.nav-help-text {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 右上角快捷入口：圆形底按钮，容器 top 为 76rpx，使圆心落在 statusBar+112rpx 与返回键 chevron 圆心对齐（该行已避开胶囊带） ===== */
.nav-entries { position: absolute; right: 20rpx; top: calc(var(--status-bar-height) + 76rpx); height: 72rpx; display: flex; flex-direction: row; align-items: center; gap: 18rpx; }
.nav-entry { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--warm); border: 1px solid var(--line); box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-entry:active { opacity: .8; transform: scale(.94); }
.entry-person { position: relative; width: 40rpx; height: 40rpx; }
.entry-person-head { position: absolute; left: 11rpx; top: 0; width: 18rpx; height: 18rpx; border: 3rpx solid var(--ink); border-radius: 50%; box-sizing: border-box; }
.entry-person-body { position: absolute; left: 3rpx; bottom: 0; width: 34rpx; height: 16rpx; border: 3rpx solid var(--ink); border-bottom: none; border-radius: 17rpx 17rpx 0 0; box-sizing: border-box; }
.entry-person-dot { position: absolute; right: -3rpx; bottom: -3rpx; width: 15rpx; height: 15rpx; border-radius: 50%; background: var(--sage); border: 2rpx solid var(--paper); box-sizing: border-box; }
.entry-lines { width: 36rpx; display: flex; flex-direction: column; gap: 7rpx; }
.entry-lines view { height: 4rpx; border-radius: 2rpx; background: var(--ink); }

/* ===== 滚动区域 ===== */
.workspace-scroller { flex: 1; height: 0; background: var(--canvas); }
.workspace-content { min-height: 100%; padding: 20rpx 22rpx 130rpx; background: var(--canvas); }
/* 客源线索右下角是成对悬浮键（224rpx 高），底部留白要比其他工作台更足，避免最后一张卡的操作行被压住。 */
.workspace-content.lead-space { padding-bottom: 250rpx; }
.workspace-heading { padding: 8rpx 4rpx 18rpx; display: flex; flex-direction: column; gap: 5rpx; }
.workspace-title { font-size: 32rpx; font-weight: 800; color: var(--ink); }.workspace-copy,.workspace-muted { font-size: 20rpx; color: var(--muted); }
/* 页签：1:1 照搬资料待审的 .pr-tabs（浅灰胶囊托盘 + 选中深青实心反白，无下划线） */
.workspace-tabs { flex-shrink: 0; padding: 4rpx 0 0; display: flex; flex-direction: row; justify-content: center; }.workspace-tabs-row { display: flex; flex-direction: row; width: 100%; padding: 8rpx; border-radius: 999rpx; background: var(--warm); }.workspace-tab { flex: 1; height: 62rpx; padding: 0 10rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; }.workspace-tab text { color: var(--muted); font-size: 24rpx; font-weight: 700; }.workspace-tab.active { background: var(--accent2); }.workspace-tab.active text { color: var(--paper); }.workspace-tab:active { opacity: .82; }
.workspace-search { height: 78rpx; margin: 18rpx 0; padding: 0 26rpx; border-radius: 999rpx; background: var(--warm); display: flex; flex-direction: row; align-items: center; gap: 14rpx; }.workspace-search-input { flex: 1; min-width: 0; font-size: 25rpx; color: var(--ink); }.workspace-search-ph { color: var(--muted); font-size: 25rpx; }.workspace-search-glyph { font-size: 32rpx; line-height: 1; color: var(--muted); flex-shrink: 0; }
.workspace-cash { min-height: 254rpx; padding: 30rpx; position: relative; border-radius: 20rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 12rpx; color: var(--ink2); font-size: 23rpx; }.workspace-cash-value { font-size: 56rpx; color: var(--ink); font-weight: 800; }.workspace-cash > view { position: absolute; top: 40rpx; right: 26rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.workspace-notice,.workspace-promotion { margin-top: 20rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 10rpx; color: var(--ink2); font-size: 21rpx; line-height: 1.55; box-shadow: var(--shadow-sm); }.workspace-notice-title { font-size: 25rpx; color: var(--ink); font-weight: 800; }.workspace-promotion { background: var(--sage-soft); color: var(--accent2); font-weight: 800; }.workspace-promotion > view { display: flex; gap: 12rpx; }.workspace-promotion > view text { flex: 1; padding: 12rpx 8rpx; border-radius: 999rpx; background: var(--surface); text-align: center; font-size: 19rpx; }
.workspace-commission-row { margin-top: 18rpx; color: var(--muted); font-size: 20rpx; }.workspace-commission-row > view { margin-top: 8rpx; padding: 20rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-commission-row image,.workspace-member-header image { width: 60rpx; height: 60rpx; border-radius: 50%; }.workspace-commission-row > view > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; color: var(--ink); font-size: 21rpx; }.workspace-commission-row > view > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-commission-row > view > text:last-child { color: var(--accent2); font-size: 27rpx; font-weight: 800; }
.workspace-commission-row > view > .workspace-commission-avatar { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--warm); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 800; }
.workspace-info-card,.workspace-match-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) { padding-bottom: 13rpx; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--ink2); font-size: 21rpx; font-weight: 400; }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) text:last-child { color: var(--ink); }.workspace-actions { display: flex; gap: 9rpx; }.workspace-actions text { flex: 1; padding: 12rpx 4rpx; border-radius: 14rpx; background: var(--warm); color: var(--accent2); text-align: center; font-size: 18rpx; font-weight: 700; }
.workspace-state { margin-top: 18rpx; min-height: 180rpx; padding: 28rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; color: var(--muted); font-size: 22rpx; box-shadow: var(--shadow-sm); }.workspace-state-action { padding: 12rpx 24rpx; border-radius: 999rpx; background: var(--sage-soft); color: var(--accent2); font-size: 21rpx; font-weight: 700; }
.workspace-filter-note { padding: 12rpx; color: var(--accent2); font-size: 22rpx; line-height: 1.5; }.workspace-demo-notice { margin: 4rpx 12rpx 12rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: var(--accent-bg); color: var(--accent2); font-size: 19rpx; line-height: 1.45; }
/* 分成标准 / 牵线卡片：比例数值与牵线状态 */
.workspace-rate-value { color: var(--accent2); font-size: 30rpx; font-weight: 800; }.workspace-match-card { font-size: 21rpx; font-weight: 400; }.workspace-match-card-top { display: flex; justify-content: space-between; align-items: center; color: var(--muted); }.workspace-match-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-match-status-pending { background: var(--accent-bg); color: var(--accent2); }.workspace-match-status-progress { background: var(--match-sky); color: var(--match-deep); }.workspace-match-status-succeeded { background: var(--sage-soft); color: var(--sage); }.workspace-match-status-failed { background: var(--match-blush); color: var(--match-coral); }.workspace-match-reason { padding: 14rpx; border-radius: 14rpx; background: var(--match-blush); color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-match-owner { color: var(--muted); font-size: 19rpx; }

/* 牵线管理（按设计稿）：申请时间+黄色状态胶囊、双人放大头像+心形徽标、图下联系方式行、牵线状态弹窗。 */
.workspace-match-card { gap: 20rpx; padding: 26rpx 26rpx; }
.workspace-match-card .workspace-match-card-top { margin-bottom: 2rpx; }
.workspace-match-status-btn { height: 60rpx; padding: 0 22rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10rpx; }
.workspace-match-status-btn text { color: var(--paper); font-size: 22rpx; font-weight: 800; }
.workspace-match-status-btn.t-PENDING { background: var(--review-orange); }
.workspace-match-status-btn.t-IN_PROGRESS { background: var(--accent2); }
.workspace-match-status-btn.t-SUCCEEDED { background: var(--sage); }
.workspace-match-status-btn.t-FAILED { background: var(--match-coral); }
.workspace-match-status-arrow { width: 28rpx; height: 28rpx; border-radius: 50%; background: rgba(255, 255, 255, .3); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-arrow i { width: 10rpx; height: 10rpx; border-top: 3rpx solid var(--paper); border-right: 3rpx solid var(--paper); transform: rotate(45deg); margin-left: -3rpx; }
.workspace-match-status-btn.match-status-indicator { background: var(--sage-soft); }
.workspace-match-status-btn.match-status-indicator text { color: var(--accent2); }
.match-status-indicator.t-PENDING .workspace-match-status-arrow { background: var(--plane-yellow); }
.match-status-indicator.t-IN_PROGRESS .workspace-match-status-arrow { background: var(--paper); }
.match-status-indicator.t-SUCCEEDED .workspace-match-status-arrow { background: var(--accent2); }
.match-status-indicator.t-FAILED .workspace-match-status-arrow { background: var(--match-coral); }
.workspace-match-status-btn:active { opacity: .8; transform: scale(.97); }
/* 双人放大头像：两张圆角方图并排，中间压一枚心形徽标；图下各带角色标 + 姓名 + 编号，点图以红娘权限进该会员主页。 */
.meeting-invitation { padding: 24rpx 8rpx 12rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.meeting-invitation-portraits { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.meeting-invitation-portrait { width: 232rpx; height: 232rpx; border-radius: 50%; border: 6rpx solid var(--surface); box-sizing: border-box; overflow: hidden; background: var(--warm); box-shadow: var(--shadow-sm); }
.meeting-invitation-target { margin-left: -44rpx; position: relative; z-index: 1; }
.meeting-invitation-portrait:active { opacity: 0.85; }
.meeting-invitation-image { width: 100%; height: 100%; border-radius: 50%; }
.meeting-invitation-title { max-width: 100%; color: var(--ink2); font-size: 28rpx; line-height: 1.6; text-align: center; word-break: break-all; }
.meeting-invitation-name { color: var(--accent2); font-weight: 800; }
.meeting-invitation-members { width: 100%; display: flex; flex-direction: row; align-items: flex-start; justify-content: center; }
.meeting-invitation-member { width: 50%; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.workspace-match-pair { position: relative; padding: 44rpx 0 0; display: flex; flex-direction: row; align-items: flex-start; }
.workspace-match-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
/* 两列相向平移 20rpx + 照片各转 4°，让两张图在接缝处部分叠住（右图压左图）；姓名与编号不跟着倾斜。 */
.workspace-match-col.is-left { transform: translateX(20rpx); }
.workspace-match-col.is-right { transform: translateX(-20rpx); }
.workspace-match-photo { position: relative; width: 300rpx; height: 300rpx; }
.workspace-match-photo:active { opacity: .85; }
.workspace-match-photo-image { width: 300rpx; height: 300rpx; box-sizing: border-box; border: 8rpx solid var(--clasp-indigo); border-radius: 68rpx; background: var(--warm); box-shadow: var(--match-shadow); }
.is-left .workspace-match-photo { transform: rotate(-4deg); }
.is-right .workspace-match-photo { transform: rotate(4deg); }
/* 照片描边与交握的心同色：左靛蓝、右亮青；border-box 让 8rpx 边框吃在 300rpx 外框内，不会挤到接缝。 */
.is-right .workspace-match-photo-image { border-color: var(--clasp-teal); }
/* 交握的心：设计图原色（靛蓝 #3B3CA9 / 亮青 #00E0C2）抠成透明底的资源，按 1.344 宽高比取 180×134rpx，垂直居中在照片带上。 */
.workspace-match-heart { position: absolute; left: 50%; top: 127rpx; transform: translateX(-50%); z-index: 3; display: block; width: 180rpx; height: 134rpx; box-sizing: border-box; }
/* 彩带：三种形状混撒，缎带条带渐变高光和落地阴影，亮片有径向高光，卷花只留两条边的弧；压在照片之上、心形之下。 */
.workspace-match-confetti { position: absolute; z-index: 2; box-sizing: border-box; }
/* 缎带条：一端收尖的不对称圆角 + 上亮下暗渐变 + 落地小阴影，转角度后才有撒下去的纸带感 */
.workspace-match-confetti.strip { height: 8rpx; border-radius: 8rpx 8rpx 8rpx 2rpx; background-image: linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,0) 62%, rgba(0,0,0,.14)); box-shadow: 0 2rpx 3rpx rgba(27,91,86,.18); }
/* 卷花：椭圆只留两条边的弧，模拟卷起来的彩带 */
.workspace-match-confetti.curl { width: 32rpx; height: 26rpx; border: 5rpx solid transparent; border-radius: 50%; }
/* 亮片：径向高光点 + 短阴影 */
.workspace-match-confetti.dot { width: 11rpx; height: 11rpx; border-radius: 50%; background-image: radial-gradient(circle at 32% 28%, rgba(255,255,255,.8), rgba(255,255,255,0) 62%); box-shadow: 0 1rpx 2rpx rgba(27,91,86,.2); }
/* 撒点：19 枚的高度刻意散开在 4~306 之间，压进照片上沿和两侧留白，不许排成一条花边；避开姓名、编号和心形。 */
/* 配色以青瓷绿阶为主（deep→accent2→sage→accent→soft→accent-bg/sage-soft），只留 2 枚金色做暖色对比；浅色一律落在照片面上，别放白卡上。 */
.mc-1 { left: 6rpx; top: 8rpx; width: 34rpx; height: 9rpx; transform: rotate(-26deg); background-color: var(--soft); }
.mc-2 { left: 56rpx; top: 18rpx; width: 34rpx; height: 26rpx; transform: rotate(24deg); border-top-color: var(--accent); border-left-color: var(--accent); }
.mc-3 { left: 96rpx; top: 62rpx; background-color: var(--accent-bg); }
.mc-4 { left: 140rpx; top: 10rpx; width: 22rpx; height: 7rpx; transform: rotate(58deg); background-color: var(--accent2); }
.mc-5 { left: 182rpx; top: 22rpx; width: 30rpx; height: 8rpx; transform: rotate(-14deg); background-color: var(--sage); }
.mc-6 { left: 250rpx; top: 26rpx; width: 30rpx; height: 24rpx; transform: rotate(-36deg); border-top-color: var(--accent); border-left-color: var(--accent); }
.mc-7 { left: 300rpx; top: 14rpx; width: 10rpx; height: 10rpx; background-color: var(--accent); }
.mc-8 { left: 330rpx; top: 12rpx; width: 44rpx; height: 11rpx; transform: rotate(34deg); background-color: #b98a2b; }
.mc-9 { left: 410rpx; top: 44rpx; width: 24rpx; height: 7rpx; transform: rotate(-52deg); background-color: var(--match-deep); }
.mc-10 { left: 450rpx; top: 4rpx; transform: rotate(12deg); border-top-color: var(--sage); border-left-color: var(--sage); }
.mc-11 { left: 520rpx; top: 46rpx; background-color: var(--accent2); }
.mc-12 { left: 542rpx; top: 8rpx; width: 26rpx; height: 8rpx; transform: rotate(30deg); background-color: var(--accent); }
.mc-13 { left: 560rpx; top: 68rpx; width: 32rpx; height: 8rpx; transform: rotate(-20deg); background-color: var(--sage-soft); }
.mc-14 { left: 44rpx; top: 66rpx; width: 26rpx; height: 8rpx; transform: rotate(-16deg); background-color: var(--sage); }
.mc-15 { left: 60rpx; top: 330rpx; width: 8rpx; height: 8rpx; background-color: #b98a2b; }
.mc-16 { left: 544rpx; top: 222rpx; width: 30rpx; height: 24rpx; transform: rotate(-28deg); border-top-color: var(--sage-soft); border-left-color: var(--sage-soft); }
.mc-17 { left: 120rpx; top: 306rpx; width: 10rpx; height: 10rpx; background-color: var(--sage); }
.mc-18 { left: 452rpx; top: 288rpx; width: 30rpx; height: 9rpx; transform: rotate(62deg); background-color: var(--accent); }
.mc-19 { left: 606rpx; top: 92rpx; width: 9rpx; height: 9rpx; background-color: var(--accent-bg); }
.workspace-match-caption { max-width: 100%; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8rpx; }
.workspace-match-caption-name { max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 26rpx; font-weight: 800; }
.workspace-match-caption-code { color: var(--muted); font-size: 19rpx; }
/* 角色标：由头像角标改为行内胶囊，图下与联系方式行共用同一套配色。 */
.workspace-match-role { padding: 3rpx 14rpx; border-radius: 999rpx; font-size: 17rpx; font-weight: 800; white-space: nowrap; flex-shrink: 0; }
.workspace-match-role.role-applicant { background: var(--accent-bg); color: var(--accent2); }
.workspace-match-role.role-target { background: var(--match-blush); color: var(--match-coral); }
.workspace-match-gender { padding: 1rpx 10rpx; border-radius: 6rpx; font-size: 17rpx; font-weight: 800; flex-shrink: 0; }
.workspace-match-gender.male { background: var(--match-sky); color: var(--paper); }
.workspace-match-gender.female { background: var(--match-blush); color: var(--paper); }
.workspace-match-vip { padding: 1rpx 10rpx; border-radius: 6rpx; font-size: 17rpx; font-weight: 800; color: #ffffff; background: #b98a2b; flex-shrink: 0; }
/* 联系方式：默认只留入口，点开走受审计接口后就地展开；号码芯片再点一下即复制。 */
.workspace-match-contact-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; min-height: 60rpx; padding: 10rpx 0; border-top: 1rpx solid var(--line); }
.workspace-match-contact-row .workspace-match-role { width: 180rpx; height: 60rpx; padding: 0; box-sizing: border-box; text-align: center; line-height: 60rpx; font-size: 21rpx; }
.workspace-match-contact-body { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; flex-wrap: wrap; }
.workspace-match-contact-values { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; flex-wrap: wrap; }
.workspace-match-contact-chip { max-width: 250rpx; padding: 8rpx 16rpx; border-radius: 12rpx; font-size: 21rpx; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-match-contact-chip.phone { background: #FDE7EB; color: var(--match-coral); }
.workspace-match-contact-chip.wechat { background: #E9F7EF; color: var(--sage); }
.workspace-match-contact-open { width: 180rpx; height: 60rpx; padding: 0; box-sizing: border-box; text-align: center; line-height: 58rpx; border-radius: 999rpx; border: 1rpx dashed var(--accent2); color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.workspace-match-contact-open:active { opacity: .7; }
.workspace-match-contact-state { color: var(--muted); font-size: 20rpx; }
.workspace-match-contact-state.error { color: var(--match-coral); }
.workspace-match-status-form { display: flex; flex-direction: column; gap: 20rpx; }
.workspace-match-status-choices { display: flex; flex-direction: column; gap: 16rpx; }
.workspace-match-status-choice { min-height: 92rpx; border-radius: 18rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-choice text { color: var(--ink2); font-size: 27rpx; font-weight: 700; }
.workspace-match-status-choice.active { background: var(--accent-bg); border-color: var(--accent2); }
.workspace-match-status-choice.active text { color: var(--accent2); font-weight: 800; }
.workspace-match-status-choice:active { opacity: .78; }
.workspace-match-status-submit { min-height: 88rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-submit text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.workspace-match-status-submit.disabled { opacity: .55; }
.workspace-match-status-submit:active { opacity: .85; }

/* 添加牵线记录：行式表单 + 单选 + 扣次说明 + 紫色提交。 */
/* 悬浮添加键：1:1 照搬资料待审的 .fab-enter（104rpx 浅青圆 + ✎/添加 竖排 + --match-shadow）。 */
.match-float-actions { position: fixed; right: 20rpx; bottom: calc(env(safe-area-inset-bottom) + 20rpx); z-index: 75; display: flex; flex-direction: column; gap: 16rpx; }
.fab-match-add { width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--accent-bg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; box-shadow: var(--match-shadow); }
.fab-match-add text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }
.fab-match-glyph { font-size: 26rpx !important; }
.fab-match-add:active { opacity: 0.8; transform: scale(0.96); }
.workspace-match-add-form { display: flex; flex-direction: column; gap: 6rpx; }
.workspace-match-add-row { min-height: 100rpx; border-bottom: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; }
.workspace-match-add-row.last { border-bottom: none; }
.workspace-match-add-label { color: var(--ink); font-size: 27rpx; font-weight: 800; flex-shrink: 0; }
.workspace-match-add-picker { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-picker text { color: var(--ink2); font-size: 24rpx; max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-match-add-picker text.placeholder { color: var(--muted); }
.workspace-match-add-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); flex-shrink: 0; }
.workspace-match-add-result { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-result > text { color: var(--ink2); font-size: 24rpx; }
.workspace-match-add-result > text.radio-on { color: var(--ink); font-weight: 700; }
.workspace-match-add-radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 1rpx solid var(--line); background: var(--surface); display: flex; align-items: center; justify-content: center; }
.workspace-match-add-radio.active { background: var(--accent2); border-color: var(--accent2); }
.workspace-match-add-radio.active text { color: var(--paper); font-size: 20rpx; font-weight: 900; }
.workspace-match-add-note { margin: 16rpx 0 6rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: var(--match-mist); display: flex; flex-direction: row; gap: 10rpx; }
.workspace-match-add-note-mark { width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 17rpx; font-weight: 800; text-align: center; line-height: 28rpx; flex-shrink: 0; }
.workspace-match-add-note > text:last-child { flex: 1; color: var(--ink2); font-size: 20rpx; line-height: 1.6; }
.workspace-match-add-submit { margin-top: 10rpx; min-height: 92rpx; border-radius: 16rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.workspace-match-add-submit text { color: var(--paper); font-size: 28rpx; font-weight: 800; }
.workspace-match-add-submit.disabled { opacity: .55; }
.workspace-match-add-submit:active { opacity: .85; }
.workspace-meeting-overview { margin-top: 4rpx; padding: 21rpx 22rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: column; gap: 8rpx; color: var(--accent2); font-size: 20rpx; line-height: 1.45; }.workspace-meeting-overview > view { display: flex; align-items: baseline; gap: 12rpx; }.workspace-meeting-overview-value { color: var(--match-deep); font-family: var(--serif); font-size: 48rpx; line-height: 1; font-weight: 700; }.workspace-meeting-overview-label { color: var(--ink2); font-size: 22rpx; font-weight: 700; }.workspace-meeting-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--match-paper); display: flex; flex-direction: column; gap: 18rpx; box-shadow: var(--match-shadow); }.workspace-meeting-card-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 19rpx; }.workspace-meeting-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-meeting-status-submitted { background: var(--accent-bg); color: var(--accent2); }.workspace-meeting-status-processing { background: var(--match-sky); color: var(--match-deep); }.workspace-meeting-status-upcoming { background: var(--sage-soft); color: var(--sage); }.workspace-meeting-status-completed { background: var(--match-mist); color: var(--accent2); }.workspace-meeting-status-ended { background: var(--match-blush); color: var(--match-coral); }.workspace-meeting-pair { padding: 18rpx 0; border-top: 1rpx solid var(--match-line); border-bottom: 1rpx solid var(--match-line); display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person image { width: 58rpx; height: 58rpx; border-radius: 50%; flex-shrink: 0; }.workspace-meeting-person > view { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }.workspace-meeting-person > view text:first-child { color: var(--ink); font-size: 22rpx; font-weight: 800; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-person > view text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-meeting-link { width: 58rpx; height: 38rpx; border-radius: 999rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; color: var(--accent2); font-size: 17rpx; font-weight: 800; flex-shrink: 0; }.workspace-meeting-arrangement { padding: 16rpx; border-radius: 14rpx; background: var(--surface); display: flex; flex-direction: column; gap: 8rpx; }.workspace-meeting-arrangement > text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }.workspace-meeting-arrangement > view { display: flex; justify-content: space-between; gap: 14rpx; color: var(--ink2); font-size: 20rpx; }.workspace-meeting-arrangement > view text:last-child { flex: 1; min-width: 0; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-detail { color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-meeting-time { color: var(--muted); font-size: 18rpx; }

/* 约见申请（按设计稿）：浅紫须知卡 + 白卡双列大头像 + 灰盒元信息 + 实心胶囊操作 + 圆形回顶。 */
.workspace-meeting-intro { margin-top: 4rpx; padding: 30rpx 30rpx; border-radius: 24rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-meeting-intro-head { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.workspace-meeting-intro-mark { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 19rpx; font-weight: 800; text-align: center; line-height: 34rpx; }
.workspace-meeting-intro-title { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-meeting-intro-text { color: var(--ink2); font-size: 23rpx; line-height: 1.7; }
.workspace-meeting-card { margin-top: 20rpx; padding: 30rpx 26rpx 26rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 20rpx; }
.workspace-meeting-pair { display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 0; border-top: none; border-bottom: none; }
.workspace-meeting-pair .workspace-meeting-person { flex-direction: column; align-items: center; }
.workspace-meeting-person { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.workspace-meeting-avatar-wrap { position: relative; width: 110rpx; height: 110rpx; }
.workspace-meeting-avatar-wrap image { width: 110rpx; height: 110rpx; border-radius: 50%; background: var(--warm); }
.workspace-meeting-gender { position: absolute; right: -2rpx; bottom: -2rpx; width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid var(--surface); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; color: var(--paper); }
.workspace-meeting-gender.male { background: var(--match-sky); color: var(--match-deep); }
.workspace-meeting-gender.female { background: var(--match-blush); color: var(--match-coral); }
.workspace-meeting-name { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-meeting-name-row { max-width: 250rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6rpx; }
.workspace-meeting-name-row .workspace-meeting-name { max-width: 176rpx; }
.workspace-meeting-vip { padding: 1rpx 10rpx; border-radius: 6rpx; font-size: 17rpx; font-weight: 800; color: #ffffff; background: #b98a2b; flex-shrink: 0; }
.workspace-meeting-avatar-wrap:active { opacity: .8; }
.workspace-meeting-name-row:active { opacity: .7; }
.workspace-meeting-person-code { color: var(--muted); font-size: 21rpx; }
.workspace-meeting-wish { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--accent-bg); flex-shrink: 0; }
.workspace-meeting-wish text { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.workspace-meeting-meta { padding: 20rpx 22rpx; border-radius: 16rpx; background: var(--warm); display: flex; flex-direction: column; gap: 10rpx; }
.workspace-meeting-meta-line { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.workspace-meeting-meta-glyph { font-size: 20rpx; }
.workspace-meeting-meta-line text { color: var(--ink2); font-size: 22rpx; }
.workspace-meeting-foot { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.workspace-meeting-status-btn { height: 72rpx; padding: 0 30rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; }
.workspace-meeting-status-btn text { color: var(--paper); font-size: 25rpx; font-weight: 800; }
.workspace-meeting-status-arrow { width: 30rpx; height: 30rpx; border-radius: 50%; background: rgba(255, 255, 255, .28); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-arrow i { width: 11rpx; height: 11rpx; border-top: 3rpx solid var(--paper); border-right: 3rpx solid var(--paper); transform: rotate(45deg); margin-left: -4rpx; }
.workspace-meeting-status-btn.pending { background: var(--accent2); }
.workspace-meeting-status-btn.done { background: var(--match-coral); }
.workspace-meeting-status-btn:active { opacity: .8; transform: scale(.97); }
.workspace-meeting-delete { height: 72rpx; padding: 0 34rpx; border-radius: 999rpx; background: var(--warm); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-delete text { color: var(--ink2); font-size: 24rpx; font-weight: 700; }
.workspace-meeting-delete:active { opacity: .75; }
.workspace-scroll-top { position: fixed; right: 30rpx; bottom: 130rpx; z-index: 20; width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--surface); box-shadow: 0 8rpx 30rpx rgba(70, 70, 105, .16); display: flex; align-items: center; justify-content: center; }
.workspace-scroll-top-arrow { color: var(--ink2); font-size: 40rpx; font-weight: 900; line-height: 1; }
.workspace-scroll-top:active { opacity: .8; transform: scale(.95); }


.workspace-meeting-status-form { display: flex; flex-direction: column; gap: 20rpx; }

.workspace-meeting-status-pair { display: flex; flex-direction: row; gap: 20rpx; }
.workspace-meeting-status-pill { flex: 1; min-width: 0; min-height: 92rpx; border-radius: 999rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-pill text { color: var(--ink2); font-size: 27rpx; font-weight: 700; }
.workspace-meeting-status-pill.active { background: var(--accent-bg); border-color: var(--accent2); }
.workspace-meeting-status-pill.active text { color: var(--accent2); font-weight: 800; }
.workspace-meeting-status-pill:active { opacity: .78; }
.workspace-member-header { display: flex; align-items: center; gap: 15rpx; }.workspace-member-header > view { display: flex; flex-direction: column; gap: 6rpx; color: var(--muted); font-size: 20rpx; font-weight: 400; }.workspace-member-header > view text:first-child { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-entry-card { margin-top: 18rpx; padding: 26rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 18rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }

/* 录入客源线索：分步卡片 + chips 单选 + 示例填充，复用工作台 Token。 */
.workspace-entry-page { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 40rpx; }
.workspace-entry-hero { padding: 22rpx 26rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: row; align-items: center; gap: 18rpx; }
.workspace-entry-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.workspace-entry-hero-title { color: var(--accent2); font-size: 25rpx; font-weight: 800; }
.workspace-entry-hero-sub { color: var(--ink2); font-size: 21rpx; line-height: 1.5; }
.workspace-entry-demo { padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); flex-shrink: 0; }
.workspace-entry-demo text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.workspace-entry-demo:active { opacity: .75; transform: scale(.98); }
.workspace-entry-formcard { margin-top: 0; padding: 26rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.workspace-entry-card-head { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding-bottom: 6rpx; }
.workspace-entry-step { width: 40rpx; height: 40rpx; border-radius: 12rpx; background: var(--accent); color: var(--paper); font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.workspace-entry-card-head-copy { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12rpx; }
.workspace-entry-card-title { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-entry-card-require { color: var(--muted); font-size: 20rpx; }
.workspace-entry-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; min-height: 92rpx; border-bottom: 1px solid var(--line); }
.workspace-entry-row.last { border-bottom: none; }
.workspace-entry-label { width: 84rpx; color: var(--ink2); font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.workspace-entry-row input { flex: 1; min-width: 0; color: var(--ink); font-size: 25rpx; }
/* 带 typo 的卡片（基础信息、身形与属地）字号向「学历」气泡看齐：标签 28rpx、控件文字 27rpx。
   只动字号，颜色和字重保持原样。 */
.workspace-entry-formcard-typo .workspace-entry-label { font-size: 28rpx; }
.workspace-entry-formcard-typo .workspace-entry-row input { font-size: 27rpx; }
.workspace-entry-formcard-typo .workspace-entry-picker text { font-size: 27rpx; }
.workspace-entry-formcard-typo .ls-chip text { font-size: 27rpx; }
.workspace-entry-picker { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-entry-picker text { color: var(--ink2); font-size: 25rpx; }
.workspace-entry-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.workspace-entry-block { padding: 20rpx 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-entry-block.last { border-bottom: none; padding-bottom: 4rpx; }
/* 购房面板展开时隐藏本行分隔线：1px 实线会穿过半透明投影，把软阴影切成一条硬边。 */
.workspace-entry-block-floating { border-bottom-color: transparent; }
.workspace-entry-block-label { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-entry-chip { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--surface); border: 1px solid var(--match-line); }
.workspace-entry-chip text { color: var(--ink2); font-size: 21rpx; font-weight: 700; }
.workspace-entry-chip.active { background: var(--match-deep); border-color: var(--match-deep); }
.workspace-entry-chip.active text { color: var(--paper); }
.workspace-entry-chip:active { opacity: .75; }
/* 会员标签云：未选中为中性浅灰底，选中用描边 + 浅底 + 勾。勾位常驻占位、只切透明度，
   所以每个标签的宽度和位置固定，勾选不会挤动同行标签。 */
.workspace-tag-cloud { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 18rpx 16rpx; }
.workspace-tag-chip { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 16rpx 40rpx 16rpx 14rpx; border-radius: 999rpx; border: 2rpx solid transparent; background: #F1F3F2; }
.workspace-tag-chip text { color: var(--ink2); font-size: 22rpx; font-weight: 700; line-height: 1; }
/* 勾统一 20rpx 且固定在等宽盒内，避免大字号时溢出药丸左缘被裁切。 */
.workspace-tag-chip .workspace-tag-check { width: 20rpx; flex-shrink: 0; font-size: 20rpx; text-align: center; opacity: 0; }
.workspace-tag-check.on { opacity: 1; }
.workspace-tag-chip.active { background: var(--match-mist); border-color: var(--match-deep); box-shadow: 0 4rpx 14rpx rgba(21, 74, 69, .14); }
.workspace-tag-chip.active text { color: var(--match-deep); }
.workspace-tag-chip:active { opacity: .7; }
.workspace-tag-reset { margin-left: auto; padding: 16rpx 30rpx; border-radius: 999rpx; background: var(--match-blush); }
.workspace-tag-reset text { color: var(--match-coral); font-size: 22rpx; font-weight: 800; line-height: 1; }
/* 购房下拉：选项面板在表单内展开（enhanced scroll-view 里 fixed/absolute 包含块不可靠，会盖住上方内容）。
   白底、圆角、阴影只挂在最外层 .workspace-select 上，触发条和选项列表是它的两块透明内容，
   展开时是一个容器的两段，不是两个方块。阴影总扩散半径压在卡片内边距 26rpx 以内，避免跨底色跳出硬边。 */
.workspace-select { border-radius: 22rpx; background: var(--surface); box-shadow: 0 0 0 1rpx rgba(12, 19, 19, .06), 0 8rpx 22rpx rgba(12, 19, 19, .12); overflow: hidden; display: flex; flex-direction: column; }
/* 择偶职业仍用原生 picker 选择（滚轮弹层），只把它的点击条套进同一个气泡外壳：picker 默认宽度不撑满，需要拉满才能和别的下拉同宽。 */
.workspace-select-picker { width: 100%; }
.workspace-select-trigger { min-height: 88rpx; padding: 0 28rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; }
.workspace-select-trigger text { color: var(--ink); font-size: 27rpx; font-weight: 500; }
.workspace-select-trigger .workspace-select-placeholder { color: var(--muted); font-weight: 400; }
/* 自由输入项（如宗教）套进同一个气泡外壳时，input 自己吃掉剩余宽度，字号与触发条正文对齐。 */
.workspace-select-trigger input { flex: 1; min-width: 0; background: transparent; color: var(--ink); font-size: 27rpx; font-weight: 500; }
/* 双人字箭头：两条边框拼出的转角是极尖锐角，细描边在尖点上会被光栅化削掉（像素图里两撇实心、尖点空白），
   所以给转角加小圆角把尖点变钝头；描边维持 3rpx 且用 --muted，比正文的 --ink 浅一档。 */
.workspace-select-caret { width: 36rpx; height: 44rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.workspace-select-caret-up { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--muted); border-top: 3rpx solid var(--muted); border-top-left-radius: 7rpx; transform: rotate(45deg); }
.workspace-select-caret-down { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--muted); border-bottom: 3rpx solid var(--muted); border-bottom-left-radius: 7rpx; transform: rotate(-45deg); }
.workspace-select-menu { padding: 0 12rpx 12rpx; display: flex; flex-direction: column; gap: 4rpx; }
.workspace-select-option { min-height: 84rpx; padding: 0 24rpx; border-radius: 18rpx; display: flex; flex-direction: row; align-items: center; }
.workspace-select-option text { color: var(--ink); font-size: 27rpx; font-weight: 400; }
.workspace-select-option.active { background: var(--match-mist); }
.workspace-select-option.active text { color: var(--match-deep); font-weight: 600; }
.workspace-select-option:active { background: var(--match-mist); }
.workspace-entry-textarea { width: 100%; min-height: 130rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface); border: 1px solid var(--match-line); color: var(--ink); font-size: 23rpx; line-height: 1.6; box-sizing: border-box; }
.workspace-entry-custom-input { width: 100%; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: var(--surface); border: 1px solid var(--match-line); color: var(--ink); font-size: 23rpx; }
/* 年龄 / 身高共用的同轴双向范围条（仿设计稿）。浅雾绿底板里绿/白两段，两个白色旋钮共用同一根轴，旋钮顶上一枚墨绿气泡读数。
   小程序会把「溢出定位祖先」的绝对子元素整块裁掉，所以既不能用负 margin 居中旋钮，也不能把定位盒缩窄：
   定位盒铺满轨道，位置一律写成 calc((100% - 一个旋钮宽) * 比例)，旋钮盒永远留在轨道内，端点上气泡和右端旋钮都不会被裁。
   刻度行用同一个 calc 表达式（比例 0/0.25/0.5/0.75/1、标签盒与旋钮同宽），标签中心与旋钮中心逐一对齐。 */
.member-range-plate { width: 100%; box-sizing: border-box; padding: 22rpx 28rpx 16rpx; border-radius: 28rpx; background: var(--match-mist); }
.member-range-track { position: relative; width: 100%; height: 140rpx; }
.member-range-rail { position: absolute; left: 0; right: 0; top: 96rpx; height: 44rpx; border-radius: 22rpx; background: rgba(21, 74, 69, .10); }
.member-range-fill { position: absolute; left: 8rpx; right: 8rpx; top: 102rpx; height: 32rpx; border-radius: 16rpx; background: var(--sage-soft); }
.member-range-travel { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.member-range-band { position: absolute; top: 102rpx; height: 32rpx; border-radius: 16rpx; background: var(--surface); box-shadow: inset 0 0 0 1px rgba(21, 74, 69, .06); }
.member-range-knob { position: absolute; top: 96rpx; width: 84rpx; display: flex; flex-direction: column; align-items: center; }
.member-range-knob-dot { width: 44rpx; height: 44rpx; border-radius: 22rpx; background: var(--surface); border: 1px solid var(--match-line); box-shadow: 0 4rpx 12rpx rgba(21, 74, 69, .18); }
/* 气泡单独一层（不再嵌在旋钮里）：两旋钮贴近时它需要横向让位，而小程序会裁掉溢出定位盒的子元素，只有平级才推得开。 */
.member-range-bubble { position: absolute; top: 37rpx; width: 84rpx; display: flex; flex-direction: column; align-items: center; }
.member-range-scale { position: relative; height: 28rpx; }
.member-range-scale-item { position: absolute; top: 0; width: 84rpx; display: flex; flex-direction: row; justify-content: center; }
.member-range-scale-text { color: var(--ink2); font-size: 20rpx; }
.member-range-bubble-box { width: 84rpx; height: 52rpx; border-radius: 14rpx; background: var(--match-deep); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.member-range-bubble-text { color: var(--match-paper); font-size: 26rpx; font-weight: 800; }
.member-range-bubble-tail { width: 14rpx; height: 14rpx; margin-top: -7rpx; border-radius: 3rpx; background: var(--match-deep); transform: rotate(45deg); }
.workspace-entry-submit { margin-top: 6rpx; min-height: 88rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.workspace-entry-submit text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.workspace-entry-submit.disabled { opacity: .55; }
.workspace-entry-submit:active { opacity: .8; transform: scale(.99); }
.workspace-entry-foot { display: flex; justify-content: center; }
.workspace-entry-foot text { color: var(--muted); font-size: 20rpx; text-align: center; }.workspace-entry-card > view:not(.workspace-entry-submit) { min-height: 72rpx; padding-bottom: 12rpx; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--ink2); font-size: 22rpx; font-weight: 400; }.workspace-entry-card input { flex: 1; text-align: right; font-size: 22rpx; color: var(--ink); }.workspace-entry-submit { height: 72rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 24rpx; font-weight: 800; }
.workspace-generic-card { margin-top: 18rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-generic-card > view:first-child { width: 58rpx; height: 58rpx; border-radius: 14rpx; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 25rpx; }.workspace-generic-card > view:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-generic-card > view:nth-child(2) text:first-child { font-size: 24rpx; font-weight: 800; }.workspace-generic-card > view:nth-child(2) text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-generic-card > text:last-child { color: var(--accent2); font-size: 20rpx; }
.workspace-add { position: fixed; right: 22rpx; bottom: 38rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 17rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-add text:first-child { font-size: 30rpx; line-height: 28rpx; }

/* 微信小程序 uvue 必须显式标记横向 flex，避免文字与操作按钮纵向叠压。 */
.match-contact-action { min-height: 88rpx; border-radius: 999rpx; background: var(--accent); display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 20rpx; }
.match-contact-action-pressed { opacity: 0.8; }
.match-contact-action-label { color: var(--paper); font-size: 24rpx; font-weight: 700; }
.workspace-tabs, .workspace-search, .workspace-promotion > view, .workspace-commission-row > view, .workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header), .workspace-actions, .workspace-match-card-top, .workspace-meeting-card-top, .workspace-meeting-pair, .workspace-meeting-person, .workspace-meeting-arrangement > view, .workspace-member-header, .workspace-entry-card > view:not(.workspace-entry-submit), .workspace-generic-card { flex-direction: row; }
.workspace-tabs, .workspace-search, .workspace-actions, .workspace-meeting-pair, .workspace-meeting-person, .workspace-member-header, .workspace-generic-card { min-width: 0; }
.workspace-info-card > view, .workspace-member-header > view, .workspace-generic-card > view { min-width: 0; }

.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 148rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 34rpx 30rpx;
	border-radius: 22rpx;
	background: linear-gradient(145deg, var(--accent-bg), var(--surface));
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 208rpx;
	box-sizing: border-box;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--accent2);
}

.banner-title {
	font-size: 40rpx;
	line-height: 1.34;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.banner-desc {
	font-size: 21rpx;
	line-height: 1.55;
	color: var(--ink2);
}

/* ===== 红娘管理中心入口 ===== */
.management-entry {
	padding: 26rpx;
	border: 1px solid var(--line);
	border-radius: 20rpx;
	background: var(--warm);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 18rpx;
}

.management-entry.ready {
	background: var(--match-mist);
	border-color: var(--accent);
}

.management-entry-copy {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.management-entry-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
}

.management-entry-title {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--ink);
}

.management-demo-badge {
	padding: 4rpx 10rpx;
	border-radius: 999rpx;
	background: var(--accent-bg);
	color: var(--accent2);
	font-size: 18rpx;
	font-weight: 800;
}

.management-entry-desc {
	font-size: 21rpx;
	line-height: 1.5;
	color: var(--ink2);
}

.management-entry-action {
	min-width: 136rpx;
	height: 64rpx;
	padding: 0 16rpx;
	border-radius: 14rpx;
	background: var(--accent);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--paper);
	font-size: 21rpx;
	font-weight: 800;
	white-space: nowrap;
	flex-shrink: 0;
}

.management-entry-action.disabled {
	background: var(--muted);
	opacity: 0.72;
}

/* ===== 管理中心加载骨架 ===== */
.management-center-loading {
	flex: 1;
	height: 0;
	padding: 24rpx 32rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.management-loading-card,
.management-loading-heading,
.management-loading-pill {
	background: var(--warm);
	border-radius: 16rpx;
}

.management-loading-identity {
	height: 260rpx;
	border-radius: 20rpx;
}

.management-loading-tabs {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
}

.management-loading-pill {
	width: 142rpx;
	height: 58rpx;
	border-radius: 999rpx;
}

.management-loading-pill.short {
	width: 96rpx;
}

.management-loading-heading {
	width: 186rpx;
	height: 38rpx;
}

.management-loading-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14rpx;
}

.management-loading-grid .management-loading-card {
	height: 176rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.optional-label {
	font-size: 20rpx;
	color: var(--muted);
	padding: 4rpx 12rpx;
	border-radius: 999rpx;
	background: var(--warm);
}

.section-desc {
	font-size: 22rpx;
	line-height: 1.55;
	color: var(--muted);
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
}

.optional {
	font-size: 20rpx;
	font-weight: 400;
	color: var(--muted);
	margin-left: 8rpx;
}

.field-hint {
	font-size: 20rpx;
	color: var(--muted);
}

.field-counter {
	font-size: 20rpx;
	color: var(--muted);
	text-align: right;
}

.field-input {
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 25rpx;
	color: var(--ink);
}

.field-textarea {
	width: 100%;
	min-height: 146rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 24rpx;
	line-height: 1.6;
	color: var(--ink);
}

.case-textarea {
	min-height: 120rpx;
}

/* ===== 头像上传 ===== */
.avatar-upload {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	overflow: hidden;
	border: 2rpx dashed var(--line);
	background: var(--canvas);
}

.avatar-preview {
	width: 100%;
	height: 100%;
}

.avatar-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6rpx;
}

.avatar-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.avatar-hint {
	font-size: 18rpx;
	color: var(--muted);
}

/* ===== 擅长领域 ===== */
.specialty-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 12rpx;
}

.specialty-chip {
	width: 100%;
	height: 58rpx;
	padding: 0 8rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 999rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 22rpx;
	line-height: 1;
	color: var(--ink2);
}

.specialty-chip text {
	display: block;
	width: 100%;
	text-align: center;
	line-height: 1;
	white-space: nowrap;
}

.specialty-chip.selected {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 价格输入 ===== */
.price-input-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	gap: 8rpx;
}

.price-prefix {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--brown);
	flex-shrink: 0;
}

.price-input {
	flex: 1;
	min-width: 0;
	font-size: 25rpx;
	color: var(--ink);
}

.price-suffix {
	font-size: 22rpx;
	color: var(--muted);
	flex-shrink: 0;
}

/* ===== 成功案例 ===== */
.case-block {
	padding: 22rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.case-block-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.case-block-title {
	font-size: 24rpx;
	font-weight: 800;
	color: var(--ink);
}

.case-delete {
	padding: 8rpx 16rpx;
	border-radius: 8rpx;
	background: rgba(231, 110, 76, 0.12);
}

.case-delete text {
	font-size: 20rpx;
	color: var(--brown);
}

.case-block .form-field {
	border-top: none;
	padding-top: 0;
}

.case-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 12rpx;
}

.case-image-item {
	position: relative;
	width: 148rpx;
	height: 148rpx;
	border-radius: 12rpx;
	overflow: hidden;
}

.case-image-preview {
	width: 100%;
	height: 100%;
}

.case-image-delete {
	position: absolute;
	top: 4rpx;
	right: 4rpx;
	width: 36rpx;
	height: 36rpx;
	border-radius: 50%;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-image-delete text {
	font-size: 24rpx;
	color: var(--paper);
	font-weight: 700;
}

.case-image-add {
	width: 148rpx;
	height: 148rpx;
	border: 2rpx dashed var(--line);
	border-radius: 12rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-add-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.add-case-button {
	height: 72rpx;
	border: 1px dashed var(--line);
	border-radius: 14rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.add-case-button text {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--accent2);
}

/* ===== 审核流程 ===== */
.process-card {
	position: relative;
	overflow: visible;
}

.process-steps {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.process-step {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rpx;
	padding-bottom: 28rpx;
}

.process-step:last-child {
	padding-bottom: 0;
}

.step-indicator {
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	border: 2rpx solid var(--line);
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 18rpx;
	font-weight: 800;
	color: var(--muted);
	flex-shrink: 0;
	z-index: 1;
}

.step-indicator.active {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--paper);
}

.step-indicator.done {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
}

.step-copy {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	padding-top: 4rpx;
}

.step-title {
	font-size: 25rpx;
	font-weight: 700;
	color: var(--ink);
}

.step-desc {
	font-size: 20rpx;
	line-height: 1.5;
	color: var(--muted);
}

.step-line {
	position: absolute;
	left: 25rpx;
	top: 56rpx;
	width: 2rpx;
	height: calc(100% - 38rpx);
	background: var(--line);
}

/* ===== 咨询入口 ===== */
.consult-icons {
	position: absolute;
	/* 保持在审核流程卡片内，避免悬出页面边缘。 */
	right: 30rpx;
	top: 46%;
	transform: translateY(-50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12rpx;
	z-index: 2;
}

.consult-icon {
	width: 70rpx;
	height: 70rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 18rpx rgba(45, 124, 114, 0.18);
}

.wechat-brand {
	width: 64rpx;
	height: 64rpx;
	flex-shrink: 0;
}

.wechat-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.consult-emoji {
	display: none;
}

.phone-brand {
	width: 64rpx;
	height: 64rpx;
}

.phone-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* ===== 微信二维码弹窗 ===== */
.qr-overlay {
	position: fixed;
	inset: 0;
	z-index: 100;
	background: rgba(17, 23, 24, 0.48);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-card {
	position: relative;
	width: 540rpx;
	padding: 44rpx 40rpx 36rpx;
	border-radius: 28rpx;
	background: var(--paper);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 16rpx;
	box-shadow: var(--shadow-lg);
}

.qr-close {
	position: absolute;
	top: 16rpx;
	right: 16rpx;
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	background: var(--surface);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-close text {
	font-size: 32rpx;
	color: var(--muted);
	font-weight: 300;
}

.qr-title {
	font-size: 36rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.qr-subtitle {
	font-size: 24rpx;
	line-height: 1.55;
	color: var(--muted);
	text-align: center;
}

.qr-image-wrap {
	width: 360rpx;
	height: 360rpx;
	padding: 16rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
}

.qr-image {
	width: 100%;
	height: 100%;
}

.qr-tip {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 隐私声明 ===== */
.privacy-card {
	padding: 22rpx 24rpx;
	border-radius: 18rpx;
	background: var(--sage-soft);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.privacy-title {
	font-size: 25rpx;
	font-weight: 800;
	color: var(--accent2);
}

.privacy-copy {
	font-size: 21rpx;
	line-height: 1.65;
	color: var(--ink2);
}

/* ===== 底部按钮 ===== */
.footer-safe {
	position: fixed;
	z-index: 20;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
	background: rgba(250, 252, 252, 0.96);
	border-top: 1px solid var(--line);
	flex-shrink: 0;
}

.submit-button {
	height: 86rpx;
	border-radius: 20rpx;
	background: var(--brown);
	color: var(--paper);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	font-weight: 800;
}

.submit-button.disabled {
	opacity: 0.56;
}

/* ===== 客源线索工作台 ===== */
/* 添加/筛选悬浮键：1:1 照搬资料待审的 .review-float-actions 成对悬浮键 */
.lead-float-actions {
	position: fixed;
	right: 20rpx;
	bottom: calc(env(safe-area-inset-bottom) + 20rpx);
	z-index: 75;
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.fab-lead-add,
.fab-lead-filter {
	width: 104rpx;
	height: 104rpx;
	border-radius: 50%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 2rpx;
	box-shadow: var(--match-shadow);
}

.fab-lead-add { background: var(--accent-bg); }
.fab-lead-add text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }
.fab-lead-filter { background: var(--match-blush); }
.fab-lead-filter text { color: var(--match-coral); font-size: 19rpx; font-weight: 800; }
.fab-lead-filter.active { background: var(--accent-bg); }
.fab-lead-filter.active text { color: var(--accent2); }
.fab-lead-glyph { font-size: 26rpx !important; }
.fab-lead-add:active,
.fab-lead-filter:active { opacity: 0.8; transform: scale(0.96); }

.workspace-lead-card {
	margin-top: 14rpx;
	padding: 30rpx 28rpx 20rpx;
	border-radius: 24rpx;
	background: var(--surface);
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	box-shadow: var(--shadow-sm);
}

.workspace-lead-card .workspace-actions {
	margin-top: 16rpx;
	flex-wrap: wrap;
}

.workspace-lead-card .workspace-actions text {
	flex: 1 1 30%;
	min-width: 29%;
	padding: 16rpx 6rpx;
	border-radius: 12rpx;
	background: var(--warm);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
	text-align: center;
}

.workspace-lead-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	min-width: 0;
}

.workspace-lead-name {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
	flex: 1;
	min-width: 0;
}

.workspace-lead-title {
	color: var(--ink);
	font-size: 34rpx;
	font-weight: 800;
}

/* 性别徽标：配色沿用约见/牵线卡片的男女档（浅底 + 深字），未知给中性灰，避免卡片间另起一套色 */
.workspace-lead-gender {
	padding: 4rpx 12rpx;
	border-radius: 10rpx;
	font-size: 19rpx;
	font-weight: 800;
	flex-shrink: 0;
}

.workspace-lead-gender.male {
	background: var(--match-sky);
	color: var(--match-deep);
}

.workspace-lead-gender.female {
	background: var(--match-blush);
	color: var(--match-coral);
}

.workspace-lead-gender.unknown {
	background: var(--warm);
	color: var(--muted);
}

/* 年龄由生日现算（满周岁），跟在性别徽标后面，用中性灰不跟姓名抢视觉重量 */
.workspace-lead-age {
	color: var(--muted);
	font-size: 22rpx;
	font-weight: 700;
	flex-shrink: 0;
}

.workspace-lead-time {
	color: var(--muted);
	font-size: 20rpx;
}

/* 右上角让出固定宽度给「入库」胶囊，日期落到它下面，长名字（如「孟亦航（示例）」）不会被挤断 */
.workspace-lead-top-right {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: 8rpx;
	flex-shrink: 0;
}

/* 入库胶囊：照参考稿的实心小药丸（饱和底 + 反白加粗字、全程无图标），已入库用品牌深绿，未入库用珊瑚色提醒 */
.workspace-lead-intake {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 7rpx 20rpx;
	border-radius: 999rpx;
}

.workspace-lead-intake.todo {
	background: var(--match-coral);
}

.workspace-lead-intake.done {
	background: var(--accent2);
}

.workspace-lead-intake-label {
	font-size: 22rpx;
	font-weight: 800;
	letter-spacing: 1rpx;
	color: #ffffff;
}

.workspace-lead-rows {
	display: flex;
	flex-direction: column;
}

/* 参考稿的读法：灰色标签列定宽，值一律左对齐顶在同一条竖线上，行间不画分隔线。 */
.workspace-lead-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 22rpx;
	min-width: 0;
	min-height: 68rpx;
}

.workspace-lead-row > text:first-child {
	width: 104rpx;
	flex-shrink: 0;
	color: var(--muted);
	font-size: 23rpx;
}

.workspace-lead-row > text:last-child {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 25rpx;
	font-weight: 600;
	text-align: left;
}

.workspace-lead-value {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	gap: 6rpx;
}

.workspace-lead-value > text:first-child {
	color: var(--ink);
	font-size: 25rpx;
	font-weight: 600;
}

.workspace-lead-chevron {
	color: var(--muted) !important;
	font-size: 24rpx !important;
	font-weight: 400 !important;
}

/* 备注是长文本，按参考稿 Description 的处理：灰色小标题 + 浅底内嵌块，可折行不截断。 */
.workspace-lead-remark {
	display: flex;
	flex-direction: column;
	gap: 10rpx;
	padding: 14rpx 0 18rpx;
}

.workspace-lead-remark > text {
	color: var(--muted);
	font-size: 23rpx;
}

.workspace-lead-remark-box {
	padding: 18rpx 20rpx;
	border-radius: 14rpx;
	background: var(--canvas);
}

.workspace-lead-remark-box > text {
	color: var(--ink2);
	font-size: 23rpx;
	line-height: 1.6;
}

/* 弃海原因：沿用资料待审「弃海原因」的提示色，和备注区分开。 */
.workspace-lead-remark-box.abandon {
	background: var(--match-blush);
}

.workspace-lead-remark-box.abandon > text {
	color: var(--match-coral);
}

/* 状态与意向是可选值，借参考稿 Today / Ongoing 的浅底色块 + 彩色字 + 下拉角标。 */
.workspace-lead-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6rpx;
	padding: 9rpx 18rpx;
	border-radius: 10rpx;
	background: var(--warm);
}

.workspace-lead-chip > text {
	font-size: 22rpx;
	font-weight: 800;
	color: var(--ink2);
}

.workspace-lead-status-new {
	background: var(--accent-bg);
}

.workspace-lead-status-new > text {
	color: var(--accent2) !important;
}

.workspace-lead-status-ok {
	background: var(--sage-soft);
}

.workspace-lead-status-ok > text {
	color: var(--sage) !important;
}

.workspace-lead-status-warn {
	background: var(--review-orange-soft);
}

.workspace-lead-status-warn > text {
	color: var(--review-orange) !important;
}

.workspace-lead-status-muted {
	background: var(--warm);
}

.workspace-lead-status-muted > text {
	color: var(--muted) !important;
}

.workspace-lead-stale {
	color: var(--match-coral) !important;
	font-weight: 700 !important;
}

.workspace-lead-intention {
	background: var(--match-sky);
}

.workspace-lead-intention > text {
	color: var(--accent) !important;
}

/* 跟进记录面板 */
.workspace-follow-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	padding: 2rpx 0 16rpx;
}

.workspace-follow-back {
	color: var(--accent2);
	font-size: 24rpx;
	font-weight: 700;
}

.workspace-follow-title {
	color: var(--ink);
	font-size: 28rpx;
	font-weight: 800;
}

.workspace-follow-list {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.workspace-follow-item {
	padding: 20rpx;
	border-radius: 16rpx;
	background: var(--match-mist);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.workspace-follow-item-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
}

.workspace-follow-method {
	color: var(--accent2);
	font-size: 21rpx;
	font-weight: 800;
}

.workspace-follow-time {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-content {
	color: var(--ink);
	font-size: 24rpx;
	line-height: 1.5;
}

.workspace-follow-intention {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-form {
	margin-top: 20rpx;
	padding: 22rpx;
	border-radius: 16rpx;
	background: var(--match-paper);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
	box-shadow: var(--shadow-sm);
}

.workspace-follow-form-title {
	color: var(--ink);
	font-size: 24rpx;
	font-weight: 800;
}

.workspace-follow-methods {
	display: flex;
	flex-direction: row;
	gap: 10rpx;
	flex-wrap: wrap;
}

.workspace-follow-method-chip {
	padding: 10rpx 24rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
}

.workspace-follow-method-chip.active {
	background: var(--match-deep);
	border-color: var(--match-deep);
	color: var(--paper);
}

.workspace-follow-textarea {
	width: 100%;
	min-height: 110rpx;
	padding: 16rpx;
	border-radius: 12rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink);
	font-size: 23rpx;
	box-sizing: border-box;
}

.workspace-follow-submit {
	padding: 16rpx 0;
	border-radius: 14rpx;
	background: var(--match-deep);
	color: var(--paper);
	text-align: center;
	font-size: 24rpx;
	font-weight: 800;
}

/* 底部弹层内容 */
.workspace-option-list {
	display: flex;
	flex-direction: column;
}

/* 添加牵线记录：会员选择弹层（搜索 + 列表） */
.workspace-match-add-picker {
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.workspace-option {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx 8rpx;
	border-bottom: 1px solid var(--line);
	color: var(--ink);
	font-size: 26rpx;
	font-weight: 600;
}

.workspace-option.selected {
	color: var(--accent2);
}

.workspace-option-check {
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 会员选择弹层：命令面板模板（头部 / 搜索 / 键位提示 / 头像结果行）
	 sheet-body 自带 16px 18px 内边距，这里用负外边距让分割线贴齐面板边缘。 ===== */
.mp-pick {
	margin: -16px -18px 0;
	background: var(--surface);
	display: flex;
	flex-direction: column;
	max-height: 72vh;
}

/* 名单自己滚动：头部 / 搜索 / 提示条固定不动，几十条也能滑到底 */
.mp-pick-scroll {
	flex: 1;
	min-height: 0;
}

.mp-pick-head {
	flex-shrink: 0;
	height: 96rpx;
	background: var(--paper);
	padding: 0 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-back {
	width: 64rpx;
	height: 64rpx;
	border-radius: 18rpx;
	background: var(--warm);
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.mp-pick-back:active {
	opacity: .7;
}

.mp-pick-back-glyph {
	width: 16rpx;
	height: 16rpx;
	border-left: 3rpx solid var(--muted);
	border-bottom: 3rpx solid var(--muted);
	border-bottom-left-radius: 6rpx;
	transform: rotate(45deg);
	margin-left: 6rpx;
}

.mp-pick-title {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 32rpx;
	font-weight: 600;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-total {
	min-width: 56rpx;
	padding: 6rpx 16rpx;
	border-radius: 999rpx;
	background: var(--match-mist);
	color: var(--match-deep);
	font-size: 21rpx;
	font-weight: 700;
	text-align: center;
	flex-shrink: 0;
}

.mp-pick-search {
	flex-shrink: 0;
	height: 120rpx;
	padding: 0 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-search-glyph {
	color: var(--muted);
	font-size: 34rpx;
	line-height: 1;
	flex-shrink: 0;
}

.mp-pick-search-input {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 28rpx;
}

.mp-pick-search-ph {
	color: var(--muted);
	font-size: 26rpx;
}

/* 清空按钮只在有关键词时出现，槽位常驻以免搜索框左右抖动 */
.mp-pick-clear-slot {
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.mp-pick-clear {
	width: 48rpx;
	height: 48rpx;
	border-radius: 14rpx;
	background: var(--warm);
	color: var(--muted);
	font-size: 22rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.mp-pick-clear:active {
	opacity: .7;
}

.mp-pick-hints {
	flex-shrink: 0;
	padding: 14rpx 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	gap: 22rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-hint {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8rpx;
}

.mp-pick-hint-key {
	padding: 2rpx 12rpx;
	border-radius: 10rpx;
	background: var(--surface);
	border: 1rpx solid var(--match-line);
	color: var(--ink2);
	font-size: 20rpx;
	line-height: 1.6;
}

.mp-pick-hint-label {
	color: var(--muted);
	font-size: 20rpx;
}

.mp-pick-state {
	min-height: 220rpx;
	padding: 40rpx 28rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--muted);
	font-size: 24rpx;
}

.mp-pick-results-label {
	display: block;
	padding: 22rpx 28rpx 8rpx;
	color: var(--muted);
	font-size: 21rpx;
}

.mp-pick-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 21rpx 28rpx;
}

.mp-pick-row.picked {
	background: var(--match-mist);
}

.mp-pick-avatar {
	width: 68rpx;
	height: 68rpx;
	border-radius: 18rpx;
	background: var(--warm);
	flex-shrink: 0;
}

.mp-pick-name {
	margin-left: 18rpx;
	max-width: 300rpx;
	color: var(--ink);
	font-size: 28rpx;
	font-weight: 600;
	flex-shrink: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-row.picked .mp-pick-name {
	color: var(--match-deep);
}

.mp-pick-meta {
	flex: 1;
	min-width: 0;
	margin-left: 14rpx;
	color: var(--muted);
	font-size: 23rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-tail {
	width: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex-shrink: 0;
}

.mp-pick-tail-check {
	color: var(--match-deep);
	font-size: 28rpx;
	font-weight: 800;
}

.workspace-filter-group {
	margin-bottom: 20rpx;
}

.workspace-filter-label {
	display: block;
	color: var(--muted);
	font-size: 21rpx;
	margin-bottom: 12rpx;
}

.workspace-filter-chips {
	display: flex;
	flex-direction: row;
	gap: 10rpx;
	flex-wrap: wrap;
}

.workspace-filter-chip {
	padding: 10rpx 26rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
}

.workspace-filter-chip.active {
	background: var(--match-mist);
	border-color: var(--accent);
	color: var(--accent2);
}

.intention-filter-chip {
	max-width: 100%;
	padding-left: 16rpx;
	padding-right: 16rpx;
	font-size: 19rpx;
}

.workspace-sheet-actions {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
	margin-top: 10rpx;
}

.workspace-sheet-btn {
	flex: 1;
	padding: 16rpx 0;
	border-radius: 14rpx;
	background: var(--match-deep);
	color: var(--paper);
	text-align: center;
	font-size: 24rpx;
	font-weight: 800;
}

.workspace-sheet-btn.ghost {
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--accent2);
}

.workspace-sheet-btn.disabled {
	opacity: 0.56;
}

/* 线索表单与确认 */
.workspace-lead-form,
.workspace-lead-confirm {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.workspace-form-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	padding: 14rpx 0;
	border-bottom: 1px solid var(--line);
}

.workspace-form-row text {
	width: 76rpx;
	color: var(--ink2);
	font-size: 22rpx;
	flex-shrink: 0;
}

.workspace-form-row input {
	flex: 1;
	color: var(--ink);
	font-size: 24rpx;
}

.workspace-form-error {
	color: var(--match-coral);
	font-size: 21rpx;
}

/* ===== 添加/编辑线索：性别、生日、照片、来源渠道（补充样式） ===== */
.workspace-entry-options {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	gap: 14rpx;
	flex: 1;
	min-width: 0;
}

.workspace-entry-options-wrap {
	align-content: flex-start;
}

.workspace-entry-option {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8rpx;
	padding: 6rpx 18rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
}

.workspace-entry-option.selected {
	background: var(--match-deep);
	border-color: var(--match-deep);
}

.workspace-entry-option text {
	width: auto;
	color: var(--ink2);
	font-size: 22rpx;
	font-weight: 700;
}

.workspace-entry-option.selected text {
	color: var(--paper);
}

.workspace-entry-radio {
	width: 20rpx;
	height: 20rpx;
	border-radius: 50%;
	border: 2rpx solid var(--muted);
	box-sizing: border-box;
}

.workspace-entry-option.selected .workspace-entry-radio {
	border-color: var(--paper);
	background: var(--paper);
}

.workspace-entry-options .workspace-entry-chip {
	margin: 0;
}

.workspace-entry-options .workspace-entry-chip text {
	width: auto;
}

.workspace-form-picker {
	flex: 1;
}

.workspace-form-picker-value {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	gap: 10rpx;
	flex: 1;
	min-width: 0;
}

.workspace-form-picker-value text {
	width: auto;
	color: var(--ink);
	font-size: 24rpx;
}

.workspace-form-picker-value .workspace-entry-chevron {
	color: var(--muted);
	font-size: 28rpx;
}

.lead-photo-upload {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	flex: 1;
	min-width: 0;
}

.lead-photo-preview {
	width: 96rpx;
	height: 96rpx;
	border-radius: 16rpx;
	background: var(--surface);
	border: 1px solid var(--line);
}

.lead-photo-add {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4rpx;
	width: 96rpx;
	height: 96rpx;
	border-radius: 16rpx;
	background: var(--surface);
	border: 1px dashed var(--match-line);
}

.lead-photo-add text {
	width: auto;
	color: var(--muted);
	font-size: 20rpx;
}

.lead-photo-plus {
	color: var(--muted);
	font-size: 36rpx;
	font-weight: 700;
	line-height: 1;
}

.lead-photo-remove {
	color: var(--match-coral);
	font-size: 22rpx;
}

.workspace-confirm-tip {
	color: var(--ink2);
	font-size: 23rpx;
	line-height: 1.5;
}

.workspace-confirm-gender {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.workspace-confirm-gender > text {
	color: var(--muted);
	font-size: 21rpx;
}

/* ===== 复制资料弹窗（内联实现，常驻挂载 + open 类；卡片结构与配色照搬资料待审的复制弹窗） ===== */
.cp-overlay {
	position: fixed;
	z-index: 9700;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
