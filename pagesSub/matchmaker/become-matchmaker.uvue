<template>
	<view class="become-page">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="handlePageBack">
				<view class="nav-back-chevron"></view>
			</view>
			<text class="nav-title">{{ pendingReviewVisible ? '资料待审' : (workspaceVisible ? workspaceTitle : (managementCenterVisible || managementCenterLoading ? '红娘管理中心' : '我要做红娘')) }}</text>
			<!-- 工作区遮罩右上角只保留「保存」药丸；返回走左侧箭头（handlePageBack 会先关遮罩）。 -->
			<view v-if="pendingReviewVisible || workspaceVisible">
				<view v-if="isLeadEntryStudio" class="nav-help nav-help-save" @click="submitLeadForm()">
					<text class="nav-help-text">保存</text>
				</view>
			</view>
			<view v-else-if="managementCenterVisible" class="nav-entries">
				<view class="nav-entry" @click="openMyAccount">
					<view class="entry-person"><view class="entry-person-head"></view><view class="entry-person-body"></view><view class="entry-person-dot"></view></view>
				</view>
				<view class="nav-entry" @click="serviceNavVisible = true">
					<view class="entry-lines"><view></view><view></view><view></view></view>
				</view>
			</view>
			<view v-else-if="!managementCenterLoading" class="nav-help" @click="showHelp">
				<text class="nav-help-text">帮助</text>
			</view>
		</view>

		<MatchmakerPendingReview
			v-if="pendingReviewVisible"
			:initial-tab="pendingReviewInitialTab"
			:refresh-token="pendingReviewRefreshToken"
			@entry="openMemberEntryFromReview"
			@servedCount="onPendingReviewServedCount"
			@contact="onPendingReviewContact"
		/>
		<scroll-view v-else-if="workspaceVisible" scroll-y class="workspace-scroller" :class="{ 'ls-scroll': isLeadEntryStudio }" :show-scrollbar="false" :scroll-top="workspaceScrollTop">
			<view class="workspace-content" :class="{ 'lead-space': workspaceKind == 'lead' }">
				<view v-if="workspaceKind != 'remote' && workspaceKind != 'news'" class="workspace-heading">
					<text class="workspace-title">{{ workspaceTitle }}</text>
					<text v-if="workspaceKind != 'income-placeholder'" class="workspace-copy">{{ workspaceKind == 'entry' ? '提交后自动分派到您名下，信息仅用于平台牵线服务。' : '仅展示服务端已提供的数据，未开放能力不会创建本地记录。' }}</text>
				</view>
				<view v-if="workspaceKind != 'remote' && workspaceKind != 'entry' && workspaceKind != 'income-placeholder' && workspaceKind != 'news'" class="workspace-tabs">
					<view class="workspace-tabs-row">
						<view v-for="item in workspaceTabs" :key="item" class="workspace-tab" :class="{ active: workspaceActiveTab == item }" @click="selectWorkspaceTab(item)"><text>{{ item }}</text></view>
					</view>
				</view>
				<view v-if="workspaceKind != 'remote' && workspaceKind != 'entry' && workspaceKind != 'news' && workspaceKind != 'income-placeholder'" class="workspace-search"><text class="workspace-search-glyph">⌕</text><input class="workspace-search-input" :placeholder="workspaceSearchPlaceholder" placeholder-class="workspace-search-ph" :value="workspaceKeyword" confirm-type="search" @input="onWorkspaceKeywordInput" @confirm="runWorkspaceSearch"/></view>

				<view v-if="workspaceKind == 'income-placeholder'" class="workspace-state"><text>暂无记录</text></view>
				<view v-else-if="workspaceKind == 'commission'">
					<view class="workspace-cash"><text>资金结算</text><text class="workspace-cash-value">{{ workspaceTitle == '财务明细' ? workspaceFinanceTotal : workspaceCommissionTotal }}</text><text>{{ workspaceCashNote }}</text></view>

					<!-- 分成标准：各消费事件计提比例 -->
					<view v-if="workspaceActiveTab == '分成标准'">
						<view class="workspace-demo-notice"><text>平台尚未提供分成标准查询接口，请以平台确认的规则为准。</text></view>
						<view v-for="rate in workspaceCommissionRates" :key="rate.event" class="workspace-info-card">
							<view><text>{{ rate.event }}</text><text class="workspace-rate-value">{{ rate.rate }}</text></view>
							<text class="workspace-muted">{{ rate.note }}</text>
						</view>
					</view>

					<!-- 财务明细 · 结算说明 -->
					<view v-else-if="workspaceTitle == '财务明细' && workspaceActiveTab == '结算说明'" class="workspace-notice"><text class="workspace-notice-title">结算说明</text><text>线下业绩含门店服务、线下 VIP 与活动收款，由平台按月统一结算；当前逐笔记录取自本人作为销售红娘的线下 VIP 已收款订单。</text></view>

					<!-- 财务明细 · 逐笔记录：本人作为销售红娘的线下 VIP 已收款订单 -->
					<view v-else-if="workspaceTitle == '财务明细'">
						<view v-if="workspaceFinanceUsingDemoData" class="workspace-demo-notice"><text>当前显示本地测试数据；服务端产生线下业绩后将自动切换为真实数据。</text></view>
						<view v-if="workspaceFinanceLoading" class="workspace-state"><text>正在加载财务明细…</text></view>
						<view v-else-if="workspaceFinanceError.length > 0" class="workspace-state"><text>{{ workspaceFinanceError }}</text><text class="workspace-state-action" @click="loadWorkspaceOfflineIncome">重新加载</text></view>
						<view v-else-if="workspaceFinanceRows.length == 0" class="workspace-state"><text>暂时没有线下业绩记录</text></view>
						<view v-else>
							<view v-for="row in workspaceFinanceRows" :key="row.id" class="workspace-commission-row"><text>{{ row.time }}</text><view><image v-if="row.avatar.length > 0" :src="row.avatar" mode="aspectFill"/><view v-else class="workspace-commission-avatar"><text>{{ commissionAvatarText(row.name) }}</text></view><view><text>{{ row.name }}</text><text>{{ row.item }}</text></view><text>{{ row.amount }}</text></view></view>
						</view>
					</view>

					<!-- 分成明细 · 逐笔记录：会员名/头像按支付订单回带，事件名取分成规则 -->
					<view v-else>
						<view v-if="workspaceCommissionUsingDemoData" class="workspace-demo-notice"><text>当前显示本地测试数据；服务端产生分成记录后将自动切换为真实数据。</text></view>
						<view v-if="workspaceCommissionLoading" class="workspace-state"><text>正在加载分成明细…</text></view>
						<view v-else-if="workspaceCommissionError.length > 0" class="workspace-state"><text>{{ workspaceCommissionError }}</text><text class="workspace-state-action" @click="loadWorkspaceCommissionEntries">重新加载</text></view>
						<view v-else-if="workspaceCommissionRows.length == 0" class="workspace-state"><text>暂时没有分成记录</text></view>
						<view v-else>
							<view v-for="row in workspaceCommissionRows" :key="row.id" class="workspace-commission-row"><text>{{ row.time }}</text><view><image v-if="row.avatar.length > 0" :src="row.avatar" mode="aspectFill"/><view v-else class="workspace-commission-avatar"><text>{{ commissionAvatarText(row.name) }}</text></view><view><text>{{ row.name }}</text><text>{{ row.item }}</text></view><text>{{ row.amount }}</text></view></view>
						</view>
					</view>
				</view>

				<view v-else-if="workspaceKind == 'lead'">
					<view v-if="leadFollowPanelVisible" class="workspace-lead-follow-panel">
						<view class="workspace-follow-head">
							<text class="workspace-follow-back" @click="closeLeadFollowPanel">‹ 返回</text>
							<text class="workspace-follow-title">{{ leadFollowLeadName }} 的跟进记录</text>
						</view>
						<view v-if="leadFollowLoading" class="workspace-state"><text>正在加载跟进记录…</text></view>
						<view v-else-if="leadFollowError.length > 0" class="workspace-state"><text>{{ leadFollowError }}</text><text class="workspace-state-action" @click="loadLeadFollowRecords">重新加载</text></view>
						<view v-else-if="leadFollowRecords.length == 0" class="workspace-state"><text>暂时没有跟进记录，添加第一条跟进吧</text></view>
						<view v-else class="workspace-follow-list">
							<view v-for="rec in leadFollowRecords" :key="rec.id" class="workspace-follow-item">
								<view class="workspace-follow-item-top"><text class="workspace-follow-method">{{ rec.methodLabel }}</text><text class="workspace-follow-time">{{ rec.time }}</text></view>
								<text class="workspace-follow-content">{{ rec.content }}</text>
								<text v-if="rec.intentionLabel.length > 0" class="workspace-follow-intention">意向：{{ rec.intentionLabel }}</text>
							</view>
						</view>
						<view class="workspace-follow-form">
							<text class="workspace-follow-form-title">添加跟进</text>
							<view class="workspace-follow-methods">
								<view v-for="m in leadFollowMethods" :key="m.value" class="workspace-follow-method-chip" :class="{ active: leadFollowMethod == m.value }" @click="leadFollowMethod = m.value"><text>{{ m.label }}</text></view>
							</view>
							<textarea class="workspace-follow-textarea" :value="leadFollowContent" @input="leadFollowContent = $event.detail.value" placeholder="记录本次沟通内容（必填）" :maxlength="500" auto-height/>
							<view class="workspace-follow-submit" @click="submitLeadFollowUp"><text>提交跟进</text></view>
						</view>
					</view>
					<view v-else>
					<view class="workspace-notice"><text>总店超级红娘可查看全部客源，门店超级红娘查看本门店客源，普通红娘查看本人客源。</text></view>
					<view v-if="workspaceLeadsLoading" class="workspace-state"><text>正在加载客源数据…</text></view>
					<view v-else-if="workspaceLeadsError.length > 0" class="workspace-state"><text>{{ workspaceLeadsError }}</text><text class="workspace-state-action" @click="loadWorkspaceLeads">重新加载</text><text v-if="workspaceLeadsDiagnostic.length > 0" class="workspace-state-action" @tap="copyLeadDiagnostic">复制故障信息</text></view>
					<view v-else-if="workspaceVisibleLeads.length == 0" class="workspace-state"><text>没有符合条件的客源</text></view>
					<view v-else>
						<view v-for="row in workspaceVisibleLeads" :key="row.id" class="workspace-lead-card">
							<view class="workspace-lead-top">
								<view class="workspace-lead-name">
									<text class="workspace-lead-title">{{ row.name }}</text>
									<text class="workspace-lead-gender" :class="row.genderTone">{{ row.genderMark }}</text>
									<text v-if="row.age > 0" class="workspace-lead-age">{{ row.age }}岁</text>
								</view>
								<view class="workspace-lead-top-right">
									<view class="workspace-lead-intake" :class="row.intakeTone">
										<text class="workspace-lead-intake-label">{{ row.intakeLabel }}</text>
									</view>
									<text class="workspace-lead-time">{{ row.time }}</text>
								</view>
							</view>
								<view class="workspace-lead-rows">
									<view class="workspace-lead-row"><text>电话</text><text>{{ row.phone }}</text></view>
									<view class="workspace-lead-row"><text>微信</text><text>{{ row.wechat }}</text></view>
									<view class="workspace-lead-row"><text>来源</text><text>{{ row.source }}</text></view>
									<view class="workspace-lead-row"><text>录入人</text><text>{{ row.creator }}</text></view>
									<view class="workspace-lead-row" @click="openLeadStatusSheet(row)">
										<text>状态</text>
										<view class="workspace-lead-chip" :class="'workspace-lead-status-' + row.statusTone"><text>{{ row.statusLabel }}</text><text class="workspace-lead-chevron">›</text></view>
									</view>
									<view v-if="row.status == 'LOST'" class="workspace-lead-remark"><text>弃海原因</text><view class="workspace-lead-remark-box abandon"><text>{{ row.abandonReason.length > 0 ? row.abandonReason : '未填写原因' }}</text></view></view>
									<view class="workspace-lead-row" @click="openLeadAssignSheet(row)">
										<text>分派跟进</text>
										<view class="workspace-lead-value"><text>{{ row.owner }}</text><text class="workspace-lead-chevron">›</text></view>
									</view>
									<view class="workspace-lead-row" @click="openLeadFollowPanel(row)">
										<text>跟进</text>
										<view class="workspace-lead-value"><text :class="{ 'workspace-lead-stale': row.isStale }">{{ row.followSummary }}</text><text class="workspace-lead-chevron">›</text></view>
									</view>
									<view class="workspace-lead-row" @click="openLeadIntentionSheet(row)"><text>意向</text><view class="workspace-lead-chip workspace-lead-intention"><text>{{ row.intentionLabel }}</text><text class="workspace-lead-chevron">›</text></view></view>
									<view class="workspace-lead-remark"><text>备注</text><view class="workspace-lead-remark-box"><text>{{ row.remark || '暂无备注' }}</text></view></view>
								</view>
							<view class="workspace-actions">
								<text @click="openLeadEditSheet(row)">编辑</text>
								<text @click="copyLeadProfile(row)">复制资料</text>
								<text v-if="row.status != 'LOST'" @click="confirmAbandonLead(row)">移入弃海</text>
								<text v-else @click="confirmRestoreLead(row)">恢复客源</text>
								<text v-if="row.status != 'CONVERTED' && row.status != 'CLOSED' && row.status != 'LOST'" @click="confirmConvertLead(row)">一键入库</text>
								<text v-else-if="row.status == 'CONVERTED'" @click="showToast('已入库，编号 ' + row.convertedUserId)">已入库</text>
							</view>
						</view>
					</view>
					</view>
				</view>

				<view v-else-if="workspaceKind == 'match'">
					<view class="workspace-filter-note"><text>未回应或对方拒绝均待牵线；查看双方电话并确认已获得联系方式后进入牵线中，再确认已联系并记录结果。</text></view>
					<view v-if="!workspaceMatchesLoading && workspaceMatchesError.length == 0 && workspaceIntroductionWorkflowVersion != 2" class="workspace-filter-note"><text>服务端牵线流程尚未升级，请部署新版后端后再操作。</text></view>
					<view v-if="workspaceMatchesUsingDemoData" class="workspace-demo-notice"><text>当前显示本地测试数据；服务端产生记录后将自动切换为真实数据。</text></view>
					<view v-if="workspaceMatchesLoading" class="workspace-state"><text>正在加载牵线记录…</text></view>
					<view v-else-if="workspaceMatchesError.length > 0" class="workspace-state"><text>{{ workspaceMatchesError }}</text><text class="workspace-state-action" @click="loadWorkspaceMatches">重新加载</text></view>
					<view v-else-if="workspaceVisibleMatches.length == 0" class="workspace-state"><text>没有符合条件的牵线记录</text></view>
					<view v-else>
						<view v-for="row in workspaceVisibleMatches" :key="row.id" class="workspace-match-card">
							<view class="workspace-match-card-top"><text>申请时间：{{ row.time }}</text><view class="workspace-match-status-btn match-status-indicator" :class="'t-' + row.status" @click="openMatchStatusSheet(row)"><text>{{ row.statusLabel }}</text><view class="workspace-match-status-arrow"></view></view></view>
							<!-- 双人放大头像：按参考图做成两张圆角方图并排、中间压一枚心形徽标；点心形两侧任一图即以红娘权限进入该会员主页。 -->
							<view class="workspace-match-pair">
								<view class="workspace-match-col is-left">
									<view class="workspace-match-photo" @click="openWorkspaceMemberProfile(row.fromUser)"><image :src="row.fromUser.avatar" mode="aspectFill" class="workspace-match-photo-image" /></view>
									<view class="workspace-match-caption"><text class="workspace-match-role role-applicant">申请人</text><text class="workspace-match-caption-name">{{ row.fromUser.name }}</text><text class="workspace-match-gender" :class="row.fromUser.gender == '女' ? 'female' : 'male'">{{ row.fromUser.gender == '女' ? '♀' : '♂' }}</text><text v-if="isVipPerson(row.fromUser)" class="workspace-match-vip">VIP</text></view>
									<text class="workspace-match-caption-code">编号：{{ row.fromUser.id }}</text>
								</view>
								<view class="workspace-match-col is-right">
									<view class="workspace-match-photo" @click="openWorkspaceMemberProfile(row.toUser)"><image :src="row.toUser.avatar" mode="aspectFill" class="workspace-match-photo-image" /></view>
									<view class="workspace-match-caption"><text class="workspace-match-role role-target">被牵线方</text><text class="workspace-match-caption-name">{{ row.toUser.name }}</text><text class="workspace-match-gender" :class="row.toUser.gender == '女' ? 'female' : 'male'">{{ row.toUser.gender == '女' ? '♀' : '♂' }}</text><text v-if="isVipPerson(row.toUser)" class="workspace-match-vip">VIP</text></view>
									<text class="workspace-match-caption-code">编号：{{ row.toUser.id }}</text>
								</view>
								<!-- 彩带：缎带条（渐变高光+落地阴影）、卷花弧、亮片圆点三种形状混撒，压在照片之上、心形之下。 -->
								<view class="workspace-match-confetti strip mc-1"></view>
								<view class="workspace-match-confetti curl mc-2"></view>
								<view class="workspace-match-confetti dot mc-3"></view>
								<view class="workspace-match-confetti strip mc-4"></view>
								<view class="workspace-match-confetti strip mc-5"></view>
								<view class="workspace-match-confetti curl mc-6"></view>
								<view class="workspace-match-confetti dot mc-7"></view>
								<view class="workspace-match-confetti strip mc-8"></view>
								<view class="workspace-match-confetti strip mc-9"></view>
								<view class="workspace-match-confetti curl mc-10"></view>
								<view class="workspace-match-confetti dot mc-11"></view>
								<view class="workspace-match-confetti strip mc-12"></view>
								<view class="workspace-match-confetti strip mc-13"></view>
								<view class="workspace-match-confetti strip mc-14"></view>
								<view class="workspace-match-confetti dot mc-15"></view>
								<view class="workspace-match-confetti curl mc-16"></view>
								<view class="workspace-match-confetti dot mc-17"></view>
								<view class="workspace-match-confetti strip mc-18"></view>
								<view class="workspace-match-confetti dot mc-19"></view>
								<!-- 心形必须排在两列之后：微信小程序里它原先夹在两列之间，会被右侧头像压掉一半。 -->
								<!-- 交握的心：设计图原样（两个相叠色块 + 两手收尖手指互穿），排在两列之后才压得住照片。 -->
								<image class="workspace-match-heart" src="/static/generated/matchmaker-clasp-heart.webp" mode="aspectFit"></image>
							</view>
							<!-- 双方有效电话均查看后，由后端推进牵线中；查看单方或只有微信不会推进。 -->
							<view class="workspace-match-contact-row">
								<text class="workspace-match-role role-applicant">申请人</text>
								<view class="workspace-match-contact-body">
									<text v-if="row.fromContact.loading" class="workspace-match-contact-state">正在读取…</text>
									<text v-else-if="row.fromContact.error.length > 0" class="workspace-match-contact-state error">{{ row.fromContact.error }}</text>
									<view v-else-if="row.fromContact.revealed" class="workspace-match-contact-values">
										<text v-if="row.fromContact.phone.length > 0" class="workspace-match-contact-chip phone" @tap="copyWorkspaceContact(row.fromContact.phone)">{{ row.fromContact.phone }}</text>
										<text v-if="row.fromContact.wechat.length > 0" class="workspace-match-contact-chip wechat" @tap="copyWorkspaceContact(row.fromContact.wechat)">微信 {{ row.fromContact.wechat }}</text>
										<text v-if="row.fromContact.phone.length == 0 && row.fromContact.wechat.length == 0" class="workspace-match-contact-state">未留联系方式</text>
									</view>
									<text v-else class="workspace-match-contact-open" @tap="revealMatchContact(row, 'from')">查看联系方式</text>
								</view>
							</view>
							<view class="workspace-match-contact-row">
								<text class="workspace-match-role role-target">被牵线方</text>
								<view class="workspace-match-contact-body">
									<text v-if="row.toContact.loading" class="workspace-match-contact-state">正在读取…</text>
									<text v-else-if="row.toContact.error.length > 0" class="workspace-match-contact-state error">{{ row.toContact.error }}</text>
									<view v-else-if="row.toContact.revealed" class="workspace-match-contact-values">
										<text v-if="row.toContact.phone.length > 0" class="workspace-match-contact-chip phone" @tap="copyWorkspaceContact(row.toContact.phone)">{{ row.toContact.phone }}</text>
										<text v-if="row.toContact.wechat.length > 0" class="workspace-match-contact-chip wechat" @tap="copyWorkspaceContact(row.toContact.wechat)">微信 {{ row.toContact.wechat }}</text>
										<text v-if="row.toContact.phone.length == 0 && row.toContact.wechat.length == 0" class="workspace-match-contact-state">未留联系方式</text>
									</view>
									<text v-else class="workspace-match-contact-open" @tap="revealMatchContact(row, 'to')">查看联系方式</text>
								</view>
							</view>
							<text v-if="row.status == 'PENDING'" class="workspace-match-reason">{{ row.applicationResponse == 'REJECTED' ? '对方拒绝' : '未回应' }}{{ row.responseReason.length > 0 ? '：' + row.responseReason : '' }}</text>
							<text v-if="row.status == 'PENDING' || row.status == 'IN_PROGRESS'" class="workspace-match-owner">电话查看：申请人{{ row.fromPhoneViewed ? '已查看' : '未查看' }} · 被牵线方{{ row.toPhoneViewed ? '已查看' : '未查看' }}</text>
							<text v-if="row.status == 'FAILED' && row.failureReason.length > 0" class="workspace-match-reason">失败原因：{{ row.failureReason }}</text>
							<view v-if="row.status == 'IN_PROGRESS'" class="match-contact-action" hover-class="match-contact-action-pressed" @tap="openMatchStatusSheet(row)">
								<text class="match-contact-action-label">确认已联系并记录对方态度</text>
							</view>
							<view v-if="row.status == 'PENDING' && row.fromPhoneViewed && row.toPhoneViewed" class="workspace-actions"><text @tap="confirmMatchContactsObtained(row)">确认已获得双方联系方式</text></view>
							<text class="workspace-match-owner">服务红娘：{{ row.owner }}</text>
						</view>
					</view>
				</view>
				<view v-else-if="workspaceKind == 'meeting'">
					<view class="workspace-filter-note"><text>接受申请后安排时间地点；已联系双方且双方均同意时，也可直接添加约会。约会完成后须填写跟进记录。</text></view>
					<view v-if="workspaceMeetingsLoaded && workspaceMeetingWorkflowVersion != 2" class="workspace-filter-note"><text>服务端约会流程尚未升级，请部署新版后端后再安排或完成约会。</text></view>
					<view v-if="workspaceMeetingsLoading" class="workspace-state"><text>正在加载约会记录…</text></view>
					<view v-else-if="workspaceMeetingsError.length > 0" class="workspace-state"><text>{{ workspaceMeetingsError }}</text><text class="workspace-state-action" @click="loadWorkspaceMeetings">重新加载</text></view>
					<view v-else-if="workspaceVisibleMeetings.length == 0" class="workspace-state"><text>没有符合条件的约会记录</text></view>
					<view v-else>
						<view v-for="row in workspaceVisibleMeetings" :key="row.id" class="workspace-match-card">
							<view class="workspace-match-card-top"><text>申请时间：{{ row.createdAt }}</text><view class="workspace-match-status-btn match-status-indicator" :class="row.phase == 'FAILED' ? 't-FAILED' : (row.phase == 'COMPLETED' ? 't-SUCCEEDED' : (row.phase == 'PROCESSING' ? 't-IN_PROGRESS' : 't-PENDING'))"><text>{{ row.statusLabel }}</text><view class="workspace-match-status-arrow"></view></view></view>
							<view class="meeting-invitation">
								<view class="meeting-invitation-portraits">
									<view class="meeting-invitation-portrait" @tap="openWorkspaceMemberProfile(row.applicant)"><image :src="row.applicant.avatar" mode="aspectFill" class="meeting-invitation-image" /></view>
									<view class="meeting-invitation-portrait meeting-invitation-target" @tap="openWorkspaceMemberProfile(row.target)"><image :src="row.target.avatar" mode="aspectFill" class="meeting-invitation-image" /></view>
								</view>
								<text class="meeting-invitation-title"><text class="meeting-invitation-name">{{ row.applicant.name }}</text> 想要约见 <text class="meeting-invitation-name">{{ row.target.name }}</text></text>
								<view class="meeting-invitation-members">
									<view class="meeting-invitation-member"><text class="workspace-match-role role-applicant">申请人</text><text class="workspace-match-caption-code">编号：{{ row.applicant.id }}</text></view>
									<view class="meeting-invitation-member"><text class="workspace-match-role role-target">被邀请方</text><text class="workspace-match-caption-code">编号：{{ row.target.id }}</text></view>
								</view>
							</view>
							<text class="workspace-match-owner">{{ row.detail }}</text>
							<text v-if="row.note.length > 0" class="workspace-match-owner">申请说明：{{ row.note }}</text>
							<view v-if="row.meeting != null" class="workspace-filter-note"><view><text>约会时间：{{ row.meeting.scheduledAt }}</text></view><view><text>约会地点：{{ row.meeting.location }}</text></view></view>
							<view v-if="row.meeting != null && row.meeting.followUpContent.length > 0" class="workspace-filter-note"><text>跟进记录：{{ row.meeting.followUpContent }}</text></view>
							<view v-if="row.phase == 'PROCESSING' || (row.phase == 'UPCOMING' && row.meeting == null)" class="workspace-actions">
								<text v-if="row.phase == 'PROCESSING'" @tap="openMeetingStatusSheet(row)">联系双方并记录意愿</text>
								<text v-if="row.phase == 'UPCOMING' && row.meeting == null" @tap="openMeetingScheduleSheet(row)">安排时间地点</text>
							</view>
							<view v-if="row.phase == 'UPCOMING' && row.meeting != null" class="match-contact-action" hover-class="match-contact-action-pressed" @tap="openMeetingRecordSheet(row)">
								<text class="match-contact-action-label">填写跟进 / 完成约会</text>
							</view>
							<text class="workspace-match-owner">服务红娘：{{ row.owner }}</text>
						</view>
					</view>
				</view>

				<view v-else-if="workspaceKind == 'entry' && workspaceTitle == '录入会员'" class="workspace-entry-page">
					<view class="workspace-entry-hero">
						<view class="workspace-entry-hero-copy">
							<text class="workspace-entry-hero-title">分派提示</text>
							<text class="workspace-entry-hero-sub">录入的会员进入待审核名单并挂到您名下，审核通过后开始参与匹配推荐</text>
						</view>
						<view class="workspace-entry-demo" @click="fillMemberDemo"><text>{{ memberEntryFilled ? '清空示例' : '填充示例' }}</text></view>
					</view>

					<view class="workspace-entry-formcard workspace-entry-formcard-typo">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">1</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">建号信息</text><text class="workspace-entry-card-require">姓名、昵称、手机为必填，其余资料下一步在同一页填写</text></view></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">姓名</text><input :value="memberEntry.realName" @input="memberEntry.realName = $event.detail.value" placeholder="真实姓名（保密存储）" :maxlength="20"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">昵称</text><input :value="memberEntry.nickname" @input="memberEntry.nickname = $event.detail.value" placeholder="会员展示昵称" :maxlength="20"/></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">性别</text>
							<view class="ls-chips">
								<view class="ls-chip ls-tone-blue" :class="{ active: memberEntry.gender == 1 }" @click="memberEntry.gender = memberEntry.gender == 1 ? 0 : 1"><text>男</text></view>
								<view class="ls-chip ls-tone-pink" :class="{ active: memberEntry.gender == 2 }" @click="memberEntry.gender = memberEntry.gender == 2 ? 0 : 2"><text>女</text></view>
							</view>
						</view>
						<view class="workspace-entry-row last"><text class="workspace-entry-label">手机</text><input :value="memberEntry.phone" @input="memberEntry.phone = $event.detail.value" placeholder="11 位手机号" type="number" :maxlength="11"/></view>
					</view>

					<view v-if="memberEntryError.length > 0" class="workspace-form-error"><text>{{ memberEntryError }}</text></view>

					<view class="workspace-entry-submit" :class="{ disabled: memberEntrySubmitting }" @click="submitMemberEntry"><text>{{ memberEntrySubmitting ? '提交中…' : '建号并补资料' }}</text></view>
					<view class="workspace-entry-foot"><text>建号后立刻打开「编辑资料」补齐会员资料，与会员本人填写的是同一张表单；未补齐前会员仍在待审名单</text></view>
				</view>

				<view v-else-if="workspaceKind == 'entry' && workspaceTitle == '录入客源线索'" class="workspace-entry-page lead-studio">
					<!-- 顶部提示：漂浮标题卡 -->
					<view class="ls-hero">
						<view class="ls-hero-copy">
							<text class="ls-hero-title">新增一位客源</text>
							<text class="ls-hero-sub">您录入的客源将挂到您名下，平台核实后即可开始跟进</text>
						</view>
						<view class="ls-hero-demo" @click="fillLeadDemo"><text>{{ leadDemoFilled ? '清空' : '示例' }}</text></view>
					</view>

					<!-- 联系方式 -->
					<text class="ls-section">联系方式</text>
					<view class="ls-card">
						<view class="ls-field">
							<text class="ls-label">姓名</text>
							<input :value="leadFormRealName" @input="leadFormRealName = $event.detail.value" placeholder="客户真实姓名（选填）" :maxlength="20"/>
						</view>
						<view class="ls-field">
							<text class="ls-label">称呼</text>
							<input :value="leadFormName" @input="onLeadFormNameInput" placeholder="如：李阿姨介绍的小雅" :maxlength="20"/>
							<view class="ls-auto" :class="{ checked: leadAutoName }" @click="toggleLeadAutoName">
								<view class="ls-auto-head">
									<view class="ls-auto-box"><text v-if="leadAutoName" class="ls-auto-tick">✓</text></view>
									<text class="ls-auto-title">自动生成称呼</text>
									<text class="ls-auto-code">{{ leadAutoName ? (leadAutoNameCode.length > 0 ? leadAutoNameCode : '正在获取客源编号…') : '关闭' }}</text>
								</view>
								<text class="ls-auto-sub">按客源编号命名，例如第一位客源线索写 客源_1；勾选后手动改动即退出自动生成</text>
							</view>
						</view>
						<view class="ls-field">
							<text class="ls-label">电话</text>
							<input :value="leadFormPhone" @input="leadFormPhone = $event.detail.value" placeholder="手机号（必填，用于联系与入库）" type="number" :maxlength="11"/>
						</view>
						<view class="ls-field">
							<text class="ls-label">微信</text>
							<input :value="leadFormWechat" @input="leadFormWechat = $event.detail.value" placeholder="微信号（选填），可与电话相同"/>
						</view>
					</view>

					<!-- 客源画像 -->
					<text class="ls-section">客源画像</text>
					<view class="ls-card">
						<view class="ls-field">
							<text class="ls-label">性别</text>
							<view class="ls-chips">
								<view class="ls-chip ls-tone-blue" :class="{ active: leadFormGender == 1 }" @click="leadFormGender = leadFormGender == 1 ? 0 : 1"><text>男</text></view>
								<view class="ls-chip ls-tone-pink" :class="{ active: leadFormGender == 2 }" @click="leadFormGender = leadFormGender == 2 ? 0 : 2"><text>女</text></view>
							</view>
						</view>
						<view class="ls-field">
							<text class="ls-label">出生年月日</text>
							<picker mode="date" :value="leadFormBirthday" start="1940-01-01" end="2008-12-31" @change="onLeadFormBirthday">
								<view class="ls-picker"><text :class="{ 'ls-placeholder': leadFormBirthday.length == 0 }">{{ leadFormBirthday.length > 0 ? leadFormBirthday : '请选择出生年月日' }}</text><i></i></view>
							</picker>
						</view>
						<view class="ls-field">
							<text class="ls-label">照片</text>
							<view class="lead-photo-upload">
								<image v-if="leadFormPhoto.length > 0" class="lead-photo-preview" :src="leadFormPhoto" mode="aspectFill" @click="previewLeadPhoto"/>
								<view v-else class="lead-photo-add" @click="chooseLeadPhoto"><text class="lead-photo-plus">＋</text><text>上传照片</text></view>
								<text v-if="leadFormPhoto.length > 0" class="lead-photo-remove" @click="leadFormPhoto = ''">移除</text>
							</view>
						</view>
						<view class="ls-field" :class="{ 'ls-field-floating': leadFormSourcePickerVisible }">
							<text class="ls-label">来源渠道</text>
							<view class="workspace-select">
								<view class="workspace-select-trigger" @click="leadFormSourcePickerVisible = !leadFormSourcePickerVisible">
									<text :class="{ 'workspace-select-placeholder': leadFormSource.length == 0 }">{{ leadFormSourceLabel }}</text>
									<view class="workspace-select-caret"><view class="workspace-select-caret-up"></view><view class="workspace-select-caret-down"></view></view>
								</view>
								<view v-if="leadFormSourcePickerVisible" class="workspace-select-menu">
									<view v-for="src in leadSourceOptions" :key="src" class="workspace-select-option" :class="{ active: leadFormSource == src }" @click="pickLeadFormSource(src)"><text>{{ src }}</text></view>
								</view>
							</view>
						</view>
						<view class="ls-field">
							<view class="ls-label-row"><text class="ls-label">补充描述</text><text class="ls-count">{{ leadFormRemark.length }}/500</text></view>
							<textarea class="ls-textarea" :value="leadFormRemark" @input="leadFormRemark = $event.detail.value" placeholder="职业、学历、身高、婚况、收入、择偶需求等，便于后续匹配推荐" :maxlength="500" auto-height/>
						</view>
					</view>

					<view v-if="leadFormError.length > 0" class="ls-error"><text>{{ leadFormError }}</text></view>

					<view class="ls-submit" :class="{ disabled: leadFormSubmitting }" @click="submitLeadForm"><text>{{ leadFormSubmitting ? '提交中…' : '确定提交' }}</text></view>
					<view class="ls-foot"><text>提交即表示信息经本人确认，仅用于平台牵线服务</text></view>
				</view>

				<view v-else-if="workspaceKind == 'member'">
					<view v-if="workspaceMembersLoading" class="workspace-state"><text>正在加载会员数据…</text></view>
					<view v-else-if="workspaceMembersError.length > 0" class="workspace-state"><text>{{ workspaceMembersError }}</text><text class="workspace-state-action" @click="loadWorkspaceMembers">重新加载</text></view>
					<view v-else-if="workspaceVisibleMembers.length == 0" class="workspace-state"><text>没有符合条件的会员</text></view>
					<view v-else><view v-for="member in workspaceVisibleMembers" :key="member.id" class="workspace-info-card"><view class="workspace-member-header"><image :src="member.avatar" mode="aspectFill"/><view><text>{{ member.name }} · {{ member.gender }}</text><text>编号：{{ member.id }} · {{ member.type }}</text></view></view><view><text>服务红娘</text><text>{{ member.owner }}</text></view><view><text>资料状态</text><text>{{ member.status }}</text></view><view class="workspace-actions"><text @click="openPendingReview('mine')">详细资料</text><text @click="openPendingReview('mine')">服务跟进</text><text @click="openWorkspace('牵线记录', 'match')">牵线记录</text></view></view></view>
				</view>

				<view v-else-if="workspaceKind == 'activity'">
					<view class="workspace-demo-notice"><text>远端尚未开放红娘活动报名管理。</text></view>
					<view v-for="activity in workspaceActivities" :key="activity.title" class="workspace-info-card"><text>{{ activity.title }}</text><text class="workspace-muted">{{ activity.time }} · {{ activity.city }}</text><view><text>报名人数</text><text>{{ activity.count }} 人</text></view><view><text>审核状态</text><text>{{ activity.status }}</text></view><view class="workspace-actions"><text @click="showToast('远端暂未开放活动管理')">报名名单</text><text @click="showToast('远端暂未开放活动管理')">编辑</text><text @click="showToast('远端暂未开放活动管理')">报名审核</text></view></view>
				</view>

				<MatchmakerGoodNews v-else-if="workspaceKind == 'news'" ref="goodNewsPanel" :display-name="goodNewsDisplayName" :initial-item-id="goodNewsInitialItem" :initial-kind="goodNewsInitialKind" @title="workspaceTitle = $event" @resetScroll="resetGoodNewsScroll" @profile="openGoodNewsPerson" @shareInfo="goodNewsShare = $event"/>

				<view v-else><view v-for="row in workspaceGenericRows" :key="row.title" class="workspace-generic-card"><view><text>{{ row.icon }}</text></view><view><text>{{ row.title }}</text><text>{{ row.desc }}</text></view><text @click="showToast(row.action)">{{ row.action }} ></text></view></view>
			</view>
			<view v-if="workspaceKind != 'remote' && workspaceKind != 'meeting' && workspaceKind != 'entry' && workspaceKind != 'news' && workspaceKind != 'lead' && workspaceKind != 'match' && workspaceKind != 'income-placeholder'" class="workspace-add" @click="showToast('远端暂未开放此功能')"><text>+</text><text>添加</text></view>
			<!-- 牵线记录：添加入口照搬资料待审的悬浮录入键（同款浅底圆形 + ✎ 字形） -->
			<view v-if="workspaceKind == 'match'" class="match-float-actions">
				<view class="fab-match-add" @click="openMatchAddSheet"><text class="fab-match-glyph">✎</text><text>添加</text></view>
			</view>
			<view v-if="workspaceKind == 'meeting'" class="match-float-actions">
				<view class="fab-match-add" @tap="openMeetingCreateSheet"><text class="fab-match-glyph">✎</text><text>添加约会</text></view>
			</view>
			<!-- 客源线索：添加与筛选入口照搬资料待审的悬浮录入键（成对、右下角、同款圆形浅底） -->
			<view v-if="workspaceKind == 'lead' && !leadFollowPanelVisible" class="lead-float-actions">
				<view class="fab-lead-add" @click="openLeadAddSheet"><text class="fab-lead-glyph">✎</text><text>添加</text></view>
				<view class="fab-lead-filter" :class="{ active: leadFilterStatus.length > 0 || leadFilterIntention > 0 }" @click="openLeadFilterSheet"><text class="fab-lead-glyph">☲</text><text>筛选</text></view>
			</view>

		</scroll-view>
		<MatchmakerManagementCenter
			v-else-if="managementCenterVisible && managementCenterSnapshot != null"
			:snapshot="managementCenterSnapshot"
			@exit="exitManagementCenter"
			@refresh="refreshManagementCenter"
			@identity="openMatchmakerIdentity"
			@action="handleManagementCenterAction"
		/>
		<view v-else-if="managementCenterLoading" class="management-center-loading">
			<view class="management-loading-card management-loading-identity"></view>
			<view class="management-loading-tabs">
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill short"></view>
			</view>
			<view class="management-loading-heading"></view>
			<view class="management-loading-grid">
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
			</view>
		</view>

		<scroll-view v-else scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- Banner 宣传区域 -->
				<view class="banner-card">
					<view class="banner-copy">
						<text class="banner-kicker">红娘招募</text>
						<text class="banner-title">用你的真诚经验，帮助更多人稳稳靠近幸福</text>
						<text class="banner-desc">提交资料后，平台将尽快联系你确认服务信息。</text>
					</view>
				</view>

				<!-- 服务端确认服务红娘角色有效后即可进入；本期不以支付作为门槛。 -->
				<view class="management-entry" :class="{ ready: canEnterManagementCenter }">
					<view class="management-entry-copy">
					<view class="management-entry-title-row">
						<text class="management-entry-title">红娘管理中心</text>
					</view>
						<text class="management-entry-desc">{{ managementAccessDescription }}</text>
					</view>
					<view
						class="management-entry-action"
						:class="{ disabled: !canEnterManagementCenter || managementAccessLoading || managementCenterLoading }"
						@click="openManagementCenter"
					>
						<text>{{ managementAccessActionText }}</text>
					</view>
				</view>

				<!-- 基本信息 -->
				<view class="form-card">
					<text class="section-title">基本信息</text>
					<text class="section-desc">用于身份核验与平台联系，信息不会对外公开。</text>

					<view class="form-field">
						<text class="field-label">真实姓名 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="realName"
							placeholder="请填写真实姓名"
							@input="onRealNameInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">手机号 <text class="required">*</text></text>
						<input
							class="field-input"
							type="number"
							maxlength="11"
							:value="phone"
							placeholder="用于接收审核通知"
							@input="onPhoneInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">微信号 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="wechat"
							placeholder="便于平台工作人员后续沟通"
							@input="onWechatInput"
						/>
					</view>
				</view>

				<!-- 红娘资料 -->
				<view class="form-card">
					<text class="section-title">红娘资料</text>
					<text class="section-desc">展示给用户的专业形象，建议完整填写。</text>

					<!-- 上传头像 -->
					<view class="form-field">
						<text class="field-label">上传头像 <text class="required">*</text></text>
						<view class="avatar-upload" @click="uploadAvatar">
							<image
								v-if="avatar.length > 0"
								class="avatar-preview"
								:src="avatar"
								mode="aspectFill"
							></image>
							<view v-else class="avatar-placeholder">
								<text class="avatar-plus">+</text>
								<text class="avatar-hint">点击上传头像</text>
							</view>
						</view>
						<text class="field-hint">建议使用真实、清晰的正面照，裁剪比例 1:1</text>
					</view>

					<!-- 个人简介 -->
					<view class="form-field">
						<text class="field-label">个人简介 <text class="required">*</text></text>
						<textarea
							class="field-textarea"
							:value="introduction"
							maxlength="200"
							placeholder="简短介绍你的背景、经验和风格，例如：专注高知青年牵线服务，已有5年经验。"
							@input="onIntroductionInput"
						/>
						<text class="field-counter">{{ introduction.length }}/200</text>
					</view>

					<!-- 擅长领域 -->
					<view class="form-field">
						<text class="field-label">擅长领域 <text class="required">*</text></text>
						<view class="specialty-grid">
							<view
								v-for="item in specialtyOptions"
								:key="item"
								class="specialty-chip"
								:class="{ selected: specialties.indexOf(item) >= 0 }"
								@click="toggleSpecialty(item)"
							>
								<text>{{ item }}</text>
							</view>
						</view>
					</view>

					<!-- 服务价格 -->
					<view class="form-field">
						<text class="field-label">服务价格 <text class="optional">选填</text></text>
						<view class="price-input-row">
							<text class="price-prefix">¥</text>
							<input
								class="price-input"
								type="digit"
								:value="price"
								placeholder="不填则默认免费咨询"
								@input="onPriceInput"
							/>
							<text class="price-suffix">/次</text>
						</view>
					</view>
				</view>

				<!-- 成功案例 -->
				<view class="form-card">
					<view class="section-title-row">
						<text class="section-title">成功案例</text>
						<text class="optional-label">选填</text>
					</view>
					<text class="section-desc">展示过往牵线经验，增强可信度。内容需脱敏处理，避免泄露用户隐私。</text>

					<view
						v-for="(caseItem, index) in successCases"
						:key="index"
						class="case-block"
					>
						<view class="case-block-header">
							<text class="case-block-title">案例 {{ index + 1 }}</text>
							<view class="case-delete" @click="removeCase(index)">
								<text>删除</text>
							</view>
						</view>

						<view class="form-field">
							<text class="field-label">案例描述</text>
							<textarea
								class="field-textarea case-textarea"
								:value="caseItem.description"
								maxlength="50"
								placeholder="例如：成功帮助一位教师与工程师牵线。"
								@input="(e: any) => onCaseDescriptionInput(index, e)"
							/>
						</view>

						<view class="form-field">
							<text class="field-label">案例图片</text>
							<view class="case-images">
								<view
									v-for="(img, imgIndex) in caseItem.images"
									:key="imgIndex"
									class="case-image-item"
								>
									<image class="case-image-preview" :src="img" mode="aspectFill"></image>
									<view class="case-image-delete" @click="removeCaseImage(index, imgIndex)">
										<text>×</text>
									</view>
								</view>
								<view
									v-if="caseItem.images.length < 3"
									class="case-image-add"
									@click="uploadCaseImage(index)"
								>
									<text class="case-add-plus">+</text>
								</view>
							</view>
						</view>
					</view>

					<view class="add-case-button" @click="addCase" v-if="successCases.length < 3">
						<text>+ 添加案例</text>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="form-card process-card">
					<text class="section-title">审核流程</text>
					<text class="section-desc">提交申请后，预计 1-3 个工作日内完成审核。</text>

					<view class="process-steps">
						<view
							v-for="(step, index) in processSteps"
							:key="step.title"
							class="process-step"
						>
							<view class="step-indicator" :class="{ active: index === 0, done: index < currentStep }">
								<text v-if="index < currentStep">✓</text>
								<text v-else>0{{ index + 1 }}</text>
							</view>
							<view class="step-copy">
								<text class="step-title">{{ step.title }}</text>
								<text class="step-desc">{{ step.desc }}</text>
							</view>
							<view v-if="index < processSteps.length - 1" class="step-line"></view>
						</view>
					</view>

					<!-- 咨询入口 -->
					<view class="consult-icons">
						<view class="phone-slot" @click="callConsult">
							<image class="phone-brand" src="/static/icons/phone-call.svg" mode="aspectFit"></image>
						</view>
						<view class="wechat-slot" @click="wechatConsult">
							<image class="wechat-brand" src="/static/icons/wechat-bubble.svg" mode="aspectFit"></image>
						</view>
					</view>
				</view>

				<!-- 微信二维码弹窗 -->
				<view class="qr-overlay" v-if="qrVisible" @click="qrVisible = false">
					<view class="qr-card" @click.stop>
						<view class="qr-close" @click="qrVisible = false">
							<text>×</text>
						</view>
						<text class="qr-title">微信扫码咨询</text>
						<text class="qr-subtitle">添加客服微信，备注"红娘入驻咨询"</text>
						<view class="qr-image-wrap">
							<image class="qr-image" src="/static/qrcodes/kefu-wechat.webp" mode="aspectFit"></image>
						</view>
						<text class="qr-tip">长按识别二维码添加</text>
					</view>
				</view>

				<!-- 隐私声明 -->
				<view class="privacy-card">
					<text class="privacy-title">隐私与安全</text>
					<text class="privacy-copy">你所提交的全部资料将受到平台隐私协议保护，仅用于红娘资质审核与服务安排。请如实填写，不要提交他人的联系方式或敏感身份信息。审核通过后，你可在个人设置中随时管理展示范围。</text>
				</view>

				<!-- 底部占位 -->
				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<!-- 底部提交按钮 -->
		<view v-if="!pendingReviewVisible && !workspaceVisible && !managementCenterVisible && !managementCenterLoading" class="footer-safe">
			<view
				class="submit-button"
				:class="{ disabled: !canSubmit || submitting }"
				@click="submitApplication"
			>
				<text>{{ submitting ? '提交中…' : (canSubmit ? '提交申请' : '请补全必填信息') }}</text>
			</view>
		</view>

		<!-- 线索：状态选择 -->
		<XsaSheet :visible="leadStatusSheetVisible" title="状态" @close="leadStatusSheetVisible = false">
			<view class="workspace-option-list">
				<view v-for="opt in leadStatusOptions" :key="opt.value" class="workspace-option" :class="{ disabled: opt.disabled, selected: leadStatusCurrent == opt.value }" @click="opt.disabled ? showToast('已入库的客源不可回退') : selectLeadStatus(opt.value)">
					<text>{{ opt.label }}</text>
					<text v-if="leadStatusCurrent == opt.value" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：意向选择 -->
		<XsaSheet :visible="leadIntentionSheetVisible" title="意向" @close="leadIntentionSheetVisible = false">
			<view class="workspace-option-list">
				<view v-for="opt in leadIntentionOptions" :key="opt.value" class="workspace-option" :class="{ selected: leadIntentionCurrent == opt.value }" @click="selectLeadIntention(opt.value)">
					<text>{{ opt.label }}</text>
					<text v-if="leadIntentionCurrent == opt.value" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：分派跟进 -->
		<XsaSheet :visible="leadAssignSheetVisible" title="分派跟进" @close="leadAssignSheetVisible = false">
			<view v-if="leadFollowersLoading" class="workspace-state"><text>正在加载红娘列表…</text></view>
			<view v-else class="workspace-option-list">
				<view v-for="f in leadFollowers" :key="f.userId" class="workspace-option" :class="{ selected: leadAssignCurrent == f.userId }" @click="selectLeadAssign(f)">
					<text>{{ f.displayName }}{{ f.isSelf ? '（我）' : '' }}</text>
					<text v-if="leadAssignCurrent == f.userId" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：筛选 -->
		<XsaSheet :visible="leadFilterSheetVisible" title="筛选客源" @close="leadFilterSheetVisible = false">
			<view class="workspace-filter-group">
				<text class="workspace-filter-label">状态</text>
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: leadFilterStatus.length == 0 }" @click="leadFilterStatus = []"><text>全部</text></view>
					<view v-for="opt in leadStatusOptions" :key="opt.value" class="workspace-filter-chip" :class="{ active: leadFilterStatus.indexOf(opt.value) >= 0 }" @click="toggleLeadFilterStatus(opt.value)"><text>{{ opt.label }}</text></view>
				</view>
			</view>
			<view class="workspace-filter-group">
				<text class="workspace-filter-label">意向级别</text>
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: leadFilterIntention == 0 }" @click="leadFilterIntention = 0"><text>全部</text></view>
					<view v-for="opt in leadIntentionOptions" :key="opt.value" class="workspace-filter-chip intention-filter-chip" :class="{ active: leadFilterIntention == opt.value }" @click="leadFilterIntention = opt.value"><text>{{ opt.label }}</text></view>
				</view>
			</view>
			<view class="workspace-sheet-actions">
				<view class="workspace-sheet-btn ghost" @click="resetLeadFilter"><text>重置</text></view>
				<view class="workspace-sheet-btn" @click="applyLeadFilter"><text>确认</text></view>
			</view>
		</XsaSheet>

		<!-- 线索：添加 / 编辑 -->
		<XsaSheet :visible="leadFormSheetVisible" :title="leadFormIsEdit ? '编辑线索' : '添加线索'" @close="leadFormSheetVisible = false">
			<view class="workspace-lead-form">
				<view class="workspace-form-row"><text>姓名</text><input :value="leadFormRealName" @input="leadFormRealName = $event.detail.value" placeholder="真实姓名（选填）"/></view>
				<view class="workspace-form-row"><text>称呼</text><input :value="leadFormName" @input="leadFormName = $event.detail.value" placeholder="客户称呼（必填）"/></view>
				<view class="workspace-form-row"><text>电话</text><input :value="leadFormPhone" @input="leadFormPhone = $event.detail.value" placeholder="手机号（必填）" type="number" :maxlength="11"/></view>
				<view class="workspace-form-row"><text>微信</text><input :value="leadFormWechat" @input="leadFormWechat = $event.detail.value" placeholder="微信号"/></view>
				<view class="workspace-form-row"><text>性别</text>
					<view class="workspace-entry-options">
						<view class="workspace-entry-option" :class="{ selected: leadFormGender == 1 }" @click="leadFormGender = leadFormGender == 1 ? 0 : 1"><text class="workspace-entry-radio"></text><text>男</text></view>
						<view class="workspace-entry-option" :class="{ selected: leadFormGender == 2 }" @click="leadFormGender = leadFormGender == 2 ? 0 : 2"><text class="workspace-entry-radio"></text><text>女</text></view>
					</view>
				</view>
				<picker class="workspace-form-row workspace-form-picker" mode="date" :value="leadFormBirthday" start="1940-01-01" end="2008-12-31" @change="onLeadFormBirthday">
					<text>出生年月日</text>
					<view class="workspace-form-picker-value"><text>{{ leadFormBirthday.length > 0 ? leadFormBirthday : '请选择' }}</text><text class="workspace-entry-chevron">›</text></view>
				</picker>
				<view class="workspace-form-row"><text>照片</text>
					<view class="lead-photo-upload">
						<image v-if="leadFormPhoto.length > 0" class="lead-photo-preview" :src="leadFormPhoto" mode="aspectFill" @click="previewLeadPhoto"/>
						<view v-else class="lead-photo-add" @click="chooseLeadPhoto"><text class="lead-photo-plus">＋</text><text>上传照片</text></view>
						<text v-if="leadFormPhoto.length > 0" class="lead-photo-remove" @click="leadFormPhoto = ''">移除</text>
					</view>
				</view>
				<view class="workspace-form-row"><text>来源渠道</text>
					<view class="workspace-entry-options workspace-entry-options-wrap">
						<view v-for="c in leadSourceOptions" :key="c" class="workspace-entry-chip" :class="{ active: leadFormSource == c }" @click="leadFormSource = leadFormSource == c ? '' : c"><text>{{ c }}</text></view>
					</view>
				</view>
				<view class="workspace-form-row"><text>备注</text><input :value="leadFormRemark" @input="leadFormRemark = $event.detail.value" placeholder="补充说明"/></view>
				<view v-if="leadFormError.length > 0" class="workspace-form-error"><text>{{ leadFormError }}</text></view>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="leadFormSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: leadFormSubmitting }" @click="submitLeadForm"><text>{{ leadFormSubmitting ? '保存中…' : '保存' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 约见申请：审核状态 / 删除确认 -->
		<XsaSheet :visible="matchStatusSheetVisible" title="牵线状态" @close="matchStatusSheetVisible = false">
			<view class="workspace-match-status-form">
				<view class="workspace-filter-note" @tap="matchContactConfirmed = !matchContactConfirmed"><text>{{ matchContactConfirmed ? '☑' : '☐' }} 我已联系双方，并了解被牵线方的态度</text></view>
				<view class="workspace-match-status-choices">
					<view v-for="opt in matchStatusOptions" :key="opt.value" class="workspace-match-status-choice" :class="{ active: matchStatusChoice == opt.value }" @click="matchStatusChoice = opt.value"><text>{{ opt.label }}</text></view>
				</view>
				<textarea v-if="matchStatusChoice == 'FAILED'" class="workspace-entry-textarea" :value="matchFailureReason" @input="matchFailureReason = $event.detail.value" placeholder="请填写被牵线方态度及失败原因" :maxlength="500" auto-height/>
				<view class="workspace-match-status-submit" :class="{ disabled: matchStatusSubmitting }" @click="submitMatchStatus"><text>{{ matchStatusSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>
				<XsaSheet :visible="matchAddSheetVisible" title="添加牵线记录" @close="matchAddSheetVisible = false">
			<view class="workspace-match-add-form">
				<view class="workspace-match-add-row" @click="openMatchAddPicker('from')"><text class="workspace-match-add-label">牵线会员</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddFromName == '' }">{{ matchAddFromName == '' ? '请选择' : matchAddFromName }}</text><i></i></view></view>
				<view class="workspace-match-add-row" @click="openMatchAddPicker('to')"><text class="workspace-match-add-label">被牵线会员</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddToName == '' }">{{ matchAddToName == '' ? '请选择' : matchAddToName }}</text><i></i></view></view>
				<picker mode="date" :value="matchAddAppliedAt" start="2020-01-01" end="2030-12-31" @change="matchAddAppliedAt = $event.detail.value"><view class="workspace-match-add-row"><text class="workspace-match-add-label">牵线申请时间</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddAppliedAt == '' }">{{ matchAddAppliedAt == '' ? '请选择' : matchAddAppliedAt }}</text><i></i></view></view></picker>
				<view class="workspace-match-add-note"><text class="workspace-match-add-note-mark">T</text><text>新记录进入待牵线。查看双方电话并确认已获得联系方式后进入牵线中，再确认已联系并记录结果。</text></view>
				<view v-if="matchAddError.length > 0" class="workspace-form-error"><text>{{ matchAddError }}</text></view>
				<view class="workspace-match-add-submit" :class="{ disabled: matchAddSubmitting }" @click="submitMatchAdd"><text>{{ matchAddSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>

		<!-- 会员选择弹层（添加牵线记录用）：命令面板式模板，头部 / 搜索 / 键位提示 / 带头像结果行 -->
		<XsaSheet :visible="matchAddPickerVisible" title="" :show-handle="false" @close="matchAddPickerVisible = false">
			<view class="mp-pick">
				<view class="mp-pick-head">
					<view class="mp-pick-back" @click="matchAddPickerVisible = false"><i class="mp-pick-back-glyph"></i></view>
					<text class="mp-pick-title">{{ matchAddContext == 'meeting' ? (matchAddPickerKind == 'from' ? '选择名下申请人' : '选择约会对象') : (matchAddPickerKind == 'from' ? '选择牵线会员' : '选择被牵线会员') }}</text>
					<view v-if="!matchAddLoading && matchAddCandidates.length > 0" class="mp-pick-total"><text>{{ matchAddCandidates.length }}</text></view>
				</view>
				<view v-if="!matchAddLoading && matchAddCandidates.length > 0" class="mp-pick-search">
					<text class="mp-pick-search-glyph">⌕</text>
					<input class="mp-pick-search-input" placeholder="输入名字 / 编号搜索会员" placeholder-class="mp-pick-search-ph" :value="matchAddSearch" @input="onMatchAddSearchInput"/>
					<view class="mp-pick-clear-slot">
						<view v-if="matchAddSearch.length > 0" class="mp-pick-clear" @click="matchAddSearch = ''"><text>✕</text></view>
					</view>
				</view>
				<view class="mp-pick-hints">
					<view class="mp-pick-hint"><text class="mp-pick-hint-key">点按</text><text class="mp-pick-hint-label">选择会员</text></view>
					<view class="mp-pick-hint"><text class="mp-pick-hint-key">⌕</text><text class="mp-pick-hint-label">名字 / 编号可搜</text></view>
					<view class="mp-pick-hint"><text class="mp-pick-hint-key">返回</text><text class="mp-pick-hint-label">关闭名单</text></view>
				</view>
				<scroll-view scroll-y :show-scrollbar="false" class="mp-pick-scroll">
					<view v-if="matchAddLoading" class="mp-pick-state"><text>正在加载会员…</text></view>
					<view v-else-if="matchAddCandidates.length == 0" class="mp-pick-state"><text>服务范围内暂无会员</text></view>
					<view v-else-if="matchAddFilteredCandidates.length == 0" class="mp-pick-state"><text>没有匹配「{{ matchAddSearch }}」的会员</text></view>
					<view v-else class="mp-pick-results">
						<text class="mp-pick-results-label">{{ matchAddResultsLabel }}</text>
						<view v-for="m in matchAddFilteredCandidates" :key="m.id" class="mp-pick-row" :class="{ picked: isMatchAddPicked(m.id) }" @click="pickMatchAddMember(m)">
							<image class="mp-pick-avatar" :src="m.avatar" mode="aspectFill"/>
							<text class="mp-pick-name">{{ m.name }}</text>
							<text class="mp-pick-meta">{{ m.gender }} · {{ m.id }}</text>
							<view class="mp-pick-tail"><text v-if="isMatchAddPicked(m.id)" class="mp-pick-tail-check">✓</text></view>
						</view>
					</view>
				</scroll-view>
			</view>
		</XsaSheet>

<XsaSheet :visible="meetingStatusSheetVisible" title="确认双方约会意愿" @close="meetingStatusSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<view class="workspace-meeting-status-pair">
					<view class="workspace-filter-chip" :class="{ active: meetingStatusChoice == 'DECLINED' }" @click="meetingStatusChoice = 'DECLINED'"><text>约会失败</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingStatusChoice == 'ACCEPTED' }" @click="meetingStatusChoice = 'ACCEPTED'"><text>双方同意</text></view>
				</view>

				<view v-if="meetingStatusChoice == 'ACCEPTED'" class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: meetingContactsConfirmed }" @tap="meetingContactsConfirmed = !meetingContactsConfirmed"><text>{{ meetingContactsConfirmed ? '✓ ' : '○ ' }}已联系双方</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingApplicantAgreed }" @tap="meetingApplicantAgreed = !meetingApplicantAgreed"><text>{{ meetingApplicantAgreed ? '✓ ' : '○ ' }}申请人同意</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingTargetAgreed }" @tap="meetingTargetAgreed = !meetingTargetAgreed"><text>{{ meetingTargetAgreed ? '✓ ' : '○ ' }}被邀请方同意</text></view>
				</view>
				<textarea v-else class="workspace-follow-textarea" :value="meetingStatusReason" @input="meetingStatusReason = $event.detail.value" placeholder="请填写约会失败原因" :maxlength="200"/>
				<view class="workspace-match-status-submit" :class="{ disabled: meetingStatusSubmitting }" @click="submitMeetingStatus"><text>{{ meetingStatusSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>
		<XsaSheet :visible="meetingDeleteSheetVisible" title="删除记录" @close="meetingDeleteSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<text v-if="meetingDeleteRow != null" class="workspace-confirm-tip">确定删除 #{{ meetingDeleteRow.id }}（{{ meetingDeleteRow.applicant.name }} × {{ meetingDeleteRow.target.name }}）的约见申请吗？关联的约见安排会一并删除，删除后不可恢复。</text>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="meetingDeleteSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: meetingDeleteSubmitting }" @click="submitMeetingDelete"><text>{{ meetingDeleteSubmitting ? '删除中…' : '确认删除' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 约见：安排约见弹层（仅双方接受的申请） -->
		<XsaSheet :visible="meetingScheduleSheetVisible && !matchAddPickerVisible" :title="meetingScheduleRow == null ? '添加约会' : '安排时间地点'" @close="meetingScheduleSheetVisible = false">
			<view class="workspace-meeting-status-form">

				<view v-if="meetingScheduleRow == null">
					<view class="workspace-match-add-row" @tap="openMeetingMemberPicker('from')"><text class="workspace-match-add-label">名下会员</text><text>{{ meetingCreateApplicantName || '请选择申请人' }}</text></view>
					<view class="workspace-match-add-row" @tap="openMeetingMemberPicker('to')"><text class="workspace-match-add-label">约会对象</text><text>{{ meetingCreateTargetName || '请选择被邀请方' }}</text></view>
					<view class="workspace-filter-chips">
						<view class="workspace-filter-chip" :class="{ active: meetingCreateContacted }" @tap="meetingCreateContacted = !meetingCreateContacted"><text>{{ meetingCreateContacted ? '✓ ' : '○ ' }}已联系双方</text></view>
						<view class="workspace-filter-chip" :class="{ active: meetingCreateApplicantAgreed }" @tap="meetingCreateApplicantAgreed = !meetingCreateApplicantAgreed"><text>{{ meetingCreateApplicantAgreed ? '✓ ' : '○ ' }}申请人同意</text></view>
						<view class="workspace-filter-chip" :class="{ active: meetingCreateTargetAgreed }" @tap="meetingCreateTargetAgreed = !meetingCreateTargetAgreed"><text>{{ meetingCreateTargetAgreed ? '✓ ' : '○ ' }}被邀请方同意</text></view>
					</view>
				</view>
				<text v-if="meetingScheduleRow != null" class="workspace-confirm-tip">{{ meetingScheduleRow.applicant.name }} × {{ meetingScheduleRow.target.name }} 已同意约会，请协调双方时间后安排。</text>
				<picker mode="date" :value="meetingScheduleDate" :start="meetingScheduleMinDate" end="2030-12-31" @change="onMeetingScheduleDate">
					<view class="workspace-match-add-row"><text class="workspace-match-add-label">约会日期</text><view class="workspace-match-add-picker"><text :class="{ placeholder: meetingScheduleDate == '' }">{{ meetingScheduleDate == '' ? '请选择' : meetingScheduleDate }}</text><i></i></view></view>
				</picker>
				<picker mode="time" :value="meetingScheduleTime" @change="onMeetingScheduleTime">
					<view class="workspace-match-add-row"><text class="workspace-match-add-label">约会时间</text><view class="workspace-match-add-picker"><text :class="{ placeholder: meetingScheduleTime == '' }">{{ meetingScheduleTime == '' ? '请选择' : meetingScheduleTime }}</text><i></i></view></view>
				</picker>
				<view class="workspace-form-row"><text>约会地点</text><input :value="meetingScheduleLocation" @input="meetingScheduleLocation = $event.detail.value" placeholder="请填写约会地点（必填）" :maxlength="128"/></view>
				<view v-if="meetingScheduleError.length > 0" class="workspace-form-error"><text>{{ meetingScheduleError }}</text></view>
				<view class="workspace-match-status-submit" :class="{ disabled: meetingScheduleSubmitting }" @click="submitMeetingSchedule"><text>{{ meetingScheduleSubmitting ? '提交中…' : '确认安排' }}</text></view>
			</view>
		</XsaSheet>

		<!-- 约见：约见安排状态弹层（完成 / 取消 / 爽约） -->
		<XsaSheet :visible="meetingRecordSheetVisible" title="约会跟进与结果" @close="meetingRecordSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'REMINDED' }" @click="meetingRecordChoice = 'REMINDED'"><text>已提醒</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'CHECKED_IN' }" @click="meetingRecordChoice = 'CHECKED_IN'"><text>已到场</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'COMPLETED' }" @click="meetingRecordChoice = 'COMPLETED'"><text>完成约会</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'CANCELLED' }" @click="meetingRecordChoice = 'CANCELLED'"><text>已取消</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'NO_SHOW' }" @click="meetingRecordChoice = 'NO_SHOW'"><text>爽约</text></view>
				</view>
				<textarea v-if="meetingRecordChoice == 'COMPLETED'" class="workspace-follow-textarea" :value="meetingRecordFollowUp" @input="meetingRecordFollowUp = $event.detail.value" placeholder="请填写约会经过、双方反馈与后续跟进（必填）" :maxlength="2000"/>
				<textarea v-if="meetingRecordChoice == 'CANCELLED' || meetingRecordChoice == 'NO_SHOW'" class="workspace-follow-textarea" :value="meetingRecordReason" @input="meetingRecordReason = $event.detail.value" :placeholder="meetingRecordChoice == 'CANCELLED' ? '请填写取消原因（必填）' : '请填写爽约说明（必填）'" :maxlength="200"/>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="meetingRecordSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: meetingRecordSubmitting }" @click="submitMeetingRecordStatus"><text>{{ meetingRecordSubmitting ? '提交中…' : '提交' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：弃海 / 入库确认 -->
		<XsaSheet :visible="leadConfirmSheetVisible" :title="leadConfirmKind == 'abandon' ? '移入弃海' : (leadConfirmKind == 'restore' ? '恢复客源' : '一键入库')" @close="leadConfirmSheetVisible = false">
			<view class="workspace-lead-confirm">
				<text class="workspace-confirm-tip">{{ leadConfirmTip }}</text>
				<view v-if="leadConfirmKind == 'convert'" class="workspace-confirm-gender">
					<text>客户性别（入库建档用）</text>
					<view class="workspace-filter-chips">
						<view class="workspace-filter-chip" :class="{ active: leadConvertGender == 2 }" @click="leadConvertGender = 2"><text>女</text></view>
						<view class="workspace-filter-chip" :class="{ active: leadConvertGender == 1 }" @click="leadConvertGender = 1"><text>男</text></view>
					</view>
				</view>
				<textarea v-if="leadConfirmKind != 'convert'" class="workspace-follow-textarea" :value="leadConfirmReason" @input="leadConfirmReason = $event.detail.value" :placeholder="leadConfirmKind == 'abandon' ? '请填写弃海原因（必填）' : '恢复原因（选填）'" :maxlength="200"/>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="leadConfirmSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: leadConfirmSubmitting }" @click="submitLeadConfirm"><text>{{ leadConfirmSubmitting ? '处理中…' : '确认' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 查看联系方式（设计稿：手机号/微信号分别复制、拨打 + 红娘权限说明）
		     这里内联实现而不是独立组件：常驻挂载 + open 类控制显隐（与 XsaSheet 同款），
		     既避免新增组件文件在微信开发者工具热编译时不被识别，也避免关闭时用 opacity 过渡。 -->
		<view class="xsa-contact-overlay" :class="{ open: workspaceContactVisible }" @tap="onWorkspaceContactOverlay">
			<view class="xsa-contact-card" @tap.stop>
				<view class="xsa-contact-head">
					<view class="xsa-contact-head-icon">
						<view class="cc-avatar"><view class="cc-avatar-head"></view><view class="cc-avatar-body"></view></view>
						<view class="cc-lens"></view>
					</view>
					<text class="xsa-contact-title">查看联系方式</text>
				</view>

				<text class="xsa-contact-name">{{ workspaceContactNameText }}</text>

				<view v-if="workspaceContactLoading" class="xsa-contact-state"><text>正在读取联系方式…</text></view>
				<view v-else-if="workspaceContactError.length > 0" class="xsa-contact-state error"><text>{{ workspaceContactError }}</text></view>
				<view v-else class="xsa-contact-rows">
					<view class="xsa-contact-row phone">
						<view class="cc-badge phone"><image class="cc-badge-img" src="/static/icons/phone-call-white.svg" mode="aspectFit"></image></view>
						<text class="cc-value">{{ workspaceContactPhone.length > 0 ? workspaceContactPhone : '该会员未绑定手机号' }}</text>
						<view v-if="workspaceContactPhone.length > 0" class="cc-actions">
							<view class="cc-btn phone" @tap="copyWorkspaceContact(workspaceContactPhone)"><text>复制</text></view>
							<view class="cc-btn phone" @tap="callWorkspaceContact"><text>拨打</text></view>
						</view>
					</view>

					<view class="xsa-contact-row wechat">
						<view class="cc-badge wechat"><image class="cc-badge-img" src="/static/icons/wechat-bubble-white.svg" mode="aspectFit"></image></view>
						<text class="cc-value">{{ workspaceContactWechat.length > 0 ? workspaceContactWechat : '该会员未绑定微信号' }}</text>
						<view v-if="workspaceContactWechat.length > 0" class="cc-btn wechat" @tap="copyWorkspaceContact(workspaceContactWechat)"><text>复制</text></view>
					</view>
				</view>

				<view class="xsa-contact-tip">
					<view class="cc-tip-head">
						<view class="cc-tip-mark"><text>T</text></view>
						<text class="cc-tip-title">温馨提示</text>
					</view>
					<text class="cc-tip-copy">{{ workspaceContactTipText }}</text>
				</view>

				<view class="xsa-contact-close" @tap="closeWorkspaceContact"><text>关闭</text></view>
			</view>
		</view>

		<!-- 复制资料（客源线索）：模板照搬资料待审的「复制资料」——先预览全文，可改文本再一键复制。
		     文案口径 = 编辑线索表单的全量字段，未填写留空。
		     仍是内联实现：常驻挂载 + open 类控制显隐，避免新增组件文件热编译不识别。 -->
		<view class="cp-overlay" :class="{ open: copyVisible }" @tap="closeCopyProfile">
			<view class="cp-card" @tap.stop>
				<view class="cpd-icon"><text class="cpd-icon-glyph">◈</text></view>
				<text class="cpd-title">复制客源资料</text>
				<text class="cpd-subtitle">确认下方文本后再复制，可先修改。</text>
				<view v-if="copyEditing" class="cpd-body cpd-editor">
					<textarea class="cpd-textarea" maxlength="2000" :value="copyText" @input="onCopyText" />
					<text class="cpd-note">这里的修改只影响要复制的文本，不会改动该客源的资料。</text>
				</view>
				<scroll-view v-else scroll-y class="cpd-body" :show-scrollbar="false">
					<view class="cpd-lines">
						<text v-for="(line, index) in copyLines" :key="index" class="cpd-line">{{ line }}</text>
					</view>
				</scroll-view>
				<view class="cpd-footer">
					<view class="cpd-btn" @tap="toggleCopyEdit"><text>{{ copyEditing ? '预览' : '修改' }}</text></view>
					<view class="cpd-btn primary" @tap="confirmCopyProfile"><text>{{ copyCopied ? '已复制 ✓' : '一键复制' }}</text></view>
				</view>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
		<MatchmakerServiceNavSheet :visible="serviceNavVisible" member-center-label="我的账号" hide-video-entry hide-member-center-entry tone="deep" @close="serviceNavVisible = false" @select="onServiceNavSelect" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'
import MatchmakerManagementCenter from '@/pagesSub/matchmaker/components/MatchmakerManagementCenter.uvue'
import MatchmakerGoodNews from '@/pagesSub/matchmaker/components/MatchmakerGoodNews.uvue'
import { onShareAppMessage } from '@dcloudio/uni-app'
import MatchmakerPendingReview from '@/pagesSub/matchmaker/components/MatchmakerPendingReview.uvue'
import MatchmakerServiceNavSheet from '@/pagesSub/matchmaker/components/MatchmakerServiceNavSheet.uvue'
import {
	getMatchmakerManagementCenterAccess,
	getMatchmakerManagementCenterSnapshot,
	getMatchmakerReviewMembers,
	getMatchmakerWorkspaceProfile,
	getMatchmakerWorkspaceLeads,
	getWorkspaceLeadFollowUps,
	addWorkspaceLeadFollowUp,
	getWorkspaceLeadFollowers,
	assignWorkspaceLead,
	abandonWorkspaceLead,
	restoreWorkspaceLead,
	convertWorkspaceLead,
	updateWorkspaceLead,
	createWorkspaceLead,
	uploadWorkspaceLeadPhoto,
	createMatchmakerWorkspaceMember,
	updateMatchmakerMeetingStatus,
	updateMatchmakerMeetingRecordStatus,
	scheduleMatchmakerMeeting,
	createMatchmakerMeeting,
	updateMatchmakerIntroductionStatus,
	viewMatchmakerIntroductionContact,
	createMatchmakerIntroduction,
	deleteMatchmakerMeetingRequest,
	getMatchmakerWorkspaceIntroductions,
	getMatchmakerWorkspaceMeetingRequests,
	getMatchmakerWorkspaceCommissionEntries,
	getMatchmakerWorkspaceOfflineIncome,
	getMatchmakerMemberContact,
	submitMatchmakerApplication
} from '@/api'
import { getWorkspaceMeetingPresentation } from '@/utils/meeting-workflow.uts'
import { resolveMediaUrl, getAccessToken } from '@/api/config.uts'
import { nextTick } from 'vue'
import { savePosterToPhotos } from '@/utils/moxiang-poster-drawer.uts'
import { PLATFORM_HOME_URL } from '@/utils/matchmaker-promo-poster.uts'

// ===== 基本信息 =====
const realName = ref('')
const phone = ref('')
const wechat = ref('')

// ===== 红娘资料 =====
const avatar = ref('')
const introduction = ref('')
const specialties = ref<string[]>([])
const price = ref('')

// ===== 成功案例 =====
interface CaseItem {
	description: string
	images: string[]
}
const successCases = ref<CaseItem[]>([])

// ===== 状态 =====
const submitting = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')
const qrVisible = ref(false)
const currentStep = ref(0)
const managementAccess = ref<any>(null)
const managementCenterSnapshot = ref<any>(null)
const managementAccessLoading = ref(true)
const managementCenterLoading = ref(false)
const managementCenterVisible = ref(false)
const pendingReviewVisible = ref(false)
const pendingReviewInitialTab = ref('PENDING')
// 会员主页「编辑资料」入口深链：进入页面后自动打开资料待审列表
const autoOpenPendingReview = ref(false)
// 支持从其他页面直达某个工作区：?workspace=meeting（约见申请）/ ?workspace=match（待我牵线）
const autoOpenWorkspace = ref('')
const goodNewsPanel = ref<any>(null)
const goodNewsShare = ref<any>(null)
const goodNewsInitialItem = ref('')
const goodNewsInitialKind = ref('news')
const goodNewsDisplayName = computed(() => managementCenterSnapshot.value != null && managementCenterSnapshot.value.identity != null ? String(managementCenterSnapshot.value.identity.name || '服务红娘') : '服务红娘')
const resetGoodNewsScroll = () => { workspaceScrollTop.value = 1; nextTick(() => { workspaceScrollTop.value = 0 }) }
const openGoodNewsPerson = (id: string) => { openWorkspaceMemberProfile({ id: id }) }
const workspaceVisible = ref(false)
const workspaceTitle = ref('')
const workspaceKind = ref('general')
const workspaceActiveTab = ref('全部')
const workspaceKeyword = ref('')
const workspaceMembersLoading = ref(false)
const workspaceMembersError = ref('')
const workspaceLeadsLoading = ref(false)
const workspaceLeadsError = ref('')
const workspaceLeadsDiagnostic = ref('')
const copyLeadDiagnostic = () => {
	if (workspaceLeadsDiagnostic.value.length == 0) return
	uni.setClipboardData({ data: workspaceLeadsDiagnostic.value })
}
const workspaceMatchesLoading = ref(false)
const workspaceMatchesError = ref('')
const workspaceMeetingsLoading = ref(false)
const workspaceMeetingsError = ref('')
const workspaceDefaultTabs = ['全部', '进行中', '已完成']
const workspaceCommissionTabs = ['分成明细', '分成标准']
const workspaceLeadTabs = ['客源线索', '弃海客源']
const workspaceMatchTabs = ['全部', '待牵线', '牵线中', '成功', '失败']
const workspaceMeetingTabs = ['全部', '约会失败', '待见面', '完成约会']
// 录入客源线索页的「轻档案卡」风格开关
const isLeadEntryStudio = computed(() => workspaceVisible.value && workspaceKind.value == 'entry' && workspaceTitle.value == '录入客源线索')
const workspaceTabs = computed(() => {
	if (workspaceKind.value == 'commission') {
		// 「线上分成」与「财务明细」共用 commission 工作区，按标题切换页签与内容。
		return workspaceTitle.value == '财务明细' ? ['财务明细', '结算说明'] : workspaceCommissionTabs
	}
	if (workspaceKind.value == 'news') return ['喜讯', '锦旗']
	if (workspaceKind.value == 'lead') return workspaceLeadTabs
	if (workspaceKind.value == 'match') return workspaceMatchTabs
	if (workspaceKind.value == 'meeting') return workspaceMeetingTabs
	return workspaceDefaultTabs
})
const workspaceSearchPlaceholder = computed(() => {
	if (workspaceKind.value == 'lead') return '请输入昵称、手机或微信'
	if (workspaceKind.value == 'match') return '请输入申请人昵称、姓名或编号'
	if (workspaceKind.value == 'meeting') return '请输入申请人昵称或编号'
	return '请输入关键词'
})
// 分成明细与财务明细读服务端（会员名与事件名由订单/规则回带）；分成标准未开放时明确提示。
const workspaceCommissionRows = ref<any[]>([])
const workspaceCommissionLoading = ref(false)
const workspaceCommissionError = ref('')
const workspaceCommissionUsingDemoData = ref(false)
const workspaceCommissionTotalAmount = ref('')
const workspaceCommissionRates: any[] = []
const workspaceFinanceRows = ref<any[]>([])
const workspaceFinanceLoading = ref(false)
const workspaceFinanceError = ref('')
const workspaceFinanceUsingDemoData = ref(false)
const workspaceFinanceTotalAmount = ref('')
const commissionAvatarText = (name: any): string => {
	const text = name != null ? String(name).trim() : ''
	return text.length > 0 ? text.substring(0, 1) : '会'
}
const parseDemoAmount = (text: string): number => {
	let digits = ''
	for (let i = 0; i < text.length; i++) {
		const ch = text.charAt(i)
		if ((ch >= '0' && ch <= '9') || ch == '.') digits += ch
	}
	return digits.length > 0 ? Number(digits) : 0
}
const formatDemoAmount = (rows: any[]): string => {
	let total = 0
	rows.forEach((row: any) => { total += parseDemoAmount(String(row.amount)) })
	const fixed = total.toFixed(2)
	const segments = fixed.split('.')
	let intPart = segments[0]
	let grouped = ''
	while (intPart.length > 3) {
		grouped = ',' + intPart.substring(intPart.length - 3) + grouped
		intPart = intPart.substring(0, intPart.length - 3)
	}
	return '￥' + intPart + grouped + '.' + segments[1]
}
const workspaceCommissionTotal = computed((): string => workspaceCommissionTotalAmount.value.length > 0
	? workspaceCommissionTotalAmount.value
	: formatDemoAmount(workspaceCommissionRows.value))
const workspaceFinanceTotal = computed((): string => workspaceFinanceTotalAmount.value.length > 0
	? workspaceFinanceTotalAmount.value
	: formatDemoAmount(workspaceFinanceRows.value))
const workspaceCashNote = computed((): string => {
	if (workspaceTitle.value == '财务明细') return workspaceFinanceUsingDemoData.value
		? '线下业绩与开单收款为本地演示数据，服务端接入后自动切换。'
		: '线下业绩为本人作为销售红娘的线下 VIP 已收款订单，由平台按月统一结算。'
	if (workspaceCommissionUsingDemoData.value) return '分成金额计入账号余额，可申请提现；当前为本地演示数据。'
	return '分成记录按服务端数据展示，实际可提现余额以账户余额为准。'
})
const workspaceLeads = ref<any[]>([])
// 九级意向独立保存，便于按 A-J 完整筛选与回显。
const leadIntentionDetails = ref<any>({})
const workspaceMatches = ref<any[]>([])
const workspaceMeetings = ref<any[]>([])
const workspaceMeetingsLoaded = ref(false)
const workspaceMeetingWorkflowVersion = ref(0)
const workspaceMatchesUsingDemoData = ref(false)
const workspaceMeetingsUsingDemoData = ref(false)

// 「待我牵线 / 牵线成功」只认 /matchmaker/management-center/dashboard 的服务端计数：
// 它和工作台牵线列表用同一个 _scope_predicate，且不受列表首页 100 条上限影响。
// 这里只回填约见两项（约见工作区仍按已加载行统计）。
const applyBusinessMetricCounts = (meetingRequests: number, pendingMeeting: number) => {
	if (managementCenterSnapshot.value == null || !Array.isArray(managementCenterSnapshot.value.storeMetrics)) return
	const metricValues: any = {
		meeting_requests: String(meetingRequests),
		pending_meeting: String(pendingMeeting)
	}
	managementCenterSnapshot.value = {
		...managementCenterSnapshot.value,
		storeMetrics: managementCenterSnapshot.value.storeMetrics.map((item: any) => metricValues[item.key] != null
			? { ...item, value: metricValues[item.key] }
			: item)
	}
}

const syncBusinessMetricCountsFromWorkspace = () => {
	if (!workspaceMeetingsLoaded.value) return
	const meetingRequests = workspaceMeetings.value.length
	const pendingMeeting = workspaceMeetings.value.filter((item: any): boolean => item.phase == 'UPCOMING').length
	applyBusinessMetricCounts(meetingRequests, pendingMeeting)
}

const refreshBusinessMetricCounts = async () => {
	try {
		const meetingsResult = await getMatchmakerWorkspaceMeetingRequests()
		if (!meetingsResult.success || meetingsResult.data == null) return
		const meetings = Array.isArray(meetingsResult.data.items) ? meetingsResult.data.items : []
		const meetingRequests = meetings.length
		const pendingMeeting = meetings.filter((item: any): boolean => getWorkspaceMeetingPresentation(String(item.status), item.meeting).phase == 'UPCOMING').length
		applyBusinessMetricCounts(meetingRequests, pendingMeeting)
	} catch (e) {
		// 统计接口失败时保留聚合快照，避免用空数据覆盖上一次有效统计。
	}
}
const workspaceMembers = ref<any[]>([])
// 与资料待审“待审”页使用相同的全会员筛选和服务端总数，避免工作范围汇总与列表不一致。
let pendingReviewCountRequest = 0
let pendingReviewCountTimer: any = null
const applyPendingReviewCount = (value: string) => {
	if (managementCenterSnapshot.value == null || !Array.isArray(managementCenterSnapshot.value.storeMetrics)) return
	managementCenterSnapshot.value = {
		...managementCenterSnapshot.value,
		storeMetrics: managementCenterSnapshot.value.storeMetrics.map((item: any) => item.key == 'pending_review'
			? { ...item, value: value }
			: item)
	}
}
const refreshPendingReviewCount = async () => {
	const requestId = ++pendingReviewCountRequest
	try {
		const result = await getMatchmakerReviewMembers({ page: 1, page_size: 1, member_pool: 'all', review_status: 'PENDING', filters: '{}' })
		if (requestId != pendingReviewCountRequest) return
		if (!result.success || result.data == null || Number(result.data.member_pool_version || 0) < 1 || result.data.total == null) {
			applyPendingReviewCount('--')
			return
		}
		applyPendingReviewCount(String(Math.max(0, Number(result.data.total))))
	} catch (e) {
		if (requestId == pendingReviewCountRequest) applyPendingReviewCount('--')
	}
}
const stopPendingReviewCountTimer = () => {
	if (pendingReviewCountTimer != null) clearInterval(pendingReviewCountTimer)
	pendingReviewCountTimer = null
}
const startPendingReviewCountTimer = () => {
	stopPendingReviewCountTimer()
	pendingReviewCountTimer = setInterval(() => {
		if (managementCenterVisible.value && !pendingReviewVisible.value && !workspaceVisible.value) refreshPendingReviewCount()
	}, 15000)
}
// 「我服务的」以会员列表真实数据（matchmaker_id == 当前红娘）为准，实时覆盖简报里的服务端统计。
const selfMatchmakerUserId = ref(0)
const ensureSelfMatchmakerUserId = async (): Promise<number> => {
	if (selfMatchmakerUserId.value != 0) return selfMatchmakerUserId.value
	try {
		const result = await getMatchmakerWorkspaceProfile()
		if (result.success && result.data != null && result.data.user_id != null) {
			selfMatchmakerUserId.value = Number(result.data.user_id)
		}
	} catch (e) {
	}
	return selfMatchmakerUserId.value
}
const applyServedMemberCount = (count: number) => {
	if (managementCenterSnapshot.value == null || !Array.isArray(managementCenterSnapshot.value.storeMetrics)) return
	const value = Math.max(0, Math.round(Number(count) || 0))
	managementCenterSnapshot.value = {
		...managementCenterSnapshot.value,
		storeMetrics: managementCenterSnapshot.value.storeMetrics.map((item: any) => item.key == 'served_members'
			? { ...item, value: String(value) }
			: item)
	}
}
const countServedMembers = async (items: any[]) => {
	const selfId = await ensureSelfMatchmakerUserId()
	if (selfId == 0) return
	applyServedMemberCount(items.filter((item: any): boolean => Number(item.matchmaker_id) == selfId).length)
}
const refreshServedMemberCount = async () => {
	try {
		const result = await getMatchmakerReviewMembers()
		if (!result.success || result.data == null) return
		countServedMembers(Array.isArray(result.data.items) ? result.data.items : [])
	} catch (e) {
		// 统计失败时保留上一次有效数字，与业务指标刷新策略一致。
	}
}
const onPendingReviewServedCount = (count: number) => { applyServedMemberCount(Number(count)) }
// 牵线记录新增/改状态后重拉一次工作台统计：待我牵线、牵线成功只在服务端有全量真值，
// 本地按已加载的首页行数是数不准的（接口单页上限 100 条）。
const reloadManagementCenterSnapshot = async () => {
	try {
		const result = await getMatchmakerManagementCenterSnapshot()
		if (!result.success || result.data == null) return
		managementCenterSnapshot.value = result.data
		await Promise.all([refreshBusinessMetricCounts(), refreshServedMemberCount(), refreshPendingReviewCount()])
	} catch (e) {
		// 重拉失败时保留上一次有效统计，和刷新接口的容错一致。
	}
}
// 远端未开放红娘活动管理，不展示本地活动。
const workspaceActivities: any[] = []
const workspaceGenericRows: any[] = []
const workspaceVisibleMembers = computed(() => {
	let rows = workspaceMembers.value
	if (workspaceActiveTab.value == '进行中') rows = rows.filter((item: any) => item.reviewStatus == 'PENDING')
	if (workspaceActiveTab.value == '已完成') rows = rows.filter((item: any) => item.reviewStatus != 'PENDING')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.id) + String(item.status) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleLeads = computed(() => {
	let rows = workspaceLeads.value
	if (workspaceActiveTab.value == '弃海客源') rows = rows.filter((item: any) => item.status == 'LOST')
	if (workspaceActiveTab.value == '客源线索') rows = rows.filter((item: any) => item.status != 'LOST')
	// 弃海池按弃海时点倒序（最新弃海在最上）：接口整体按客源 id 倒序，早录入晚弃海的会沉底。
	if (workspaceActiveTab.value == '弃海客源') {
		rows = rows.slice().sort((a: any, b: any): number => {
			const left = String(a.abandonedAt)
			const right = String(b.abandonedAt)
			if (left == right) return Number(b.id) - Number(a.id)
			if (left.length == 0) return 1
			if (right.length == 0) return -1
			return left < right ? 1 : -1
		})
	}
	if (leadFilterStatus.value.length > 0) rows = rows.filter((item: any) => leadFilterStatus.value.indexOf(item.status) >= 0)
	if (leadFilterIntention.value > 0) rows = rows.filter((item: any) => Number(item.intentionValue) == leadFilterIntention.value)
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.phone) + String(item.wechat) + String(item.source)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMatches = computed(() => {
	let rows = workspaceMatches.value
	if (workspaceActiveTab.value == '待牵线') rows = rows.filter((item: any) => item.status == 'PENDING')
	if (workspaceActiveTab.value == '牵线中') rows = rows.filter((item: any) => item.status == 'IN_PROGRESS')
	if (workspaceActiveTab.value == '成功') rows = rows.filter((item: any) => item.status == 'SUCCEEDED')
	if (workspaceActiveTab.value == '失败') rows = rows.filter((item: any) => item.status == 'FAILED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.statusLabel) + String(item.fromUser.name) + String(item.toUser.name)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMeetings = computed(() => {
	let rows = workspaceMeetings.value
	if (workspaceActiveTab.value == '待见面') rows = rows.filter((item: any) => item.phase == 'UPCOMING')
	if (workspaceActiveTab.value == '完成约会') rows = rows.filter((item: any) => item.phase == 'COMPLETED')
	if (workspaceActiveTab.value == '约会失败') rows = rows.filter((item: any) => item.phase == 'FAILED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.applicant.name) + String(item.target.name) + String(item.statusLabel)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})

const specialtyOptions = [
	'高知青年', '同城牵线', '离异再婚', '大龄脱单',
	'海归交友', '理工专属', '情感修复', '婚前辅导',
	'沟通指导', '形象建议', '约会策划', '家庭关系'
]

const processSteps = [
	{ title: '填写申请', desc: '填写完整资料并提交' },
	{ title: '平台审核', desc: '运营人员对资料进行审核' },
	{ title: '审核通过', desc: '获得服务红娘身份' },
	{ title: '成为服务红娘', desc: '可正式在平台提供牵线服务' }
]

// ===== 计算属性 =====
const canSubmit = computed(() => {
	return realName.value.trim().length >= 2
		&& realName.value.trim().length <= 64
		&& /^1[3-9]\d{9}$/.test(phone.value.trim())
		&& wechat.value.trim().length > 0
		&& wechat.value.trim().length <= 128
		&& avatar.value.length > 0
		&& avatar.value.length <= 512
		&& introduction.value.trim().length >= 10
		&& introduction.value.trim().length <= 2000
		&& specialties.value.length > 0
		&& isValidOptionalPrice()
})

const canEnterManagementCenter = computed(() => {
	return managementAccess.value != null && managementAccess.value.canAccess == true
})

const managementAccessDescription = computed(() => {
	if (managementAccessLoading.value) return '正在核验服务红娘开通状态…'
	if (managementAccess.value == null) return '暂时无法核验开通状态，请稍后重试。'
	// 文案一律取服务端 message，成功与拒绝同一个来源，前端不再各自写一句话。
	const serverMessage = managementAccess.value.message != null ? String(managementAccess.value.message).trim() : ''
	if (serverMessage.length > 0) return serverMessage
	return canEnterManagementCenter.value
		? '服务开通已确认，可进入工作台处理门店服务事项。'
		: '当前账号暂未获得管理中心权限。'
})

const managementAccessActionText = computed(() => {
	if (managementAccessLoading.value) return '核验中'
	if (managementCenterLoading.value) return '进入中'
	if (canEnterManagementCenter.value) return '进入中心'
	return '暂不可进入'
})

// ===== Toast =====
const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}

const selectWorkspaceTab = (tab: string) => {
	workspaceActiveTab.value = tab
}

const onWorkspaceKeywordInput = (event: any) => {
	workspaceKeyword.value = event.detail.value
}

const runWorkspaceSearch = () => {
	if (workspaceKind.value == 'member') {
		showToast('已筛选 ' + String(workspaceVisibleMembers.value.length) + ' 位会员')
		return
	}
	if (workspaceKind.value == 'lead') {
		showToast('已筛选 ' + String(workspaceVisibleLeads.value.length) + ' 条客源')
		return
	}
	if (workspaceKind.value == 'match') {
		showToast('已筛选 ' + String(workspaceVisibleMatches.value.length) + ' 条牵线记录')
		return
	}
	if (workspaceKind.value == 'meeting') {
		showToast('已筛选 ' + String(workspaceVisibleMeetings.value.length) + ' 条约见申请')
		return
	}
	if (workspaceKeyword.value.trim().length == 0) {
		showToast('请输入搜索关键词')
		return
	}
	showToast('该工作台能力正在接入服务端数据')
}

