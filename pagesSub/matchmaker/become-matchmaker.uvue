	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 56rpx;
	box-sizing: border-box;
	opacity: 0;
	pointer-events: none;
	transition: opacity .2s ease-out;
}

.cp-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

.cp-card {
	width: 100%;
	max-width: 640rpx;
	background: var(--surface);
	border-radius: 32rpx;
	padding: 40rpx 32rpx 0;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	box-shadow: var(--shadow-lg);
	transform: translateY(24rpx) scale(.97);
	transition: transform .2s ease-out;
}

.cp-overlay.open .cp-card {
	transform: translateY(0) scale(1);
}

.cpd-icon {
	align-self: center;
	width: 112rpx;
	height: 112rpx;
	border-radius: 28rpx;
