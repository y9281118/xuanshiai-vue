<template>
  <view class="page">
    <scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false">
      <view class="hero">
        <view class="hero-art">
          <view class="hero-circle-a"></view>
          <view class="hero-circle-b"></view>
          <view class="hero-dot-c"></view>
          <view class="hero-bubble">
            <view class="hero-bubble-row">
              <view class="hero-bubble-dot"></view>
              <view class="hero-bubble-dot"></view>
              <view class="hero-bubble-dot"></view>
            </view>
          </view>
        </view>
        <view class="hero-kicker">
          <view class="hero-kicker-dot"></view>
          <text class="hero-kicker-text">HELP · SUPPORT</text>
        </view>
        <text class="hero-title">帮助与客服</text>
        <text class="hero-subtitle">选择问题分类，快速找到答案</text>
      </view>

      <view class="section-head">
        <view class="heading-left">
          <view class="title-dot"></view>
          <text class="section-title">快速入口</text>
        </view>
        <text class="section-caption">先看常见问题，再找人工</text>
      </view>
      <view class="quick-row">
        <view class="quick-card primary" @tap="openContact">
          <text class="quick-arrow">›</text>
          <view class="quick-icon ai"><text>客服</text></view>
          <text class="quick-title">联系客服</text>
          <text class="quick-desc">描述你遇到的问题，客服在工作时间回复</text>
          <view class="quick-note"><text>涉及举报时，客服会引导你前往相关卡片上方的举报入口。</text></view>
        </view>
        <view class="quick-card plain" @tap="openFeedback">
          <view class="quick-icon feedback"><text>✎</text></view>
          <view class="quick-copy-plain">
            <text class="quick-title">意见箱</text>
            <text class="quick-desc">告诉我们使用中的建议或遇到的问题</text>
          </view>
          <text class="quick-arrow">›</text>
        </view>
      </view>

      <view class="section-head">
        <view class="heading-left">
          <view class="title-dot"></view>
          <text class="section-title">问题分类</text>
        </view>
        <text class="section-caption">左右滑动查看全部</text>
      </view>
      <view class="chips-wrap">
        <scroll-view class="category-chips" scroll-x show-scrollbar="false">
          <view class="category-chips-inner" :style="{ width: chipsInnerWidth + 'px' }">
            <view v-for="category in categories" :key="category.id" class="category-chip" :class="{ active: activeCategoryId == category.id }" @tap="selectCategory(category.id)">
              <text class="category-chip-label">{{ category.title.replace('\n', '') }}</text>
            </view>
          </view>
        </scroll-view>
        <view class="chips-fade"></view>
      </view>

      <view class="faq-panel">
        <view v-if="loading" class="state-panel"><text>帮助内容加载中...</text></view>
        <view v-else-if="error != ''" class="state-panel error" @tap="loadHelpCenter"><text>{{ error }}，点击重试</text></view>
        <view v-else-if="activeItems.length == 0" class="state-panel"><text>暂无相关问题</text></view>
        <view v-else class="faq-card">
          <view v-for="(item, index) in activeItems" :key="item.id" class="faq-item">
            <view class="faq-row" @tap="toggleFaq(item.id)">
              <text class="faq-badge">Q{{ index + 1 }}</text>
              <text class="faq-question">{{ item.question }}</text>
              <view class="faq-chev"><text>{{ expandedFaqId == item.id ? '︿' : '›' }}</text></view>
            </view>
            <view v-if="expandedFaqId == item.id" class="faq-answer">
              <text class="faq-answer-text">{{ answerOf(item) }}</text>
              <view class="faq-answer-cta" @tap="openContact"><text>仍然没解决？联系客服</text></view>
            </view>
          </view>
        </view>
      </view>
      <view class="safety-tip">
        <view class="tip-line"></view>
        <text class="tip-text">没有找到答案？点击上方“联系客服”继续咨询。</text>
        <view class="tip-line"></view>
      </view>
    </scroll-view>
  </view>

  <XsaSheet :visible="contactVisible" title="联系客服" :tall="true" @close="closeContact">
    <view class="sheet-intro">
      <text class="sheet-intro-title">描述你遇到的问题</text>
      <text class="sheet-intro-desc">提交后会生成一条咨询工单，客服在工作时间回复。涉及举报时，请按提示前往对应卡片操作。</text>
    </view>
    <textarea class="feedback-input" :value="contactDraft" maxlength="500" placeholder="请输入咨询内容" @input="onContactInput"></textarea>
    <view class="feedback-meta"><text>{{ contactDraft.length }}/500</text></view>
    <input class="contact-phone" :value="contactPhone" maxlength="20" placeholder="联系手机号（选填，便于回复）" @input="onPhoneInput" />
    <text class="feedback-error" v-if="contactError != ''">{{ contactError }}</text>
    <XsaButton variant="primary" size="large" :loading="contactSubmitting" :disabled="contactSubmitting" @click="submitContact">提交咨询</XsaButton>
  </XsaSheet>

  <XsaSheet :visible="feedbackVisible" title="意见箱" @close="closeFeedback">
    <view class="sheet-intro">
      <text class="sheet-intro-title">你的意见会帮助我们改进</text>
      <text class="sheet-intro-desc">请尽量描述具体场景，便于我们理解问题。</text>
    </view>
    <textarea class="feedback-input" :value="feedbackDraft" maxlength="1000" placeholder="请输入你的意见或建议" @input="onFeedbackInput"></textarea>
    <view class="feedback-meta"><text>{{ feedbackDraft.length }}/1000</text></view>
    <text class="feedback-error" v-if="feedbackError != ''">{{ feedbackError }}</text>
    <XsaButton variant="primary" size="large" :loading="feedbackSubmitting" :disabled="feedbackSubmitting" @click="submitFeedbackForm">提交意见</XsaButton>
  </XsaSheet>
</template>

<script setup lang="uts">
import XsaButton from '@/components/XsaButton.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'
import { getHelpCenter, contactSupport, submitFeedback, HelpCategory, HelpFaqItem } from '@/api/help'

let categories = ref([] as HelpCategory[])
let activeCategoryId = ref('common')
let loading = ref(false)
let error = ref('')
// 当前展开答案的 FAQ id，空串表示全部收起（一次只展开一条，避免长列表滚不完）
let expandedFaqId = ref('')
let contactVisible = ref(false)
let contactDraft = ref('')
let contactPhone = ref('')
// 幂等键在「打开表单」时生成、整个提交过程复用：重试不会把同一条咨询推成两张工单
let contactKey = ref('')
let contactSubmitting = ref(false)
let contactError = ref('')
let feedbackVisible = ref(false)
let feedbackDraft = ref('')
let feedbackSubmitting = ref(false)
let feedbackError = ref('')
let openOnLoad = ''

const activeItems = computed(() => {
  const list = categories.value as HelpCategory[]
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == activeCategoryId.value) return list[i].items
  }
  return [] as HelpFaqItem[]
})

// 分类胶囊横滑：给内层容器一个确定的、大于屏宽的宽度，确保 scroll-view 能滚动
const chipsInnerWidth = computed(() => {
  let total = 24 // 安全余量
  const list = categories.value as HelpCategory[]
  for (let i = 0; i < list.length; i++) {
    const title = list[i].title.replace('\n', '')
    total += title.length * 12 + 30 + 8 // 字宽约 12px + 内边距 30 + 间距 8
  }
  return total
})

const loadHelpCenter = async () => {
  loading.value = true
  error.value = ''
  try {
    const res = await getHelpCenter()
    if (!res.success || res.data == null) throw new Error('help unavailable')
    categories.value = res.data.categories as HelpCategory[]
    if (categories.value.length > 0) {
      let exists = false
      for (let i = 0; i < categories.value.length; i++) {
        if (categories.value[i].id == activeCategoryId.value) exists = true
      }
      if (!exists) activeCategoryId.value = categories.value[0].id
    }
  } catch (e) {
    error.value = '帮助内容加载失败'
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  loadHelpCenter()
})

onLoad((options) => {
  openOnLoad = options?.open ?? ''
  if (openOnLoad == 'feedback') {
    setTimeout(() => { openFeedback() }, 100)
  } else if (openOnLoad == 'contact' || openOnLoad == 'ai') {
    // open=ai 是历史深链（security.uvue、旧分享路径都还带着它）。AI 客服后端从未实现，
    // 这里把它当别名落到人工入口，避免老链接打不开或打开一个必然失败的对话框。
    setTimeout(() => { openContact() }, 100)
  }
})

const selectCategory = (id: string) => {
  activeCategoryId.value = id
}

// 答案来自 /support/help-docs 的 body；后台没维护答案时显式说明并引导人工，
// 不能把标题当答案回显（旧实现就是把 body 当提问发给不存在的 AI 接口）。
const answerOf = (item: HelpFaqItem): string => {
  const answer = item.answer
  if (answer != null && answer != '') return answer
  return '这个问题还没有配置说明。可以直接提交咨询，客服会在工作时间回复你。'
}

const toggleFaq = (id: string) => {
  expandedFaqId.value = expandedFaqId.value == id ? '' : id
}

const newContactKey = (): string => 'support-contact-' + Date.now().toString(36) + '-' + Math.floor(Math.random() * 1e9).toString(36)

const openContact = () => {
  contactVisible.value = true
  contactError.value = ''
  contactKey.value = newContactKey()
}

const closeContact = () => {
  contactVisible.value = false
}

const openFeedback = () => {
  feedbackVisible.value = true
  feedbackError.value = ''
}

const closeFeedback = () => {
  feedbackVisible.value = false
}

const onContactInput = (e: any) => {
  contactDraft.value = e.detail.value
  contactError.value = ''
}

const onPhoneInput = (e: any) => {
  contactPhone.value = e.detail.value
}

const onFeedbackInput = (e: any) => {
  feedbackDraft.value = e.detail.value
  feedbackError.value = ''
}

const submitContact = async () => {
  const content = contactDraft.value.trim()
  if (content.length == 0) {
    contactError.value = '请描述你遇到的问题'
    return
  }
  if (contactSubmitting.value) return
  contactSubmitting.value = true
  contactError.value = ''
  let failure = ''
  try {
    const res = await contactSupport(content, contactPhone.value.trim(), contactKey.value)
    if (!res.success) {
      failure = res.message != null && '' + res.message != '' ? '' + res.message : '提交失败，请重试'
    }
  } catch (e) {
    failure = '网络异常，请稍后重试'
  }
  contactSubmitting.value = false
  if (failure != '') {
    contactError.value = failure
    return
  }
  contactDraft.value = ''
  contactPhone.value = ''
  contactKey.value = ''
  contactVisible.value = false
  uni.showToast({ title: '已提交，客服会在工作时间回复你', icon: 'none' })
}

const submitFeedbackForm = async () => {
  const content = feedbackDraft.value.trim()
  if (content.length == 0) {
    feedbackError.value = '请填写意见内容'
    return
  }
  if (feedbackSubmitting.value) return
  feedbackSubmitting.value = true
  feedbackError.value = ''
  try {
    const res = await submitFeedback(content)
    if (!res.success) throw new Error('feedback unavailable')
    feedbackDraft.value = ''
    feedbackVisible.value = false
    uni.showToast({ title: '意见已提交，感谢你的反馈', icon: 'success' })
  } catch (e) {
    feedbackError.value = '提交失败，请重试'
  } finally {
    feedbackSubmitting.value = false
  }
}
</script>

<style>
.page { min-height: 100vh; height: 100vh; display: flex; flex-direction: column; background: var(--canvas); }
.page-scroll { flex: 1; min-height: 0; padding-bottom: 16px; }
/* ===== Hero：开放式大标题 + 几何气泡装饰 ===== */
.hero { position: relative; padding: 20px 20px 8px; }
.hero-art { position: absolute; right: -30px; top: 0px; width: 150px; height: 130px; }
.hero-circle-a { position: absolute; right: 6px; top: 4px; width: 92px; height: 92px; border-radius: 46px; background: var(--accent-bg); opacity: 0.55; }
.hero-circle-b { position: absolute; right: 74px; top: 66px; width: 52px; height: 52px; border-radius: 26px; background: var(--warm); opacity: 0.7; }
.hero-dot-c { position: absolute; right: 4px; top: 104px; width: 18px; height: 18px; border-radius: 9px; background: var(--soft); opacity: 0.35; }
.hero-bubble { position: absolute; right: 16px; top: 14px; width: 66px; height: 46px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; }
.hero-bubble-row { display: flex; flex-direction: row; align-items: center; gap: 6px; }
.hero-bubble-dot { width: 6px; height: 6px; border-radius: 3px; background: var(--accent); opacity: 0.55; }
.hero-kicker { display: flex; flex-direction: row; align-items: center; gap: 6px; margin-bottom: 10px; }
.hero-kicker-dot { width: 5px; height: 5px; border-radius: 3px; background: var(--accent); }
.hero-kicker-text { color: var(--accent); font-size: 10px; font-weight: 800; letter-spacing: 2px; }
.hero-title { display: block; color: var(--ink); font-family: var(--serif); font-size: 26px; font-weight: 700; letter-spacing: 1px; line-height: 34px; }
.hero-subtitle { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; line-height: 18px; max-width: 240px; }

/* ===== 区块标题 ===== */
.section-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 20px 10px; }
.heading-left { display: flex; flex-direction: row; align-items: center; gap: 8px; }
.title-dot { width: 6px; height: 6px; border-radius: 3px; background: var(--accent); }
.section-title { color: var(--ink); font-size: 16px; font-weight: 800; }
.section-caption { color: var(--soft); font-size: 11px; }

/* ===== 快速入口：并排双卡 ===== */
/* 联系客服为主卡（上下排布、占满整行，尺寸收敛），意见箱同宽紧凑小卡 */
.quick-row { display: flex; flex-direction: column; gap: 10px; padding: 0 20px; }
.quick-card { position: relative; box-sizing: border-box; border-radius: 16px; overflow: hidden; }
.quick-card.primary { width: 100%; padding: 12px 14px 12px; background-image: linear-gradient(160deg, #FFFFFF 0%, #E9F4F1 100%); box-shadow: 0 5px 14px rgba(45, 124, 114, 0.1); }
.quick-card.plain { width: 100%; padding: 12px 14px 12px 14px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-sm); display: flex; flex-direction: row; align-items: center; gap: 10px; }
.quick-copy-plain { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.quick-icon { border-radius: 14px; display: flex; align-items: center; justify-content: center; }
.quick-icon.ai { width: 34px; height: 34px; border-radius: 10px; margin-bottom: 8px; background-image: linear-gradient(135deg, #3E9187 0%, var(--accent2) 100%); color: var(--text-invert); font-size: 11px; font-weight: 800; }
.quick-icon.feedback { width: 30px; height: 30px; border-radius: 10px; margin-bottom: 0; background: var(--accent-bg); color: var(--accent2); font-size: 14px; }
.quick-title { display: block; color: var(--ink); font-size: 14px; font-weight: 800; }
.quick-desc { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; line-height: 15px; }
.quick-card.plain .quick-title { font-size: 13px; }
.quick-card.plain .quick-desc { margin-top: 2px; font-size: 10px; line-height: 14px; }
.quick-arrow { position: absolute; right: 12px; top: 16px; color: var(--soft); font-size: 16px; line-height: 16px; }
.quick-card.plain .quick-arrow { position: relative; right: 0px; top: 0px; flex-shrink: 0; width: 14px; font-size: 14px; text-align: center; }
.quick-note { margin-top: 6px; padding: 6px 9px; border-radius: 9px; background-color: rgba(255, 255, 255, 0.72); }
.quick-note text { color: var(--soft); font-size: 9px; line-height: 14px; }

/* ===== 分类胶囊：横向滑动 ===== */
/* mp-weixin 嵌套 scroll-view 内 flex 容器无法自算宽度，改用 JS 给定确定宽度 */
.chips-wrap { position: relative; }
.category-chips { width: 100%; height: 46px; white-space: nowrap; }
.category-chips-inner { box-sizing: border-box; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; height: 46px; padding: 0 20px; }
.category-chip { flex-shrink: 0; height: 32px; padding: 0 15px; margin-right: 8px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.category-chip-label { color: var(--muted); font-size: 12px; font-weight: 600; }
.category-chip.active { background: var(--accent); border-color: var(--accent); }
.category-chip.active .category-chip-label { color: var(--text-invert); }
.chips-fade { position: absolute; right: 0px; top: 0px; bottom: 0px; width: 26px; pointer-events: none; background-image: linear-gradient(90deg, rgba(244, 248, 247, 0) 0%, rgba(244, 248, 247, 1) 100%); }
/* ===== 问题列表：单张大圆角卡 ===== */
.faq-panel { margin: 6px 20px 0; }
.faq-card { background: var(--surface); border-radius: 20px; box-shadow: var(--shadow-sm); overflow: hidden; }
.faq-row { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 15px 16px; }
/* FAQ 行现在包在 .faq-item 里，相邻行分割线要按 item 层判断 */
.faq-item + .faq-item .faq-row { border-top: 1px solid var(--warm); }
.faq-row:active { background: var(--bg-hover); }
.faq-answer { padding: 0 16px 14px 52px; }
.faq-answer-text { display: block; color: var(--muted); font-size: 12px; line-height: 19px; }
.faq-answer-cta { display: flex; flex-direction: row; align-items: center; justify-content: center; margin-top: 10px; height: 32px; border-radius: 9px; background: var(--accent-bg); }
.faq-answer-cta text { color: var(--accent2); font-size: 12px; font-weight: 700; }
.faq-badge { flex-shrink: 0; width: 26px; height: 26px; border-radius: 9px; background: var(--accent-glow); color: var(--accent2); font-size: 10px; font-weight: 800; text-align: center; line-height: 26px; }
.faq-question { flex: 1; min-width: 0; color: var(--ink2); font-size: 13px; line-height: 20px; }
.faq-chev { flex-shrink: 0; width: 22px; height: 22px; border-radius: 11px; background: var(--canvas); display: flex; align-items: center; justify-content: center; }
.faq-chev text { color: var(--soft); font-size: 15px; line-height: 15px; }
.state-panel { display: flex; align-items: center; justify-content: center; min-height: 180px; padding: 24px; color: var(--muted); font-size: 13px; text-align: center; }
.state-panel.error { color: var(--accent2); }

/* ===== 底部提示：居中 + 两侧细线 ===== */
.safety-tip { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 18px 24px 20px; }
.tip-line { flex: 1; height: 1px; background: var(--warm); }
.tip-text { color: var(--soft); font-size: 10px; line-height: 16px; }
.sheet-intro { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }
.sheet-intro-title { color: var(--ink); font-size: 15px; font-weight: 800; }
.sheet-intro-desc { color: var(--muted); font-size: 12px; line-height: 1.6; }
.contact-phone { width: 100%; height: 44px; margin-top: 10px; padding: 0 12px; box-sizing: border-box; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--ink); font-size: 13px; }
.feedback-input { width: 100%; min-height: 150px; padding: 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--ink); font-size: 13px; line-height: 1.6; }
.feedback-meta { color: var(--muted); font-size: 11px; text-align: right; margin: 6px 0 10px; }
.feedback-error { display: block; color: var(--accent2); font-size: 12px; margin-bottom: 10px; }
</style>
