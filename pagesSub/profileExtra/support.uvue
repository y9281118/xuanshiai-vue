<template>
  <view class="support-redirect"><text class="support-redirect-text">正在打开客服与帮助...</text></view>
</template>

<script setup lang="uts">
/**
 * 旧版「帮助与客服」页（legacy）。
 *
 * 这个页面曾经是 help 的一份静态副本：4 组 hardcode FAQ + 两个按钮全是
 * `uni.showToast`，零接口调用，意见箱写死「暂未开放」。Q54 把它合并到
 * `pagesSub/profileExtra/help`（真实 /support/help-docs、/support/feedback、
 * /support/contact）。
 *
 * 保留路由而不是直接删掉，是因为老分享路径、二维码和已安装客户端的深链都还指向
 * `/pagesSub/profileExtra/support`；直接下线会让这些入口 404。改成中转页后老链接
 * 仍然可用，功能只有一份实现。用 `redirectTo` 而不是 `navigateTo`，避免用户返回时
 * 又回到这个空白中转页。
 */
onLoad((options) => {
  const open = options?.open ?? ''
  const url = open != '' ? '/pagesSub/profileExtra/help?open=' + open : '/pagesSub/profileExtra/help'
  uni.redirectTo({
    url: url,
    fail: () => { uni.showToast({ title: '客服与帮助打开失败，请重试', icon: 'none' }) }
  })
})
</script>

<style scoped>
.support-redirect { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--canvas); }
.support-redirect-text { color: var(--muted); font-size: 13px; }
</style>
